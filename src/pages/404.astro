---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import TableauPalettes from '@/components/motion/TableauPalettes.astro';
import { t } from '@/i18n/utils';
import type { Language } from '@/i18n/config';

// Detect language from URL path or default to English
const path = Astro.url.pathname;
const langMatch = path.match(/^\/(en|fr)/);
const lang: Language = (langMatch?.[1] as Language) || 'en';

const pageTitle = t(lang, 'error404.metaTitle');
const pageDescription = t(lang, 'error404.metaDescription');
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  noindex={true}
>
  <Header lang={lang} />

  <!-- La page 404, direction Encre (groupe 4, 30/09/2026) : le code tombe sur le tableau à
       palettes, puis les deux portes et les pages les plus demandées. -->
  <main class="section-blanc flex-1">
    <div class="container-custom grid grid-cols-1 items-center gap-10 py-16 sm:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:gap-16">
      <div class="grid justify-items-start gap-5 lg:gap-6">
        <p class="rubrique">{lang === 'fr' ? 'Erreur 404' : 'Error 404'}</p>
        <h1 class="titre-grand text-encre">
          {t(lang, 'error404.heading')}
        </h1>
        <p class="chapo max-w-md">
          {t(lang, 'error404.description')}
        </p>
        <div class="pilules mt-2">
          <a href={`/${lang}`} class="pilule pilule-pleine">
            {t(lang, 'error404.backHome')}
            <Icon name="arrow-right" size={18} class="pilule-fleche" />
          </a>
          <a href={`/${lang}/contact`} class="pilule pilule-contour">
            {t(lang, 'error404.contact')}
          </a>
        </div>
        <div class="mt-6 grid gap-3 border-t border-slate-200 pt-6">
          <p class="text-sm font-semibold text-slate-500">
            {lang === 'fr' ? 'Ou explorez nos pages les plus lues :' : 'Or explore our most visited pages:'}
          </p>
          <ul class="flex flex-wrap gap-2">
            {[
              { href: `/${lang}/services`, label: t(lang, 'nav.services') },
              { href: `/${lang}/case-studies`, label: t(lang, 'nav.caseStudies') },
              { href: `/${lang}/blog`, label: t(lang, 'nav.blog') },
              { href: `/${lang}/calculator`, label: t(lang, 'nav.calculator') },
            ].map((l) => (
              <li><a href={l.href} class="inline-block rounded-full bg-brume-clair px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-marque hover:text-white">{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="carte-encre p-8 lg:p-10">
        <TableauPalettes lang={lang} lignes={[{ chiffre: '404', texte: lang === 'fr' ? 'cette adresse ne mène à aucune page' : 'this address leads to no page' }]} tete auChargement />
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
