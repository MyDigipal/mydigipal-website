---
/**
 * Calculateur v6, PAGE DE TEST (noindex, hors sitemap).
 *
 * Parcours B sur téléphone, guide D1 sur ordinateur (choix de Paul du 22/09/2026).
 * Ici le calculateur tourne en mode test : rien n'est envoyé au webhook, aucun event
 * GA4 ne part, et les emplacements des vidéos facecam s'affichent vides.
 * La page publique `/{lang}/calculator` reste sur l'ancienne version jusqu'à validation.
 *
 * Pilotage : docs/calculator/refonte-2026-09/calculateur-en-etapes.html
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { type Language, languages } from '@/i18n/config';
import CalculatorV6 from '@/components/calculator-v6/CalculatorV6';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };

const copy = {
  fr: {
    title: 'Calculateur de devis, version de test',
    description: 'Version de test du calculateur de devis MyDigipal.',
    headline: 'Votre devis marketing, question par question',
    sub: 'Choisissez vos services, répondez à quelques questions, le prix se calcule au fil des réponses.'
  },
  en: {
    title: 'Quote calculator, test version',
    description: 'Test version of the MyDigipal quote calculator.',
    headline: 'Your marketing quote, one question at a time',
    sub: 'Pick your services, answer a few questions, and the price builds up as you go.'
  }
}[lang === 'fr' ? 'fr' : 'en'];
---

<BaseLayout lang={lang} title={copy.title} description={copy.description} noindex>
  <Header lang={lang} />
  <main class="bg-slate-50 pb-20 pt-28 lg:pt-32">
    <div class="container-custom max-w-6xl">
      <div class="mb-8 max-w-2xl">
        <p class="mb-3 inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">{lang === 'fr' ? 'Page de test : rien n’est envoyé' : 'Test page: nothing is sent'}</p>
        <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">{copy.headline}</h1>
        <p class="mt-3 text-lg text-slate-600">{copy.sub}</p>
      </div>
      <CalculatorV6 client:load lang={lang === 'fr' ? 'fr' : 'en'} showEmptyVideoSlots dryRun />
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
