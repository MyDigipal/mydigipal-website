---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import { type Language, languages } from '@/i18n/config';
import AcademyV2 from '@/components/academy-v2/AcademyV2';
import { copyV2 } from '@/components/academy-v2/copy-v2';
import { ENDPOINT, type Jour30Data } from '@/components/academy/data';
import secoursFr from '@/data/academy/jour30-fr.json';
import secoursEn from '@/data/academy/jour30-en.json';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';

/**
 * AI Academy, seconde formule.
 *
 * ⚠️ Page NOUVELLE, à côté de `/{lang}/academy`, qui reste en ligne et continue
 * de recevoir les campagnes. Paul, 06/09/2026 : « tu ne remplaces pas la page
 * existante, tu builds une nouvelle page qui soit à l'effigie de cette nouvelle
 * formule ». La bascule se décidera après comparaison, et c'est à ce
 * moment-là qu'il faudra reprendre les redirections, le sitemap et les URL des
 * annonces.
 *
 * ⚠️ `noindex` tant que la comparaison n'est pas tranchée : deux pages qui
 * vendent la même formation, toutes deux indexables, se feraient concurrence
 * dans les résultats et brouilleraient le signal que l'on cherche justement à
 * améliorer.
 *
 * Ce qu'elle change par rapport à la première : le programme décrit avant le
 * récit, le récit en trois phases dépliables, la barre qui explique chaque
 * entrée, les écrans du produit là où on se pose la question, et « pour
 * 30 jours » au lieu de « par mois ».
 */
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const c = copyV2(lang as 'fr' | 'en');

async function lire(): Promise<Jour30Data> {
  try {
    const r = await fetch(`${ENDPOINT}?lang=${lang}`, { signal: AbortSignal.timeout(10000) });
    if (r.ok) {
      const d = (await r.json()) as Jour30Data;
      if (d?.etats?.length && d.lang === lang) return d;
    }
  } catch {
    /* instantané */
  }
  return (lang === 'fr' ? secoursFr : secoursEn) as unknown as Jour30Data;
}
const data = await lire();
---

<BaseLayout lang={lang} title={c.meta.titre} description={c.meta.description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="flex-grow">
    <AcademyV2 client:load locale={lang as 'fr' | 'en'} initial={data} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
