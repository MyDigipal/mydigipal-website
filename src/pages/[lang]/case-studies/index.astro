---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import TestimonialSpotlight from '@/components/sections/TestimonialSpotlight.astro';
import TableauPalettes from '@/components/motion/TableauPalettes.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Get case studies for current language only
const allCaseStudies = await getCollection('case-studies');
const caseStudies = allCaseStudies
  .filter((s) => s.id.startsWith(lang + '/'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const translations = {
  en: {
    title: 'Case Studies - B2B Tech and Automotive Results',
    description: 'Explore MyDigipal case studies and success stories. See how we help B2B tech and automotive clients achieve exceptional ROI through strategic digital marketing.',
    hero: {
      badge: 'Success stories',
      headline: 'Our case studies',
      subheadline: 'Real results for real businesses. See how our strategies drive growth.',
    },
    filterAll: 'All',
    filterAutomotive: 'Automotive',
    filterB2BTech: 'B2B Tech',
    viewCaseStudy: 'View case study',
    services: 'Services',
    noResults: 'No case studies found.',
  },
  fr: {
    title: 'Études de cas - Résultats B2B et automobile',
    description: 'Découvrez comment nous aidons les entreprises B2B tech et automobiles à obtenir des résultats exceptionnels grâce à un marketing digital stratégique.',
    hero: {
      badge: 'Études de cas',
      headline: 'Nos études de cas',
      subheadline: 'Des résultats réels pour de vraies entreprises. Découvrez comment nos stratégies stimulent la croissance.',
    },
    filterAll: 'Tous',
    filterAutomotive: 'Automobile',
    filterB2BTech: 'B2B Tech',
    viewCaseStudy: 'Voir l\'étude',
    services: 'Services',
    noResults: 'Aucune étude de cas trouvée.',
  },
};

const t = translations[lang] || translations.en;
const fr = lang === 'fr';
const slugDe = (id: string) => id.replace(/^(en|fr)\//, '');
const chiffre = (v: string) => (fr ? v.replace(/(\d)\s?%/, '$1\u00a0%').replace(/(\d)\.(\d)/, '$1,$2') : v);

// L'étude en vedette : la plus récente des études mises en avant. Ses trois premiers chiffres
// tombent sur le tableau à palettes. Le verbatim vient d'une autre étude mise en avant.
const vedettes = caseStudies.filter((s) => s.data.featured);
const vedette = vedettes[0] ?? caseStudies[0];
const tableau = (vedette.data.kpis as { value: string; label: string }[]).slice(0, 3).map((k) => {
  const [, c = k.value, unite = ''] = k.value.match(/^([+\-−]?[\d.,\s]*\d)\s*(.*)$/) ?? [];
  // Un sigle ou une marque garde sa majuscule (« SEO traffic », « Google Ads conversions »).
  const texte = /^([A-Z]{2}|Google|Facebook|LinkedIn|Meta|Instagram|YouTube|TikTok|Waze)/.test(k.label) ? k.label : k.label.charAt(0).toLowerCase() + k.label.slice(1);
  return { chiffre: fr ? c.replace('.', ',') : c, unite, texte };
});
const cite = vedettes.find((s) => s !== vedette && s.data.testimonial) ?? caseStudies.find((s) => s !== vedette && s.data.testimonial);
const lx = {
  vedette: fr ? 'À la une' : 'Featured',
  lire: fr ? 'Lire l’étude de cas' : 'Read the case study',
  toutes: fr ? 'Toutes les études' : 'All case studies',
  automobile: fr ? 'Automobile' : 'Automotive',
};
---

<PageLayout
  lang={lang}
  title={t.title}
  description={t.description}
>
  <PageHero eyebrow={t.hero.badge} title={t.hero.headline} description={t.hero.subheadline} />

  <!-- L'étude à la une (encre) : sa photo, son logo en couleur, ses chiffres sur le tableau
       à palettes. Direction Encre, groupe 4 (30/09/2026). -->
  <section class="section-encre section-monte py-20 lg:py-28">
    <div class="container-custom grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
      <a href={`/${lang}/case-studies/${slugDe(vedette.id)}`} class="vedette-photo group" data-reveal>
        <img src={vedette.data.image} alt={vedette.data.client} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" decoding="async" />
        {vedette.data.logo && (
          <span class="absolute left-5 top-5 grid h-14 place-items-center rounded-2xl bg-white px-4">
            <img src={vedette.data.logo} alt="" class="max-h-9 max-w-[140px] w-auto object-contain" />
          </span>
        )}
      </a>
      <div class="grid content-start gap-6">
        <p class="text-base font-semibold text-sur-encre-2">{lx.vedette} · {vedette.data.client}</p>
        <h2 class="titre-moyen">{vedette.data.title}</h2>
        <div class="carte-verre p-6 lg:p-8">
          <TableauPalettes lang={lang} lignes={tableau} tete />
        </div>
        <div class="pilules">
          <a href={`/${lang}/case-studies/${slugDe(vedette.id)}`} class="pilule pilule-blanche">
            {lx.lire}
            <Icon name="arrow-right" size={18} class="pilule-fleche" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Toutes les études (brume), filtrables par secteur. -->
  <section class="section-brume py-20 lg:py-28">
    <div class="container-custom">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6 lg:mb-14">
        <h2 class="titre-moyen text-encre">{lx.toutes}</h2>
        <div class="flex flex-wrap gap-2" role="group" aria-label={fr ? 'Filtrer par secteur' : 'Filter by sector'}>
          <button type="button" class="category-filter active" data-category="all" aria-pressed="true">{t.filterAll}</button>
          <button type="button" class="category-filter" data-category="automotive" aria-pressed="false">{t.filterAutomotive}</button>
          <button type="button" class="category-filter" data-category="b2b-tech" aria-pressed="false">{t.filterB2BTech}</button>
        </div>
      </div>

      <div id="no-results" class="hidden py-16 text-center">
        <p class="text-xl text-slate-500">{t.noResults}</p>
      </div>

      <ul id="case-studies-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {caseStudies.map((study, i) => {
          const k = study.data.kpis[0];
          const k2 = study.data.kpis[1];
          return (
            <li class="case-study-card" data-category={study.data.category} data-reveal style={`--i:${i % 3}`}>
              <a href={`/${lang}/case-studies/${slugDe(study.id)}`} class="carte group grid h-full overflow-hidden">
                <span class="relative block aspect-[16/10] overflow-hidden">
                  <img src={study.data.image} alt="" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                  {study.data.logo && (
                    <span class="absolute left-4 top-4 grid h-11 place-items-center rounded-xl bg-white px-3">
                      <img src={study.data.logo} alt="" class="max-h-7 max-w-[110px] w-auto object-contain" loading="lazy" decoding="async" />
                    </span>
                  )}
                </span>
                <span class="grid content-start gap-3 p-6">
                  <span class="text-sm font-semibold text-slate-500">{study.data.category === 'automotive' ? lx.automobile : 'B2B Tech'} · {study.data.client}</span>
                  <span class="font-display text-lg font-bold leading-snug text-encre text-pretty">{study.data.title}</span>
                  <span class="mt-2 flex flex-wrap items-baseline gap-x-5 gap-y-2 border-t border-slate-200 pt-4">
                    <span><span class="font-display text-4xl font-extrabold tracking-[-0.045em] text-encre">{chiffre(k.value)}</span> <span class="text-sm text-slate-600">{k.label}</span></span>
                    {k2 && <span><span class="font-display text-2xl font-extrabold tracking-[-0.03em] text-encre">{chiffre(k2.value)}</span> <span class="text-sm text-slate-600">{k2.label}</span></span>}
                  </span>
                  <span class="mt-1 inline-flex items-center gap-2 font-semibold text-marque transition-all group-hover:gap-3">{t.viewCaseStudy}<Icon name="arrow-right" size={16} /></span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {cite?.data.testimonial && (
    <TestimonialSpotlight lang={lang} quote={cite.data.testimonial.quote} author={cite.data.testimonial.author} role="" company={cite.data.testimonial.role} />
  )}

  <FinalCTA lang={lang} title={lang === 'fr' ? 'Prêt à écrire votre success story ?' : 'Ready to write your success story?'} subtitle={lang === 'fr' ? 'Calculez votre plan sur mesure en 3 minutes, ou dites-nous où vous en êtes : on vous répond sous 24 h.' : 'Calculate your tailored plan in 3 minutes, or tell us where you stand: we reply within 24 hours.'} />
</PageLayout>

<script>
  // Le filtre par secteur : les cartes gardent leur place dans la grille, seules les autres
  // se masquent.
  function brancher() {
    const boutons = Array.from(document.querySelectorAll<HTMLButtonElement>('.category-filter'));
    const cartes = Array.from(document.querySelectorAll<HTMLElement>('.case-study-card'));
    const vide = document.getElementById('no-results');
    const grille = document.getElementById('case-studies-grid');
    boutons.forEach((b) => {
      if (b.dataset.branche) return;
      b.dataset.branche = '1';
      b.addEventListener('click', () => {
        boutons.forEach((x) => { x.classList.toggle('active', x === b); x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        const c = b.dataset.category;
        let n = 0;
        cartes.forEach((carte) => {
          const ok = c === 'all' || carte.dataset.category === c;
          carte.hidden = !ok;
          if (ok) n++;
        });
        vide?.classList.toggle('hidden', n > 0);
        grille?.classList.toggle('hidden', n === 0);
      });
    });
  }
  brancher();
  document.addEventListener('astro:page-load', brancher);
</script>

<style>
  .vedette-photo {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--rayon-scene);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), 0 30px 60px -36px rgb(2 9 16 / 0.9);
  }
  .category-filter {
    border-radius: 999px;
    padding: 10px 18px;
    font-weight: 600;
    color: #334155;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--filet);
    transition: background-color 200ms, color 200ms;
  }
  .category-filter:hover {
    color: var(--color-marque);
  }
  .category-filter.active {
    color: #fff;
    background: var(--color-marque);
    box-shadow: none;
  }
</style>
