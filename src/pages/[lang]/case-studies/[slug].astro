---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import { getCollection, render } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import CaseStudySchema from '@/components/seo/CaseStudySchema.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import TestimonialSpotlight from '@/components/sections/TestimonialSpotlight.astro';
import TableauPalettes from '@/components/motion/TableauPalettes.astro';
import RevelationLogo from '@/components/motion/RevelationLogo.astro';
import { LOGOS } from '@/components/accueil/donnees';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  const paths: { params: { lang: string; slug: string }; props: { caseStudy: any } }[] = [];

  // Group case studies by slug (without language prefix)
  const studiesBySlug = new Map<string, Map<string, any>>();

  caseStudies.forEach((study) => {
    const [studyLang, ...slugParts] = study.id.split('/');
    const slug = slugParts.join('/');

    if (!studiesBySlug.has(slug)) {
      studiesBySlug.set(slug, new Map());
    }
    studiesBySlug.get(slug)!.set(studyLang, study);
  });

  // Create paths for each language that has a file
  studiesBySlug.forEach((studiesByLang, slug) => {
    Object.keys(languages).forEach((lang) => {
      const study = studiesByLang.get(lang);
      if (study) {
        paths.push({
          params: { lang, slug },
          props: { caseStudy: study },
        });
      }
    });
  });

  return paths;
}

const { lang } = Astro.params as { lang: Language };
const { caseStudy } = Astro.props;
const { Content } = await render(caseStudy);
const fr = lang === 'fr';
const slugDe = (id: string) => id.replace(/^(en|fr)\//, '');
const studySlug = slugDe(caseStudy.id);

// Les autres études : la même catégorie d'abord, puis les plus récentes, trois au plus.
const allCaseStudies = await getCollection('case-studies');
const autres = allCaseStudies
  .filter((s) => s.id.startsWith(`${lang}/`) && s.id !== caseStudy.id)
  .sort((a, b) => Number(b.data.category === caseStudy.data.category) - Number(a.data.category === caseStudy.data.category) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const t = {
  en: {
    retour: 'All case studies', defi: 'The challenge', solution: 'Our solution', services: 'Services used',
    partager: 'Share this case study', autres: 'Other case studies', lire: 'Read the case study',
    ctaTitle: 'Ready to achieve similar results?', ctaText: 'Calculate your tailored plan in 3 minutes, or tell us where you stand: we reply within 24 hours.',
    automobile: 'Automotive', copier: 'Copy the link', resultats: 'Results',
  },
  fr: {
    retour: 'Toutes les études de cas', defi: 'Le défi', solution: 'Notre solution', services: 'Services utilisés',
    partager: 'Partager cette étude', autres: 'Autres études de cas', lire: 'Lire l’étude de cas',
    ctaTitle: 'Prêt à obtenir des résultats similaires ?', ctaText: 'Calculez votre plan sur mesure en 3 minutes, ou dites-nous où vous en êtes : on vous répond sous 24 h.',
    automobile: 'Automobile', copier: 'Copier le lien', resultats: 'Résultats',
  },
}[lang];

const categorie = caseStudy.data.category === 'automotive' ? t.automobile : 'B2B Tech';

// Le logo du client, détouré (celui de l'accueil), à SURFACE égale d'une étude à l'autre.
const DETOURES: Record<string, string> = {
  'dmd-group': 'dmd', 'theobald-group': 'theobald', 'vulcain-group': 'vulcain', genesys: 'genesys',
  gwi: 'gwi', 'symbl-ai': 'symbl', 'quantum-metrics': 'quantum',
};
const detoure = LOGOS[DETOURES[studySlug] ?? ''];
const logo = detoure
  ? (() => {
      const ratio = detoure.largeur / detoure.hauteur;
      const h = Math.round(Math.min(84, Math.max(44, Math.sqrt(9500 / ratio) * detoure.echelle)));
      return { src: detoure.src, h, l: Math.round(h * ratio) };
    })()
  : caseStudy.data.logo
    ? { src: caseStudy.data.logo, h: 56, l: 200 }
    : null;

// Les chiffres du client sur le tableau à palettes : « +112% » devient le chiffre « +112 »
// et l'unité « % » ; le quatrième, quand la fiche en a un, est écrit dessous.
const decouper = (k: { value: string; label: string }) => {
  const [, chiffre = k.value, unite = ''] = k.value.match(/^([+\-−]?[\d.,\s]*\d)\s*(.*)$/) ?? [];
  const texte = /^[A-Z]{2}/.test(k.label) ? k.label : k.label.charAt(0).toLowerCase() + k.label.slice(1);
  return { chiffre: fr ? chiffre.replace('.', ',') : chiffre, unite, texte };
};
const kpis = caseStudy.data.kpis as { value: string; label: string }[];
const tableau = kpis.slice(0, 3).map(decouper);
const quatrieme = kpis[3] ? decouper(kpis[3]) : null;

// SEO Schema data
const studyUrl = `https://mydigipal.com/${lang}/case-studies/${studySlug}`;
const breadcrumbItems = [
  { name: fr ? 'Accueil' : 'Home', url: `/${lang}` },
  { name: fr ? 'Études de cas' : 'Case Studies', url: `/${lang}/case-studies` },
  { name: caseStudy.data.client, url: `/${lang}/case-studies/${studySlug}` }
];
const temoignage = caseStudy.data.testimonial;
---

<PageLayout
  lang={lang}
  title={caseStudy.data.seo?.title ?? `${caseStudy.data.client} - ${caseStudy.data.title}`}
  description={caseStudy.data.seo?.description ?? caseStudy.data.description}
>
  <CaseStudySchema
    client={caseStudy.data.client}
    title={caseStudy.data.title}
    description={caseStudy.data.description}
    url={studyUrl}
    image={caseStudy.data.image}
    datePublished={caseStudy.data.date}
    services={caseStudy.data.services}
    lang={lang}
    testimonial={caseStudy.data.testimonial}
  />
  <BreadcrumbSchema items={breadcrumbItems} />

  <!-- Le haut de l'étude, direction Encre (groupe 4, 30/09/2026) : le logo du client se forme
       en particules de ses propres couleurs, puis le vrai logo monte ; ses chiffres tombent sur
       le tableau à palettes, dans le panneau d'encre. La toile des particules couvre la section
       (premier ancêtre positionné) et passe sous le texte. -->
  <section class="cas-hero section-blanc relative isolate overflow-hidden">
    <div class="container-custom pt-8 pb-16 sm:pt-12 lg:pt-14 lg:pb-24">
      <a href={`/${lang}/case-studies`} class="relative z-[1] mb-10 inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition-colors hover:text-encre">
        <Icon name="arrow-left" size={16} />
        {t.retour}
      </a>

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
        <div class="grid justify-items-start gap-5 lg:gap-6">
          {logo && <RevelationLogo src={logo.src} alt={caseStudy.data.client} largeur={logo.l} hauteur={logo.h} class="mb-2" />}
          <p class="rubrique relative z-[1]">{categorie} · {caseStudy.data.client}</p>
          <h1 class="titre-grand relative z-[1] text-encre break-words">{caseStudy.data.title}</h1>
          <p class="chapo relative z-[1] max-w-[56ch]">{caseStudy.data.description}</p>
          <ul class="puces relative z-[1] mt-1" aria-label={t.services}>
            {caseStudy.data.services.map((s: string) => <li>{s}</li>)}
          </ul>
        </div>

        <div class="cas-panneau relative z-[1]">
          <p class="mb-6 text-base font-semibold text-sur-encre-2">{t.resultats}</p>
          <TableauPalettes lang={lang} lignes={tableau} tete auChargement />
          {quatrieme && (
            <p class="mt-6 border-t border-white/10 pt-5 text-sur-encre-2">
              <span class="font-display text-2xl font-extrabold tracking-[-0.03em] text-white">{quatrieme.chiffre}{quatrieme.unite}</span>
              {' '}{quatrieme.texte}
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Le défi et la solution (encre), avec la photo du cas. -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom grid grid-cols-1 items-center gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-10">
      {caseStudy.data.image && (
        <figure class="cas-photo" data-reveal>
          <img src={caseStudy.data.image} alt={caseStudy.data.client} loading="lazy" decoding="async" />
        </figure>
      )}
      <div class="grid gap-4 lg:gap-5">
        <div class="carte-verre grid gap-3 p-6 lg:p-8" data-reveal>
          <span class="tuile tuile-pleine"><Icon name="target" size={26} /></span>
          <h2 class="titre-carte text-white lg:text-[1.75rem]">{t.defi}</h2>
          <p class="text-lg leading-relaxed text-sur-encre text-pretty">{caseStudy.data.challenge}</p>
        </div>
        <div class="carte-verre grid gap-3 p-6 lg:p-8" data-reveal style="--i:1">
          <span class="tuile tuile-pleine"><Icon name="check-circle" size={26} /></span>
          <h2 class="titre-carte text-white lg:text-[1.75rem]">{t.solution}</h2>
          <p class="text-lg leading-relaxed text-sur-encre text-pretty">{caseStudy.data.solution}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Le récit complet (blanc), puis les services et le partage. -->
  <section class="section-blanc py-20 lg:py-28">
    <div class="container-custom">
      <article class="cas-recit prose prose-lg prose-slate mx-auto max-w-[760px]">
        <Content />
      </article>

      <div class="mx-auto mt-14 grid max-w-[760px] gap-8 border-t border-slate-200 pt-8 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
        <div class="grid gap-3">
          <p class="text-sm font-semibold text-slate-500">{t.services}</p>
          <ul class="puces">{caseStudy.data.services.map((s: string) => <li>{s}</li>)}</ul>
        </div>
        <div class="grid gap-3">
          <p class="text-sm font-semibold text-slate-500">{t.partager}</p>
          <div class="flex gap-2.5">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(caseStudy.data.client + ': ' + caseStudy.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank" rel="noopener noreferrer" aria-label="X"
              class="grid h-11 w-11 place-items-center rounded-full bg-brume-clair text-slate-600 transition-colors hover:bg-marque hover:text-white"
            ><Icon name="twitter" size={18} /></a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
              class="grid h-11 w-11 place-items-center rounded-full bg-brume-clair text-slate-600 transition-colors hover:bg-marque hover:text-white"
            ><Icon name="linkedin" size={18} /></a>
            <button
              type="button"
              data-copier={Astro.url.href}
              title={t.copier}
              aria-label={t.copier}
              class="grid h-11 w-11 place-items-center rounded-full bg-brume-clair text-slate-600 transition-colors hover:bg-marque hover:text-white"
            ><Icon name="link" size={18} /></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Le verbatim du client (encre). -->
  {temoignage && (
    <TestimonialSpotlight lang={lang} quote={temoignage.quote} author={temoignage.author} role="" company={temoignage.role} />
  )}

  <!-- Les autres études (blanc) : la photo, le logo en couleur, un chiffre. -->
  {autres.length > 0 && (
    <section class="section-blanc py-20 lg:py-28">
      <div class="container-custom">
        <h2 class="titre-moyen mb-10 text-encre lg:mb-14">{t.autres}</h2>
        <ul class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {autres.map((s, i) => {
            const k = s.data.kpis[0];
            return (
              <li data-reveal style={`--i:${i}`}>
                <a href={`/${lang}/case-studies/${slugDe(s.id)}`} class="carte group grid h-full overflow-hidden">
                  <span class="relative block aspect-[16/10] overflow-hidden">
                    <img src={s.data.image} alt="" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                    {s.data.logo && (
                      <span class="absolute left-4 top-4 grid h-11 place-items-center rounded-xl bg-white px-3">
                        <img src={s.data.logo} alt="" class="max-h-7 max-w-[110px] w-auto object-contain" loading="lazy" decoding="async" />
                      </span>
                    )}
                  </span>
                  <span class="grid content-start gap-3 p-6">
                    <span class="font-semibold text-slate-500">{s.data.client}</span>
                    <span class="font-display text-5xl font-extrabold leading-none tracking-[-0.045em] text-encre">{fr ? k.value.replace(/(\d)\s?%/, '$1\u00a0%').replace(/(\d)\.(\d)/, '$1,$2') : k.value}</span>
                    <span class="text-slate-600">{k.label}</span>
                    <span class="mt-2 inline-flex items-center gap-2 font-semibold text-marque transition-all group-hover:gap-3">{t.lire}<Icon name="arrow-right" size={16} /></span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <FinalCTA lang={lang} title={t.ctaTitle} subtitle={t.ctaText} />
</PageLayout>

<script>
  // Copier le lien de l'étude, sans script en ligne dans le HTML.
  function brancher() {
    document.querySelectorAll<HTMLButtonElement>('[data-copier]').forEach((b) => {
      if (b.dataset.branche) return;
      b.dataset.branche = '1';
      b.addEventListener('click', () => navigator.clipboard?.writeText(b.dataset.copier || location.href));
    });
  }
  brancher();
  document.addEventListener('astro:page-load', brancher);
</script>

<style>
  @reference "../../../styles/global.css";

  /* Le panneau d'encre du haut, le même que celui des pages de services. */
  .cas-panneau {
    --plaque-x: 10px;
    --plaque-y: 12px;
    margin: 0 var(--plaque-x) var(--plaque-y) 0;
    padding: 28px 24px;
    border-radius: var(--rayon-panneau);
    color: var(--texte-sombre);
    background:
      radial-gradient(110% 80% at 92% -10%, rgb(29 113 184 / 0.55) 0%, rgb(29 113 184 / 0.16) 42%, transparent 68%),
      var(--encre);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.10),
      var(--plaque-x) var(--plaque-y) 0 0 var(--brume),
      var(--plaque-x) var(--plaque-y) 0 1px var(--filet),
      var(--ombre-forte);
  }
  @media (min-width: 1024px) {
    .cas-panneau {
      --plaque-x: 16px;
      --plaque-y: 18px;
      padding: 40px;
    }
  }

  .cas-photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--rayon-scene);
    aspect-ratio: 4 / 3;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), 0 30px 60px -36px rgb(2 9 16 / 0.9);
  }
  .cas-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Le récit : les titres et les liens du système Encre. */
  .cas-recit :global(h2) {
    @apply font-display text-encre mt-14 mb-5;
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2.125rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .cas-recit :global(h3) {
    @apply font-display text-encre mt-10 mb-3;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .cas-recit :global(p) {
    @apply text-slate-600 leading-relaxed mb-5;
  }
  .cas-recit :global(ul),
  .cas-recit :global(ol) {
    @apply my-5 pl-6;
  }
  .cas-recit :global(li) {
    @apply text-slate-600 mb-2;
  }
  .cas-recit :global(a) {
    @apply text-marque underline underline-offset-2;
  }
  .cas-recit :global(strong) {
    @apply text-encre font-semibold;
  }
  .cas-recit :global(blockquote) {
    @apply border-l-4 border-marque pl-6 text-slate-700 my-8;
  }
  .cas-recit > :global(:first-child) {
    margin-top: 0;
  }

  /* Les parties du récit (rehype-parties-cas) : des bandes sur toute la largeur de l'écran,
     la stratégie sur la brume, les résultats sur l'encre. L'ombre étend le fond de la bande,
     le découpage l'arrête en haut et en bas ; aucune barre de défilement de côté. */
  .cas-recit :global(.cas-partie) {
    position: relative;
    padding-block: 8px;
  }
  .cas-recit :global(.cas-partie-brume),
  .cas-recit :global(.cas-partie-encre) {
    margin-block: 56px;
    padding-block: 56px 40px;
    clip-path: inset(0 -100vmax);
  }
  .cas-recit :global(.cas-partie-brume) {
    background: var(--brume);
    box-shadow: 0 0 0 100vmax var(--brume);
  }
  .cas-recit :global(.cas-partie-encre) {
    background: var(--encre);
    box-shadow: 0 0 0 100vmax var(--encre);
  }
  .cas-recit :global(.cas-partie-brume > h2:first-child),
  .cas-recit :global(.cas-partie-encre > h2:first-child) {
    margin-top: 0;
  }
  .cas-recit :global(.cas-partie-encre h2),
  .cas-recit :global(.cas-partie-encre h3),
  .cas-recit :global(.cas-partie-encre strong) {
    color: #fff;
  }
  .cas-recit :global(.cas-partie-encre p),
  .cas-recit :global(.cas-partie-encre li) {
    color: var(--texte-sombre);
  }
  .cas-recit :global(.cas-partie-encre a) {
    color: var(--color-marque-clair);
  }
  .cas-recit :global(.cas-partie-encre li::marker) {
    color: var(--color-marque-clair);
  }
  .cas-recit > :global(.cas-partie:last-child) {
    margin-bottom: 0;
  }
</style>
