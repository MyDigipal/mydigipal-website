export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const fr = lang === 'fr';
const L = fr ? 'fr' : 'en';

/* ------------------------------------------------------------ les fiches */

const etudes = (await getCollection('case-studies')).filter((s) => s.id.startsWith(`${L}/`));
const slugDe = (id: string) => id.replace(/^(en|fr)\//, '');
const fiche = (slug: string) => {
  const e = etudes.find((s) => slugDe(s.id) === slug);
  if (!e) throw new Error(`automotive-apercu : l'étude ${L}/${slug} est introuvable.`);
  return e;
};
const chiffreDe = (slug: string, i: number) => {
  const c = (fiche(slug).data as any).chiffres?.[i];
  if (!c) throw new Error(`automotive-apercu : ${L}/${slug} n'a pas de chiffre n° ${i}.`);
  return { valeur: c.valeur as string, texte: c.texte as string };
};
/** La scène telle que la fiche la déclare (titre, légende et repos dans la bonne langue). */
const sceneDe = (slug: string, labo: string, jeu?: string) => {
  const plans = ((fiche(slug).data as any).plans ?? []) as any[];
  const scenes = plans.flatMap((p) => [p.scene, ...(p.recit ?? []).map((c: any) => c.scene)]).filter(Boolean);
  const s = scenes.find((x: any) => x.labo === labo && (jeu === undefined || x.jeu === jeu));
  if (!s) throw new Error(`automotive-apercu : pas de scène ${labo}${jeu ? `?jeu=${jeu}` : ''} dans ${L}/${slug}.`);
  return s;
};
const etudeUrl = (slug: string) => `/${lang}/case-studies/${slug}`;

