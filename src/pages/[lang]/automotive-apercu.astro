/* Les logos des groupes à SURFACE égale, comme dans le bandeau : un logo presque carré
   (Théobald) monte plus haut qu'un logo en longueur (Lancien). */
const mesures = await mesurerLogos(groupesAuto.filter((g) => g.logo).map((g) => ({ name: g.id, logo: g.logo! })));
const hauteurLogo = (id: string, k = 1) => {
  const m = mesures.find((x) => x.name === id);
  if (!m?.largeur || !m?.hauteur) return 36 * k;
  /* Le fichier de Guyane Automobile garde une large marge transparente autour du mot. */
  const marge = id === 'guyane' ? 1.45 : 1;
  return Math.round(Math.min(58, Math.max(26, Math.sqrt(4400 / (m.largeur / m.hauteur)))) * k * marge);
};
