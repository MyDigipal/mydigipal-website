    : [
        { texte: 'MyDigipal’s automotive expertise is unmatched. They understand our industry, our challenges, and deliver campaigns that actually bring customers to our showroom.', auteur: 'Jennifer G.', fonction: 'marketing director, Theobald Group', photo: '/images/Client logo/Jennifer G.jpeg' },
        { texte: 'What sets MyDigipal apart is the proximity and personalised follow-up. They’re always available, proactive with optimisations, and truly invested in our success.', auteur: 'Vanina F.', fonction: 'digital manager, Vulcain Group', photo: '/images/Client logo/Vanina F.jpeg' },
      ],
};

/* ------------------------------------------------------------ les questions */

const faq = fr
  ? [
      { question: 'Faut-il un gros budget pour commencer ?', answer: 'Non. On commence souvent par une marque ou par l’occasion, puis on élargit à ce qui vend. L’estimateur plus haut donne un ordre de grandeur pour votre zone et votre budget, à partir des résultats de nos comptes automobiles.' },
      { question: 'Vous occupez-vous de groupes de plusieurs marques ?', answer: 'Oui, c’est le cas de la plupart de nos clients : dix marques chez Théobald, huit chez Guyane Automobile. Chaque marque a son budget, ses annonces et ses chiffres, et le groupe garde une vue d’ensemble.' },
      { question: 'Comment travaillez-vous avec les programmes des constructeurs ?', answer: 'Certaines marques diffusent déjà pour vous dans leurs programmes, d’autres encadrent les recherches sur leur nom. Nous vérifions le cadre de chaque marque avant de lancer, pour compléter ce qu’elles font sans se marcher dessus.' },
      { question: 'Que faut-il pour transformer notre stock en annonces ?', answer: 'Le stock de votre site, exporté chaque jour : modèle, année, kilométrage, prix, photos et concession. Nous en faisons un flux pour Google et pour Meta, et une voiture vendue sort des annonces toute seule.' },
      { question: 'Pouvez-vous relier les contacts à notre CRM ?', answer: 'Oui. La source de chaque contact (canal, campagne, mot-clé) voyage jusqu’au CRM, puis contacts, opportunités et ventes sont rapprochés automatiquement, en temps réel quand le CRM le permet.' },
    ]
  : [
      { question: 'Do we need a big budget to start?', answer: 'No. We often start with one brand or with used cars, then extend to what sells. The estimator above gives an order of magnitude for your area and budget, based on the results of the dealer accounts we run.' },
      { question: 'Do you work with multi-brand dealer groups?', answer: 'Yes, most of our clients are: ten brands at Théobald, eight at Guyane Automobile. Each brand has its own budget, ads and numbers, and the group keeps the overall view.' },
      { question: 'How do you work with manufacturer programmes?', answer: 'Some brands already advertise for you through their programmes, others set rules on searches for their name. We check each brand’s framework before launching, so we add to what they do instead of competing with it.' },
      { question: 'What do you need to turn our stock into ads?', answer: 'The stock on your website, exported every day: model, year, mileage, price, photos and dealership. We turn it into a feed for Google and Meta, and a sold car leaves the ads on its own.' },
      { question: 'Can you connect leads to our CRM?', answer: 'Yes. Each lead’s source (channel, campaign, keyword) travels into the CRM, then leads, opportunities and sales are matched automatically, in real time when the CRM allows it.' },
    ];

const fin = fr
  ? { titre: 'Et chez vous, combien de voitures de plus ?', texte: 'Le calculateur chiffre vos campagnes en deux minutes. Ou écrivez-nous : réponse sous 24 h.' }
  : { titre: 'How many more cars could you sell?', texte: 'The calculator prices your campaigns in two minutes. Or write to us: we reply within 24 hours.' };

const problemes = [
  { id: 'acheteurs', fond: 'encre', bloc: acheteurs },
  { id: 'contacts', fond: 'blanc', bloc: contacts },
  { id: 'mesure', fond: 'encre', bloc: mesure },
] as const;
---

<PageLayout lang={lang} title={t.seo.titre} description={t.seo.description} noindex>
  <div class="auto-apercu">
    <!-- 1. Le hero (blanc) : la phrase, les chiffres de l'agence sur le tableau à palettes,
         les deux portes, puis les logos des clients en couleur. -->
    <HeroService
      lang={lang}
      badge={t.hero.badge}
      headline={t.hero.titre}
      description={t.hero.texte}
      tableau={tableau}
      heroLogos={logos}
      titreLogos={t.hero.logos}
      serviceCalculateur="google-ads,paid-social"
    />

    <!-- 2. Le parcours d'un acheteur, sur le rail (brume) : gardé de la page actuelle. -->
    <AutomotiveRail lang={lang} titre={t.rail} chapo={t.railChapo} stations={railParcours(lang)} fond="brume" />

    <!-- 3, 6 et 8. Les trois problèmes, chacun en récit collé : le texte défile à gauche, la
         scène du labo reste à droite et change avec le chapitre. Au téléphone, chaque scène
         passe dans le flux, au-dessus de son chapitre. -->
    {problemes.map((p) => (
      <Fragment>
        <section
          id={p.id}
          class:list={[`section-${p.fond}`, { 'section-monte': p.fond === 'encre' }, 'probleme py-20 lg:py-28']}
        >
          <div class="container-custom">
            <header class="grid max-w-[760px] gap-5 lg:gap-6">
              <h2 class:list={['titre-moyen', p.fond === 'encre' ? 'text-white' : 'text-encre']}>{p.bloc.titre}</h2>
              <p class="chapo">{p.bloc.chapo}</p>
            </header>
            <div class="recit-colle" data-recit>
              <div class="recit-chapitres">
                {p.bloc.chapitres.map((c, j) => (
                  <article class="recit-chapitre" data-chapitre={j}>
                    <div class="recit-mobile"><SceneEtude lang={lang} scene={c.scene} fond={p.fond} id={`${p.id}-${j}-m`} /></div>
                    <p class="levier-nom">{c.marque}</p>
                    <h3 class:list={['recit-titre', p.fond === 'encre' ? 'text-white' : 'text-encre']}>{c.titre}</h3>
                    {c.paragraphes.map((x) => <p class="recit-texte">{x}</p>)}
                    <div class="chiffre-levier">
                      <b>{c.chiffre.valeur}</b>
                      <span>{c.chiffre.texte}</span>
                    </div>
                    <p class="liens-levier">
                      {c.liens.map((l) => (
                        <a href={l.href}>{l.label}<Icon name="arrow-right" size={16} /></a>
                      ))}
                    </p>
                  </article>
                ))}
              </div>
              <aside class="recit-scene" aria-hidden="true">
                <div class="recit-pile">
                  {p.bloc.chapitres.map((c, j) => (
                    <div class:list={['recit-calque', { actif: j === 0 }]} data-calque={j}>
                      <SceneEtude lang={lang} scene={c.scene} fond={p.fond} id={`${p.id}-${j}`} chargement="eager" />
                    </div>
                  ))}
                </div>
              </aside>
            </div>
          </div>
        </section>

        {p.id === 'acheteurs' && (
          <Fragment>
            <!-- 4. Le stock qui devient des annonces, puis ce que cela donne en quatre mois
                 (brume) : gardé de la page actuelle, avec le lien vers le dossier. -->
            <VehicleAdsResultats lang={lang} fond="brume" chaine>
              <p class="liens-levier mt-8">
                <a href={etudeUrl('vehicle-catalogue-ads')}>{fr ? 'Lire le dossier : le stock qui devient l’annonce' : 'Read the deep dive: stock that becomes the ad'}<Icon name="arrow-right" size={16} /></a>
              </p>
            </VehicleAdsResultats>

            <!-- 5. Les portes ouvertes (encre) : la boucle de remarketing, au défilement. -->
            <section id="portes-ouvertes" class="section-encre section-monte py-20 lg:py-28">
              <div class="container-custom">
                <header class="grid max-w-[760px] gap-5 lg:gap-6">
                  <h2 class="titre-moyen text-white">{portes.titre}</h2>
                  <p class="chapo">{portes.chapo}</p>
                </header>
                <div class="mt-12 lg:mt-14">
                  <BoucleRemarketing lang={lang} id="auto-boucle" defilement />
                </div>
                <div class="chiffres-portes">
                  {portes.chiffres.map((c) => (
                    <div><b>{c.valeur}</b><span>{c.texte}</span></div>
                  ))}
                </div>
                <p class="liens-levier mt-8">
                  <a href={etudeUrl('open-days')}>{t.dossier}<Icon name="arrow-right" size={16} /></a>
                </p>
              </div>
            </section>
          </Fragment>
        )}
      </Fragment>
    ))}

    <!-- 9. Les trois leviers (brume) : gardés de la page actuelle, une ligne chacun, ses
         marques, et sur l'encre un chiffre lu dans l'étude de cas du levier. -->
    <section class="section-brume py-20 lg:py-28">
      <div class="container-custom">
        <header class="mb-12 grid max-w-[760px] gap-5 lg:mb-14 lg:gap-6">
          <h2 class="titre-moyen text-encre">{leviers.titre}</h2>
          <p class="chapo">{leviers.chapo}</p>
        </header>
        <ul class="grid gap-4 lg:gap-5">
          {leviers.items.map((s, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a href={s.href} class="levier carte group grid grid-cols-1 gap-6 p-6 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-10 lg:p-8">
                <div class="grid content-start gap-4">
                  <ul class="flex flex-wrap gap-2.5" aria-hidden="true">
                    {s.marques.map((m) => (
                      <li class="grid h-11 w-11 place-items-center rounded-xl bg-brume-clair"><Marque nom={m} taille={22} /></li>
                    ))}
                  </ul>
                  <div class="grid gap-1">
                    <h3 class="titre-carte text-encre transition-colors group-hover:text-marque lg:text-[2rem]">{s.nom}</h3>
                    <p class="font-semibold text-slate-500">{s.accroche}</p>
                  </div>
                  <p class="max-w-[60ch] text-slate-600 text-pretty">{s.texte}</p>
                  <ul class="puces">{s.formats.map((f) => <li>{f}</li>)}</ul>
                  <span class="mt-1 inline-flex items-center gap-2 font-semibold text-marque transition-all group-hover:gap-3">
                    {leviers.lien}
                    <Icon name="arrow-right" size={18} />
                  </span>
                </div>
                <div class="carte-encre grid content-between gap-6 p-6 lg:p-8">
                  <p class="levier-grand">{s.chiffre.valeur}</p>
                  <p class="text-base leading-relaxed text-sur-encre text-pretty">{s.chiffre.texte}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 10. Les groupes qu'on accompagne (blanc) : le premier en grand avec sa vignette,
         les six autres autour, et la porte vers toutes les études. -->
    <section class="section-blanc py-20 lg:py-28">
      <div class="container-custom">
        <header class="mb-12 grid max-w-[760px] gap-5 lg:mb-14 lg:gap-6">
          <h2 class="titre-moyen text-encre">{groupes.titre}</h2>
          <p class="chapo">{groupes.chapo}</p>
        </header>
        <ul class="groupes">
          <li class="groupe-tete">
            <a href={etudeUrl(groupeTete.slug)} class="carte group grid h-full overflow-hidden">
              <span class="block aspect-[16/9] overflow-hidden">
                <img src={groupeTete.image} alt="" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
              </span>
              <span class="grid content-start gap-4 p-6 lg:p-8">
                {groupeTete.logo ? <img src={groupeTete.logo} alt={groupeTete.nom} class="groupe-logo" style={`height:${hauteurLogo(groupeTete.id, 1.15)}px`} loading="lazy" decoding="async" /> : <span class="groupe-nom">{groupeTete.nom}</span>}
                <span class="groupe-chiffre groupe-chiffre-grand">{groupeTete.chiffre.valeur}</span>
                <span class="text-slate-600 text-pretty">{groupeTete.chiffre.texte}</span>
                <span class="font-display text-xl font-extrabold leading-snug tracking-[-0.02em] text-encre text-pretty">{groupeTete.titre}</span>
                <span class="inline-flex items-center gap-2 font-semibold text-marque transition-all group-hover:gap-3">{groupes.lire}<Icon name="arrow-right" size={16} /></span>
              </span>
            </a>
          </li>
          {groupesSuite.map((g) => (
            <li>
              <a href={etudeUrl(g.slug)} class="carte group grid h-full content-between gap-5 p-6">
                <span class="grid h-16 items-center">
                  {g.logo ? <img src={g.logo} alt={g.nom} class="groupe-logo" style={`height:${hauteurLogo(g.id)}px`} loading="lazy" decoding="async" /> : <span class="groupe-nom">{g.nom}</span>}
                </span>
                <span class="grid gap-2">
                  <span class="groupe-chiffre">{g.chiffre.valeur}</span>
                  <span class="text-[0.95rem] leading-snug text-slate-600">{g.court}</span>
                </span>
                <span class="inline-flex items-center gap-2 text-[0.95rem] font-semibold text-marque transition-all group-hover:gap-3">{g.nom}<Icon name="arrow-right" size={16} /></span>
              </a>
            </li>
          ))}
          <li class="groupe-tout">
            <a href={`/${lang}/case-studies`} class="carte-encre group grid h-full content-between gap-6 p-6 lg:p-8">
              <span class="font-display text-2xl font-extrabold leading-tight tracking-[-0.025em] text-white">{groupes.tout}</span>
              <span class="text-sur-encre-2 text-pretty">{groupes.toutTexte}</span>
              <span class="inline-flex items-center gap-2 font-semibold text-marque-clair transition-all group-hover:gap-3">{groupes.tout}<Icon name="arrow-right" size={16} /></span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 11. L'estimateur (brume) : « Vos chiffres, dans votre zone ». -->
    <EstimateurAuto lang={lang} fond="brume" etude="automotive" />

    <!-- 12. Comment on travaille, puis l'équipe automobile (encre). -->
    <section class="section-encre section-monte py-20 lg:py-28">
      <div class="container-custom">
        <header class="mb-12 grid max-w-[760px] gap-5 lg:mb-16 lg:gap-6">
          <h2 class="titre-moyen text-white">{methode.titre}</h2>
          <p class="chapo">{methode.chapo}</p>
        </header>
        <ol class="frise">
          {methode.temps.map((m, i) => (
            <li class="frise-temps" data-reveal style={`--i:${i}`}>
              <p class="frise-quand">{m.quand}</p>
              <h3 class="titre-carte text-white">{m.titre}</h3>
              <p class="text-sur-encre-2 text-pretty">{m.texte}</p>
            </li>
          ))}
        </ol>

        <h3 class="equipe-titre">{methode.equipeTitre}</h3>
        <ul class="equipe">
          {methode.equipe.map((p, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="equipe-photo"><img src={p.photo} alt={p.nom} loading="lazy" decoding="async" width="320" height="400" /></span>
              <b>{p.nom}</b>
              <span class="equipe-role">{p.role}</span>
              <span class="equipe-detail">{p.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 13. La parole des clients (brume) : les verbatims de la page actuelle. -->
    <section class="section-brume py-20 lg:py-28">
      <div class="container-custom">
        <h2 class="titre-moyen mb-12 text-encre lg:mb-14">{paroles.titre}</h2>
        <div class="paroles">
          {paroles.items.map((q) => (
            <figure class="parole">
              <blockquote>{fr ? `« ${q.texte} »` : `“${q.texte}”`}</blockquote>
              <figcaption>
                <img src={q.photo} alt="" width="56" height="56" loading="lazy" decoding="async" />
                <span><b>{q.auteur}</b>{q.fonction}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 14. Les questions (blanc), puis l'appel final (brume). -->
    <AutomotiveFAQ lang={lang} faq={faq} />
    <FinalCTA lang={lang} title={fin.titre} subtitle={fin.texte} />
  </div>
</PageLayout>

<script>
  /* Chaque scène du labo ne joue que lorsqu'elle est à l'écran ; sinon elle reste sur son
     image de repos. Dans un récit collé, la scène de droite suit le chapitre lu.
     (Même mécanique que `EtudeC.astro`.) */
  function envoyer(f: HTMLIFrameElement | null, m: object) { f?.contentWindow?.postMessage(m, '*'); }
  function repos(f: HTMLIFrameElement) { envoyer(f, { cmd: 'pause' }); envoyer(f, { cmd: 'seek', t: Number(f.dataset.repos || 0) }); }
  function jouer(f: HTMLIFrameElement) { envoyer(f, { cmd: 'seek', t: 0 }); envoyer(f, { cmd: 'play' }); }
  function brancher() {
    if (!('IntersectionObserver' in window)) return;
    const libres = Array.from(document.querySelectorAll<HTMLIFrameElement>('.auto-apercu .recit-mobile [data-scene-etude] iframe'));
    const io = new IntersectionObserver((es) => es.forEach((e) => { const f = e.target as HTMLIFrameElement; e.isIntersecting ? jouer(f) : repos(f); }), { threshold: 0.4 });
    libres.forEach((f) => { if (f.dataset.branche) return; f.dataset.branche = '1'; f.addEventListener('load', () => { repos(f); io.observe(f); }); });
    document.querySelectorAll<HTMLElement>('.auto-apercu [data-recit]').forEach((r) => {
      if (r.dataset.branche) return; r.dataset.branche = '1';
      const calques = Array.from(r.querySelectorAll<HTMLElement>('.recit-calque'));
      const cadres = calques.map((c) => c.querySelector('iframe'));
      let actif = 0;
      let visible = false;
      cadres.forEach((f, i) => f?.addEventListener('load', () => { if (i !== actif || !visible) repos(f); }));
      const activer = (i: number) => {
        if (i === actif) return;
        calques[actif].classList.remove('actif'); if (cadres[actif]) repos(cadres[actif]!);
        actif = i; calques[i].classList.add('actif'); if (cadres[i]) jouer(cadres[i]!);
      };
      const ioR = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) activer(Number((e.target as HTMLElement).dataset.chapitre)); }), { rootMargin: '-45% 0px -45% 0px' });
      r.querySelectorAll('[data-chapitre]').forEach((c) => ioR.observe(c));
      /* La scène du premier chapitre joue dès que le récit arrive à l'écran. */
      new IntersectionObserver((es) => es.forEach((e) => {
        visible = e.isIntersecting;
        const f = cadres[actif];
        if (f) (visible ? jouer : repos)(f);
      }), { threshold: 0.2 }).observe(r);
    });
  }
  brancher();
  document.addEventListener('astro:page-load', brancher);
</script>

<style>
  @reference "../../styles/global.css";

  /* Le nom du levier au-dessus d'un chapitre : un repère, pas une rubrique de section. */
  .levier-nom { font-size: 1rem; font-weight: 600; color: var(--color-marque); }
  :global(.section-encre) .levier-nom { color: var(--color-marque-clair); }

  /* Le récit collé (repris de EtudeC) : le texte défile, la scène reste. */
  .recit-colle { display: grid; gap: 40px; margin-top: 32px; }
  .recit-chapitre { display: grid; gap: 14px; align-content: center; padding-block: 32px; }
  .recit-texte { font-size: 1.0625rem; line-height: 1.7; color: var(--color-slate-600); max-width: 58ch; }
  :global(.section-encre) .recit-texte { color: var(--texte-sombre); }
  .recit-titre { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em; font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); line-height: 1.08; text-wrap: balance; }
  .recit-mobile { margin-bottom: 12px; }
  .recit-scene { display: none; }
  @media (min-width: 1024px) {
    .recit-colle { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; align-items: start; margin-top: 8px; }
    .recit-chapitre { min-height: 78vh; padding-block: 8vh; }
    .recit-mobile { display: none; }
    .recit-scene { display: grid; position: sticky; top: 96px; height: calc(100vh - 140px); align-content: center; }
    .recit-pile { position: relative; }
    .recit-calque { position: absolute; inset: 0 0 auto 0; opacity: 0; transition: opacity 0.45s cubic-bezier(0.15, 1, 0.32, 1); pointer-events: none; }
    .recit-calque:first-child { position: relative; }
    .recit-calque.actif { opacity: 1; pointer-events: auto; }
  }

  /* Le chiffre d'un levier : grand, lu dans la fiche, avec sa phrase dessous. */
  .chiffre-levier { display: grid; gap: 6px; margin-top: 10px; padding-top: 18px; border-top: 1px solid var(--filet); max-width: 52ch; }
  :global(.section-encre) .chiffre-levier { border-top-color: rgb(125 184 238 / 0.22); }
  .chiffre-levier b {
    font-family: var(--font-display); font-weight: 800; letter-spacing: -0.04em; line-height: 1;
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem); color: var(--encre); font-variant-numeric: tabular-nums;
  }
  :global(.section-encre) .chiffre-levier b { color: #fff; }
  .chiffre-levier span { font-size: 0.97rem; line-height: 1.5; color: var(--color-slate-500); }
  :global(.section-encre) .chiffre-levier span { color: var(--texte-sombre-2); }

  .liens-levier { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 6px; }
  .liens-levier a { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--color-marque); transition: gap 300ms var(--mdp-entree); }
  .liens-levier a:hover { gap: 12px; }
  :global(.section-encre) .liens-levier a { color: var(--color-marque-clair); }

  /* Les deux chiffres des portes ouvertes, sous la boucle. */
  .chiffres-portes { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1px; margin-top: 48px; background: rgb(125 184 238 / 0.18); border-radius: 22px; overflow: hidden; }
  .chiffres-portes > div { display: grid; gap: 8px; align-content: start; padding: 26px; background: var(--encre-2); }
  .chiffres-portes b { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 1.6rem + 2.2vw, 3.4rem); line-height: 1; letter-spacing: -0.03em; color: #fff; }
  .chiffres-portes span { font-size: 0.97rem; line-height: 1.5; color: var(--texte-sombre-2); }
  @media (min-width: 768px) { .chiffres-portes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Les trois leviers. */
  .levier { transition: box-shadow 300ms var(--mdp-entree); }
  .levier:hover { box-shadow: inset 0 0 0 1px rgb(29 113 184 / 0.35), 0 24px 50px -30px rgb(11 27 43 / 0.45); }
  .levier-grand {
    font-family: var(--font-display); font-weight: 800; line-height: 0.9; letter-spacing: -0.05em; color: #fff; white-space: nowrap;
