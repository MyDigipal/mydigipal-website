---
import { type Language, languages } from '@/i18n/config';

/**
 * `/{lang}/accueil-v2` : l'adresse de l'aperçu de la nouvelle accueil, montrée
 * à Paul du 24 au 25/09/2026 avant la bascule. La page vit désormais à
 * `/{lang}` (`index.astro`) ; celle-ci renvoie vers elle.
 *
 * ⚠️ Une page de renvoi et non une suppression : Render publie de façon
 * incrémentale et continuerait de servir l'ancien aperçu (CLAUDE.md,
 * section 1). Et une page plutôt qu'une 301 pour la raison dite dans
 * `academy-v2.astro` : les redirections de ce site se saisissent dans le
 * dashboard Render. Elle est en `noindex` et n'a jamais été indexée.
 */
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const cible = `/${lang}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>Redirection</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={`https://mydigipal.com${cible}`} />
    <meta http-equiv="refresh" content={`0; url=${cible}`} />
  </head>
  <body>
    <p>
      {lang === 'fr' ? 'Cette page a déménagé : ' : 'This page has moved: '}<a href={cible}>{cible}</a>
    </p>
    <script is:inline define:vars={{ cible }}>
      window.location.replace(cible);
    </script>
  </body>
</html>
