---
/**
 * La page d'accueil, refaite en septembre 2026 et en ligne depuis le
 * 25/09/2026 (« Ouais, tu peux la mettre en ligne », Paul). Elle a d'abord
 * vécu en aperçu caché sur `/{lang}/accueil-v2`, qui n'est plus qu'un renvoi.
 *
 * ⚠️ Elle porte `refonte` : l'en-tête, le pied de page et le bouton collant
 * dans leur nouvelle version (bleu du logo, « EN » / « FR »). Le reste du site
 * garde l'ancienne tant que Paul n'a pas décidé de l'étendre (CLAUDE.md,
 * section 7).
 *
 * Point de départ : la direction A (« Les visages ») du document
 * docs/site-mise-en-avant/refonte-accueil-directions.html, choisie parce que
 * la page d'accueil reçoit surtout ceux qui nous cherchent par notre nom et
 * viennent vérifier à qui ils vont confier leur budget. Donc, dans l'ordre :
 * des gens ; l'AI Academy, ce que MyDigipal veut mettre en avant le plus, et
 * ce qu'en disent ceux qu'on a formés ; ce qu'on fait ; ce que nos clients ont
 * obtenu ; et trois façons de commencer. (Ordre revu avec Paul le 24/09/2026 :
 * les résultats clients descendent, l'Academy monte, les prix sortent.)
 *
 * Aucun chiffre écrit à la main : voir `components/accueil/donnees.ts`.
 * Le mouvement vient du socle commun (global.css et lib/scroll.ts) ; chaque
 * section documente le geste qu'elle emploie et pourquoi.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import Visages from '@/components/accueil/Visages.astro';
import Bandeau from '@/components/accueil/Bandeau.astro';
import Resultats from '@/components/accueil/Resultats.astro';
import Offre from '@/components/accueil/Offre.astro';
import Academie from '@/components/accueil/Academie.astro';
import Avis from '@/components/accueil/Avis.astro';
import Articles from '@/components/accueil/Articles.astro';
import Portes from '@/components/accueil/Portes.astro';
import { lireAcademy, type Lang } from '@/components/accueil/donnees';
import '@/components/accueil/accueil.css';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang: langue } = Astro.params as { lang: Language };
const lang = langue as Lang;
const academy = await lireAcademy(lang);

// Le titre de l'ancienne accueil est gardé mot pour mot : c'est celui que
// Google connaît. La description suit la nouvelle page (plus de prix).
const meta =
  lang === 'fr'
    ? {
        titre: 'Agence Marketing Digital IA B2B et Automobile',
        description: 'Agence marketing digital IA pour le B2B et l’automobile, à Paris et à Londres : SEO, Google Ads, social ads, ABM et AI Academy. Nos résultats clients, en clair.',
      }
    : {
        titre: 'AI Marketing Agency for B2B and Automotive',
        description: 'AI-powered digital marketing agency for B2B and automotive, in London and Paris: SEO, Google Ads, paid social, ABM and the AI Academy. See our client results.',
      };
---

<PageLayout lang={langue} title={meta.titre} description={meta.description} refonte>
  <div class="accueil">
    <Visages lang={lang} />
    <Bandeau lang={lang} />
    <Academie lang={lang} academy={academy} />
    <Avis lang={lang} academy={academy} />
    <Offre lang={lang} academy={academy} />
    <Resultats lang={lang} />
    <Articles lang={lang} />
    <Portes lang={lang} academy={academy} />
  </div>
</PageLayout>
