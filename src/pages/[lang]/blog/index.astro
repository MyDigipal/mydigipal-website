---
/**
 * La première page de l'index du blog. Le contenu est dans `components/blog/IndexBlog.astro`,
 * partagé avec les pages suivantes (`blog/page/[page].astro`, 30/09/2026).
 */
import { type Language, languages } from '@/i18n/config';
import IndexBlog from '@/components/blog/IndexBlog.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
---

<IndexBlog lang={lang} page={1} />
