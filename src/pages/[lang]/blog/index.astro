---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Get blog posts filtered by current language
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.id.startsWith(`${lang}/`) && !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Helper to get the blog URL for current language
const getBlogUrl = (post: typeof posts[0]) => {
  const slug = post.id.replace(/^(en|fr)\//, '');
  return `/${lang}/blog/${slug}`;
};

// Categories and industries for filters
const categories = [
  { id: 'all', label: lang === 'fr' ? 'Tous' : 'All' },
  { id: 'abm', label: 'ABM' },
  { id: 'ai', label: lang === 'fr' ? 'IA' : 'AI' },
  { id: 'paid-ads', label: lang === 'fr' ? 'Publicité' : 'Paid Ads' },
  { id: 'seo', label: 'SEO' },
  { id: 'marketing-ops', label: 'Marketing Ops' },
  { id: 'strategy', label: lang === 'fr' ? 'Stratégie' : 'Strategy' },
  { id: 'company-news', label: lang === 'fr' ? 'Actualités' : 'News' },
];

const industries = [
  { id: 'all', label: lang === 'fr' ? 'Toutes' : 'All' },
  { id: 'automotive', label: lang === 'fr' ? 'Automobile' : 'Automotive' },
  { id: 'b2b-tech', label: 'B2B Tech' },
  { id: 'general', label: lang === 'fr' ? 'Général' : 'General' },
];

const translations = {
  en: {
    title: 'Blog - Digital Marketing, AI and B2B Growth',
    description: 'Expert insights on digital marketing, AI automation and B2B growth strategies. Actionable advice from the MyDigipal team, published every single week.',
    hero: {
      badge: 'Insights & Resources',
      headline: 'Our Blog',
      subheadline: 'Expert insights on digital marketing, AI, and B2B growth strategies',
    },
    search: 'Search articles...',
    filterCategory: 'Filter by Topic',
    filterIndustry: 'Filter by Industry',
    readMore: 'Read more',
    noResults: 'No articles found matching your criteria.',
    featured: 'Featured',
    minRead: 'min read',
  },
  fr: {
    title: 'Blog - Marketing digital, IA et croissance B2B',
    description: 'Analyses sur le marketing digital, l\'automatisation IA et les stratégies de croissance B2B. Des conseils actionnables, publiés par l\'équipe MyDigipal.',
    hero: {
      badge: 'Blog',
      headline: 'Notre blog',
      subheadline: 'Expertise en marketing digital, IA et stratégies de croissance B2B',
    },
    search: 'Rechercher des articles...',
    filterCategory: 'Filtrer par sujet',
    filterIndustry: 'Filtrer par industrie',
    readMore: 'Lire la suite',
    noResults: 'Aucun article trouvé correspondant à vos critères.',
    featured: 'À la une',
    minRead: 'min de lecture',
  },
};

const t = translations[lang] || translations.en;
const fr = lang === 'fr';
const libelleCategorie = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const dateCourte = (d: Date) => d.toLocaleDateString(fr ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const avecImage = (p: typeof posts[0]) => !!p.data.image && !p.data.image.includes('/images/blog/');
// À la une : le dernier article publié, puis les trois suivants en liste.
const [une, ...suivants] = posts;
const ensuite = suivants.slice(0, 3);
---

<PageLayout
  lang={lang}
  title={t.title}
  description={t.description}
>
  <PageHero eyebrow={t.hero.badge} title={t.hero.headline} description={t.hero.subheadline} />

  <!-- À la une (encre) : le dernier article en grand, les trois suivants en liste. Direction
       Encre, groupe 4 (30/09/2026). Le texte des articles n'est pas touché. -->
  {une && (
    <section class="section-encre section-monte py-20 lg:py-28">
      <div class="container-custom grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] lg:gap-8">
        <a href={getBlogUrl(une)} class="carte-verre group grid overflow-hidden" data-reveal>
          {avecImage(une) && (
            <span class="block aspect-[1200/630] overflow-hidden">
              <img src={une.data.image} alt="" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" decoding="async" />
            </span>
          )}
          <span class="grid gap-3 p-6 lg:p-8">
            <span class="text-sm font-semibold text-sur-encre-2">{t.featured} · {libelleCategorie[une.data.category] ?? une.data.category} · <time datetime={une.data.date.toISOString()}>{dateCourte(une.data.date)}</time></span>
            <span class="titre-carte text-white lg:text-[2rem]">{une.data.title}</span>
            <span class="text-sur-encre-2 text-pretty">{une.data.description}</span>
            <span class="mt-2 inline-flex items-center gap-2 font-semibold text-marque-clair transition-all group-hover:gap-3">{t.readMore}<Icon name="arrow-right" size={16} /></span>
          </span>
        </a>
        <ul class="grid content-start gap-4">
          {ensuite.map((p, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <a href={getBlogUrl(p)} class="carte-verre group grid gap-2 p-5 lg:p-6">
                <span class="text-sm font-semibold text-sur-encre-2">{libelleCategorie[p.data.category] ?? p.data.category} · <time datetime={p.data.date.toISOString()}>{dateCourte(p.data.date)}</time></span>
                <span class="font-display text-lg font-bold leading-snug text-white transition-colors group-hover:text-marque-clair">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- La recherche et les filtres, puis tous les articles (blanc). Les identifiants et les
       attributs lus par le script du bas de page sont ceux d'avant. -->
  <section class="section-blanc py-20 lg:py-28">
    <div class="container-custom">
      <div class="mb-10 flex flex-col gap-4 lg:mb-14 lg:flex-row lg:items-center lg:justify-between">
        <div class="relative w-full lg:w-96">
          <Icon name="search" size={20} class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            id="blog-search"
            placeholder={t.search}
            aria-label={t.search}
            class="champ-blog w-full pl-13 pr-5"
          />
        </div>
        <div class="flex flex-wrap gap-3">
          <label class="relative">
            <span class="sr-only">{t.filterCategory}</span>
            <select id="category-filter" class="champ-blog cursor-pointer appearance-none pl-5 pr-11">
              {categories.map((cat) => (
                <option value={cat.id}>{cat.label}</option>
              ))}
            </select>
            <Icon name="chevron-down" size={16} class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" />
          </label>
          <label class="relative">
            <span class="sr-only">{t.filterIndustry}</span>
            <select id="industry-filter" class="champ-blog cursor-pointer appearance-none pl-5 pr-11">
              {industries.map((ind) => (
                <option value={ind.id}>{ind.label}</option>
              ))}
            </select>
            <Icon name="chevron-down" size={16} class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" />
          </label>
        </div>
      </div>

      <div id="no-results" class="hidden py-16 text-center">
        <p class="text-xl text-slate-500">{t.noResults}</p>
      </div>

      <div id="blog-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article
            class="blog-card carte group overflow-hidden"
            data-title={post.data.title.toLowerCase()}
            data-description={post.data.description.toLowerCase()}
            data-category={post.data.category}
            data-industry={post.data.industry}
          >
            <a href={getBlogUrl(post)} class="relative block aspect-[16/10] overflow-hidden" tabindex="-1" aria-hidden="true">
              {avecImage(post) ? (
                <img
                  src={post.data.image}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="absolute inset-0 bg-marque-doux"></span>
              )}
            </a>
            <div class="grid gap-3 p-6">
              <p class="text-sm font-semibold text-slate-500">
                {libelleCategorie[post.data.category] ?? post.data.category} · <time datetime={post.data.date.toISOString()}>{dateCourte(post.data.date)}</time>
              </p>
              <h2 class="font-display text-xl font-bold leading-snug text-encre line-clamp-3 transition-colors group-hover:text-marque">
                <a href={getBlogUrl(post)}>{post.data.title}</a>
              </h2>
              <p class="text-slate-600 line-clamp-3">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA lang={lang} />
</PageLayout>

<script>
  // Search and filter functionality
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const industryFilter = document.getElementById('industry-filter') as HTMLSelectElement;
  const blogGrid = document.getElementById('blog-grid');
  const noResults = document.getElementById('no-results');
  const cards = document.querySelectorAll('.blog-card');

  function filterArticles() {
    const searchTerm = searchInput?.value.toLowerCase() || '';
    const selectedCategory = categoryFilter?.value || 'all';
    const selectedIndustry = industryFilter?.value || 'all';

    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const description = card.getAttribute('data-description') || '';
      const category = card.getAttribute('data-category') || '';
      const industry = card.getAttribute('data-industry') || '';

      const matchesSearch = title.includes(searchTerm) || description.includes(searchTerm);
      const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
      const matchesIndustry = selectedIndustry === 'all' || industry === selectedIndustry;

      if (matchesSearch && matchesCategory && matchesIndustry) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    // Show/hide no results message
    if (noResults && blogGrid) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
        blogGrid.classList.add('hidden');
      } else {
        noResults.classList.add('hidden');
        blogGrid.classList.remove('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', filterArticles);
  categoryFilter?.addEventListener('change', filterArticles);
  industryFilter?.addEventListener('change', filterArticles);
</script>

<style>
  .champ-blog {
    height: 52px;
    border-radius: 999px;
    background: #fff;
    color: var(--encre);
    box-shadow: inset 0 0 0 1px var(--filet);
    outline: none;
    transition: box-shadow 200ms;
  }
  .champ-blog:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-marque);
  }
  .pl-13 {
    padding-left: 3.25rem;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
