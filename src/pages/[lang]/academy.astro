---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import { type Language, languages } from '@/i18n/config';
import AcademyV2 from '@/components/academy-v2/AcademyV2';
import { copyV2 } from '@/components/academy-v2/copy-v2';
import { ENDPOINT, type Jour30Data } from '@/components/academy/data';
import secoursFr from '@/data/academy/jour30-fr.json';
import secoursEn from '@/data/academy/jour30-en.json';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';

/**
 * AI Academy : la page de vente de la formation en ligne.
 *
 * ⚠️ SECONDE FORMULE, en place depuis le 07/09/2026. Elle a d'abord vécu à
 * `/{lang}/academy-v2` le temps d'être jugée, puis a pris l'URL historique :
 * les campagnes Search et Performance Max pointent ici, et changer leurs URL
 * aurait remis leur historique à zéro.
 *
 * La première formule reste en ligne à `/{lang}/academy-v1`, en noindex, le
 * temps de comparer et de pouvoir revenir vite. Elle est à supprimer quand la
 * bascule aura fait ses preuves.
 *
 * Ce qui change : le programme décrit avant le récit (c'est ce que Google ne
 * trouvait pas, avec un post_click_quality_score BELOW_AVERAGE sur les vingt
 * mots-clés notés), le récit en frise dépliable, deux formules et des licences
 * dans les tarifs, un sélecteur de devise, et « pour 30 jours » partout.
 */
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const c = copyV2(lang as 'fr' | 'en');

async function lire(): Promise<Jour30Data> {
  try {
    const r = await fetch(`${ENDPOINT}?lang=${lang}`, { signal: AbortSignal.timeout(10000) });
    if (r.ok) {
      const d = (await r.json()) as Jour30Data;
      if (d?.etats?.length && d.lang === lang) return d;
    }
  } catch {
    /* instantané */
  }
  return (lang === 'fr' ? secoursFr : secoursEn) as unknown as Jour30Data;
}
const data = await lire();
---

<BaseLayout lang={lang} title={c.meta.titre} description={c.meta.description}>
  <main class="flex-grow">
    <AcademyV2 client:load locale={lang as 'fr' | 'en'} initial={data} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
