---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layout/Footer.astro';
import { type Language, languages } from '@/i18n/config';
import Console from '@/components/academy-tools/Console';
import Demo from '@/components/academy-tools/Demo';
import { OUTILS_PUBLIES, autresOutils, lienOutil, outilParSlug } from '@/components/academy-tools';
import { ETAPES, nomsDe } from '@/components/academy-v2/modules';
import {
  ENDPOINT,
  AVIS_REPLI,
  leconsGratuit,
  leconsProgramme,
  noteLocale,
  prixDe,
  type Jour30Data,
} from '@/components/academy/data';
import { formatPrice } from '@/components/academy/offres';
import secoursFr from '@/data/academy/jour30-fr.json';
import secoursEn from '@/data/academy/jour30-en.json';
import leconsOutils from '@/data/academy/lecons-outils.json';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';

/**
 * Les pages outils de l'AI Academy : `/{lang}/academy/{outil}`.
 *
 * Des pages de VENTE de la formation, centrées sur un outil. Elles existent
 * parce que les quatre groupes d'annonces outils pointaient tous sur la page
 * de vente générale, et que Google notait la page BELOW_AVERAGE sur 39
 * mots-clés sur 39, en demandant jusqu'à 8,00 £ la première page sur
 * « formation microsoft copilot ».
 *
 * ⚠️ Le poids compte autant que le texte. La page de vente est un îlot React
 * chargé en `client:load`, soit 237 Ko ; ici tout est statique sauf deux îlots
 * en `client:visible` (la console et la démonstration). La vitesse de
 * chargement entre dans la note que Google donne à la page.
 *
 * ⚠️ Aucun montant n'est écrit dans le code. Les chiffres sont lus au build,
 * avec l'instantané de `src/data/academy/` en secours, PUIS relus dans le
 * navigateur par le script du bas : un prix changé dans l'application se voit
 * sur ces pages sans redéploiement du site (exigence de Paul, 11/09/2026).
 */
export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) =>
    OUTILS_PUBLIES.map((o) => ({ params: { lang, tool: o.slug } })),
  );
}

const { lang, tool } = Astro.params as { lang: Language; tool: string };
const locale = lang as 'fr' | 'en';
const outil = outilParSlug(tool)!;
const c = outil.copy(locale);

async function lire(): Promise<Jour30Data> {
  try {
    const r = await fetch(`${ENDPOINT}?lang=${lang}`, { signal: AbortSignal.timeout(10000) });
    if (r.ok) {
      const d = (await r.json()) as Jour30Data;
      if (d?.faits?.lessons && d.lang === lang) return d;
    }
  } catch {
    /* instantané */
  }
  return (lang === 'fr' ? secoursFr : secoursEn) as unknown as Jour30Data;
}
const data = await lire();

const programme = data.offres.find((o) => o.id === 'programme');
const prixTexte = `${formatPrice(prixDe(programme ?? { ttc_minor: 0 }, 'EUR'), locale)} €`;
const avis = data.avis ?? AVIS_REPLI;
const jours = data.acces_jours ?? 60;

/**
 * Les leçons du module outil.
 *
 * ⚠️ L'API publique ne les sert pas encore : elle donne les totaux, pas le
 * détail des modules. L'instantané de `lecons-outils.json` vient des sources du
 * dépôt de l'application. Dès que l'endpoint servira `modulesOutils`, la page
 * le lira en priorité et l'instantané redeviendra un simple secours, comme
 * pour le reste des chiffres.
 *
 * Aucune durée par leçon n'est affichée : les minutes du dépôt et celles
 * servies en production ne concordent pas encore, et un chiffre douteux ne
 * part pas en ligne.
 */
const catalogue = (leconsOutils as Record<string, { lecons: Array<{ id: string; titre: Record<string, string> }> }>)[
  outil.cleLecons
];
const servi = (data as unknown as { modulesOutils?: Record<string, { lecons: Array<{ id: string; titre: Record<string, string> }> }> })
  .modulesOutils?.[outil.cleLecons];
const lecons = (servi ?? catalogue).lecons.map((l) => l.titre[locale]);

// Les libellés de la console, composés ICI : les propriétés d'un îlot passent
// par une sérialisation JSON, donc une fonction n'y survit pas.
const indices = c.console.ecrans.map((e) => c.console.indice(e.points.length));

const autres = autresOutils(outil.id);
const lienApp = `https://academy.mydigipal.com/checkout?items=programme&lang=${locale}`;
const lienVente = `/${locale}/academy`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      name: c.hero.titre.trim() + ' ' + c.hero.accent,
      description: c.meta.description,
      inLanguage: locale,
      provider: { '@type': 'Organization', name: 'MyDigipal', url: 'https://mydigipal.com' },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'online',
        courseWorkload: data.faits.heuresProgramme ?? data.faits.heures,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: c.faq.items.map((q) => ({
        '@type': 'Question',
        name: q.q,
        acceptedAnswer: { '@type': 'Answer', text: q.r.join(' ') },
      })),
    },
  ],
};
---

<BaseLayout lang={lang} title={c.meta.titre} description={c.meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <main class="j30 flex-grow overflow-x-clip bg-salle text-corps-nuit" data-theme="nuit">
    <!-- La barre. Volontairement statique : la page de vente a sa propre barre
         React avec repères et progression, qui pèse et qui n'a pas de sens sur
         une page courte. -->
    <div class="sticky top-0 z-50 border-b border-filet-nuit bg-salle/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-[1180px] items-center gap-5 px-6">
        <a
          href={lienVente}
          class="whitespace-nowrap font-ac-mono text-xs uppercase tracking-[0.16em] text-ivoire"
        >
          My<b class="text-or">Digipal</b><span class="hidden sm:inline"> / AI Academy</span>
        </a>
        <nav class="ml-auto hidden gap-6 text-sm lg:flex">
          <a href="#outil" class="text-brume-nuit transition-colors hover:text-ivoire">{c.barre.outil}</a>
          <a href="#lecons" class="text-brume-nuit transition-colors hover:text-ivoire">{c.barre.lecons}</a>
          <a href="#programme" class="text-brume-nuit transition-colors hover:text-ivoire">{c.barre.programme}</a>
          <a href="#tarifs" class="text-brume-nuit transition-colors hover:text-ivoire">{c.barre.tarifs}</a>
        </nav>
        <a
          href={lienApp}
          data-app-link
          class="ml-auto inline-flex min-h-10 items-center whitespace-nowrap rounded-bouton bg-or px-4 text-sm font-semibold text-[#15203a] transition-colors hover:bg-or-vif lg:ml-0"
        >
          <span class="lg:hidden">{c.barre.cta}</span>
          <span class="hidden lg:inline">{c.tarifs.cta}</span>
        </a>
      </div>
    </div>

    <!-- ------------------------------------------------------------ hero -->
    <section class="mx-auto max-w-[1180px] px-6 pb-12 pt-10 md:pt-16">
      <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-14">
        <div>
          <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.hero.kicker}</p>
          <h1 class="mb-4 text-[clamp(30px,4.4vw,52px)] font-semibold leading-[1.08] tracking-[-0.025em] text-ivoire">
            {c.hero.titre}<em class="font-ac-serif font-normal italic leading-[1.1] tracking-normal text-or-vif"
              >{c.hero.accent}</em
            >
          </h1>
          <p class="max-w-[54ch] text-[clamp(17px,1.5vw,19px)] text-corps-nuit">{c.hero.sous}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={lienApp}
              data-app-link
              class="inline-flex min-h-11 items-center justify-center rounded-bouton bg-or px-5 font-semibold text-[#15203a] transition-colors hover:bg-or-vif"
            >
              <span data-fait="prix" data-gabarit={c.hero.cta('{}')}>{c.hero.cta(prixTexte)}</span>
            </a>
            <a
              href={`${lienVente}#tarifs`}
              class="inline-flex min-h-11 items-center justify-center rounded-bouton border border-filet-nuit px-5 font-semibold text-ivoire transition-colors hover:border-or hover:text-or-vif"
            >
              <span data-fait="gratuit" data-gabarit={c.hero.cta2('{}')}
                >{c.hero.cta2(leconsGratuit(data))}</span
              >
            </a>
          </div>
          <div class="mt-7 flex flex-wrap gap-7 border-t border-filet-nuit pt-5">
            <div>
              <span class="block font-ac-mono text-[19px] leading-tight text-ivoire" data-fait="note"
                >{noteLocale(avis.note, locale)} / 10</span
              >
              <span class="text-[12.5px] text-brume-nuit" data-fait="retours" data-gabarit={c.hero.note('{}')}
                >{c.hero.note(avis.nombre)}</span
              >
            </div>
            <div>
              <span class="block font-ac-mono text-[19px] leading-tight text-ivoire" data-fait="lecons"
                >{leconsProgramme(data)}</span
              >
              <span class="text-[12.5px] text-brume-nuit">{c.hero.lecons(lecons.length)}</span>
            </div>
            <div>
              <span class="block font-ac-mono text-[19px] leading-tight text-ivoire" data-fait="heures"
                >{data.faits.heuresProgramme ?? data.faits.heures}</span
              >
              <span class="text-[12.5px] text-brume-nuit">{c.hero.heures}</span>
            </div>
          </div>
        </div>

        <figure class="m-0 overflow-hidden rounded-2xl border border-filet-nuit bg-[#0a0f1c] shadow-[0_30px_80px_rgba(0,0,0,0.45)]">
          <figcaption
            class="flex items-center gap-2 border-b border-filet-nuit bg-[#111a2e] px-3.5 py-2.5 font-ac-mono text-[11px] text-brume-nuit"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-[#2b3550]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#2b3550]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#2b3550]"></span>
            <span class="ml-2">{c.hero.capture}</span>
          </figcaption>
          <img
            src={c.console.ecrans[0].image}
            alt={c.console.ecrans[0].alt}
            width={1160}
            height={880}
            loading="eager"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
      </div>
    </section>

    <!-- --------------------------------------------------------- console -->
    <section id="outil" class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
      <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.console.kicker}</p>
      <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
        {c.console.titre}
      </h2>
      <p class="mb-7 max-w-[72ch]">{c.console.chapeau}</p>
      <Console client:visible ecrans={c.console.ecrans} indices={indices} />
    </section>

    <!-- ------------------------------------------------------- livrables -->
    {
      c.livrables && (
        <section class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
          <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">
            {c.livrables.kicker}
          </p>
          <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
            {c.livrables.titre}
          </h2>
          <p class="mb-7 max-w-[72ch]">{c.livrables.chapeau}</p>

          {/* Cinq documents, cinq cases : le premier prend deux colonnes, sinon
              la grille laisserait un trou en bas à droite. */}
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {c.livrables.items.map((l, i) => (
              <a
                href={`/academy/livrables/${l.fichier}.html`}
                target="_blank"
                rel="noopener"
                class:list={[
                  'group flex flex-col overflow-hidden rounded-carte border border-filet-nuit bg-salle-2 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-or',
                  i === 0 ? 'lg:col-span-2' : '',
                ]}
              >
                <img
                  src={`/academy/livrables/vignettes/${l.fichier}.jpg`}
                  alt={l.titre}
                  width={960}
                  height={620}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full border-b border-filet-nuit"
                />
                <div class="flex flex-1 flex-col px-5 py-4">
                  <h3 class="mb-1.5 text-[17px] font-semibold text-ivoire">{l.titre}</h3>
                  <p class="mb-3 text-[14.5px] text-corps-nuit">{l.texte}</p>
                  <p class="mt-auto mb-0 font-ac-mono text-[11.5px] text-brume-nuit">{l.cout}</p>
                  <span class="mt-2 font-ac-mono text-[12.5px] text-or-texte transition-colors group-hover:text-or-vif">
                    {c.livrables!.ouvrir} -&gt;
                  </span>
                </div>
              </a>
            ))}
          </div>

          <h3 class="mb-2 mt-12 text-xl font-semibold text-ivoire">{c.livrables.filmsTitre}</h3>
          <p class="mb-5 max-w-[72ch]">{c.livrables.filmsChapeau}</p>
          <div class="grid gap-4 md:grid-cols-2">
            {c.livrables.films.map((f) => (
              <figure class="m-0 overflow-hidden rounded-carte border border-filet-nuit bg-salle-2">
                {/* preload="none" : deux films d'un mégaoctet ne se téléchargent
                    pas tant que personne ne les lance. */}
                <video
                  controls
                  preload="none"
                  playsinline
                  poster={`/academy/livrables/vignettes/${f.fichier}.jpg`}
                  class="block h-auto w-full"
                >
                  <source src={`/academy/livrables/${f.fichier}.mp4`} type="video/mp4" />
                </video>
                <figcaption class="px-5 py-4">
                  <h4 class="mb-1 text-base font-semibold text-ivoire">
                    {f.titre}
                    <span class="ml-2 font-ac-mono text-[11.5px] font-normal text-brume-nuit">{f.duree}</span>
                  </h4>
                  <p class="m-0 text-[14.5px] text-corps-nuit">{f.texte}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- ------------------------------------------------------- resultats -->
    {
      !c.livrables && (
      <section class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
        <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.resultats.kicker}</p>
        <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
          {c.resultats.titre}
        </h2>
        <p class="mb-7 max-w-[72ch]">{c.resultats.chapeau}</p>
        <div class="grid gap-px overflow-hidden rounded-carte border border-filet-nuit bg-filet-nuit sm:grid-cols-2 lg:grid-cols-3">
          {
            c.resultats.items.map((r, i) => (
              <article class="bg-salle px-6 py-5">
                <span class="font-ac-mono text-[11px] tracking-[0.14em] text-or-texte">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mb-1.5 mt-2 text-[16.5px] font-semibold text-ivoire">{r.titre}</h3>
                <p class="m-0 text-[14.5px] text-brume-nuit">{r.texte}</p>
              </article>
            ))
          }
        </div>
      </section>
        </section>
      )
    }

    <!-- ------------------------------------------------------------ demo -->
    <section class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
      <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.demo.kicker}</p>
      <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
        {c.demo.titre}
      </h2>
      <p class="mb-7 max-w-[72ch]">{c.demo.chapeau}</p>
      <Demo client:visible copy={c.demo} />
    </section>

    <!-- ---------------------------------------------------------- lecons -->
    <section id="lecons" class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
      <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.lecons.kicker}</p>
      <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
        {c.lecons.titre(lecons.length)}
      </h2>
      <p class="mb-7 max-w-[72ch]">{c.lecons.chapeau}</p>
      <ol class="m-0 list-none overflow-hidden rounded-carte border border-filet-nuit p-0">
        {
          lecons.map((titre, i) => (
            <li class="flex items-baseline gap-4 border-b border-filet-nuit px-5 py-3.5 last:border-b-0">
              <span class="font-ac-mono text-xs text-or-texte">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[15.5px] text-ivoire">{titre}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ------------------------------------------------- feuille claire -->
    <section class="bg-[#efeae0] py-14 text-encre md:py-20">
      <div class="mx-auto max-w-[1180px] px-6">
        <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or-texte">
          {c.franchise.kicker}
        </p>
        <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-encre">
          {c.franchise.titre}
        </h2>
        <p class="mb-7 max-w-[72ch] text-[#3c4657]">{c.franchise.chapeau}</p>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-carte border border-[#ddd5c6] bg-[#f7f4ed] px-6 py-5">
            <h3 class="mb-2 text-lg font-semibold text-encre">{c.franchise.forcesTitre}</h3>
            <ul class="m-0 list-none p-0">
              {
                c.franchise.forces.map((f) => (
                  <li class="relative border-b border-[#e5ded0] py-2.5 pl-6 text-[15px] text-[#3c4657] last:border-b-0">
                    <span class="absolute left-0.5 top-[17px] block h-0.5 w-2.5 bg-or-texte" />
                    {f}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-carte border border-[#ddd5c6] bg-[#f7f4ed] px-6 py-5">
            <h3 class="mb-2 text-lg font-semibold text-encre">{c.franchise.limitesTitre}</h3>
            <ul class="m-0 list-none p-0">
              {
                c.franchise.limites.map((f) => (
                  <li class="relative border-b border-[#e5ded0] py-2.5 pl-6 text-[15px] text-[#3c4657] last:border-b-0">
                    <span class="absolute left-0.5 top-[17px] block h-0.5 w-2.5 bg-[#b0705a]" />
                    {f}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <h3 class="mb-2 mt-10 text-lg font-semibold text-encre">{c.franchise.autresTitre}</h3>
        <p class="mb-5 max-w-[72ch] text-[#3c4657]">{c.franchise.autresTexte}</p>
        <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {
            autres.map((a) => (
              <a
                href={lienOutil(a, locale)}
                class="block rounded-xl border border-[#ddd5c6] bg-[#f7f4ed] px-5 py-4 no-underline transition-all hover:-translate-y-0.5 hover:border-or-texte"
              >
                <b class="mb-1 block text-base text-encre">{a.nom}</b>
                <span class="block text-[13.5px] text-[#5c6675]">{a.renvoi[locale]}</span>
                <span class="mt-2 block font-ac-mono text-[13px] text-or-texte">
                  {c.franchise.versOutil(a.nom)} -&gt;
                </span>
              </a>
            ))
          }
          {
            autres.length === 0 && (
              <a
                href={`${lienVente}#programme`}
                class="block rounded-xl border border-[#ddd5c6] bg-[#f7f4ed] px-5 py-4 no-underline transition-all hover:-translate-y-0.5 hover:border-or-texte"
              >
                <b class="mb-1 block text-base text-encre">Microsoft Copilot, ChatGPT, Google Gemini</b>
                <span class="block text-[13.5px] text-[#5c6675]">{c.franchise.autresTexte}</span>
                <span class="mt-2 block font-ac-mono text-[13px] text-or-texte">
                  {c.franchise.versProgramme} -&gt;
                </span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- programme -->
    <section id="programme" class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
      <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.programme.kicker}</p>
      <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
        {c.programme.titre}
      </h2>
      <p class="mb-7 max-w-[72ch]">{c.programme.chapeau}</p>
      <div class="grid gap-4 lg:grid-cols-3">
        {
          ETAPES.map((e) => (
            <article class="rounded-carte border border-filet-nuit bg-salle-2 px-6 py-5">
              <span class="font-ac-mono text-[11px] uppercase tracking-[0.16em] text-or-texte">
                {e.titre[locale]}
              </span>
              <p class="mb-3 mt-2.5 text-[14.5px] text-brume-nuit">{e.chapeau[locale]}</p>
              <ul class="m-0 list-none p-0">
                {nomsDe(e.id, locale, c.programme.auChoix).map((nom) => {
                  const ici = nom.includes(outil.nom);
                  return (
                    <li
                      class:list={[
                        'border-b border-filet-nuit/60 py-1.5 text-sm last:border-b-0',
                        ici ? 'text-or-vif' : 'text-corps-nuit',
                      ]}
                    >
                      {nom}
                      {ici && (
                        <span class="ml-2 font-ac-mono text-[11.5px] text-or-texte">{c.programme.ici}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ---------------------------------------------------------- tarifs -->
    <section id="tarifs" class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
      <div
        class="grid items-center gap-7 rounded-[18px] border border-filet-nuit bg-linear-to-b from-salle-2 to-salle px-7 py-9 lg:grid-cols-[minmax(0,1fr)_320px] lg:px-10"
      >
        <div>
          <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.tarifs.kicker}</p>
          <h2 class="mb-3 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
            {c.tarifs.titre}
          </h2>
          <p class="max-w-[62ch]">{c.tarifs.texte}</p>
          <p class="m-0 max-w-[62ch] text-[14.5px] text-brume-nuit">{c.tarifs.apres}</p>
        </div>
        <div class="rounded-carte border border-or/40 bg-or/5 px-6 py-5">
          <p class="m-0 mb-1 font-ac-mono text-[11px] uppercase tracking-[0.14em] text-or-vif">
            {c.tarifs.formule}
          </p>
          <p class="m-0 font-ac-mono text-[38px] leading-none text-ivoire" data-fait="prix">{prixTexte}</p>
          <ul class="my-4 list-none p-0">
            {
              c.tarifs
                .lignes({
                  lecons: leconsProgramme(data),
                  heures: data.faits.heuresProgramme ?? data.faits.heures,
                  lecture: lecons.length,
                  exercices: data.faits.exercices,
                  jours,
                })
                .map((l) => <li class="py-1 text-sm text-corps-nuit">{l}</li>)
            }
          </ul>
          <a
            href={lienApp}
            data-app-link
            class="flex min-h-11 w-full items-center justify-center rounded-bouton bg-or px-5 font-semibold text-[#15203a] transition-colors hover:bg-or-vif"
          >
            {c.tarifs.cta}
          </a>
          <p class="m-0 mt-3 text-center font-ac-mono text-[11px] text-or-texte">{c.tarifs.synchro}</p>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- faq -->
    <section class="mx-auto max-w-[1180px] px-6 py-14 md:py-20">
      <p class="mb-3.5 font-ac-mono text-[11px] uppercase tracking-[0.2em] text-or">{c.faq.kicker}</p>
      <h2 class="mb-6 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.02em] text-ivoire">
        {c.faq.titre}
      </h2>
      <div class="border-t border-filet-nuit">
        {
          c.faq.items.map((q) => (
            <details class="group border-b border-filet-nuit">
              <summary
                class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-4 text-[16.5px] font-medium text-ivoire [&::-webkit-details-marker]:hidden"
              >
                {q.q}
                <span class="font-ac-mono text-lg text-or group-open:hidden">+</span>
                <span class="hidden font-ac-mono text-lg text-or group-open:inline">-</span>
              </summary>
              <div class="max-w-[74ch] pb-4.5">
                {q.r.map((p) => (
                  <p class="m-0 mb-2.5 text-[15px] text-corps-nuit last:mb-0">{p}</p>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  /**
   * Les chiffres se relisent dans le navigateur.
   *
   * Le site est statique : une page construite hier porterait les chiffres
   * d'hier. La page de vente contourne ça en rappelant l'application après
   * l'affichage, et ces pages font pareil. Un prix modifié dans l'Academy
   * apparaît donc ici au chargement suivant, sans redéploiement (exigence de
   * Paul, 11/09/2026 : « si je modifie le prix sur la page de vente, je veux
   * que ça se modifie aussi automatiquement sur les pages de produits »).
   *
   * Chaque valeur porte `data-fait`, et son gabarit `data-gabarit` où `{}`
   * reçoit la valeur. Sans cela il faudrait dupliquer les phrases ici, et
   * elles dériveraient de celles du fichier de copie.
   */
  import { ENDPOINT, AVIS_REPLI, leconsGratuit, leconsProgramme, noteLocale, prixDe, type Jour30Data } from '@/components/academy/data';
  import { formatPrice } from '@/components/academy/offres';
  import { captureAdClickIds, withAdClickIds } from '@/components/academy/track';

  captureAdClickIds();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-app-link]')) {
    a.href = withAdClickIds(a.href);
  }

  const locale = document.documentElement.lang === 'fr' ? 'fr' : 'en';

  fetch(`${ENDPOINT}?lang=${locale}`)
    .then((r) => (r.ok ? r.json() : null))
    .then((d: Jour30Data | null) => {
      if (!d || d.lang !== locale || !d.faits?.lessons) return;
      const programme = d.offres.find((o) => o.id === 'programme');
      const avis = d.avis ?? AVIS_REPLI;
      const valeurs: Record<string, string> = {
        prix: programme ? `${formatPrice(prixDe(programme, 'EUR'), locale)} €` : '',
        gratuit: String(leconsGratuit(d)),
        lecons: String(leconsProgramme(d)),
        heures: d.faits.heuresProgramme ?? d.faits.heures,
        note: `${noteLocale(avis.note, locale)} / 10`,
        retours: String(avis.nombre),
      };
      for (const el of document.querySelectorAll<HTMLElement>('[data-fait]')) {
        const v = valeurs[el.dataset.fait || ''];
        if (!v) continue;
        const gabarit = el.dataset.gabarit;
        el.textContent = gabarit ? gabarit.replace('{}', v) : v;
      }
    })
    .catch(() => {
      /* les chiffres du build restent affichés */
    });
</script>
