---
/**
 * Le calculateur de devis, v6 (en ligne depuis le 22/09/2026).
 *
 * Parcours B sur téléphone (une question à la fois), guide D1 sur ordinateur (le panneau à
 * droite), page de résultat pleine largeur avec l'audit et le rendez-vous. « Aidez-moi à
 * choisir » ouvre l'assistant du site. L'ancienne version vit en noindex sur `/{lang}/calculator-v5`.
 *
 * Les emplacements des vidéos facecam restent cachés tant qu'aucune vidéo n'est branchée dans
 * `components/calculator-v6/videos.ts`.
 *
 * Pilotage : docs/calculator/refonte-2026-09/calculateur-en-etapes.html
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { type Language, languages } from '@/i18n/config';
import CalculatorV6 from '@/components/calculator-v6/CalculatorV6';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };

const copy = {
  fr: {
    // Mêmes titre et description que l'ancienne page : l'adresse est indexée, on garde ce qui marche.
    title: 'Calculateur de budget marketing gratuit',
    description: 'Composez votre offre marketing sur-mesure avec notre calculateur interactif. Estimation instantanée SEO, Google Ads, Paid Social et plus. Gratuit.',
    headline: 'Calculez votre budget marketing',
    sub: 'Quelques questions, un prix tout de suite, sans engagement.',
    faqTitle: 'Questions fréquentes',
    faq: [
      ['Comment fonctionne le calculateur ?', 'Choisissez vos services, répondez à quelques questions pour chacun, et le prix se calcule au fil de vos réponses. Vous recevez ensuite le devis par e-mail, avec un audit adapté si vous nous donnez votre site.'],
      ['Les prix sont-ils définitifs ?', 'Les prix affichés sont des estimations basées sur nos tarifs standards. Le devis final peut varier selon la complexité de votre projet et vos besoins spécifiques.'],
      ['Puis-je modifier ma sélection après avoir envoyé le devis ?', 'Oui. Le devis est sans engagement : le lien du mail rouvre votre devis dans le calculateur, et nous ajustons la proposition avec vous lors d’un appel.'],
      ['Quelle est la durée d’engagement minimum ?', 'La durée minimum est de 4 mois pour les services récurrents. Des remises sont proposées pour des engagements de 6 mois (-5 %) ou 12 mois (-10 %).']
    ]
  },
  en: {
    title: 'Marketing Budget Calculator - Free Estimate',
    description: 'Build your custom marketing package with our interactive calculator. Get an instant estimate for SEO, Google Ads, Paid Social and more. Free, no signup.',
    headline: 'Price your marketing plan',
    sub: 'A few questions, an instant price, no commitment.',
    faqTitle: 'Frequently asked questions',
    faq: [
      ['How does the calculator work?', 'Pick your services, answer a few questions for each, and the price updates as you go. You then receive the quote by email, with a tailored audit if you share your website.'],
      ['Are the prices final?', 'The displayed prices are estimates based on our standard rates. The final quote may vary depending on the complexity of your project and your specific needs.'],
      ['Can I change my selection after sending the quote?', 'Yes. The quote is non-binding: the link in the email reopens your quote in the calculator, and we adjust the proposal with you on a call.'],
      ['What is the minimum commitment period?', 'The minimum duration is 4 months for recurring services. Discounts are offered for 6-month (-5%) or 12-month (-10%) commitments.']
    ]
  }
}[lang === 'fr' ? 'fr' : 'en'];
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <Header lang={lang} />
  <main class="bg-slate-50 pb-16 pt-6 lg:pt-8" data-assistant-lift>
    <div class="container-custom max-w-6xl">
      <div class="mb-5">
        <h1 class="font-display text-xl font-bold tracking-tight text-slate-900 sm:text-2xl md:text-3xl">{copy.headline}</h1>
        <p class="mt-1 text-sm text-slate-600 sm:text-base md:text-lg">{copy.sub}</p>
      </div>
      <CalculatorV6 client:load lang={lang === 'fr' ? 'fr' : 'en'} />
    </div>

    <section class="container-custom mt-16 max-w-3xl" aria-labelledby="faq-calculateur">
      <h2 id="faq-calculateur" class="font-display text-2xl font-bold tracking-tight text-slate-900">{copy.faqTitle}</h2>
      <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
        {copy.faq.map(([q, a]) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
              <h3 class="text-base">{q}</h3>
              <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </summary>
            <p class="mt-3 text-[15px] leading-relaxed text-slate-600">{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
