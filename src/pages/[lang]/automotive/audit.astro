  .sc-bouton {
    justify-self: start;
    margin-top: 4px;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--color-marque);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Scène 2 : les canaux étudiés, cochés l'un après l'autre. */
  .sc-canaux {
