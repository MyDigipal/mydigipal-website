    transition: gap 300ms var(--mdp-entree);
  }
  .audit-lien:hover {
    gap: 12px;
  }
</style>

<script>
  // Joue la frise une fois, quand elle entre à l'écran. Sans IntersectionObserver, elle se
  // pose directement à l'état final.
  function frise() {
    const el = document.querySelector<HTMLElement>('[data-etapes]');
    if (!el || el.dataset.pret) return;
    el.dataset.pret = '1';
    const jouer = () => el.classList.add('joue');
    if (!('IntersectionObserver' in window)) return jouer();
    const io = new IntersectionObserver(
      (entrees) => {
        if (entrees.some((e) => e.isIntersecting)) {
          jouer();
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(el);
  }
  frise();
  document.addEventListener('astro:page-load', frise);
</script>
