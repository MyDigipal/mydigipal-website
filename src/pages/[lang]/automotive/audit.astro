  }

  /* Le mouvement : seulement sous html.mv (JavaScript actif et mouvement accepté, posé par
     BaseLayout). Sans lui, tout est à l'état final. Le script pose `joue` à l'approche. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.mv) .etapes:not(.joue) .etape {
      opacity: 0;
      transform: translateY(18px);
    }
    :global(html.mv) .etapes:not(.joue)::after {
      transform: scaleX(0);
    }
    :global(html.mv) .etapes:not(.joue) .sc-tape {
      max-width: 0;
    }
    :global(html.mv) .etapes:not(.joue) .sc-bouton,
    :global(html.mv) .etapes:not(.joue) .sc-coche,
    :global(html.mv) .etapes:not(.joue) .sc-recos li {
      opacity: 0;
    }
    :global(html.mv) .etapes:not(.joue) .sc-recos li {
      transform: translateY(10px);
    }

    .etapes.joue::after {
      transition: transform 2400ms var(--mdp-entree);
    }
    .etapes.joue .etape {
      transition:
        opacity 500ms linear calc(var(--e) * 900ms),
        transform 700ms var(--mdp-entree) calc(var(--e) * 900ms);
    }
    .etapes.joue .sc-tape {
      max-width: 100%;
      transition: max-width 900ms steps(18, end) 450ms;
    }
    .etapes.joue .sc-champ-2 .sc-tape {
      transition-delay: 1100ms;
    }
    .etapes.joue .sc-bouton {
      transition: opacity 300ms ease 1900ms;
    }
    .etapes.joue .sc-coche {
      transition: opacity 250ms ease calc(1300ms + var(--c) * 280ms);
    }
    .etapes.joue .sc-recos li {
      transition:
        opacity 350ms ease calc(2300ms + var(--r) * 350ms),
        transform 500ms var(--mdp-entree) calc(2300ms + var(--r) * 350ms);
    }
  }

  .audit-panneau {
