    gap: 8px;
  }
  .sc-canaux li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.9375rem;
    color: var(--texte-sombre);
