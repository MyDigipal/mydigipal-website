    font-size: 1rem;
    line-height: 1.55;
    color: var(--texte-sombre-2);
    max-width: 38ch;
  }

  /* Scène 1 : deux champs qui se remplissent, puis le bouton. */
  .sc-champ {
    display: grid;
    gap: 6px;
  }
  .sc-label {
    font-size: 0.8125rem;
