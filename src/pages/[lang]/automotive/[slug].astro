---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import { getCollection } from 'astro:content';

// Sections
import HeroService from '@/components/sections/HeroService.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import RubanCalculateur from '@/components/sections/RubanCalculateur.astro';
import CaseStudyCarousel from '@/components/sections/CaseStudyCarousel.astro';
import CarteVerre from '@/components/motion/CarteVerre.astro';
import BoucleRemarketing from '@/components/motion/BoucleRemarketing.astro';
import { carteCompte, railFormulaire } from '@/components/motion/donnees-automobile';
import { mesurerLogos } from '@/lib/logos-mesures';

// Automotive specific sections
import AutomotiveBenchmarks from '@/components/sections/automotive/AutomotiveBenchmarks.astro';
import AutomotiveTeam from '@/components/sections/automotive/AutomotiveTeam.astro';
import AutomotiveFAQ from '@/components/sections/automotive/AutomotiveFAQ.astro';
import AutomotiveWhySection from '@/components/sections/automotive/AutomotiveWhySection.astro';
import CampagnesSearch from '@/components/sections/automotive/CampagnesSearch.astro';
import AnnoncesMaquettes from '@/components/sections/automotive/AnnoncesMaquettes.astro';
import AutomotiveRail from '@/components/sections/automotive/AutomotiveRail.astro';

// Dynamic Ads specific sections (visual components)
import DynamicAdsFlow from '@/components/sections/automotive/DynamicAdsFlow.astro';
import DynamicAdsChannels from '@/components/sections/automotive/DynamicAdsChannels.astro';
import DynamicAdsROI from '@/components/sections/automotive/DynamicAdsROI.astro';
import VehicleAdsResultats from '@/components/sections/automotive/VehicleAdsResultats.astro';

export async function getStaticPaths() {
  const paths = [];

  for (const lang of Object.keys(languages)) {
    try {
      const pages = await getCollection('automotive', ({ id }) => {
        return id.startsWith(`${lang}/`);
      });

      for (const page of pages) {
        const slug = page.id.replace(`${lang}/`, '').replace('.mdx', '');
        paths.push({
          params: { lang, slug },
          props: { page },
        });
      }
    } catch (e) {
      // Collection might be empty
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: Language; slug: string };
const { page } = Astro.props;

const {
  title,
  description,
  color = 'automotive',
  hero,
  metrics,
  benchmarks,
  team,
  clients,
  faq,
  calculatorServiceId,
  seo,
  whySection,
  isDynamicAds,
} = page.data;

const fr = lang === 'fr';
const isGoogleAds = slug === 'google-ads';
const isPaidSocial = slug === 'paid-social';

// Le tableau à palettes du hero : trois chiffres de la fiche (chiffres de l'agence, gardés,
// à sourcer), sans les impressions ni le « 3 plateformes ». « 150K€ » devient le chiffre
// « 150 » et l'unité « K€ » ; « 3125 » s'écrit « 3 125 » en français.
const tableauHero = (metrics ?? [])
  .filter((m: { label: string }) => !/impression|plateforme|platform/i.test(m.label))
  .slice(0, 3)
  .map((m: { value: string; label: string }) => {
    // En anglais, la fiche écrit « €150K » : le symbole monte sur les volets, « K » reste l'unité.
    const [, chiffre = m.value, unite = ''] = m.value.match(/^([€$£]?[+\-−]?[\d.,]+)\s*(.*)$/) ?? [];
    const local = fr ? chiffre.replace('.', ',').replace(/^(\d{1,3})(\d{3})$/, '$1\u202f$2') : chiffre;
    const texte = fr ? m.label.charAt(0).toLowerCase() + m.label.slice(1) : m.label;
    return { chiffre: local, unite, texte };
  });

// Les logos de la page, EN COULEUR (Paul, 30/09/2026), dans la bande du hero : la version
// détourée de l'accueil quand elle existe, le fichier de la fiche sinon. La seconde bande
// qui les faisait défiler en gris plus bas (AutomotiveClients) n'est plus rendue.
// Iroise : le fichier de la fiche porte un cadre et beaucoup de blanc, celui des logos
// clients non. Tous à surface égale (`mesurerLogos`).
const heroLogos = await mesurerLogos(
  clients ?? [],
  { Theobald: 'theobald', Ford: 'ford', 'Motor K': 'motork', Vulcain: 'vulcain', DMD: 'dmd', BYmyCAR: 'bymycar' },
  { 'Iroise Automobiles': '/images/Client logo/Iroise Auto.png' },
);

// Les résultats des études de cas automobiles, lus dans la collection, un indicateur choisi
// par page ; le verbatim d'une des trois.
const PREUVES: Record<string, { ids: { id: string; kpi: number; second: number }[]; verbatim: string }> = {
  'google-ads': {
    ids: [
      { id: 'theobald-group', kpi: 0, second: 2 },
      { id: 'vulcain-group', kpi: 0, second: 1 },
      { id: 'dmd-group', kpi: 2, second: 0 },
    ],
    verbatim: 'theobald-group',
  },
  'paid-social': {
    ids: [
      { id: 'theobald-group', kpi: 1, second: 2 },
      { id: 'vulcain-group', kpi: 1, second: 0 },
      { id: 'dmd-group', kpi: 1, second: 0 },
    ],
    verbatim: 'vulcain-group',
  },
  'dynamic-ads': {
    ids: [
      { id: 'dmd-group', kpi: 4, second: 0 },
      { id: 'theobald-group', kpi: 2, second: 1 },
      { id: 'vulcain-group', kpi: 1, second: 0 },
    ],
    verbatim: 'dmd-group',
  },
};
const preuves = PREUVES[slug];

const rail = railFormulaire(lang);
const titresLogos = { fr: 'Ils nous confient leurs campagnes', en: 'They trust us with their campaigns' };
---

<PageLayout
  lang={lang}
  title={seo?.title || title}
  description={seo?.description || description}
>
  <!-- Direction Encre, modèle AI Training (groupe 3, 30/09/2026). L'encre ponctue sans
       jamais deux sections sombres collées ; commentaires : le fond de chaque section. -->
  <HeroService
    lang={lang}
    badge={hero?.badge}
    headline={hero?.headline || title}
    subheadline={hero?.subheadline}
    description={description}
    color={color}
    tableau={tableauHero}
    heroLogos={heroLogos}
    titreLogos={titresLogos[lang]}
    serviceCalculateur={calculatorServiceId}
    audit={`hero-automotive-${slug}`}
  />

  <!-- Dynamic Ads (refonte du 01/10/2026, « trop d'informations, ça se mélange ») : cinq temps.
       Comment ça marche (encre, la chaîne du stock), à quoi ça ressemble (brume, trois vitrines
       avec leur annonce), pourquoi ça ramène des acheteurs (encre, le remarketing en quatre
       temps), ce que ça donne (brume, le graphique puis l'avant et l'après). Le « pourquoi »,
       les six étapes, les cas d'usage et les trois résultats de la fiche ne sont plus rendus
       sur cette page : les scènes disent la même chose une seule fois. -->
  {isDynamicAds && <DynamicAdsFlow lang={lang} />}
  {isDynamicAds && <DynamicAdsChannels lang={lang} />}
  {isDynamicAds && (
    <section class="section-encre section-monte py-20 lg:py-32">
      <div class="container-custom">
        <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
          <h2 class="titre-moyen">{fr ? 'Il a regardé une voiture, elle le retrouve' : 'They looked at a car, the car finds them again'}</h2>
          <p class="chapo">
            {fr
              ? 'La plupart des visiteurs repartent sans appeler. Les Dynamic Ads leur remontrent la voiture qu’ils ont vue, jusqu’à la demande d’essai.'
              : 'Most visitors leave without calling. Dynamic Ads show them the car they viewed again, until they ask for a test drive.'}
          </p>
        </header>
        <BoucleRemarketing lang={lang} />
      </div>
    </section>
  )}
  {isDynamicAds && (
    <VehicleAdsResultats lang={lang} fond="brume">
      <DynamicAdsROI lang={lang} />
    </VehicleAdsResultats>
  )}

  <!-- Le pourquoi (encre) : la carte du compte sur Google Ads, les chiffres sur Paid Social,
       les deux annonces sur téléphone sur Dynamic Ads. -->
  {whySection && isGoogleAds && (
    <AutomotiveWhySection lang={lang} data={whySection} titreId="compte-titre">
      <CarteVerre lang={lang} titreId="compte-titre" {...carteCompte(lang)} />
    </AutomotiveWhySection>
  )}
  {whySection && isPaidSocial && (
    <AutomotiveWhySection lang={lang} data={whySection} marques={['Facebook', 'Instagram', 'TikTok', 'LinkedIn']} />
  )}
  <!-- Google Ads (refonte du 01/10/2026, mêmes principes que Dynamic Ads) : une campagne par
       situation, avec ses mots-clés et son annonce (blanc), puis les trois formats qui complètent
       le Search, chacun avec sa maquette (brume). -->
  {isGoogleAds && <CampagnesSearch lang={lang} />}
  {isGoogleAds && <AnnoncesMaquettes lang={lang} variante="google" />}

  <!-- Paid Social : trois annonces et leur maquette (brume), puis du formulaire Meta au CRM,
       sur le rail (blanc). -->
  {isPaidSocial && <AnnoncesMaquettes lang={lang} variante="social" />}
  {isPaidSocial && (
    <AutomotiveRail
      lang={lang}
      titre={fr ? 'Du formulaire Meta à votre CRM' : 'From the Meta form to your CRM'}
      chapo={fr
        ? 'Un contact qui attend lundi dans un fichier est un contact refroidi. Le chemin qu’on installe, de l’annonce au rappel du vendeur, puis retour à Meta.'
        : 'A lead waiting in a file until Monday is a lead gone cold. The path we set up, from the ad to the salesperson’s call, then back to Meta.'}
      stations={rail}
    />
  )}

  <!-- Les six cartes de services et les trois cas d'usage de la fiche ne sont plus rendus sur
       ces trois pages : les maquettes et les scènes montrent ce qu'ils décrivaient. -->

  <!-- Les résultats de trois concessions (encre). -->
  {benchmarks && benchmarks.length > 0 && !isDynamicAds && (
    <AutomotiveBenchmarks lang={lang} benchmarks={benchmarks} />
  )}

  <!-- Le ruban vers le calculateur, le service de la page déjà coché (blanc). Il remplace
       l'appel en dégradé du milieu de page (AutomotiveMidCTA). -->
  <RubanCalculateur lang={lang} service={calculatorServiceId} />

  <!-- L'équipe (brume). -->
  {team && team.length > 0 && (
    <AutomotiveTeam lang={lang} team={team} fond="brume" />
  )}

  <!-- Les études de cas automobiles et un verbatim (encre). -->
  {preuves && (
    <CaseStudyCarousel lang={lang} caseStudyIds={preuves.ids} verbatim={preuves.verbatim} fond="encre" />
  )}

  <!-- Les questions, puis l'appel final : l'ordre de la maquette Encre. -->
  {faq && faq.length > 0 && (
    <AutomotiveFAQ lang={lang} faq={faq} />
  )}

  <FinalCTA lang={lang} color={color} />
</PageLayout>
