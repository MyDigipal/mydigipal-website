---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import Marque from '@/components/ui/Marque.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import PageHero from '@/components/ui/PageHero.astro';
import BandeauLogos from '@/components/ui/BandeauLogos.astro';
import TableauPalettes from '@/components/motion/TableauPalettes.astro';
import AutomotiveRail from '@/components/sections/automotive/AutomotiveRail.astro';
import { railParcours } from '@/components/motion/donnees-automobile';
import { mesurerLogos } from '@/lib/logos-mesures';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

const content = {
  en: {
    seo: {
      title: "Automotive Marketing | Car Dealership Ads",
      description: "Specialized digital marketing for car dealerships. Google Ads, Dynamic Ads, and Paid Social campaigns that drive showroom visits and vehicle sales."
    },
    hero: {
      badge: "Automotive marketing",
      headline: "Drive more sales to your dealership",
      subheadline: "Your vehicles deserve to be seen.",
      description: "We specialize in automotive digital marketing. From Google Ads to Dynamic Ads, we help car dealerships reach buyers at every stage of their journey."
    },
    intro: {
      title: "Why Automotive Needs Specialized Marketing",
      description: "Selling cars is different. The buyer journey is longer, the competition is fierce, and local presence matters. That's why we've built expertise specifically for the automotive industry.",
      points: [
        { icon: "map-pin", title: "Local focus", description: "Target buyers in your dealership's geographic area with precision." },
        { icon: "car", title: "Inventory integration", description: "Sync your vehicle inventory with dynamic ad campaigns." },
        { icon: "trending-up", title: "Full funnel", description: "From awareness to showroom visit, we cover every touchpoint." },
        { icon: "bar-chart", title: "Measurable ROI", description: "Track every click, visit, and sale with complete transparency." }
      ]
    },
    stats: [
      { value: "€150K", label: "Monthly budget managed" },
      { value: "188K", label: "Clicks generated" },
      { value: "10.6K", label: "Leads generated" },
      { value: "50+", label: "Dealerships Served" }
    ],
    services: [
      {
        icon: "search",
        name: "Google Ads",
        tagline: "Dominate search results",
        description: "Be there when car buyers are searching. Search, Display, YouTube, and Vehicle Listing Ads tailored for automotive dealerships.",
        href: "/en/automotive/google-ads",
        features: ["Search campaigns", "Display retargeting", "YouTube Ads", "Vehicle Listing Ads"],
        highlights: [
          "Brand & model-specific campaigns",
          "New and used car targeting",
          "Event promotion (open days, sales)",
          "Budget allocation by objectives"
        ],
        color: "from-blue-500 to-cyan-500",
        stat: { value: "10%", label: "Conversion rate (vs 2.5% industry average)" }
      },
      {
        icon: "users",
        name: "Paid Social",
        tagline: "Reach buyers where they scroll",
        description: "Engage potential car buyers on Facebook, Instagram, and TikTok with visually compelling campaigns that drive showroom visits.",
        href: "/en/automotive/paid-social",
        features: ["Facebook Ads", "Instagram ads", "Carousel campaigns", "Lead Gen Forms"],
        highlights: [
          "Lifestyle & interest targeting",
          "Video showcases",
          "Test drive bookings",
          "Remarketing to website visitors"
        ],
        color: "from-pink-500 to-rose-500",
        stat: { value: "3x", label: "Higher engagement vs static ads" }
      },
      {
        icon: "refresh-cw",
        name: "Dynamic Ads",
        tagline: "Your inventory, automatically",
        description: "Connect your vehicle inventory directly to Meta & Google. Show the right car to the right buyer at the right time, automatically.",
        href: "/en/automotive/dynamic-ads",
        features: ["Catalog integration", "Dynamic retargeting", "Cross-Sell", "Automatic updates"],
        highlights: [
          "Real-time inventory sync",
          "Price & availability updates",
          "Model-specific targeting",
          "Automated creative generation"
        ],
        color: "from-indigo-500 to-purple-600",
        stat: { value: "40%", label: "Lower cost per lead" }
      }
    ],
    cta: "Learn more",
    clients: {
      title: "Trusted by Dealerships",
      logos: [
        { name: "DMD Group", logo: "/images/Client logo/DMD.png" },
        { name: "Theobald Group", logo: "/images/Client logo/Theobald.png" },
        { name: "BYmyCAR", logo: "/images/Client logo/BYmyCAR.png" },
        { name: "Vulcain", logo: "/images/Client logo/Vulcain.png" },
        { name: "EDA 42", logo: "/images/Client logo/EDA 42.png" },
        { name: "GGP Auto", logo: "/images/Client logo/GGP Auto.png" },
        { name: "Autovillage", logo: "/images/Client logo/Auto village.png" },
        { name: "Dugat Group", logo: "/images/Client logo/Dugat.jpg" },
        { name: "Warpcom", logo: "/images/Client logo/Warpcom.webp" },
        { name: "Iroise Auto", logo: "/images/Client logo/Iroise Auto.png" }
      ]
    },
    testimonials: {
      title: "What dealerships say",
      items: [
        {
          quote: "MyDigipal's automotive expertise is unmatched. They understand our industry, our challenges, and deliver campaigns that actually bring customers to our showroom.",
          author: "Jennifer G.",
          role: "Marketing Director",
          company: "Theobald Group",
          image: "/images/Client logo/Jennifer G.jpeg"
        },
        {
          quote: "What sets MyDigipal apart is the proximity and personalized follow-up. They're always available, proactive with optimizations, and truly invested in our success.",
          author: "Vanina F.",
          role: "Digital Manager",
          company: "BYmyCAR",
          image: "/images/Client logo/Vanina F.jpeg"
        }
      ]
    },
    process: {
      title: "Our approach",
      steps: [
        { number: "01", title: "Audit", description: "We analyze your current digital presence, competitors, and market opportunities." },
        { number: "02", title: "Strategy", description: "Custom campaign strategy aligned with your sales objectives and inventory." },
        { number: "03", title: "Launch", description: "Rapid deployment of campaigns with automotive-specific best practices." },
        { number: "04", title: "Optimize", description: "Continuous optimization based on performance data and market trends." }
      ]
    }
  },
  fr: {
    seo: {
      title: "Marketing Automobile | Concessionnaires",
      description: "Marketing digital spécialisé pour concessionnaires automobiles. Google Ads, Dynamic Ads et Paid Social pour générer des visites en showroom et des ventes."
    },
    hero: {
      badge: "Marketing automobile",
      headline: "Boostez les ventes de votre concession",
      subheadline: "Vos véhicules méritent d'être vus.",
      description: "On est spécialisés en marketing digital automobile. De Google Ads aux Dynamic Ads, on aide les concessionnaires à atteindre les acheteurs à chaque étape de leur parcours."
    },
    intro: {
      title: "Pourquoi l'automobile nécessite un marketing spécialisé",
      description: "Vendre des voitures, c'est différent. Le parcours d'achat est plus long, la concurrence est féroce, et la présence locale compte. C'est pourquoi on a développé une expertise spécifique pour l'industrie automobile.",
      points: [
        { icon: "map-pin", title: "Focus local", description: "Ciblez les acheteurs dans la zone géographique de votre concession avec précision." },
        { icon: "car", title: "Intégration stock", description: "Synchronisez votre inventaire de véhicules avec des campagnes publicitaires dynamiques." },
        { icon: "trending-up", title: "Full funnel", description: "De la notoriété à la visite en showroom, on couvre chaque point de contact." },
        { icon: "bar-chart", title: "ROI mesurable", description: "Suivez chaque clic, visite et vente avec une transparence totale." }
      ]
    },
    stats: [
      { value: "150K€", label: "Budget mensuel géré" },
      { value: "188K", label: "Clics générés" },
      { value: "10.6K", label: "Leads générés" },
      { value: "50+", label: "Concessions accompagnées" }
    ],
    services: [
      {
        icon: "search",
        name: "Google Ads",
        tagline: "Dominez les résultats de recherche",
        description: "Soyez présent quand les acheteurs de voitures recherchent. Search, Display, YouTube et Vehicle Listing Ads adaptés aux concessionnaires automobiles.",
        href: "/fr/automotive/google-ads",
        features: ["Campagnes Search", "Retargeting Display", "YouTube Ads", "Vehicle Listing Ads"],
        highlights: [
          "Campagnes par marque & modèle",
          "Ciblage voitures neuves et occasion",
          "Promotion événements (portes ouvertes, soldes)",
          "Allocation budget par objectifs"
        ],
        color: "from-blue-500 to-cyan-500",
        stat: { value: "10 %", label: "de taux de conversion, contre 2,5 % en moyenne" }
      },
      {
        icon: "users",
        name: "Paid Social",
        tagline: "Atteignez les acheteurs où ils scrollent",
        description: "Engagez les acheteurs potentiels sur Facebook, Instagram et TikTok avec des campagnes visuellement percutantes qui génèrent des visites en showroom.",
        href: "/fr/automotive/paid-social",
        features: ["Facebook Ads", "Instagram Ads", "Campagnes carrousel", "Formulaires de leads"],
        highlights: [
          "Ciblage lifestyle & intérêts",
          "Vidéos de présentation",
          "Réservation essais",
          "Remarketing visiteurs site"
        ],
        color: "from-pink-500 to-rose-500",
        stat: { value: "3x", label: "plus d'engagement que les publicités statiques" }
      },
      {
        icon: "refresh-cw",
        name: "Dynamic Ads",
        tagline: "Votre stock, automatiquement",
        description: "Connectez votre stock de véhicules directement à Meta et Google. Montrez la bonne voiture au bon acheteur au bon moment, automatiquement.",
        href: "/fr/automotive/dynamic-ads",
        features: ["Intégration catalogue", "Retargeting dynamique", "Cross-sell", "Mises à jour auto"],
        highlights: [
          "Sync stock temps réel",
          "Mises à jour prix & dispo",
          "Ciblage par modèle",
          "Génération créa automatique"
        ],
        color: "from-indigo-500 to-purple-600",
        stat: { value: "40 %", label: "de coût par lead en moins" }
      }
    ],
    cta: "En savoir plus",
    clients: {
      title: "Ils nous font confiance",
      logos: [
        { name: "Groupe DMD", logo: "/images/Client logo/DMD.png" },
        { name: "Groupe Theobald", logo: "/images/Client logo/Theobald.png" },
        { name: "BYmyCAR", logo: "/images/Client logo/BYmyCAR.png" },
        { name: "Vulcain", logo: "/images/Client logo/Vulcain.png" },
        { name: "EDA 42", logo: "/images/Client logo/EDA 42.png" },
        { name: "GGP Auto", logo: "/images/Client logo/GGP Auto.png" },
        { name: "Autovillage", logo: "/images/Client logo/Auto village.png" },
        { name: "Groupe Dugat", logo: "/images/Client logo/Dugat.jpg" },
        { name: "Warpcom", logo: "/images/Client logo/Warpcom.webp" },
        { name: "Iroise Auto", logo: "/images/Client logo/Iroise Auto.png" }
      ]
    },
    testimonials: {
      title: "Ce que disent les concessions",
      items: [
        {
          quote: "L'expertise automobile de MyDigipal est inégalée. Ils comprennent notre industrie, nos défis, et délivrent des campagnes qui amènent vraiment des clients en showroom.",
          author: "Jennifer G.",
          role: "Directrice Marketing",
          company: "Groupe Theobald",
          image: "/images/Client logo/Jennifer G.jpeg"
        },
        {
          quote: "Ce qui distingue MyDigipal, c'est la proximité et le suivi personnalisé. Ils sont toujours disponibles, proactifs sur les optimisations, et vraiment investis dans notre succès.",
          author: "Vanina F.",
          role: "Responsable Digital",
          company: "BYmyCAR",
          image: "/images/Client logo/Vanina F.jpeg"
        }
      ]
    },
    process: {
      title: "Notre approche",
      steps: [
        { number: "01", title: "Audit", description: "On analyse votre présence digitale actuelle, vos concurrents et les opportunités marché." },
        { number: "02", title: "Stratégie", description: "Stratégie de campagne sur-mesure alignée avec vos objectifs de vente et votre stock." },
        { number: "03", title: "Lancement", description: "Déploiement rapide des campagnes avec les best practices automobiles." },
        { number: "04", title: "Optimisation", description: "Optimisation continue basée sur les données de performance et les tendances marché." }
      ]
    }
  }
};

const c = content[lang] || content.en;
const fr = lang === 'fr';

// Le tableau à palettes : trois chiffres de l'agence (gardés, à sourcer), le quatrième
// écrit dessous. « 150K€ » devient « 150 » et l'unité « K€ ».
const decouper = (s: { value: string; label: string }) => {
  const [, chiffre = s.value, unite = ''] = s.value.match(/^([€$£]?[\d.,]+)\s*(.*)$/) ?? [];
  return { chiffre: fr ? chiffre.replace('.', ',') : chiffre, unite, texte: fr ? s.label.charAt(0).toLowerCase() + s.label.slice(1) : s.label.toLowerCase() };
};
const tableau = [c.stats[0], c.stats[2], c.stats[3]].map(decouper);
const quatrieme = decouper(c.stats[1]);

// Les logos, EN COULEUR : la version détourée de l'accueil quand elle existe.
// Autovillage : la version en longueur, plus lisible dans la bande que le carré.
const logos = await mesurerLogos(
  c.clients.logos,
  { 'Groupe DMD': 'dmd', 'DMD Group': 'dmd', 'Groupe Theobald': 'theobald', 'Theobald Group': 'theobald', BYmyCAR: 'bymycar', Vulcain: 'vulcain' },
  { Autovillage: '/images/Automotive/Google Ads/92289030-0554-4210-a051-cef137629e42.webp' },
);

// Les marques de chaque levier, en couleur.
const MARQUES: Record<string, string[]> = {
  'Google Ads': ['Google Ads', 'YouTube'],
  'Paid Social': ['Facebook', 'Instagram', 'TikTok'],
  'Dynamic Ads': ['Meta Ads', 'Google Ads'],
};

const rail = railParcours(lang);
const t = {
  pourquoi: fr ? 'Pourquoi l’automobile demande un marketing à part' : 'Why automotive needs its own kind of marketing',
  rail: fr ? 'Le parcours d’un acheteur, de la recherche à l’essai' : 'A buyer’s journey, from search to test drive',
  railChapo: fr
    ? 'Trois leviers pour un seul acheteur. Chacun agit à un moment précis du parcours ; ensemble, ils le mènent jusqu’en concession.'
    : 'Three levers for one buyer. Each acts at a precise moment of the journey; together, they bring the buyer to the dealership.',
  leviers: fr ? 'Trois leviers pour les concessions' : 'Three levers for dealerships',
  leviersChapo: fr ? 'Chacun a sa page : ce qu’il fait, pour qui, et ce qu’il a donné chez nos clients.' : 'Each has its page: what it does, for whom, and what it delivered for our clients.',
  logos: fr ? 'Ils nous confient leurs campagnes' : 'They trust us with their campaigns',
};
---

<PageLayout lang={lang} title={c.seo.title} description={c.seo.description}>
  <!-- Direction Encre, modèle AI Training (groupe 3, 30/09/2026). -->
  <PageHero
    eyebrow={c.hero.badge}
    title={c.hero.headline}
    subtitle={c.hero.subheadline}
    description={c.hero.description}
    actions={[
      { href: `/${lang}/calculator?service=google-ads,paid-social`, label: fr ? 'Calculer mon budget' : 'Calculate my budget' },
      { href: `/${lang}/contact`, label: fr ? 'Nous contacter' : 'Contact us', style: 'contour' },
    ]}
  />

  <!-- Les logos des concessions, en couleur (blanc). -->
  <section class="section-blanc py-10 lg:py-12">
    <BandeauLogos titre={t.logos} logos={logos} />
  </section>

  <!-- Pourquoi un marketing à part (encre) : le tableau à palettes et les quatre raisons. -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
        <h2 class="titre-moyen">{t.pourquoi}</h2>
        <p class="chapo">{c.intro.description}</p>
      </header>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-5">
        <div class="carte-verre auto-tableau grid content-between gap-8 p-6 lg:p-9" data-reveal>
          <TableauPalettes lang={lang} lignes={tableau} tete />
          <p class="border-t border-white/10 pt-5 text-sur-encre-2">
            <span class="font-display text-2xl font-extrabold tracking-[-0.03em] text-white">{quatrieme.chiffre}{quatrieme.unite}</span>
            {' '}{quatrieme.texte}
          </p>
        </div>
        <ul class="grid grid-cols-1 content-start gap-4 sm:grid-cols-2">
          {c.intro.points.map((p, i) => (
            <li class="carte-verre grid content-start gap-3 p-6" data-reveal style={`--i:${i}`}>
              <span class="tuile tuile-pleine"><Icon name={p.icon} size={26} /></span>
              <h3 class="titre-carte text-white">{p.title}</h3>
              <p class="text-sur-encre-2">{p.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Le tunnel d'un concessionnaire, sur le rail (blanc). -->
  <AutomotiveRail lang={lang} titre={t.rail} chapo={t.railChapo} stations={rail} />

  <!-- Notre approche (encre) : quatre temps sur une frise. -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16">
        <h2 class="titre-moyen">{c.process.title}</h2>
      </header>
      <ol class="frise grid grid-cols-1 gap-8 md:grid-cols-4 md:gap-6">
        {c.process.steps.map((s, i) => (
          <li class="frise-temps grid content-start gap-3" data-reveal style={`--i:${i}`}>
            <span class="frise-numero" aria-hidden="true">{i + 1}</span>
            <h3 class="titre-carte text-white">{s.title}</h3>
            <p class="text-sur-encre-2 text-pretty">{s.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Les trois leviers (brume) : une ligne chacun, ses marques, son chiffre sur l'encre. -->
  <section class="section-brume py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
        <h2 class="titre-moyen text-encre">{t.leviers}</h2>
        <p class="chapo">{t.leviersChapo}</p>
      </header>
      <ul class="grid gap-4 lg:gap-5">
        {c.services.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={s.href} class="levier carte group grid grid-cols-1 gap-6 p-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-10 lg:p-8">
              <div class="grid content-start gap-4">
                <ul class="flex flex-wrap gap-2.5" aria-hidden="true">
                  {(MARQUES[s.name] ?? []).map((m) => (
                    <li class="grid h-11 w-11 place-items-center rounded-xl bg-brume-clair"><Marque nom={m} taille={22} /></li>
                  ))}
                </ul>
                <div class="grid gap-1">
                  <h3 class="titre-carte text-encre transition-colors group-hover:text-marque lg:text-[2rem]">{s.name}</h3>
                  <p class="font-semibold text-slate-500">{s.tagline}</p>
                </div>
                <p class="max-w-[60ch] text-slate-600 text-pretty">{s.description}</p>
                <ul class="puces">{s.features.map((f) => <li>{f}</li>)}</ul>
                <span class="mt-1 inline-flex items-center gap-2 font-semibold text-marque transition-all group-hover:gap-3">
                  {c.cta}
                  <Icon name="arrow-right" size={18} />
                </span>
              </div>
              <div class="carte-encre grid content-between gap-6 p-6 lg:p-8">
                <p class="levier-chiffre">{s.stat.value}</p>
                <div class="grid gap-3">
                  <p class="text-lg text-sur-encre">{s.stat.label}</p>
                  <ul class="grid gap-1.5 border-t border-white/10 pt-4">
                    {s.highlights.slice(0, 3).map((h) => (
                      <li class="flex items-start gap-2 text-sur-encre-2">
                        <Icon name="check" size={16} class="mt-1 flex-none text-marque-clair" />
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ce que disent les concessions (encre). -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16">
        <h2 class="titre-moyen">{c.testimonials.title}</h2>
      </header>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-5">
        {c.testimonials.items.map((q, i) => (
          <figure class="carte-verre grid content-between gap-8 p-6 lg:p-9" data-reveal style={`--i:${i}`}>
            <blockquote>
              <p class="citation">{fr ? `« ${q.quote} »` : `“${q.quote}”`}</p>
            </blockquote>
            <figcaption class="flex items-center gap-4">
              {q.image && <img src={q.image} alt="" width="56" height="56" class="h-14 w-14 flex-none rounded-full object-cover" loading="lazy" decoding="async" />}
              <span>
                <span class="block font-semibold text-white">{q.author}</span>
                <span class="block text-sur-encre-2">{[q.role, q.company].filter(Boolean).join(', ')}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA lang={lang} color="primary" />
</PageLayout>

<style>
  .levier {
    transition: box-shadow 300ms var(--mdp-entree);
  }
  .levier:hover {
    box-shadow: inset 0 0 0 1px rgb(29 113 184 / 0.35), 0 24px 50px -30px rgb(11 27 43 / 0.45);
  }
  .levier-chiffre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 2.2rem + 4vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: #fff;
    white-space: nowrap;
  }
  .citation {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: pretty;
  }
  .frise-numero {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-marque);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
  }
  @media (min-width: 768px) {
    .frise-temps {
      position: relative;
    }
    /* Le trait de la frise, du numéro au suivant. */
    .frise-temps:not(:last-child)::before {
      content: '';
      position: absolute;
      top: 22px;
      left: 56px;
      right: -12px;
      height: 2px;
      background: rgb(255 255 255 / 0.16);
    }
  }
</style>
