---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import TrustedBy from '@/components/sections/TrustedBy.astro';
import TrainingTestimonials from '@/components/sections/TrainingTestimonials.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { ENDPOINT, prixDe, type Jour30Data } from '@/components/academy/data';
import secoursFr from '@/data/academy/jour30-fr.json';
import secoursEn from '@/data/academy/jour30-en.json';
import PageHero from '@/components/ui/PageHero.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

/**
 * Les chiffres de l'AI Academy viennent du catalogue, jamais de cette page.
 *
 * Elle annoncait « Accès permanent, dès 290 € » et « Relecture humaine » : trois
 * erreurs d'un coup au 16/09/2026. L'accès dure soixante jours depuis le
 * 11/09 ; l'entrée est à 250 € puisque Les automatisations se vendent seules ;
 * et les relectures appartiennent au palier `pro`, retirées de la page de vente
 * le 15/09 pour cette raison. Le nombre de leçons, lui, a bougé sept fois.
 *
 * Même mécanique que la page de vente : l'API au build, l'instantané en secours
 * (règle « un fait chiffré, une source », Paul le 28/08/2026).
 */
async function lireAcademy(): Promise<Jour30Data> {
  try {
    const r = await fetch(`${ENDPOINT}?lang=${lang}`, { signal: AbortSignal.timeout(10000) });
    if (r.ok) {
      const d = (await r.json()) as Jour30Data;
      if (d?.faits?.lessons && d.lang === lang) return d;
    }
  } catch {
    /* instantané */
  }
  return (lang === 'fr' ? secoursFr : secoursEn) as unknown as Jour30Data;
}
const academy = await lireAcademy();
// La page anglaise compte en dollars, la française en euros (Paul, 16/09/2026).
const deviseAcademy = lang === 'fr' ? 'EUR' : 'USD';
const prixEntree = Math.min(
  ...academy.offres
    .filter((o) => o.id === 'programme' || o.id === 'construire')
    .map((o) => prixDe(o, deviseAcademy)),
);
const entree =
  lang === 'fr'
    ? `${Math.round(prixEntree / 100)} €`
    : `$${Math.round(prixEntree / 100)}`;
const leconsAcademy = academy.faits.lessons;
const joursAcademy = academy.acces_jours ?? 60;

