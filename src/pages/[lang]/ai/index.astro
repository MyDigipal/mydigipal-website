---

<PageLayout lang={lang} title={c.seo.title} description={c.seo.description}>
  <PageHero
    eyebrow={c.hero.badge}
    title={c.hero.headline}
    subtitle={c.hero.subheadline}
    description={c.hero.description}
    actions={[
      { href: `/${lang}/academy`, label: lang === 'fr' ? 'Découvrir l’AI Academy' : 'Explore the AI Academy' },
      { href: `/${lang}/contact`, label: lang === 'fr' ? 'Nous contacter' : 'Contact us', style: 'contour' },
    ]}
  />


  <!-- Direction Encre (30/09/2026). Le rythme : l'aiguillage sur l'encre, le détail des
       quatre offres sur le blanc, les départements sur l'encre, les articles sur le blanc,
       les avis des formations sur l'encre. Plus de « 300 % / 50+ / 100+ » (aucune
       source), plus d'avis hors sujet (emailing, Google Ads). -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[900px] gap-5 lg:mb-16 lg:gap-6">
        <h2 class="titre-moyen">{c.intro.title}</h2>
        <p class="chapo">{c.intro.description}</p>
      </header>
      <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white lg:text-3xl">{c.aiguillage.titre}</h3>
      <p class="mb-6 mt-2 text-sur-encre-2">{c.aiguillage.chapo}</p>
      <ul>
        {c.aiguillage.lignes.map((l) => (
          <li class="border-t border-white/10">
            <a href={l.href} class="group grid gap-2 py-6 lg:grid-cols-[200px_minmax(0,1fr)_minmax(0,1.2fr)_auto] lg:items-center lg:gap-8">
              <span class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white">{l.nom}</span>
              <span class="font-semibold text-sur-encre">{l.pour}</span>
              <span class="text-sur-encre-2">{l.phrase}</span>
              <span class="inline-flex items-center gap-2 font-semibold text-marque-clair transition-colors group-hover:text-white">
                {c.cta}
                <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-blanc py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-10 grid max-w-[880px] gap-5 lg:mb-14">
        <h2 class="titre-moyen text-encre">{c.servicesSection.title}</h2>
        <p class="chapo">{c.intro.paragraph}</p>
      </header>
      {c.services.map((service, index) => (
        <article class="grid gap-8 border-t border-slate-200 py-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16" data-reveal style={`--i:${index % 2}`}>
          <div class="grid content-start justify-items-start gap-4">
            <div class="flex items-center gap-3">
              <Icon name={service.icon} size={26} class="text-marque" />
              <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-encre">{service.name}</h3>
            </div>
            <p class="font-semibold text-marque">{service.tagline}</p>
            <p class="text-slate-600">{service.description}</p>
            <p class="text-slate-500">{service.features.join(', ')}</p>
            <a href={service.href} class="pilule pilule-contour mt-2">
              {c.cta}
              <Icon name="arrow-right" size={18} class="pilule-fleche" />
            </a>
          </div>
          <div>
            <h4 class="mb-4 font-semibold text-encre">{lang === 'fr' ? 'Points clés' : 'Key highlights'}</h4>
            <ul class="grid gap-3">
              {service.highlights.map((highlight) => (
                <li class="flex items-start gap-3 text-slate-700">
                  <Icon name="check" size={16} class="mt-1 flex-none text-marque" />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-encre section-monte py-20 lg:py-28">
    <div class="container-custom">
      <h2 class="titre-moyen mb-10 lg:mb-14">{c.useCases.title}</h2>
      <ul class="grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {c.useCases.items.map((useCase, index) => (
          <li class="grid content-start gap-2 border-t border-white/10 py-7" data-reveal style={`--i:${index}`}>
            <Icon name={useCase.icon} size={24} class="mb-1 text-marque-clair" />
            <h3 class="text-lg font-semibold text-white">{useCase.name}</h3>
            <p class="text-sur-encre-2">{useCase.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-blanc py-20 lg:py-28">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5">
        <h2 class="titre-moyen text-encre">{c.blogSection.title}</h2>
        <p class="chapo">{c.blogSection.subtitle}</p>
      </header>
      <div class="grid gap-8 md:grid-cols-3">
        {articles.map((article, index) => (
          <a href={article.href} class="group block overflow-hidden rounded-[20px] border border-slate-200 bg-white transition-shadow duration-300 hover:shadow-xl" data-reveal style={`--i:${index}`}>
            <div class="hidden aspect-video overflow-hidden sm:block">
              <img src={article.image} alt={article.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
            </div>
            <div class="p-6">
              <h3 class="mb-2 text-lg font-bold text-encre transition-colors group-hover:text-marque">{article.title}</h3>
              <p class="mb-4 text-slate-600">{article.description}</p>
              <span class="flex items-center gap-2 font-semibold text-marque">
                {lang === 'fr' ? 'Lire l’article' : 'Read article'}
                <Icon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-12">
        <a href={`/${lang}/blog?category=ai`} class="pilule pilule-contour">{lang === 'fr' ? 'Voir tous les articles IA' : 'View all AI articles'}</a>
      </div>
    </div>
  </section>

  <TrainingTestimonials lang={lang} />

  <TrustedBy
    lang={lang}
    titre={lang === 'fr' ? 'Ils nous ont confié leurs équipes' : 'They trusted us with their teams'}
    slugs={['la-poste', 'leclerc', 'pierre-fabre', 'moet-hennessy', 'yves-saint-laurent', 'la-redoute', 'pernod-ricard', 'gucci', 'kaufman-broad', 'gl-events', 'grands-moulins', 'balenciaga']}
  />

  <!-- Final CTA -->
  <FinalCTA lang={lang} color="primary" />
</PageLayout>
