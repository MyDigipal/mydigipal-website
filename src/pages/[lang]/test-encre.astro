---
/**
 * La page de validation des composants animés de la direction Encre (étape 2 de la
 * refonte, 30/09/2026). En `noindex`, hors sitemap : Paul y regarde `CarteVerre` et
 * `RailMorphing` en français et en anglais avant qu'ils entrent dans les pages.
 * Le contenu est celui de la maquette (`labo/refonte-site/direction-a.html`).
 */
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CarteVerre from '@/components/motion/CarteVerre.astro';
import RailMorphing from '@/components/motion/RailMorphing.astro';
import { languages, type Language } from '@/i18n/config';
import { cartePmax, methodeGoogleAds } from '@/components/motion/donnees-pmax';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const fr = lang === 'fr';

const c = fr
  ? {
      titre: 'Composants animés, direction Encre',
      description: 'Page de validation, hors référencement. Chaque scène joue une fois à son entrée dans l’écran ; les repères rejouent chaque temps ; ?fige=1 montre l’état final.',
      pmaxTitre: 'Comment marche une campagne Performance Max',
      pmaxChapo: 'Vous donnez à Google des éléments et un objectif. Son IA compose les annonces et choisit où les montrer. Notre travail se joue avant et après : ce qu’on lui donne, puis ce qu’on lui apprend.',
      methodeTitre: 'De l’audit au reporting, en quatre temps',
    }
  : {
      titre: 'Animated components, Ink direction',
      description: 'Validation page, not indexed. Each scene plays once when it enters the screen; the markers replay each stage; ?fige=1 shows the final state.',
      pmaxTitre: 'How a Performance Max campaign works',
      pmaxChapo: 'You give Google a set of assets and a goal. Its AI assembles the ads and decides where to show them. Our work happens before and after: what we feed it, then what we teach it.',
      methodeTitre: 'From audit to reporting, in four stages',
    };

const pmax = cartePmax(lang);
const methode = methodeGoogleAds(lang);
---

<PageLayout lang={lang} title={c.titre} description={c.description} noindex={true}>
  <PageHero eyebrow={fr ? 'Refonte du design' : 'Design overhaul'} title={c.titre} description={c.description} />

  <section class="section-encre section-monte py-16 lg:py-28" aria-labelledby="pmax-titre">
    <div class="container-custom">
      <header class="mb-9 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
        <h2 id="pmax-titre" class="titre-moyen">{c.pmaxTitre}</h2>
        <p class="chapo">{c.pmaxChapo}</p>
      </header>
      <CarteVerre lang={lang} titreId="pmax-titre" nom={pmax.nom} entrees={pmax.entrees} sorties={pmax.sorties} retours={pmax.retours} gardes={pmax.gardes} temps={pmax.temps} conclusion={pmax.conclusion} />
    </div>
  </section>

  <section class="section-blanc py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-10 grid max-w-[880px] gap-5 lg:mb-16">
        <h2 class="titre-moyen text-encre">{c.methodeTitre}</h2>
      </header>
      <RailMorphing lang={lang} stations={methode.stations} />
    </div>
  </section>
</PageLayout>
