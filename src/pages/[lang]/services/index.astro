---
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language, languages } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import TrustedBy from '@/components/sections/TrustedBy.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Marque from '@/components/ui/Marque.astro';
import TableauPalettes from '@/components/motion/TableauPalettes.astro';
import RailMorphing from '@/components/motion/RailMorphing.astro';
import { kpiDe } from '@/lib/etudes-de-cas';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

const content = {
  en: {
    seo: {
      title: "Digital Marketing Services | Google Ads, SEO",
      description: "Full-service digital marketing: Google Ads, Paid Social, SEO, email marketing and B2B ABM. Data-driven strategies built for measurable, lasting growth."
    },
    hero: {
      badge: "Our services",
      headline: "Data-driven digital marketing",
      subheadline: "Accelerate your growth",
      description: "From paid advertising to organic strategies, we provide comprehensive digital marketing solutions that drive measurable results. Choose the services that fit your goals."
    },
    intro: {
      title: "Why choose MyDigipal?",
      description: "We're not just another agency. We combine deep expertise with a data-first approach to deliver campaigns that actually move the needle.",
      points: [
        { icon: "target", title: "Results-focused", description: "Every campaign is designed with your KPIs in mind. We optimize for what matters to your business." },
        { icon: "trending-up", title: "Data-driven", description: "Decisions backed by analytics, not guesswork. Real-time reporting and continuous optimization." },
        { icon: "users", title: "Dedicated team", description: "A team of specialists assigned to your account. Direct communication, no account managers in between." },
        { icon: "zap", title: "Agile execution", description: "Quick to adapt, fast to implement. We move at the speed your business needs." }
      ]
    },
    services: [
      {
        icon: "search",
        name: "Google Ads",
        description: "Dominate search results with targeted PPC campaigns. From Search to Display, YouTube to Performance Max, we manage it all.",
        href: "/en/services/google-ads",
        features: ["Search campaigns", "Display ads", "YouTube Ads", "Performance Max"],
        color: "from-blue-500 to-cyan-500"
      },
      {
        icon: "users",
        name: "Paid Social",
        description: "Reach your audience where they spend their time. LinkedIn, Meta, TikTok: we craft campaigns that convert.",
        href: "/en/services/paid-social",
        features: ["LinkedIn Ads", "Meta Ads", "TikTok Ads", "Retargeting"],
        color: "from-pink-500 to-rose-500"
      },
      {
        icon: "trending-up",
        name: "SEO",
        description: "Build sustainable organic traffic. Technical optimization, content strategy, and link building for long-term growth.",
        href: "/en/services/seo",
        features: ["Technical SEO", "Content strategy", "Link building", "Local SEO"],
        color: "from-green-500 to-emerald-500"
      },
      {
        icon: "mail",
        name: "Email Marketing",
        description: "Nurture leads and drive conversions with personalized email campaigns. Automation, segmentation, and AI-powered personalization.",
        href: "/en/services/emailing",
        features: ["Automation flows", "Segmentation", "A/B testing", "Newsletter design"],
        color: "from-amber-500 to-orange-500"
      },
      {
        icon: "target",
        name: "B2B / ABM",
        description: "Account-Based Marketing for precision B2B growth. Target high-value accounts with personalized multi-channel campaigns.",
        href: "/en/services/b2b-abm",
        features: ["Account targeting", "Sales alignment", "Multi-channel", "Intent data"],
        color: "from-indigo-500 to-purple-600"
      },
      {
        icon: "bar-chart-2",
        name: "Tracking & Reporting",
        description: "GA4, GTM, pixel setup and custom dashboards. Transform data into actionable insights with AI-powered analytics.",
        href: "/en/services/tracking-reporting",
        features: ["GA4 & GTM", "Custom dashboards", "Cookie compliance", "AI analytics"],
        color: "from-teal-500 to-cyan-500"
      }
    ],
    cta: "Learn more",
    testimonials: {
      title: "What our clients say",
      items: [
        {
          quote: "We were looking to improve our digital marketing efforts, but had a gap in the marketing team and over 12 internal tools to handle. MyDigipal was able to overcome significant challenges and successfully executed an ABM revamp across LinkedIn. Very impressive.",
          author: "Brett Rieser",
          company: "Genesys",
          role: "Digital Marketing Director EMEA",
          image: "https://cdn.prod.website-files.com/64ec8901e801c89308b10a5b/66a8c81987fc1c9e891a99d4_Brett%20Reiser%20100px.webp"
        },
        {
          quote: "The ABM programs MyDigipal put in place helped Quantum Metrics identify and focus on the most valuable target accounts. We were able to accelerate the deal closing process by 30%!",
          author: "Kelly Wright",
          company: "Quantum Metrics",
          role: "Global Marketing Director",
          image: "/images/Client logo/Kelly W.jpeg"
        }
      ]
    }
  },
  fr: {
    seo: {
      title: "Services Marketing Digital | Google Ads, SEO",
      description: "Agence de marketing digital full-service : Google Ads, Paid Social, SEO, email marketing et ABM B2B. Stratégies data-driven pour une croissance mesurable."
    },
    hero: {
      badge: "Nos services",
      headline: "Marketing Digital Data-Driven",
      subheadline: "Accélérez votre croissance",
      description: "De la publicité payante aux stratégies organiques, nous fournissons des solutions de marketing digital complètes qui génèrent des résultats mesurables. Choisissez les services adaptés à vos objectifs."
    },
    intro: {
      title: "Pourquoi choisir MyDigipal ?",
      description: "Nous ne sommes pas une agence comme les autres. Nous combinons une expertise approfondie avec une approche data-first pour délivrer des campagnes qui font vraiment la différence.",
      points: [
        { icon: "target", title: "Orienté résultats", description: "Chaque campagne est conçue avec vos KPIs en tête. On optimise pour ce qui compte pour votre business." },
        { icon: "trending-up", title: "Data-driven", description: "Des décisions basées sur l'analytics, pas sur l'intuition. Reporting temps réel et optimisation continue." },
        { icon: "users", title: "Équipe dédiée", description: "Une équipe de spécialistes assignée à votre compte. Communication directe, sans intermédiaires." },
        { icon: "zap", title: "Exécution agile", description: "Rapides à s'adapter, rapides à implémenter. On avance au rythme de votre business." }
      ]
    },
    services: [
      {
        icon: "search",
        name: "Google Ads",
        description: "Dominez les résultats de recherche avec des campagnes PPC ciblées. Du Search au Display, YouTube au Performance Max, on gère tout.",
        href: "/fr/services/google-ads",
        features: ["Campagnes Search", "Display Ads", "YouTube Ads", "Performance Max"],
        color: "from-blue-500 to-cyan-500"
      },
      {
        icon: "users",
        name: "Paid Social",
        description: "Atteignez votre audience là où elle passe son temps. LinkedIn, Meta, TikTok - on crée des campagnes qui convertissent.",
        href: "/fr/services/paid-social",
        features: ["LinkedIn Ads", "Meta Ads", "TikTok Ads", "Retargeting"],
        color: "from-pink-500 to-rose-500"
      },
      {
        icon: "trending-up",
        name: "SEO",
        description: "Construisez un trafic organique durable. Optimisation technique, stratégie de contenu et netlinking pour une croissance long terme.",
        href: "/fr/services/seo",
        features: ["SEO Technique", "Stratégie contenu", "Netlinking", "SEO Local"],
        color: "from-green-500 to-emerald-500"
      },
      {
        icon: "mail",
        name: "Email Marketing",
        description: "Nurturez vos leads et boostez vos conversions avec des campagnes email personnalisées. Automation, segmentation et personnalisation IA.",
        href: "/fr/services/emailing",
        features: ["Automation", "Segmentation", "A/B Testing", "Design Newsletter"],
        color: "from-amber-500 to-orange-500"
      },
      {
        icon: "target",
        name: "B2B / ABM",
        description: "Account-Based Marketing pour une croissance B2B de précision. Ciblez des comptes à forte valeur avec des campagnes multi-canal personnalisées.",
        href: "/fr/services/b2b-abm",
        features: ["Ciblage Comptes", "Alignement Sales", "Multi-Canal", "Intent Data"],
        color: "from-indigo-500 to-purple-600"
      },
      {
        icon: "bar-chart-2",
        name: "Tracking & Reporting",
        description: "Configuration GA4, GTM, pixels et dashboards custom. Transformez vos données en insights actionnables avec l'analytics IA.",
        href: "/fr/services/tracking-reporting",
        features: ["GA4 & GTM", "Dashboards Custom", "Conformité cookies", "Analytics IA"],
        color: "from-teal-500 to-cyan-500"
      }
    ],
    cta: "En savoir plus",
    testimonials: {
      title: "Ce que disent nos clients",
      items: [
        {
          quote: "Nous cherchions à améliorer nos efforts marketing digital, mais nous avions un gap dans l'équipe et plus de 12 outils internes à gérer. MyDigipal a su surmonter ces défis et exécuter avec succès une refonte ABM sur LinkedIn. Très impressionnant.",
          author: "Brett Rieser",
          company: "Genesys",
          role: "Digital Marketing Director EMEA",
          image: "https://cdn.prod.website-files.com/64ec8901e801c89308b10a5b/66a8c81987fc1c9e891a99d4_Brett%20Reiser%20100px.webp"
        },
        {
          quote: "Les programmes ABM mis en place par MyDigipal ont aidé Quantum Metrics à identifier et se concentrer sur les comptes cibles les plus précieux. Nous avons accéléré le processus de closing de 30% !",
          author: "Kelly Wright",
          company: "Quantum Metrics",
          role: "Global Marketing Director",
          image: "/images/Client logo/Kelly W.jpeg"
        }
      ]
    }
  }
};

const c = content[lang] || content.en;

const fr = lang === 'fr';
// Les résultats au tableau à palettes : lus dans trois études de cas (libellé anglais
// vérifié au build), jamais écrits ici.
const resultats = await Promise.all([
  kpiDe(lang, 'symbl-ai', 0, 'enterprise leads'),
  kpiDe(lang, 'gwi', 0, 'engagement rate'),
  kpiDe(lang, 'dmd-group', 0, 'conversions'),
]);
const coupe = (v: string) => {
  const m = v.replace(/[\u202f\u00a0]/g, ' ').match(/^([^\d+\-−]*)([+\-−]?[\d.,]+)\s*(.*)$/);
  return m ? { chiffre: `${m[1]}${m[2]}`, unite: m[3] } : { chiffre: v, unite: '' };
};
const tableau = resultats.map((r) => ({ ...coupe(r.value), texte: `${r.label}, ${r.client}` }));
// La marque de chaque service quand elle existe.
const marquesService: Record<string, string[]> = {
  'Google Ads': ['Google Ads'],
  'Paid Social': ['LinkedIn', 'Meta Ads'],
  SEO: ['Search Console'],
  'Tracking & Reporting': ['Google Analytics 4', 'Tag Manager'],
};
const iconeDe: Record<string, string> = { 'bar-chart-2': 'bar-chart' };
// Comment on démarre : le parcours commun à tous les services, sur le rail.
const demarrage = fr
  ? {
      titre: 'Comment on démarre',
      chapo: 'Le même chemin, quel que soit le service : on regarde, on choisit avec vous, on lance, puis on pilote.',
      stations: [
        { titre: 'Audit', texte: 'Vos comptes, votre tracking et vos concurrents, avant toute recommandation.', forme: 'loupe' as const },
        { titre: 'Stratégie', texte: 'Les canaux, le budget et les objectifs, choisis avec vous. Le calculateur donne le prix.', forme: 'cible' as const },
        { titre: 'Lancement', texte: 'Campagnes, contenus et mesure mis en place par l’équipe qui les pilotera.', forme: 'curseur' as const },
        { titre: 'Pilotage', texte: 'Optimisation continue et reporting clair : ce qui marche prend le budget.', forme: 'courbe' as const },
      ],
    }
  : {
      titre: 'How we start',
      chapo: 'The same path whatever the service: we look, we choose with you, we launch, then we steer.',
      stations: [
        { titre: 'Audit', texte: 'Your accounts, your tracking and your competitors, before any recommendation.', forme: 'loupe' as const },
        { titre: 'Strategy', texte: 'Channels, budget and goals, chosen with you. The calculator gives the price.', forme: 'cible' as const },
        { titre: 'Launch', texte: 'Campaigns, content and measurement set up by the team that will run them.', forme: 'curseur' as const },
        { titre: 'Steering', texte: 'Continuous optimisation and clear reporting: what works gets the budget.', forme: 'courbe' as const },
      ],
    };
---

<PageLayout lang={lang} title={c.seo.title} description={c.seo.description}>
  <!-- L'index des services, au modèle d'AI Training (30/09/2026) : les six services en cartes de
       tailles différentes dans le haut de page, les résultats de trois études de cas au
       tableau à palettes, le démarrage sur le rail, les avis sur l'encre. -->
  <PageHero
    eyebrow={c.hero.badge}
    title={c.hero.headline}
    subtitle={c.hero.subheadline}
    description={c.hero.description}
    actions={[
      { href: `/${lang}/calculator`, label: fr ? 'Calculer mon budget' : 'Calculate my budget' },
      { href: `/${lang}/contact`, label: fr ? 'Nous contacter' : 'Contact us', style: 'contour' },
    ]}
  >
    <div slot="apres" class="mt-16 lg:mt-24">
      <h2 class="titre-moyen text-encre">{fr ? 'Choisissez vos services' : 'Choose your services'}</h2>
      <p class="chapo mt-3">{fr ? 'Chaque service peut être activé individuellement ou combiné pour une stratégie complète.' : 'Each service can be activated individually or combined for a comprehensive strategy.'}</p>
      <ul class="services mt-8 lg:mt-10">
        {c.services.map((service, i) => {
          const fonce = i === 0;
          const marques = marquesService[service.name] ?? [];
          return (
            <li class:list={['service', { 'service-large': i === 0, 'service-pleine': i === 5 }]} data-reveal style={`--i:${i % 3}`}>
              <a href={service.href} class:list={['service-lien', fonce ? 'carte-encre' : 'carte']}>
                <span class="flex gap-2">
                  {marques.length > 0
                    ? marques.map((m) => <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white shadow-[inset_0_0_0_1px_var(--filet)]"><Marque nom={m} taille={28} /></span>)
                    : <span class="tuile tuile-grande"><Icon name={iconeDe[service.icon] ?? service.icon} size={30} /></span>}
                </span>
                <span class:list={['titre-carte text-2xl', fonce ? 'text-white' : 'text-encre']}>{service.name}</span>
                <span class={fonce ? 'text-sur-encre-2' : 'text-slate-600'}>{service.description}</span>
                <ul class="puces">{service.features.map((f) => <li>{f}</li>)}</ul>
                <span class:list={['mt-auto inline-flex items-center gap-2 font-semibold', fonce ? 'text-marque-clair' : 'text-marque']}>{c.cta}<Icon name="arrow-right" size={16} /></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </PageHero>

  <!-- Les résultats et ce qui nous distingue, sur l'encre. -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
        <h2 class="titre-moyen">{c.intro.title}</h2>
        <p class="chapo">{c.intro.description}</p>
      </header>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-6">
        <div class="carte-verre grid content-start gap-8 px-6 py-8 lg:px-9 lg:py-10">
          <TableauPalettes lang={lang} lignes={tableau} tete />
          <a href={`/${lang}/case-studies`} class="pilule pilule-blanche justify-self-start">
            {fr ? 'Voir les études de cas' : 'See the case studies'}
            <Icon name="arrow-right" size={18} class="pilule-fleche" />
          </a>
        </div>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {c.intro.points.map((point, index) => (
            <li class="carte-verre grid content-start gap-3 p-6" data-reveal style={`--i:${index}`}>
              <span class="tuile tuile-pleine"><Icon name={point.icon} size={26} /></span>
              <h3 class="titre-carte text-white">{point.title}</h3>
              <p class="text-sur-encre-2">{point.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Le démarrage, sur le rail. -->
  <section class="section-blanc py-20 lg:py-32">
    <div class="container-custom">
      <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
        <h2 class="titre-moyen text-encre">{demarrage.titre}</h2>
        <p class="chapo">{demarrage.chapo}</p>
      </header>
      <RailMorphing lang={lang} stations={demarrage.stations} />
    </div>
  </section>

  <!-- Les avis, sur l'encre. -->
  <section class="section-encre section-monte py-20 lg:py-32">
    <div class="container-custom">
      <h2 class="titre-moyen mb-12 lg:mb-16">{c.testimonials.title}</h2>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-6">
        {c.testimonials.items.map((x, i) => (
          <figure class:list={['carte-verre m-0 flex flex-col gap-6 p-7 lg:p-9', { 'avis-premier': i === 0 }]} data-reveal style={`--i:${i}`}>
            <p class="text-yellow-300" aria-hidden="true">★★★★★</p>
            <blockquote class="text-lg leading-relaxed text-sur-encre">{fr ? `« ${x.quote} »` : `“${x.quote}”`}</blockquote>
            <figcaption class="mt-auto flex items-center gap-4 border-t border-white/10 pt-5">
              <img src={x.image} alt="" width="56" height="56" class="h-14 w-14 rounded-full object-cover" loading="lazy" decoding="async" />
              <span><b class="block text-white">{x.author}</b><span class="text-sm text-sur-encre-2">{x.role}, {x.company}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <TrustedBy lang={lang} variant="compact" />

  <FinalCTA lang={lang} color="primary" />
</PageLayout>

<style>
  .services {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-lien {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 28px 24px;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .service-lien:hover {
    transform: translateY(-2px);
  }
  .avis-premier {
    background:
      radial-gradient(90% 80% at 0% 0%, rgb(29 113 184 / 0.45), transparent 65%),
      rgb(255 255 255 / 0.06);
  }
  @media (min-width: 768px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .service-lien {
      padding: 32px;
    }
    .service-large {
      grid-column: span 2;
    }
    .service-pleine {
      grid-column: 1 / -1;
    }
  }
</style>
