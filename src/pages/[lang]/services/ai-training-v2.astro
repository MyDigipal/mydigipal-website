---
import { type Language, languages } from '@/i18n/config';

/**
 * `/{lang}/services/ai-training-v2` : l'adresse de travail de la refonte du 14/10/2026, gardée
 * vivante parce qu'elle a pu être partagée pendant la validation. La page vit à
 * `/{lang}/services/ai-training`. Renvoi côté client (même raison que `academy-v2.astro` : les
 * redirections de Render se saisissent dans son dashboard) ; le script garde le `#chiffrage&...`
 * d'un lien partagé, qu'une balise meta ne transmettrait pas.
 */
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const cible = `/${lang}/services/ai-training`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>Redirection</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={`https://mydigipal.com${cible}`} />
    <script is:inline define:vars={{ cible }}>
      window.location.replace(cible + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${cible}`} /></noscript>
  </head>
  <body>
    <p>Cette page a déménagé : <a href={cible}>{cible}</a></p>
  </body>
</html>
