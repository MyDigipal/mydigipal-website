---
import '@/styles/global.css';
import { languages, type Language } from '@/i18n/config';
import { t } from '@/i18n/utils';
import CookieConsent from '@/components/ui/CookieConsent.astro';

// GTM Configuration - All tracking (GA4, Meta Pixel, Hotjar) is managed via GTM
const GTM_ID = 'GTM-P4TSQ9Q';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Language;
  noindex?: boolean;
  canonicalURL?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: Date;
  articleModifiedTime?: Date;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
  /** La couleur de la barre du navigateur (mobile) : le fond de l'en-tête de
   *  la page. Blanc par défaut ; la salle de nuit sur les pages de l'Academy. */
  couleurNavigateur?: string;
}

const {
  title,
  description,
  image = '/images/Logos/MyDigipal Logo_Full Main - 1200x630.png',
  lang = 'en',
  noindex = false,
  canonicalURL,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  articleTags = [],
  couleurNavigateur = '#ffffff',
} = Astro.props;

const siteTitle = t(lang, 'site.name');
const siteDescription = t(lang, 'site.description');

const pageTitle = title ? `${title} | ${siteTitle}` : `${siteTitle} - ${t(lang, 'site.tagline')}`;
const pageDescription = description || siteDescription;

const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(en|fr)/, '');

// Generate alternate language links
const alternateLinks = Object.keys(languages).map((l) => ({
  lang: l,
  href: new URL(`/${l}${pathWithoutLang}`, Astro.site).href,
}));

const canonical = canonicalURL || Astro.url.href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Le droit au mouvement (29/09/2026). `html.mv` autorise l'état de départ des
         apparitions : sans cette classe, tout le contenu est visible. Elle n'est posée
         que si le script tourne et que le visiteur n'a pas demandé moins de mouvement,
         et elle se retire seule si le script des apparitions n'a pas démarré au bout de
         quatre secondes : un contenu ne reste jamais caché par une panne. -->
    <script is:inline>
      (function (d) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (/[?&]fige=1/.test(location.search)) return;
        d.classList.add('mv');
        setTimeout(function () { if (!d.dataset.mvPret) d.classList.remove('mv'); }, 4000);
      })(document.documentElement);
    </script>

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    {/* follow, pas nofollow : ces pages (404, remerciement apres formulaire) ne
        doivent pas etre indexees, mais leurs liens vers le reste du site doivent
        rester suivis. Un nofollow y coupe la transmission du maillage interne. */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Verification de propriete du domaine par Meta.
         Exigee par le Business Manager pour attribuer les conversions du pixel
         a ce domaine et pour configurer les evenements prioritaires iOS. Meta
         refuse la verification si la balise est hors du <head> ou injectee par
         JavaScript, d'ou sa place ici, dans le HTML rendu a la construction.
         Elle vaut aussi pour les sous-domaines, donc academy.mydigipal.com. -->
    <meta name="facebook-domain-verification" content="bqtbjyonkiyiinmbkpsg9jngsn0zrp" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Alternate Languages -->
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateLinks.find(l => l.lang === 'en')?.href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="MyDigipal" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime.toISOString()} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime.toISOString()} />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    {ogType === 'article' && articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Favicon : /favicon.ico (16, 32 et 48 px, tirés du PNG) pour les
         navigateurs et les robots qui le demandent à la racine. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/Logos/Favicon logo_256px.png" />
    <link rel="apple-touch-icon" href="/images/Logos/Favicon logo_256px.png" />
    <!-- La barre du navigateur prend le fond de l'en-tête : blanc, ou la salle
         de nuit de l'Academy. L'indigo d'avant venait de l'ancienne palette
         (retirée le 25/09/2026). -->
    <meta name="theme-color" content={couleurNavigateur} />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={lang === 'fr' ? 'Blog MyDigipal' : 'MyDigipal Blog'} href={`/${lang}/rss.xml`} />

    <!-- Structured Data: Organization + WebSite + LocalBusiness (Global) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://mydigipal.com/#organization",
          "name": "MyDigipal",
          "url": "https://mydigipal.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://mydigipal.com/images/Logos/Logo_Main_Horizontal.png",
            "width": 512,
            "height": 512
          },
          "description": lang === 'fr'
            ? "Agence de marketing digital B2B spécialisée en ABM, Paid Media, SEO et solutions IA"
            : "B2B Digital Marketing Agency specialized in ABM, Paid Media, SEO and AI Solutions",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "128 Rue de la Boétie",
            "addressLocality": "Paris",
            "postalCode": "75008",
            "addressCountry": "FR"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+33-1-86-65-54-40",
            "contactType": "sales",
            "availableLanguage": ["English", "French"]
          },
          "sameAs": [
            "https://www.linkedin.com/company/mydigipal",
            "https://twitter.com/mydigipal"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://mydigipal.com/#website",
          "url": "https://mydigipal.com",
          "name": "MyDigipal",
          "publisher": {
            "@id": "https://mydigipal.com/#organization"
          },
          "inLanguage": ["en", "fr"]
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://mydigipal.com/#localbusiness",
          "name": "MyDigipal",
          "image": "https://mydigipal.com/images/Logos/Logo_Main_Horizontal.png",
          "url": "https://mydigipal.com",
          "telephone": "+33-1-86-65-54-40",
          "email": "hello@mydigipal.com",
          "priceRange": "€€€",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "128 Rue de la Boétie",
            "addressLocality": "Paris",
            "addressRegion": "Île-de-France",
            "postalCode": "75008",
            "addressCountry": "FR"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 48.8738,
            "longitude": 2.3078
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
              "opens": "09:00",
              "closes": "18:00"
            }
          ],
          "sameAs": [
            "https://www.linkedin.com/company/mydigipal",
            "https://twitter.com/mydigipal"
          ]
        }
      ]
    })} />

    <!-- DNS Prefetch for external resources -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />

    <!-- Fonts: self-hosted woff2 (see @font-face in global.css). No external
         gstatic request = no render-blocking + no stale-URL 404. Preload the
         latin subset of each family (the above-the-fold critical glyphs). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jakarta-latin.woff2" crossorigin />

    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />

    <!-- Google Consent Mode V2 - MUST be before GTM -->
    <script is:inline>
      // Initialize dataLayer and gtag function globally
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){window.dataLayer.push(arguments);};

      // Check if user has explicitly refused cookies
      var hasRefused = false;
      try {
        var consentCookie = document.cookie.split('; ').find(function(c) {
          return c.startsWith('mydigipal_consent=');
        });
        if (consentCookie) {
          var consent = JSON.parse(decodeURIComponent(consentCookie.split('=')[1]));
          hasRefused = consent.refused === true;
        }
      } catch(e) {}

      // HYBRID APPROACH:
      // - Analytics: granted by default (legitimate interest), denied if refused
      // - Ads/Marketing: denied by default, only granted with explicit consent
      window.gtag('consent', 'default', {
        'analytics_storage': hasRefused ? 'denied' : 'granted',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'functionality_storage': 'granted',
        'security_storage': 'granted',
        'wait_for_update': 500
      });

      // Enable URL passthrough for better conversion modeling
      window.gtag('set', 'url_passthrough', true);

      // Enable ads data redaction when consent denied
      window.gtag('set', 'ads_data_redaction', true);
    </script>

    <!-- Google Tag Manager - Deferred loading for better LCP -->
    <script is:inline define:vars={{ GTM_ID }}>
      (function(w,d,l,i){
        w[l]=w[l]||[];
        w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
        function loadGTM(){
          if(w.gtmLoaded)return;
          w.gtmLoaded=true;
          var f=d.getElementsByTagName('script')[0],
          j=d.createElement('script');
          j.async=true;
          j.src='https://www.googletagmanager.com/gtm.js?id='+i;
          f.parentNode.insertBefore(j,f);
        }
        // Load GTM after page is interactive or on first interaction
        if('requestIdleCallback' in w){
          w.requestIdleCallback(loadGTM,{timeout:3000});
        }else{
          w.setTimeout(loadGTM,2000);
        }
        // Also load on any user interaction
        ['scroll','click','touchstart','keydown'].forEach(function(e){
          w.addEventListener(e,loadGTM,{once:true,passive:true});
        });
      })(window,document,'dataLayer',GTM_ID);
    </script>

    <!-- Additional head content -->
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col bg-white text-slate-900 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <slot />

    <!-- Top-of-page scroll progress bar (filled by initScrollProgress in scroll.ts) -->
    <div data-scroll-progress aria-hidden="true"><i></i></div>

    <!-- Scripts -->
    <script>
      // Store UTM params on page load
      import { storeUTMParams } from '@/lib/utils';
      storeUTMParams();

      // Design v2 scroll/interaction utilities (reveal, count-up, scroll progress,
      // magnetic pointer/button, sliding nav marker). Wired to astro:page-load so
      // they re-run after every View Transition.
      import { initAll } from '@/lib/scroll';

      // Intersection Observer for the legacy .animate-on-scroll / .stagger-children
      // pattern (kept for backwards compatibility - many existing components use it).
      const legacyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      const wireAll = () => {
        // Les apparitions sont branchées : `html.mv` peut rester (voir en tête de page).
        document.documentElement.dataset.mvPret = '1';
        initAll();
        document
          .querySelectorAll('.animate-on-scroll:not(.is-visible), .stagger-children:not(.is-visible)')
          .forEach((el) => legacyObserver.observe(el));
      };

      // Initial load
      wireAll();
      // Re-run after View Transitions
      document.addEventListener('astro:page-load', wireAll);
    </script>

    <!-- L'assistant du site : la bulle avec le visage de Paul, sur tout le site depuis le
         22/09/2026 (décision de Paul), pages de l'Academy comprises depuis le 02/10/2026,
         où il passe en mode Academy (un seul chat sur le site). Jamais dans /admin ni sur
         l'ancienne page de vente gardée pour comparaison. ?assistant=0 l'éteint pour la visite, ?assistant=1 le rallume.
         Paul, 22/09/2026 : sur tout le site, deux appels à l'action et pas un de plus,
         « Calculer mon budget » et son visage. Là où la bulle s'affiche, `data-assistant="on"`
         sur <html> décale le bouton collant du calculateur (StickyCalculatorCTA) juste à gauche
         de la bulle, sur la même ligne. Son code n'est chargé qu'après le premier affichage. -->
    <!-- D'où vient la visite, gardé pour toute la visite. Jusqu'au 23/09/2026 ce relevé
         n'existait que sur les pages Academy : le calculateur lisait donc une provenance
         toujours vide sur le reste du site, et le mail de lead ne disait jamais d'où
         venait la personne. Même clé et même règle que `academy/track.ts`, pour qu'il n'y
         ait qu'un seul endroit où cette information vit. -->
    <script>
      (() => {
        try {
          const q = new URLSearchParams(location.search);
          const vus = {};
          for (const k of ['gclid', 'fbclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'matchtype', 'device', 'network']) {
            const v = q.get(k);
            if (v) vus[k] = v.slice(0, 300);
          }
          // Une arrivée par une annonce remplace la précédente ; sans annonce, la première
          // page de la visite fait foi.
          if (!Object.keys(vus).length && sessionStorage.getItem('academy_provenance')) return;
          let referent;
          const r = document.referrer ? new URL(document.referrer) : null;
          if (r && r.hostname !== location.hostname) referent = r.origin;
          sessionStorage.setItem('academy_provenance', JSON.stringify({ ...vus, ...(referent ? { referrer: referent } : {}), landing: location.pathname }));
        } catch {
          /* stockage indisponible : on continue sans */
        }
      })();
    </script>

    <script>
      // La conversation « Une question ? » de l'Academy suit le visiteur (29/09/2026).
      // Paul : « si elle quitte la page et qu'elle revient sur le site normal, est-ce
      // que ça le suit ? ». Hors de la page de vente, pas de panneau : une petite
      // bulle en bas à gauche, seulement si une conversation où le visiteur a écrit
      // existe (cookie `mdp_conversation` du domaine, voir
      // `academy-v2/conversation-cookie.ts`). Elle dit « Paul vous a répondu » quand
      // une réponse attend, sinon « Reprendre la conversation », et ramène au panneau.
      // En bas à GAUCHE : le coin droit est celui de l'assistant du site.
      // ⚠️ UN SEUL PANNEAU PAR PAGE (29/09/2026) : là où l'assistant du site s'affiche, c'est
      // lui qui reprend la conversation (même cookie), et cette bulle ne se pose pas. Depuis
      // le 02/10/2026 l'assistant est aussi sur les pages de l'Academy : la bulle ne reste
      // que là où il est éteint (`?assistant=0`) ou absent (l'ancienne page de vente). Même
      // condition que le chargement de l'assistant, plus bas.
      (() => {
        const chemin = location.pathname;
        if (chemin.startsWith('/admin')) return;
        let assistantIci = !/^\/(fr|en)\/academy-v/.test(chemin);
        try {
          const q = new URLSearchParams(location.search).get('assistant');
          if (q === '0' || (q !== '1' && sessionStorage.getItem('mdp_assistant_off') === '1')) assistantIci = false;
        } catch {
          /* stockage indisponible : l'assistant s'affiche, donc lui reprend la conversation */
        }
        if (assistantIci) return;
        const cle = 'mdp_conversation=';
        const brut = document.cookie.split('; ').find((c) => c.startsWith(cle));
        if (!brut) return;
        const [id, jeton] = decodeURIComponent(brut.slice(cle.length)).split('.');
        if (!/^[A-Za-z0-9]{10,40}$/.test(id || '') || !/^[a-f0-9]{16,128}$/.test(jeton || '')) return;
        try {
          if (sessionStorage.getItem('mdp_reprise_masquee') === '1') return;
        } catch {
          /* stockage indisponible : la bulle se montre */
        }
        const en = /^\/en(\/|$)/.test(chemin) || (!/^\/fr(\/|$)/.test(chemin) && document.documentElement.lang.startsWith('en'));
        const url = `https://academy.mydigipal.com/api/academy/public/question/fil?id=${encodeURIComponent(id)}&jeton=${encodeURIComponent(jeton)}&presence=0`;
        fetch(url)
          .then((r) => {
            if (r.status === 404) {
              const domaine = location.hostname.endsWith('mydigipal.com') ? '; domain=.mydigipal.com' : '';
              document.cookie = `${cle}; Max-Age=0; path=/${domaine}; SameSite=Lax`;
              return null;
            }
            return r.ok ? r.json() : null;
          })
          .then((d) => {
            if (!d || !d.ecrit) return;
            const repondu = d.non_lus > 0;
            const texte = repondu
              ? en ? 'Paul has replied' : 'Paul vous a répondu'
              : en ? 'Resume the conversation' : 'Reprendre la conversation';
            const boite = document.createElement('div');
            boite.id = 'mdp-reprise';
            boite.setAttribute('role', 'status');
            boite.style.cssText =
              'position:fixed;left:16px;bottom:16px;z-index:44;display:flex;align-items:center;gap:4px;padding:6px 4px 6px 6px;border-radius:999px;background:#141d33;border:1px solid #c8a951;box-shadow:0 10px 30px -8px rgba(4,8,18,.6);font:500 14px/1.3 system-ui,sans-serif;max-width:calc(100vw - 32px)';
            const lien = document.createElement('a');
            lien.href = `/${en ? 'en' : 'fr'}/academy#une-question`;
            lien.style.cssText = 'display:flex;align-items:center;gap:8px;min-height:44px;padding-right:6px;color:#f2eee4;text-decoration:none';
            const photo = document.createElement('img');
            photo.src = '/images/team/Team_Paul_Andre.webp';
            photo.alt = '';
            photo.width = 36;
            photo.height = 36;
            photo.style.cssText = 'width:36px;height:36px;border-radius:999px;object-fit:cover;flex:none';
            const mot = document.createElement('span');
            mot.textContent = texte;
            lien.append(photo, mot);
            if (repondu) {
              const point = document.createElement('span');
              point.setAttribute('aria-hidden', 'true');
              point.style.cssText = 'width:9px;height:9px;border-radius:999px;background:#c8a951;flex:none';
              lien.append(point);
            }
            const fermer = document.createElement('button');
            fermer.type = 'button';
            fermer.setAttribute('aria-label', en ? 'Hide' : 'Masquer');
            fermer.textContent = '×';
            fermer.style.cssText =
              'width:36px;height:36px;border:0;border-radius:999px;background:none;color:#8d97aa;font-size:18px;line-height:1;cursor:pointer;flex:none';
            fermer.addEventListener('click', () => {
              boite.remove();
              try {
                sessionStorage.setItem('mdp_reprise_masquee', '1');
              } catch {
                /* rien à garder */
              }
            });
            boite.append(lien, fermer);
            document.body.append(boite);
            // Le bandeau cookies occupe le bas de l'écran tant qu'il est affiché.
            const bandeau = document.getElementById('cookie-consent-banner');
            // L'état du bandeau (sa classe) et sa hauteur, pas sa position en cours de glissement.
            const placer = () => {
              const h = bandeau?.classList.contains('translate-y-0') ? Math.round(bandeau.getBoundingClientRect().height) : 0;
              boite.style.bottom = `${h + 16}px`;
            };
            placer();
            if (bandeau) new MutationObserver(placer).observe(bandeau, { attributes: true, attributeFilter: ['class', 'style'] });
          })
          .catch(() => undefined);
      })();
    </script>

    <script>
      const cheminPage = location.pathname;
      const exclue = /^\/(fr|en)\/academy-v/.test(cheminPage) || cheminPage.startsWith('/admin');
      const calculateur = /^\/(fr|en)\/calculator\/?$/.test(cheminPage);
      let actif = true;
      try {
        const q = new URLSearchParams(location.search).get('assistant');
        if (q === '0') sessionStorage.setItem('mdp_assistant_off', '1');
        if (q === '1') sessionStorage.removeItem('mdp_assistant_off');
        actif = sessionStorage.getItem('mdp_assistant_off') !== '1';
      } catch {
        /* stockage indisponible : l'assistant reste affiché */
      }
      if (actif && !exclue) {
        document.documentElement.dataset.assistant = 'on';
        const charger = () => import('@/components/site-assistant/mount').then((m) => m.monter());
        if (calculateur) charger();
        else if ('requestIdleCallback' in window) window.requestIdleCallback(charger, { timeout: 2500 });
        else setTimeout(charger, 1200);
      }
    </script>

    <!-- Analytics slot -->
    <slot name="analytics" />

    <!-- Form start + field focus + abandon tracking (GTM funnel) -->
    <script is:inline>
      (function() {
        var formsStarted = new WeakSet();
        var formFieldsTouched = new WeakMap();

        function pushEvent(name, payload) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: name }, payload || {}));
        }

        // Fire form_start on first focus of any input/select/textarea inside a <form>
        document.addEventListener('focusin', function(e) {
          var field = e.target;
          if (!field.matches || !field.matches('input, select, textarea')) return;
          var form = field.closest('form');
          if (!form) return;
          var formId = form.id || form.getAttribute('name') || 'unknown';

          // form_field_focus per field (max once per field per session)
          var touched = formFieldsTouched.get(form) || new Set();
          var fieldKey = field.name || field.id || field.type;
          if (!touched.has(fieldKey)) {
            touched.add(fieldKey);
            formFieldsTouched.set(form, touched);
            pushEvent('form_field_focus', { form_id: formId, field_name: fieldKey });
          }

          // form_start: first focus of any field
          if (!formsStarted.has(form)) {
            formsStarted.add(form);
            pushEvent('form_start', { form_id: formId });
          }
        });

        // form_abandon: page hidden after at least 1 field touched but no submit
        document.addEventListener('visibilitychange', function() {
          if (document.visibilityState !== 'hidden') return;
          document.querySelectorAll('form').forEach(function(form) {
            if (formsStarted.has(form) && !form.dataset.submitted) {
              var formId = form.id || form.getAttribute('name') || 'unknown';
              var fieldsTouched = (formFieldsTouched.get(form) || new Set()).size;
              pushEvent('form_abandon', { form_id: formId, fields_touched: fieldsTouched });
            }
          });
        }, { once: false });

        // Mark submitted forms so we don't fire abandon after success
        document.addEventListener('submit', function(e) {
          var form = e.target;
          if (form && form.tagName === 'FORM') form.dataset.submitted = 'true';
        }, true);
      })();
    </script>

    <!-- Phone and Email Click Tracking -->
    <script is:inline>
      (function() {
        document.addEventListener('click', function(e) {
          const link = e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
          if (!link) return;

          const href = link.getAttribute('href');
          const isPhone = href.startsWith('tel:');
          const isEmail = href.startsWith('mailto:');

          if (window.dataLayer) {
            if (isPhone) {
              window.dataLayer.push({
                'event': 'phone_click',
                'click_url': href,
                'click_text': link.textContent?.trim() || href
              });
            } else if (isEmail) {
              window.dataLayer.push({
                'event': 'email_click',
                'click_url': href,
                'click_text': link.textContent?.trim() || href
              });
            }
          }
        });
      })();
    </script>

    <!-- Cookie Consent Banner -->
    <CookieConsent lang={lang} />
  </body>
</html>
