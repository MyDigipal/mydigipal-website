---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import VideoEmbed from '@/components/ui/VideoEmbed.astro';
import CarteVerre from '@/components/motion/CarteVerre.astro';
import { carteLlmo } from '@/components/motion/donnees-seo';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  en: {
    badge: 'NEW — LLMO',
    title: 'AI search optimization',
    subtitle: 'Be visible where your competitors aren\'t: on ChatGPT, Perplexity, Gemini & Copilot',
    definition: 'LLMO (Large Language Model Optimization) is the practice of optimizing your content to be cited by AI assistants. Unlike traditional SEO which targets search engine crawlers, LLMO targets the language models that power AI-driven search.',
    comparisonTitle: 'SEO vs LLMO: what\'s the difference?',
    seoLabel: 'Traditional SEO',
    llmoLabel: 'LLMO',
    comparison: [
      { seo: 'Targets Google crawlers', llmo: 'Targets AI language models' },
      { seo: 'Optimizes for keywords', llmo: 'Optimizes for citability' },
      { seo: 'Focuses on backlinks', llmo: 'Focuses on structured data' },
      { seo: 'Results in SERP rankings', llmo: 'Results in AI citations' },
      { seo: 'Measures clicks & traffic', llmo: 'Measures mentions & references' },
    ],
    services: [
      {
        icon: 'search',
        title: 'LLMO audit',
        description: 'We analyze how AI assistants currently perceive and cite your brand. Benchmark your citability score against competitors.',
      },
      {
        icon: 'code',
        title: 'Schema markup',
        description: 'Advanced Schema.org implementation (FAQPage, HowTo, SpeakableSpecification) so AI models understand your content structure.',
      },
      {
        icon: 'file-text',
        title: 'Citable content',
        description: 'Content formatted for AI extraction: clear definitions, factual data, structured comparisons, and authoritative statements.',
      },
      {
        icon: 'globe',
        title: 'Multi-source presence',
        description: 'Ensure your brand appears across Wikipedia, industry directories, and knowledge bases that LLMs use as training sources.',
      },
    ],
    cta: 'Check your LLMO visibility',
    ctaHref: '/en/contact',
    stat1Value: '40%',
    stat1Label: 'of searches will involve AI by 2026',
    stat2Value: '0%',
    stat2Label: 'of your competitors optimize for LLMO',
  },
  fr: {
    badge: 'Nouveau : le LLMO',
    title: 'Optimisation Recherche IA',
    subtitle: 'Soyez visible là où vos concurrents ne sont pas : sur ChatGPT, Perplexity, Gemini & Copilot',
    definition: 'Le LLMO (Large Language Model Optimization) est la pratique d\'optimiser votre contenu pour être cité par les assistants IA. Contrairement au SEO traditionnel qui cible les crawlers, le LLMO cible les modèles de langage qui alimentent la recherche IA.',
    comparisonTitle: 'SEO vs LLMO : quelle différence ?',
    seoLabel: 'SEO Traditionnel',
    llmoLabel: 'LLMO',
    comparison: [
      { seo: 'Cible les crawlers Google', llmo: 'Cible les modèles de langage IA' },
      { seo: 'Optimise pour les mots-clés', llmo: 'Optimise pour la citabilité' },
      { seo: 'Focus sur les backlinks', llmo: 'Focus sur les données structurées' },
      { seo: 'Résultat : classement SERP', llmo: 'Résultat : citations IA' },
      { seo: 'Mesure clics & trafic', llmo: 'Mesure mentions & références' },
    ],
    services: [
      {
        icon: 'search',
        title: 'Audit LLMO',
        description: 'Nous analysons comment les assistants IA perçoivent et citent votre marque. Benchmark de votre score de citabilité face aux concurrents.',
      },
      {
        icon: 'code',
        title: 'Balisage Schema',
        description: 'Implémentation avancée Schema.org (FAQPage, HowTo, SpeakableSpecification) pour que les modèles IA comprennent la structure de votre contenu.',
      },
      {
        icon: 'file-text',
        title: 'Contenu Citable',
        description: 'Contenu formaté pour l\'extraction IA : définitions claires, données factuelles, comparaisons structurées et affirmations autoritaires.',
      },
      {
        icon: 'globe',
        title: 'Présence multi-sources',
        description: 'Assurez la présence de votre marque sur Wikipedia, annuaires sectoriels et bases de connaissances utilisées par les LLMs comme sources d\'entraînement.',
      },
    ],
    cta: 'Vérifier ma visibilité LLMO',
    ctaHref: '/fr/contact',
    stat1Value: '40%',
    stat1Label: 'des recherches impliqueront l\'IA d\'ici 2026',
    stat2Value: '0%',
    stat2Label: 'de vos concurrents optimisent pour le LLMO',
  },
};

const t = content[lang];
const carte = carteLlmo(lang);

---

<!-- SEO, phase 3 : le LLMO (direction Encre, 30/09/2026). La carte de verre explique la
     notion : ce qu'un assistant IA lit, ce qu'il cite, ce qu'il laisse de côté. Puis la
     différence avec le SEO, la vidéo de l'architecture, les quatre chantiers. -->
<section class="section-encre section-monte py-20 lg:py-32" id="llmo">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[900px] gap-5 lg:mb-16 lg:gap-6">
      <h2 id="llmo-titre" class="titre-moyen">{t.title}</h2>
      <p class="text-lg font-semibold text-sur-encre sm:text-xl">{t.subtitle}</p>
      <p class="chapo">{t.definition}</p>
    </header>

    <CarteVerre lang={lang} titreId="llmo-titre" {...carte} />

    <div class="mt-16 grid grid-cols-1 gap-6 lg:mt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-10">
      <div class="carte-verre p-6 lg:p-8" data-reveal>
        <h3 class="titre-carte mb-6 text-white">{t.comparisonTitle}</h3>
        <div class="grid grid-cols-2 gap-x-4 border-b border-white/10 pb-3 text-sm font-semibold">
          <span class="text-sur-encre-2">{t.seoLabel}</span>
          <span class="text-marque-clair">{t.llmoLabel}</span>
        </div>
        <ul>
          {t.comparison.map((row) => (
            <li class="grid grid-cols-2 gap-x-4 border-b border-white/10 py-3 last:border-b-0">
              <span class="text-sur-encre-2">{row.seo}</span>
              <span class="font-semibold text-white">{row.llmo}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="overflow-hidden rounded-[20px] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12),var(--ombre-forte)]" data-reveal style="--i:1">
        <VideoEmbed
          src="/videos/seo/SEOArchitecture.mp4"
            poster="/videos/seo/SEOArchitecture.jpg"
          title={lang === 'fr' ? 'Architecture SEO : comment nous structurons votre site' : 'SEO architecture: how we structure your site for AI and search engines'}
          description={lang === 'fr' ? "Voir l'architecture technique" : 'See the technical architecture'}
          schemaName="SEO Architecture by MyDigipal"
          schemaDescription="How MyDigipal structures websites for maximum visibility on search engines and AI platforms"
          schemaUploadDate="2026-02-10"
        />
      </div>
    </div>

    <ul class="mt-16 grid grid-cols-1 gap-4 md:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-5">
      {t.services.map((service, index) => (
        <li class="carte-verre grid content-start gap-3 p-6" data-reveal style={`--i:${index}`}>
          <span class="tuile tuile-pleine"><Icon name={service.icon} size={26} /></span>
          <h3 class="titre-carte text-white">{service.title}</h3>
          <p class="text-sur-encre-2">{service.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid grid-cols-1 gap-8 border-t border-white/10 pt-10 lg:grid-cols-[auto_auto_minmax(0,1fr)] lg:items-center lg:gap-12">
      {[[t.stat1Value, t.stat1Label], [t.stat2Value, t.stat2Label]].map(([v, l]) => (
        <p class="grid max-w-[260px] gap-1">
          <span class="font-display text-5xl font-extrabold tracking-[-0.04em] text-white">{v}</span>
          <span class="text-sur-encre-2">{l}</span>
        </p>
      ))}
      <a href={t.ctaHref} class="pilule pilule-blanche lg:justify-self-end">
        {t.cta}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
    </div>
  </div>
</section>
