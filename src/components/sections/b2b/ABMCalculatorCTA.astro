---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Free Tool",
    headline: "Estimate your marketing budget",
    subtitle: "Use our calculator to get a personalized estimate of your monthly marketing investment based on your goals and industry.",
    features: [
      "Get budget recommendations by channel",
      "Tailored to your industry & goals",
      "Takes only 2 minutes"
    ],
    cta: "Try the calculator",
    free: "100% Free"
  },
  fr: {
    badge: "Outil Gratuit",
    headline: "Estimez votre budget marketing",
    subtitle: "Utilisez notre calculateur pour obtenir une estimation personnalisée de votre investissement marketing mensuel basée sur vos objectifs et votre industrie.",
    features: [
      "Recommandations budget par canal",
      "Adapté à votre industrie & objectifs",
      "Seulement 2 minutes"
    ],
    cta: "Essayer le calculateur",
    free: "100% Gratuit"
  }
};

const t = translations[lang] || translations.en;

// L'esquisse du calculateur : ses champs, sans aucun montant.
const m = lang === 'fr'
  ? { titre: 'Calculateur MyDigipal', services: 'Vos services', email: 'E-mailing', budget: 'Budget publicitaire mensuel', niveau: 'Accompagnement', niveaux: ['Essentiel', 'Avancé', 'Premium'], resultat: 'Votre prix, calculé en direct' }
  : { titre: 'MyDigipal calculator', services: 'Your services', email: 'Email marketing', budget: 'Monthly ad budget', niveau: 'Level of support', niveaux: ['Essential', 'Advanced', 'Premium'], resultat: 'Your price, calculated live' };

---

<!-- B2B, estimer son budget (direction Encre, 30/09/2026) : un panneau d'encre sur la brume, le
     calculateur esquissé à droite (les champs qu'on y trouve, aucun montant inventé). -->
<section class="section-brume py-16 lg:py-24">
  <div class="container-custom">
    <div class="carte-encre grid grid-cols-1 items-center gap-10 p-7 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14 lg:p-12">
      <div class="grid content-start gap-5">
        <h2 class="titre-moyen text-white">{t.headline}</h2>
        <p class="text-lg text-sur-encre">{t.subtitle}</p>
        <ul class="grid gap-3">
          {t.features.map((f) => (
            <li class="grid grid-cols-[24px_minmax(0,1fr)] items-center gap-3 text-sur-encre">
              <span class="grid h-6 w-6 place-items-center rounded-full bg-white/15 text-white"><Icon name="check" size={14} /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
          <a href={`/${lang}/calculator`} class="pilule pilule-blanche">
            <Icon name="calculator" size={18} />
            {t.cta}
          </a>
          <span class="text-sur-encre-2">{t.free}</span>
        </div>
      </div>
      <div class="esquisse" aria-hidden="true">
        <p class="flex items-center gap-3 font-semibold text-encre">
          <span class="tuile h-10 w-10 rounded-xl"><Icon name="calculator" size={20} /></span>
          {m.titre}
        </p>
        <p class="esquisse-libelle">{m.services}</p>
        <p class="flex flex-wrap gap-2">
          {['LinkedIn Ads', 'Google Ads', m.email].map((x, i) => (
            <span class:list={['esquisse-choix', { 'esquisse-choisi': i < 2 }]}>{x}</span>
          ))}
        </p>
        <p class="esquisse-libelle">{m.budget}</p>
        <span class="esquisse-curseur"><span></span></span>
        <p class="esquisse-libelle">{m.niveau}</p>
        <p class="grid grid-cols-3 gap-1 rounded-xl bg-brume-clair p-1 text-center text-sm">
          {m.niveaux.map((x, i) => <span class:list={['rounded-lg py-2', i === 1 ? 'bg-white font-semibold text-encre shadow-sm' : 'text-slate-500']}>{x}</span>)}
        </p>
        <p class="mt-2 rounded-xl bg-marque-doux px-4 py-3 font-semibold text-marque">{m.resultat}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .esquisse {
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 30px 60px -30px rgb(2 9 16 / 0.8);
    transform: rotate(1.5deg);
  }
  .esquisse-libelle {
    margin-top: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #5b6b7b;
  }
  .esquisse-choix {
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--brume);
    color: #4b5b6b;
    font-size: 0.875rem;
  }
  .esquisse-choisi {
    background: var(--color-marque);
    color: #fff;
  }
  .esquisse-curseur {
    position: relative;
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--filet);
  }
  .esquisse-curseur span {
    position: absolute;
    inset: 0 42% 0 0;
    border-radius: inherit;
    background: var(--color-marque);
  }
  .esquisse-curseur span::after {
    content: '';
    position: absolute;
    right: -9px;
    top: -6px;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 2px var(--color-marque);
  }
</style>
