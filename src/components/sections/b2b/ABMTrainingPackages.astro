const t = translations[lang] || translations.en;

const iconeDe: Record<string, string> = { 'dollar-sign': 'trending-down' };

---

<!-- B2B, la formation ABM (direction Encre, 30/09/2026) : trois formules, l'atelier recommandé
     en encre et plus large ; le programme en trois sessions ; quatre engagements en tuiles.
     Les prix sont ceux de l'offre. -->
<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <div class="formules">
      {t.packages.map((p, i) => {
        const fonce = p.highlighted;
        return (
          <article class:list={['formule', fonce ? 'carte-encre formule-vedette' : 'carte']} data-reveal style={`--i:${i}`}>
            <div class="flex items-start justify-between gap-3">
              <p class:list={['text-sm font-semibold', fonce ? 'text-marque-clair' : 'text-slate-500']}>{p.duration}</p>
              {fonce && <span class="rounded-full bg-marque px-3 py-1 text-sm font-semibold text-white">{lang === 'fr' ? 'Recommandé' : 'Recommended'}</span>}
            </div>
            <h3 class:list={['font-display text-3xl font-extrabold tracking-[-0.03em]', fonce ? 'text-white' : 'text-encre']}>{p.name}</h3>
            <p class:list={['font-display text-2xl font-extrabold', fonce ? 'text-white' : 'text-marque']}>{p.price}</p>
            <p class={fonce ? 'text-sur-encre-2' : 'text-slate-600'}>{p.description}</p>
            <ul class="grid gap-2">
              {p.features.map((x) => (
                <li class:list={['grid grid-cols-[18px_minmax(0,1fr)] gap-2', fonce ? 'text-sur-encre' : 'text-slate-700']}>
                  <Icon name="check" size={16} class={fonce ? 'mt-1 text-marque-clair' : 'mt-1 text-marque'} />
                  <span>{x}</span>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    <h3 class="titre-moyen mb-8 mt-20 text-encre lg:mt-28">{t.sessionsTitle}</h3>
    <ol class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-5">
      {t.sessions.map((s) => (
        <li class="rounded-[20px] bg-brume-clair p-6">
          <span class="mb-4 grid h-11 w-11 place-items-center rounded-full bg-marque font-display font-extrabold text-white">{s.number.replace(/^0/, '')}</span>
          <p class="titre-carte mb-3 text-encre">{s.title}</p>
          <ul class="puces livrables">{s.topics.map((x) => <li>{x}</li>)}</ul>
        </li>
      ))}
    </ol>

    <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {t.benefits.map((b) => (
        <li class="grid grid-cols-[56px_minmax(0,1fr)] items-center gap-4">
          <span class="tuile"><Icon name={iconeDe[b.icon] ?? b.icon} size={24} /></span>
          <span><b class="block text-encre">{b.title}</b><span class="text-slate-600">{b.description}</span></span>
        </li>
      ))}
    </ul>

    <div class="mt-12">
      <a href={`/${lang}/contact`} class="pilule pilule-pleine">
        {t.cta}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
    </div>
  </div>
</section>

<style>
  .formules {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .formule {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 24px;
  }
  .livrables > li {
    background: #fff;
  }
  @media (min-width: 1024px) {
    .formules {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 20px;
    }
    .formule {
      padding: 32px;
    }
    .formule-vedette {
      margin-block: -16px;
      padding: 44px 36px;
    }
  }
</style>
