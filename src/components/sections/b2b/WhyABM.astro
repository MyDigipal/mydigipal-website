---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import CarteVerre from '@/components/motion/CarteVerre.astro';
import { carteAbm } from '@/components/motion/donnees-abm';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "What is ABM?",
    headline: "Account-Based Marketing explained",
    intro: "Account-Based Marketing is not a tool, and it's not display ads: ABM is a collaborative strategy to focus on quality & precision, over quantity and noise.",
    paragraph: "Traditional methods aren't working as much anymore. Rules are getting stricter (GDPR), competition is fiercer, and buyers are more informed. A new approach was needed.",
    deckCTA: "Read our ABM deck",
    points: [
      {
        icon: "target",
        title: "Hyper-targeted",
        description: "Focus your efforts on high-value accounts that matter most to your business"
      },
      {
        icon: "users",
        title: "Sales & marketing alignment",
        description: "Bridge the gap between teams with a unified approach to revenue generation"
      },
      {
        icon: "trending-up",
        title: "Higher ROI",
        description: "ABM delivers 97% higher ROI than other marketing strategies according to ITSMA"
      },
      {
        icon: "zap",
        title: "Personalized engagement",
        description: "Craft tailored messages that resonate with specific decision-makers"
      }
    ]
  },
  fr: {
    badge: "Qu'est-ce que l'ABM ?",
    headline: "L'Account-Based Marketing expliqué",
    intro: "L'Account-Based Marketing n'est pas une solution, ce n'est pas du Display : l'ABM est une stratégie collaborative axée sur la qualité et la précision, plutôt que la quantité et le bruit.",
    paragraph: "Les méthodes traditionnelles ne fonctionnent plus autant. Les règles se durcissent (RGPD), la concurrence est plus féroce, et les acheteurs sont mieux informés. Une nouvelle ère devait naître.",
    deckCTA: "Lire notre ABM deck",
    points: [
      {
        icon: "target",
        title: "Hyper-ciblé",
        description: "Concentrez vos efforts sur les comptes à forte valeur qui comptent le plus"
      },
      {
        icon: "users",
        title: "Alignement sales & marketing",
        description: "Comblez le fossé entre les équipes avec une approche unifiée de génération de revenus"
      },
      {
        icon: "trending-up",
        title: "ROI supérieur",
        description: "L'ABM génère un ROI 97% supérieur aux autres stratégies marketing selon ITSMA"
      },
      {
        icon: "zap",
        title: "Engagement personnalisé",
        description: "Créez des messages sur-mesure qui résonnent avec les décideurs spécifiques"
      }
    ]
  }
};

const t = translations[lang] || translations.en;
const carte = carteAbm(lang);

---

<!-- B2B, l'ABM expliqué (direction Encre, modèle AI Training, 30/09/2026) : la carte de verre
     montre la notion (des comptes choisis, chaque canal parle aux mêmes décideurs, c'est
     l'engagement du compte qui revient), puis quatre raisons en cartes de verre. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[900px] gap-5 lg:mb-16 lg:gap-6">
      <h2 id="abm-titre" class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.intro}</p>
      <p class="text-sur-encre-2">{t.paragraph}</p>
    </header>
    <CarteVerre lang={lang} titreId="abm-titre" {...carte} />
    <ul class="mt-16 grid grid-cols-1 gap-4 md:grid-cols-2 lg:mt-24 lg:grid-cols-4 lg:gap-5">
      {t.points.map((p, i) => (
        <li class="carte-verre grid content-start gap-3 p-6" data-reveal style={`--i:${i}`}>
          <span class="tuile tuile-pleine"><Icon name={p.icon} size={26} /></span>
          <h3 class="titre-carte text-white">{p.title}</h3>
          <p class="text-sur-encre-2">{p.description}</p>
        </li>
      ))}
    </ul>
    <div class="mt-12">
      <a href={`/${lang}/blog/abm-deck`} class="pilule pilule-blanche">
        {t.deckCTA}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
    </div>
  </div>
</section>
