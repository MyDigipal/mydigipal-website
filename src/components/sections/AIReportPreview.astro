---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "AI-Powered Insights",
    headline: "Reports that talk back",
    subtitle: "Our AI analytics don't just show data; they explain it, spot anomalies, and recommend actions.",
    chatExample: {
      aiMessage: "I've analyzed your December performance. Want me to dive deeper into this report?",
      userMessage: "Why did conversions drop last week?",
      aiResponse: "Good question! Last week's conversion drop (-23%) correlates with your landing page changes on Dec 15. The new page has 40% slower load time on mobile. I recommend reverting the header image optimization.",
      suggestion: "Would you like me to create a test variant to validate this hypothesis?"
    },
    features: [
      "Natural language queries",
      "Anomaly detection",
      "Automated recommendations",
      "Trend predictions"
    ],
    reportMetrics: [
      { label: "Sessions", value: "45,234", change: "+12%" },
      { label: "Conversions", value: "1,847", change: "-8%" },
      { label: "Revenue", value: "€127,350", change: "+5%" },
      { label: "ROAS", value: "4.2x", change: "+15%" },
    ]
  },
  fr: {
    badge: "Insights alimentés par l'IA",
    headline: "Des rapports qui vous répondent",
    subtitle: "Nos analytics IA ne montrent pas juste des données - ils les expliquent, détectent les anomalies et recommandent des actions.",
    chatExample: {
      aiMessage: "J'ai analysé votre performance de décembre. Voulez-vous que j'approfondisse ce rapport ?",
      userMessage: "Pourquoi les conversions ont baissé la semaine dernière ?",
      aiResponse: "Bonne question ! La baisse des conversions la semaine dernière (-23%) corrèle avec vos changements de landing page le 15 décembre. La nouvelle page a un temps de chargement 40% plus lent sur mobile. Je recommande de revenir sur l'optimisation de l'image header.",
      suggestion: "Souhaitez-vous que je crée une variante de test pour valider cette hypothèse ?"
    },
    features: [
      "Requêtes en langage naturel",
      "Détection d'anomalies",
      "Recommandations automatiques",
      "Prédictions de tendances"
    ],
    reportMetrics: [
      { label: "Sessions", value: "45 234", change: "+12%" },
      { label: "Conversions", value: "1 847", change: "-8%" },
      { label: "Revenu", value: "127 350€", change: "+5%" },
      { label: "ROAS", value: "4.2x", change: "+15%" },
    ]
  }
};

const t = translations[lang] || translations.en;
---

<!-- Tracking, les rapports qui répondent (direction Encre, 30/09/2026) : un rapport d'exemple
     et la conversation avec l'assistant, sur l'encre. Les chiffres du rapport sont ceux
     d'un exemple, annoncé comme tel. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <div class="grid content-start gap-6">
      <h2 class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {t.features.map((f, i) => (
          <li class="carte-verre grid grid-cols-[44px_minmax(0,1fr)] items-center gap-3 p-3">
            <span class="tuile tuile-pleine h-11 w-11 rounded-xl"><Icon name={['message-circle', 'alert-triangle', 'sparkles', 'trending-up'][i] ?? 'check'} size={20} /></span>
            <span class="font-semibold text-white">{f}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="grid gap-4" aria-hidden="true">
      <div class="carte p-6">
        <div class="mb-5 flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-slate-500">{lang === 'fr' ? 'Exemple' : 'Example'}</p>
            <p class="text-lg font-bold text-encre">{lang === 'fr' ? 'Bilan de décembre' : 'December report'}</p>
          </div>
          <span class="tuile h-11 w-11 rounded-xl"><Icon name="bar-chart" size={20} /></span>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {t.reportMetrics.map((m) => (
            <div class="rounded-xl bg-brume-clair p-3">
              <p class="text-sm text-slate-500">{m.label}</p>
              <p class="flex items-baseline gap-2">
                <span class="text-xl font-bold text-encre">{m.value}</span>
                <span class={`text-xs font-semibold ${m.change.startsWith('+') ? 'text-green-600' : 'text-red-600'}`}>{m.change}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="carte-verre grid gap-3 p-5 lg:ml-10">
        <p class="grid grid-cols-[32px_minmax(0,1fr)] gap-3">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-marque text-white"><Icon name="cpu" size={16} /></span>
          <span class="rounded-xl rounded-tl-none bg-white/10 p-3 text-sm text-white">{t.chatExample.aiMessage}</span>
        </p>
        <p class="ml-10 justify-self-end rounded-xl rounded-tr-none bg-white p-3 text-sm text-encre">{t.chatExample.userMessage}</p>
        <p class="grid grid-cols-[32px_minmax(0,1fr)] gap-3">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-marque text-white"><Icon name="cpu" size={16} /></span>
          <span class="rounded-xl rounded-tl-none bg-white/10 p-3 text-sm text-white">
            {t.chatExample.aiResponse}
            <span class="mt-2 block italic text-marque-clair">{t.chatExample.suggestion}</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>
