---
/**
 * Les logos de clients, direction Encre (30/09/2026) : une bande claire entre deux
 * filets, les logos immobiles et en gris (`BandeauLogos`). Plus de défilé infini, plus
 * d'onglets par secteur, plus de compteur « 50+ » sans source.
 *
 * `variant` et `showCount` restent acceptés pour ne pas toucher aux pages ; les
 * variantes `default` et `featured` n'étaient plus rendues nulle part.
 */
import type { Language } from '@/i18n/config';
import BandeauLogos from '@/components/ui/BandeauLogos.astro';

interface Props {
  lang: Language;
  variant?: 'default' | 'compact' | 'featured';
  showCount?: boolean;
  /** Les logos à montrer (noms de `src/data/accueil/logos.json`) ; par défaut, les clients de l'agence. */
  slugs?: string[];
  /** Le libellé à gauche des logos ; par défaut, les campagnes. */
  titre?: string;
}

const { lang, variant, showCount, slugs, titre: titrePage } = Astro.props;
void variant;
void showCount;

const titre = titrePage ?? (lang === 'fr' ? 'Ils nous confient leurs campagnes' : 'They trust us with their campaigns');
---

<section class="trusted-by section-blanc border-y border-slate-200 py-10 lg:py-12">
  <BandeauLogos titre={titre} slugs={slugs} />
</section>
