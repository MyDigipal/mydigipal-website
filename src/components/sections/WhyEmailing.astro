---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import TableauPalettes from '@/components/motion/TableauPalettes.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "The Email Renaissance",
    headline: "Email Marketing is Back",
    subheadline: "And It's More Powerful Than Ever",
    description: "While social media and new channels grab headlines, email remains the undisputed champion of digital marketing ROI. In 2026, email marketing powered by AI is more effective than ever.",
    stats: [
      { value: "$36-40", label: "ROI per $1 spent", detail: "Highest of any marketing channel" },
      { value: "4.6B", label: "Email users worldwide", detail: "Growing by 600M in 5 years" },
      { value: "41%", label: "Marketers' #1 choice", detail: "Ahead of social (16%) and paid search (16%)" },
      { value: "40x", label: "More effective", detail: "Than social media for customer acquisition" }
    ],
    warning: {
      title: "But Generic Emails Don't Work Anymore",
      description: "With inboxes overflowing, only personalized, relevant messages cut through the noise. 99% of users check email daily, but they won't open generic content."
    },
    solution: {
      title: "The Solution: AI-Powered Personalization",
      points: [
        "122% higher ROI with personalized campaigns",
        "760% revenue increase with audience segmentation",
        "95% of marketers rate AI email creation as 'effective'",
        "89% of email operations are now AI-driven"
      ]
    }
  },
  fr: {
    badge: "La renaissance de l'email",
    headline: "L'email marketing est de retour",
    subheadline: "Et plus puissant que jamais",
    description: "Alors que les réseaux sociaux font les gros titres, l'email reste le champion incontesté du ROI marketing digital. En 2026, l'email marketing propulsé par l'IA est plus efficace que jamais.",
    stats: [
      { value: "36-40€", label: "ROI par euro dépensé", detail: "Le plus élevé de tous les canaux" },
      { value: "4,6Mds", label: "Utilisateurs email dans le monde", detail: "Croissance de 600M en 5 ans" },
      { value: "41%", label: "Choix #1 des marketeurs", detail: "Devant social (16%) et paid search (16%)" },
      { value: "40x", label: "Plus efficace", detail: "Que les réseaux sociaux pour l'acquisition" }
    ],
    warning: {
      title: "Mais les emails génériques ne fonctionnent plus",
      description: "Avec des boîtes mail saturées, seuls les messages personnalisés et pertinents se démarquent. 99% des utilisateurs consultent leur email quotidiennement, mais n'ouvrent pas le contenu générique."
    },
    solution: {
      title: "La solution : personnalisation par l'IA",
      points: [
        "122% de ROI supérieur avec les campagnes personnalisées",
        "760% d'augmentation des revenus avec la segmentation",
        "95% des marketeurs jugent la création email IA 'efficace'",
        "89% des opérations email sont désormais pilotées par l'IA"
      ]
    }
  }
};

const t = translations[lang] || translations.en;

// Trois chiffres au tableau à palettes, le quatrième écrit à côté. « 36-40€ » devient le
// chiffre « 36-40 » et l'unité « € ».
const coupe = (v: string) => {
  const m = v.match(/^([^\d+\-−]*)([+\-−]?[\d.,\-]+)\s*(.*)$/);
  return m ? { chiffre: `${m[1]}${m[2]}`, unite: m[3] } : { chiffre: v, unite: '' };
};
const tableau = t.stats.slice(0, 3).map((s) => ({ ...coupe(s.value), texte: `${s.label}. ${s.detail}` }));
const quatrieme = t.stats[3];

---

<!-- Emailing, pourquoi (direction Encre, modèle AI Training, 30/09/2026) : sur l'encre, trois
     chiffres du canal au tableau à palettes (gardés tels quels, à sourcer), le quatrième à
     côté, puis le problème et la réponse en deux cartes. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.headline} <span class="block text-marque-clair">{t.subheadline}</span></h2>
      <p class="chapo">{t.description}</p>
    </header>
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-6">
      <div class="carte-verre grid content-start gap-8 px-6 py-8 lg:px-9 lg:py-10">
        <TableauPalettes lang={lang} lignes={tableau} tete />
        {quatrieme && (
          <p class="grid gap-1 border-t border-white/10 pt-6">
            <span class="font-display text-4xl font-extrabold tracking-[-0.04em] text-white">{quatrieme.value}</span>
            <span class="text-sur-encre">{quatrieme.label}</span>
            <span class="text-sm text-sur-encre-2">{quatrieme.detail}</span>
          </p>
        )}
      </div>
      <div class="grid content-start gap-5">
        <div class="carte-verre grid gap-3 p-6 lg:p-8" data-reveal>
          <span class="tuile bg-yellow-400/15 text-yellow-300"><Icon name="alert-triangle" size={26} /></span>
          <h3 class="titre-carte text-white">{t.warning.title}</h3>
          <p class="text-sur-encre-2">{t.warning.description}</p>
        </div>
        <div class="grid gap-4 rounded-[20px] bg-white p-6 text-encre shadow-[var(--ombre-forte)] lg:p-8" data-reveal style="--i:1">
          <span class="tuile tuile-pleine"><Icon name="sparkles" size={26} /></span>
          <h3 class="titre-carte text-encre">{t.solution.title}</h3>
          <ul class="grid gap-3">
            {t.solution.points.map((p) => (
              <li class="grid grid-cols-[24px_minmax(0,1fr)] gap-3 text-slate-700">
                <span class="mt-0.5 grid h-6 w-6 place-items-center rounded-full bg-marque-doux text-marque"><Icon name="check" size={14} /></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
