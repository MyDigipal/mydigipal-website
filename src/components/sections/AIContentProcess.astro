---
/**
 * AI Content : de la voix de la marque à l'article relu par un humain, expliqué par le
 * morphing sur rail en quatre états (direction Encre, 30/09/2026). Un seul objet change
 * de forme, parce que c'est un seul contenu qui avance. L'ancienne version (pastilles 01
 * à 04, détails cachés au survol, section sombre) est remplacée.
 */
import type { Language } from '@/i18n/config';
import RailMorphing from '@/components/motion/RailMorphing.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const contenu = {
  en: {
    titre: 'How AI content creation works',
    chapo: 'One piece of content moves through four stages, from your brand voice to the article a human signs off.',
    stations: [
      { titre: 'Your brand voice', texte: 'Before writing anything, we analyse your existing material to understand what makes your brand sound like itself.', forme: 'bulle' as const },
      { titre: 'The data decides', texte: 'Real SEO data from Ahrefs and your Search Console drive the topics and the angle. No guessing.', forme: 'loupe' as const },
      { titre: 'AI writes the draft', texte: 'Our AI writes a complete draft in your voice, following SEO good practice, meta title and description included.', forme: 'structure' as const },
      { titre: 'A human signs off', texte: 'Every piece is reviewed by a human before it is published. Quality is not negotiable.', forme: 'cible' as const },
    ],
  },
  fr: {
    titre: 'Comment fonctionne la création de contenu IA',
    chapo: 'Un même contenu passe par quatre états, de la voix de votre marque à l’article qu’un humain valide.',
    stations: [
      { titre: 'Votre voix de marque', texte: 'Avant d’écrire quoi que ce soit, nous analysons vos contenus existants pour comprendre ce qui fait que votre marque sonne comme elle.', forme: 'bulle' as const },
      { titre: 'La donnée décide', texte: 'Les vraies données SEO d’Ahrefs et de votre Search Console choisissent les sujets et l’angle. Pas de suppositions.', forme: 'loupe' as const },
      { titre: 'L’IA rédige', texte: 'Notre IA rédige un premier jet complet dans votre voix, selon les bonnes pratiques SEO, titre et description compris.', forme: 'structure' as const },
      { titre: 'Un humain valide', texte: 'Chaque contenu est relu par un humain avant publication. La qualité ne se négocie pas.', forme: 'cible' as const },
    ],
  },
}[lang];
---

<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{contenu.titre}</h2>
      <p class="chapo">{contenu.chapo}</p>
    </header>
    <RailMorphing lang={lang} stations={contenu.stations} />
  </div>
</section>
