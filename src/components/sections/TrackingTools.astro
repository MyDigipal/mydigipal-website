---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import Marque from '@/components/ui/Marque.astro';
import { LOGOS_OUTILS } from './logos-outils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Tools & Integrations",
    headline: "We work with your stack",
    subtitle: "Expert implementation across all major platforms, CMS, and marketing tools.",
    categories: [
      {
        title: "CMS & e-commerce",
        description: "Native integrations with your website platform",
        tools: [
          { name: "WordPress", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/wordpress/wordpress-plain.svg" },
          { name: "Shopify", logo: "https://cdn.simpleicons.org/shopify/7AB55C" },
          { name: "Wix", logo: "https://cdn.simpleicons.org/wix/0C6EFC" },
          { name: "Prestashop", logo: "https://cdn.simpleicons.org/prestashop/DF0067" },
          { name: "Webflow", logo: "https://cdn.simpleicons.org/webflow/4353FF" },
        ]
      },
      {
        title: "Analytics & tracking",
        description: "Complete measurement ecosystem",
        tools: [
          { name: "Google Tag Manager", logo: "https://www.gstatic.com/analytics-suite/header/suite/v2/ic_tag_manager.svg" },
          { name: "Google Analytics 4", logo: "https://www.gstatic.com/analytics-suite/header/suite/v2/ic_analytics.svg" },
          { name: "Meta Pixel", logo: "https://cdn.simpleicons.org/meta/0081FB" },
          { name: "LinkedIn Insight", logo: "https://cdn.worldvectorlogo.com/logos/linkedin-icon-2.svg" },
          { name: "TikTok Pixel", logo: "https://cdn.simpleicons.org/tiktok/000000" },
        ]
      },
      {
        title: "CRM & marketing automation",
        description: "Certified integrations with leading platforms",
        tools: [
          { name: "HubSpot", logo: "https://cdn.worldvectorlogo.com/logos/hubspot-1.svg", certified: true },
          { name: "Salesforce", logo: "https://cdn.worldvectorlogo.com/logos/salesforce-2.svg", certified: true },
          { name: "Marketo", logo: "https://www.vectorlogo.zone/logos/marketo/marketo-icon.svg", certified: true },
          { name: "Pipedrive", logo: "https://www.vectorlogo.zone/logos/pipedrive/pipedrive-icon.svg" },
          { name: "Zoho CRM", logo: "https://cdn.worldvectorlogo.com/logos/zoho-1.svg" },
        ]
      }
    ],
    certifiedBadge: "Certified Partner"
  },
  fr: {
    badge: "Outils & intégrations",
    headline: "Nous travaillons avec votre stack",
    subtitle: "Implémentation experte sur toutes les plateformes majeures, CMS et outils marketing.",
    categories: [
      {
        title: "CMS & E-commerce",
        description: "Intégrations natives avec votre plateforme web",
        tools: [
          { name: "WordPress", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/wordpress/wordpress-plain.svg" },
          { name: "Shopify", logo: "https://cdn.simpleicons.org/shopify/7AB55C" },
          { name: "Wix", logo: "https://cdn.simpleicons.org/wix/0C6EFC" },
          { name: "Prestashop", logo: "https://cdn.simpleicons.org/prestashop/DF0067" },
          { name: "Webflow", logo: "https://cdn.simpleicons.org/webflow/4353FF" },
        ]
      },
      {
        title: "Analytics & Tracking",
        description: "Ecosystème de mesure complet",
        tools: [
          { name: "Google Tag Manager", logo: "https://www.gstatic.com/analytics-suite/header/suite/v2/ic_tag_manager.svg" },
          { name: "Google Analytics 4", logo: "https://www.gstatic.com/analytics-suite/header/suite/v2/ic_analytics.svg" },
          { name: "Meta Pixel", logo: "https://cdn.simpleicons.org/meta/0081FB" },
          { name: "LinkedIn Insight", logo: "https://cdn.worldvectorlogo.com/logos/linkedin-icon-2.svg" },
          { name: "TikTok Pixel", logo: "https://cdn.simpleicons.org/tiktok/000000" },
        ]
      },
      {
        title: "CRM & Marketing Automation",
        description: "Intégrations certifiées avec les plateformes leaders",
        tools: [
          { name: "HubSpot", logo: "https://cdn.worldvectorlogo.com/logos/hubspot-1.svg", certified: true },
          { name: "Salesforce", logo: "https://cdn.worldvectorlogo.com/logos/salesforce-2.svg", certified: true },
          { name: "Marketo", logo: "https://www.vectorlogo.zone/logos/marketo/marketo-icon.svg", certified: true },
          { name: "Pipedrive", logo: "https://www.vectorlogo.zone/logos/pipedrive/pipedrive-icon.svg" },
          { name: "Zoho CRM", logo: "https://cdn.worldvectorlogo.com/logos/zoho-1.svg" },
        ]
      }
    ],
    certifiedBadge: "Partenaire certifié"
  }
};

const t = translations[lang] || translations.en;

// Le nom de la marque dans `logos-outils.ts` quand il diffère du libellé affiché.
const marques: Record<string, string> = {
  'Google Tag Manager': 'Tag Manager',
  'Meta Pixel': 'Meta Ads',
  'LinkedIn Insight': 'LinkedIn',
  'TikTok Pixel': 'TikTok',
  Prestashop: 'PrestaShop',
  'Zoho CRM': 'Zoho',
};

---

<!-- Tracking, les outils (direction Encre, 30/09/2026) : trois familles, chaque outil avec sa
     marque en couleur. Les marques de simple-icons sont servies par le site ; les trois qui
     n'y sont pas (Salesforce, Marketo, Pipedrive) gardent leur fichier d'origine. -->
<section class="section-brume py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 lg:gap-6">
      {t.categories.map((c, i) => (
        <div class="carte grid content-start gap-5 p-6 lg:p-8" data-reveal style={`--i:${i}`}>
          <div>
            <h3 class="titre-carte text-encre">{c.title}</h3>
            <p class="text-slate-600">{c.description}</p>
          </div>
          <ul class="grid gap-2">
            {c.tools.map((o) => {
              const nom = marques[o.name] ?? o.name;
              return (
                <li class="grid grid-cols-[44px_minmax(0,1fr)_auto] items-center gap-3 rounded-2xl bg-brume-clair p-2 pr-3">
                  <span class="grid h-11 w-11 place-items-center rounded-xl bg-white">
                    {LOGOS_OUTILS[nom] || /^linkedin/i.test(nom)
                      ? <Marque nom={nom} taille={24} />
                      : <img src={o.logo} alt="" width="24" height="24" class="h-6 w-6 object-contain" loading="lazy" decoding="async" />}
                  </span>
                  <span class="font-semibold text-encre">{o.name}</span>
                  {o.certified && <span class="rounded-full bg-marque-doux px-2.5 py-1 text-xs font-semibold text-marque">{t.certifiedBadge}</span>}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
