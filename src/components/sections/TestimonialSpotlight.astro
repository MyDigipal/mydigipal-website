---
/**
 * Le verbatim d'un client, direction Encre (30/09/2026) : une section d'encre qui
 * monte sur la précédente, la phrase du client en grand, en blanc, puis son nom.
 * Ni étoiles, ni points qui scintillent, ni mots qui apparaissent un par un : le
 * texte est là, il ne bouge pas pour rien. Une seule apparition, au défilement.
 */
interface Props {
  quote: string;
  author: string;
  role: string;
  company: string;
  image?: string;
  companyLogo?: string;
  lang?: 'en' | 'fr';
}

const { quote, author, role, company, image, companyLogo, lang } = Astro.props;

// Les guillemets de la langue de la page ; la langue se lit dans l'adresse quand la
// page ne la passe pas.
const langue = lang ?? (Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en');
const citation = langue === 'fr' ? `« ${quote} »` : `“${quote}”`;
const qui = [role, company].filter(Boolean).join(', ');
---

<section class="temoignage section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <figure class="max-w-[900px]" data-reveal>
      <blockquote>
        <p class="temoignage-citation">{citation}</p>
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4">
        {image ? (
          <img src={image} alt="" width="56" height="56" class="h-14 w-14 flex-none rounded-full object-cover" loading="lazy" decoding="async" />
        ) : companyLogo ? (
          <span class="grid h-[52px] w-24 flex-none place-items-center rounded-xl bg-white px-3 py-2">
            <img src={companyLogo} alt="" class="max-h-full w-auto object-contain" loading="lazy" decoding="async" />
          </span>
        ) : null}
        <span>
          <span class="block font-semibold text-sur-encre">{author}</span>
          {qui && <span class="block text-sur-encre-2">{qui}</span>}
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .temoignage-citation {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: pretty;
  }
</style>
