---
/**
 * AI Training : l'IA par département (direction Encre, 30/09/2026, correction de cap de
 * Paul). Une carte par département, une grande icône et UN exemple concret, écrit comme la
 * demande que le participant fera à l'assistant en sortant. Les autres usages de l'ancienne
 * liste restent, en une ligne.
 */
import { type Language } from '@/i18n/config';
import CartesDepartements from '@/components/sections/CartesDepartements.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    headline: "AI for every department",
    subtitle: "Each session is built on the tasks of the people in the room. Here is what one of them asks the assistant once the training is over.",
    departments: [
      {
        icone: "briefcase",
        nom: "Managers and directors",
        exemple: "Here are the minutes of the last three steering committees. List the decisions made, who has to act and by when, and flag what was left unanswered.",
        aussi: ["draft strategic presentations", "prepare board meeting materials"],
      },
      {
        icone: "users",
        nom: "Human resources",
        exemple: "Rewrite this job ad for a field sales rep: what they will do in their first week, what we expect, no HR jargon.",
        aussi: ["summarise CVs", "draft onboarding materials"],
      },
      {
        icone: "bar-chart",
        nom: "Finance",
        exemple: "From this export, explain the gap between budget and actuals this month in three causes, with the figures, for the leadership team.",
        aussi: ["clean and check data entries", "draft budget narratives"],
      },
      {
        icone: "building",
        nom: "Property and real estate",
        exemple: "Write the listing for this two-bedroom flat from the technical sheet, without promising anything the sheet does not say.",
        aussi: ["summarise due diligence documents", "compare market listings"],
      },
    ],
  },
  fr: {
    headline: "L'IA pour chaque département",
    subtitle: "Chaque session se construit sur les tâches des personnes présentes. Voici ce que l'une d'elles demande à l'assistant en sortant de la formation.",
    departments: [
      {
        icone: "briefcase",
        nom: "Managers et directions",
        exemple: "Voici les comptes rendus des trois derniers comités. Liste les décisions prises, qui doit agir et pour quand, et signale ce qui est resté sans réponse.",
        aussi: ["rédiger présentations stratégiques et synthèses", "préparer les supports de réunion"],
      },
      {
        icone: "users",
        nom: "Ressources humaines",
        exemple: "Réécris cette offre d'emploi pour un commercial terrain : ce qu'il fera la première semaine, ce qu'on attend de lui, sans jargon RH.",
        aussi: ["résumer les CV", "rédiger les supports d'onboarding"],
      },
      {
        icone: "bar-chart",
        nom: "Finance",
        exemple: "À partir de cet export, explique l'écart entre le budget et le réalisé du mois en trois causes, chiffres à l'appui, pour le comité de direction.",
        aussi: ["nettoyer et valider les données", "rédiger les narratifs budgétaires"],
      },
      {
        icone: "building",
        nom: "Immobilier",
        exemple: "Rédige l'annonce de ce T3 à partir de la fiche technique, sans rien promettre que la fiche ne dit pas.",
        aussi: ["résumer les documents de due diligence", "comparer les annonces du marché"],
      },
    ],
  },
};

const t = translations[lang] || translations.en;
---

<section class="section-brume py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <CartesDepartements lang={lang} departements={t.departments} fond="clair" />
  </div>
</section>
