---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "The AI Imperative",
    headline: "Every company is becoming an AI company",
    subheadline: "The question isn't if, but how fast",
    description: "Companies that don't adopt AI are falling behind their competitors. But most AI adoption fails because teams don't know where to start or how to implement effectively.",
    stats: [
      { value: "72%", label: "of executives see AI as a competitive advantage", icon: "trending-up" },
      { value: "40%", label: "productivity increase with AI adoption", icon: "zap" },
      { value: "2-4x", label: "faster decision-making with AI insights", icon: "clock" },
    ],
    journey: {
      title: "The AI Adoption Journey",
      subtitle: "Success follows a proven path",
      steps: [
        {
          number: "01",
          title: "Train Your Team",
          description: "The first step is understanding AI capabilities. Our training programs equip your team to identify opportunities and work effectively with AI tools.",
          cta: "Explore AI Training",
          ctaLink: "ai-training",
          icon: "users",
        },
        {
          number: "02",
          title: "Build Internal Expertise",
          description: "Create an internal champion or team who understands both your business processes and AI possibilities. They'll bridge the gap between technology and operations.",
          icon: "award",
        },
        {
          number: "03",
          title: "Implement Custom Solutions",
          description: "With understanding and ownership in place, develop AI solutions tailored to your specific workflows, data, and objectives.",
          icon: "code",
        },
      ],
    },
    warning: {
      title: "Why Generic AI Tools Fall Short",
      points: [
        "Can't access your proprietary data and context",
        "Don't integrate with your existing systems",
        "Require manual work to fit your workflows",
        "One-size-fits-all doesn't fit anyone well",
      ],
    },
    solution: {
      title: "Custom AI: Built for You",
      points: [
        "Works with your specific data and documents",
        "Integrates seamlessly with existing tools",
        "Designed around your actual workflows",
        "Solves your unique business challenges",
      ],
    },
  },
  fr: {
    badge: "L'impératif IA",
    headline: "Chaque entreprise devient une entreprise IA",
    subheadline: "La question n'est pas si, mais à quelle vitesse",
    description: "Les entreprises qui n'adoptent pas l'IA prennent du retard sur leurs concurrents. Mais la plupart des adoptions IA échouent car les équipes ne savent pas par où commencer ou comment implémenter efficacement.",
    stats: [
      { value: "72%", label: "des dirigeants voient l'IA comme un avantage compétitif", icon: "trending-up" },
      { value: "40%", label: "d'augmentation de productivité avec l'adoption IA", icon: "zap" },
      { value: "2-4x", label: "décisions plus rapides avec les insights IA", icon: "clock" },
    ],
    journey: {
      title: "Le parcours d'adoption IA",
      subtitle: "Le succès suit un chemin prouvé",
      steps: [
        {
          number: "01",
          title: "Former votre équipe",
          description: "La première étape est de comprendre les capacités de l'IA. Nos programmes de formation équipent votre équipe pour identifier les opportunités et travailler efficacement avec les outils IA.",
          cta: "Explorer la formation IA",
          ctaLink: "ai-training",
          icon: "users",
        },
        {
          number: "02",
          title: "Développer l'expertise interne",
          description: "Créez un champion interne ou une équipe qui comprend à la fois vos processus métier et les possibilités IA. Ils feront le pont entre technologie et opérations.",
          icon: "award",
        },
        {
          number: "03",
          title: "Implémenter des solutions sur mesure",
          description: "Avec la compréhension et l'appropriation en place, développez des solutions IA adaptées à vos workflows spécifiques, données et objectifs.",
          icon: "code",
        },
      ],
    },
    warning: {
      title: "Pourquoi les outils IA génériques échouent",
      points: [
        "Ne peuvent pas accéder à vos données propriétaires",
        "Ne s'intègrent pas à vos systèmes existants",
        "Nécessitent du travail manuel pour s'adapter",
        "Une solution universelle ne convient à personne",
      ],
    },
    solution: {
      title: "IA sur mesure : conçue pour vous",
      points: [
        "Travaille avec vos données et documents spécifiques",
        "S'intègre parfaitement aux outils existants",
        "Conçue autour de vos workflows réels",
        "Résout vos défis business uniques",
      ],
    },
  }
};

const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026) : une section d'encre qui monte sur le hero. Plus de
     statistiques sans source (72 %, 40 %, 2-4x), plus de pastilles 01 / 02 / 03 : le
     parcours d'adoption est une liste ordonnée, puis les outils génériques face à l'IA
     sur mesure, entre des filets. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-14 grid max-w-[900px] gap-5 lg:mb-20 lg:gap-6">
      <h2 class="titre-moyen">
        {t.headline}
        <span class="block text-marque-clair">{t.subheadline}</span>
      </h2>
      <p class="chapo">{t.description}</p>
    </header>

    <h3 class="mb-2 font-display text-2xl font-extrabold tracking-[-0.02em] text-white lg:text-3xl">{t.journey.title}</h3>
    <p class="mb-8 text-sur-encre-2">{t.journey.subtitle}</p>
    <ol class="grid gap-x-10 lg:grid-cols-3">
      {t.journey.steps.map((step, index) => (
        <li class="grid content-start gap-3 border-t border-white/10 py-7" data-reveal style={`--i:${index}`}>
          <Icon name={step.icon} size={24} class="text-marque-clair" />
          <h4 class="font-display text-xl font-extrabold tracking-[-0.02em] text-white">{step.title}</h4>
          <p class="text-sur-encre-2">{step.description}</p>
          {step.cta && step.ctaLink && (
            <a href={`/${lang}/services/${step.ctaLink}`} class="inline-flex min-h-11 items-center gap-2 font-semibold text-marque-clair hover:text-white">
              {step.cta}
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="mb-5 text-xl font-semibold text-sur-encre-2">{t.warning.title}</h3>
        <ul class="grid gap-3">
          {t.warning.points.map((point) => (
            <li class="flex items-start gap-3 text-sur-encre-2">
              <Icon name="ban" size={18} class="mt-0.5 flex-none text-sur-encre-2" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="mb-5 text-xl font-semibold text-white">{t.solution.title}</h3>
        <ul class="grid gap-3">
          {t.solution.points.map((point) => (
            <li class="flex items-start gap-3 text-sur-encre">
              <Icon name="check" size={18} class="mt-0.5 flex-none text-marque-clair" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
