---
/**
 * Google Ads : la méthode, de l'audit au reporting (direction Encre, 30/09/2026). Un seul
 * objet voyage d'une station à l'autre et change de forme (loupe, structure, curseur,
 * courbe) : c'est la même mission qui change de nature. Plus de pastilles 01 à 04 ni de
 * bandeau de résultats sans source.
 */
import type { Language } from '@/i18n/config';
import RailMorphing from '@/components/motion/RailMorphing.astro';
import { methodeGoogleAds } from '@/components/motion/donnees-pmax';

interface Props {
  lang: Language;
  color?: string;
}

const { lang } = Astro.props;
const m = methodeGoogleAds(lang);
---

<section class="section-blanc py-20 lg:py-32" id="methode">
  <div class="container-custom">
    <header class="mb-10 grid max-w-[880px] gap-5 lg:mb-14">
      <h2 class="titre-moyen text-encre">{m.titre}</h2>
    </header>
    <RailMorphing lang={lang} stations={m.stations} />
  </div>
</section>
