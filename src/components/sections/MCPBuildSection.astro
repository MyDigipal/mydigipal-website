---
/**
 * AI Training : construire son propre serveur MCP (direction Encre, 30/09/2026).
 * Le terminal factice (ROAS, pourcentages et nom de client inventés) est remplacé par la
 * carte de verre, qui explique ce qu'est un serveur MCP : la question entre, il va
 * chercher dans vos outils, la réponse revient, ce qui n'est pas autorisé reste fermé.
 * Le lien de contact garde son `?topic=mcp`.
 */
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import CarteVerre from '@/components/motion/CarteVerre.astro';
import { carteMcp } from '@/components/motion/donnees-mcp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    headline: "Build your own MCP.",
    headlineAccent: "Stop copy-pasting between your tools.",
    subtitle:
      "MyDigipal runs an MCP gateway with 244 tools connected to 21 marketing platforms, live in production. We train you to build your own, on your stack, with your data.",
    bullets: [
      {
        icon: "sparkles",
        title: "Demystify the tech",
        text: "Our Crawl / Walk / Run method: you start with the prompts you already use, you end with agents that query your CRM, your BI and your campaigns in real time.",
      },
      {
        icon: "cpu",
        title: "You stay autonomous",
        text: "No vendor lock-in. We hand over the code, the configuration and the continuous-improvement method. Your MCP lives in your infra, not ours.",
      },
      {
        icon: "zap",
        title: "Your stack, your MCP",
        text: "Ahrefs, GA4, Meta Ads, BigQuery, Notion, Lemlist: we connect what you actually use, not a generic vendor demo.",
      },
    ],
    carteTitre: "What an MCP server does",
    cta: "Talk about your MCP",
    ctaHref: "/en/contact?topic=mcp",
  },
  fr: {
    headline: "Construisez votre propre MCP.",
    headlineAccent: "Arrêtez de copier-coller entre vos outils.",
    subtitle:
      "MyDigipal opère une passerelle MCP de 244 outils connectés à 21 plateformes marketing, en production. On vous forme à construire la vôtre, sur votre stack, avec vos données.",
    bullets: [
      {
        icon: "sparkles",
        title: "Désacraliser la technique",
        text: "Notre process Crawl / Walk / Run : on commence avec vos prompts actuels, on finit avec des agents qui interrogent votre CRM, votre BI et vos campagnes en direct.",
      },
      {
        icon: "cpu",
        title: "Vous serez autonome",
        text: "Pas de dépendance fournisseur. On vous transmet le code, la config et la méthode d'amélioration continue. Votre MCP vit sur votre infra, pas la nôtre.",
      },
      {
        icon: "zap",
        title: "Votre stack, votre MCP",
        text: "Ahrefs, GA4, Meta Ads, BigQuery, Notion, Lemlist : on connecte ce que vous utilisez vraiment, pas une démo générique de fournisseur.",
      },
    ],
    carteTitre: "Ce que fait un serveur MCP",
    cta: "Discuter de votre MCP",
    ctaHref: "/fr/contact?topic=mcp",
  },
};

const t = translations[lang] || translations.en;
const carte = carteMcp(lang);
---

<section class="mcp-build section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">
        {t.headline}
        <span class="block text-marque-clair">{t.headlineAccent}</span>
      </h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <ul class="grid gap-x-10 md:grid-cols-3">
      {t.bullets.map((b, index) => (
        <li class="grid content-start gap-2 border-t border-white/10 py-6" data-reveal style={`--i:${index}`}>
          <Icon name={b.icon} size={22} class="mb-1 text-marque-clair" />
          <h3 class="text-lg font-semibold text-white">{b.title}</h3>
          <p class="text-sur-encre-2">{b.text}</p>
        </li>
      ))}
    </ul>

    <h3 id="mcp-carte-titre" class="mb-8 mt-16 font-display text-2xl font-extrabold tracking-[-0.02em] text-white lg:mt-24 lg:text-3xl">{t.carteTitre}</h3>
    <CarteVerre lang={lang} titreId="mcp-carte-titre" {...carte} />

    <div class="mt-14 lg:mt-20">
      <a href={t.ctaHref} class="pilule pilule-blanche">
        {t.cta}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
    </div>
  </div>
</section>
