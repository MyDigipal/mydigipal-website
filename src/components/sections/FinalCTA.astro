---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
  color?: 'seo' | 'ads' | 'social' | 'abm' | 'training' | 'emailing' | 'ai' | 'tracking' | 'content' | 'primary' | 'automotive';
  /** Titre et texte propres à la page ; les deux portes restent les mêmes. */
  title?: string;
  subtitle?: string;
}

const { lang, color = 'primary', title, subtitle } = Astro.props;

// `color` reste accepté (les pages le passent), mais la fin de page est la même
// partout depuis le 25/09/2026 : celle de l'accueil, dans le bleu du logo.
void color;

const content = {
  en: {
    title: 'Ready to take your digital activity to the next level?',
    subtitle: 'Calculate your tailored plan in 3 minutes, or get in touch. No commitment, just results measured weekly.',
    primaryButton: 'Calculate my budget',
    secondaryButton: 'Contact us',
  },
  fr: {
    title: 'Prêt à propulser votre activité digitale ?',
    subtitle: 'Calculez votre plan sur mesure en 3 minutes, ou écrivez-nous. Sans engagement, juste des résultats mesurés chaque semaine.',
    primaryButton: 'Calculer mon budget',
    secondaryButton: 'Nous contacter',
  },
};

const t = { ...content[lang], ...(title ? { title } : {}), ...(subtitle ? { subtitle } : {}) };
---

<!-- La fin de page commune, dans le style de l'accueil : titre serré à gauche,
     texte et les deux portes à droite (« Calculer mon budget », « Nous contacter »),
     sur le bleu très pâle du logo pour se détacher des sections blanches et du pied
     de page sombre. -->
<section class="final-cta bg-marque-doux py-20 lg:py-28">
  <div class="container-custom grid gap-8 lg:grid-cols-12 lg:gap-12 lg:items-end">
    <h2 class="final-cta-titre lg:col-span-7 font-display font-extrabold text-encre text-[2.125rem] sm:text-[2.75rem] lg:text-[3.5rem]">
      {t.title}
    </h2>
    <div class="lg:col-span-5">
      <p class="text-base sm:text-lg text-slate-600 mb-8 max-w-[46ch]">
        {t.subtitle}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={`/${lang}/calculator`}
          class="group inline-flex items-center justify-center gap-2 h-13 px-6 rounded-full bg-marque text-white font-semibold hover:bg-marque-fonce active:scale-[0.98] transition-colors"
        >
          {t.primaryButton}
          <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={`/${lang}/contact`}
          class="inline-flex items-center justify-center h-13 px-6 rounded-full border border-slate-300 bg-white text-encre font-semibold hover:border-slate-400 transition-colors"
        >
          {t.secondaryButton}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-titre {
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
</style>
