---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
  color?: 'seo' | 'ads' | 'social' | 'abm' | 'training' | 'emailing' | 'ai' | 'tracking' | 'content' | 'primary' | 'automotive';
  /** Titre et texte propres à la page ; les deux portes restent les mêmes. */
  title?: string;
  subtitle?: string;
}

const { lang, color = 'primary', title, subtitle } = Astro.props;

// `color` reste accepté (les pages le passent), mais la fin de page est la même
// partout depuis le 25/09/2026, dans le bleu du logo.
void color;

const content = {
  en: {
    title: 'Ready to take your digital marketing to the next level?',
    subtitle: 'Calculate your tailored plan in 3 minutes, or get in touch. No commitment, just results measured weekly.',
    primaryButton: 'Calculate my budget',
    secondaryButton: 'Contact us',
  },
  fr: {
    title: 'Prêt à propulser votre activité digitale ?',
    subtitle: 'Calculez votre plan sur mesure en 3 minutes, ou écrivez-nous. Sans engagement, juste des résultats mesurés chaque semaine.',
    primaryButton: 'Calculer mon budget',
    secondaryButton: 'Nous contacter',
  },
};

const t = { ...content[lang], ...(title ? { title } : {}), ...(subtitle ? { subtitle } : {}) };
---

<!-- La fin de page commune, direction Encre (30/09/2026) : un panneau de bleu plein
     posé sur la brume. Le bleu du logo y apparaît une fois en surface, et la bande
     de brume dessous sépare l'appel de l'encre du pied de page. Les deux mêmes portes
     que partout sur le site. -->
<section class="final-cta section-brume py-16 lg:py-24">
  <div class="container-custom">
    <div class="final-cta-panneau grid justify-items-start gap-5 lg:gap-6">
      <h2 class="titre-moyen text-white lg:max-w-[16ch]">
        {t.title}
      </h2>
      <p class="chapo final-cta-texte max-w-[52ch]">
        {t.subtitle}
      </p>
      <div class="pilules mt-3">
        <a href={`/${lang}/calculator`} class="pilule pilule-blanche">
          {t.primaryButton}
          <Icon name="arrow-right" size={18} class="pilule-fleche" />
        </a>
        <a href={`/${lang}/contact`} class="pilule pilule-claire">
          {t.secondaryButton}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-panneau {
    margin-inline: -1rem;
    padding: 56px 1rem;
    border-radius: 28px;
    color: #fff;
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(125 184 238 / 0.24), transparent 62%),
      var(--color-marque);
    box-shadow: 0 32px 64px -28px rgb(21 90 147 / 0.60);
  }
  .final-cta-panneau :focus-visible {
    outline-color: #fff;
  }
  .final-cta-texte {
    color: rgb(255 255 255 / 0.92);
  }
  @media (min-width: 640px) {
    .final-cta-panneau {
      margin-inline: 0;
      padding: 64px 48px;
      border-radius: var(--rayon-scene);
    }
  }
  @media (min-width: 1024px) {
    .final-cta-panneau {
      padding: 96px 88px;
    }
  }
</style>
