---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
  color?: 'seo' | 'ads' | 'social' | 'abm' | 'training' | 'emailing' | 'ai' | 'tracking' | 'content' | 'primary' | 'automotive';
  /** Titre et texte propres à la page ; les deux portes restent les mêmes. */
  title?: string;
  subtitle?: string;
  /** Où mène « Calculer mon budget » quand la page a son propre simulateur (AI Training). */
  lienBudget?: string;
}

const { lang, color = 'primary', title, subtitle, lienBudget } = Astro.props;

// `color` reste accepté (les pages le passent), mais la fin de page est la même
// partout depuis le 25/09/2026, dans le bleu du logo.
void color;

const content = {
  en: {
    title: 'Ready to take your digital marketing to the next level?',
    subtitle: 'Calculate your tailored plan in 3 minutes, or get in touch. No commitment, just results measured weekly.',
    primaryButton: 'Calculate my budget',
    secondaryButton: 'Contact us',
  },
  fr: {
    title: 'Prêt à propulser votre activité digitale ?',
    subtitle: 'Calculez votre plan sur mesure en 3 minutes, ou écrivez-nous. Sans engagement, juste des résultats mesurés chaque semaine.',
    primaryButton: 'Calculer mon budget',
    secondaryButton: 'Nous contacter',
  },
};

const t = { ...content[lang], ...(title ? { title } : {}), ...(subtitle ? { subtitle } : {}) };
---

<!-- La fin de page commune. Jusqu'au 20/10/2026, un panneau de bleu plein ; Paul l'a
     trouvé « dégueulasse ». Elle reprend maintenant la porte « Nous contacter » de
     l'accueil, qu'il a validée : une carte blanche sur la brume, le visage de celui qui
     répond, le titre de la page, et les deux mêmes portes que partout sur le site. Le bleu
     ne reste qu'au bouton principal. La bande de brume sépare l'appel de l'encre du pied
     de page. -->
<section class="final-cta section-brume py-16 lg:py-24">
  <div class="container-custom">
    <div class="fin-carte">
      <img
        class="fin-photo"
        src="/images/team/visages/paul-andre.avif"
        alt="Paul André"
        width="320"
        height="400"
        loading="lazy"
        decoding="async"
      />
      <div class="fin-texte">
        <h2 class="titre-moyen fin-titre">{t.title}</h2>
        <p class="fin-chapo">{t.subtitle}</p>
      </div>
      <div class="pilules fin-portes">
        <a href={lienBudget || `/${lang}/calculator`} class="pilule pilule-pleine">
          {t.primaryButton}
          <Icon name="arrow-right" size={18} class="pilule-fleche" />
        </a>
        <a href={`/${lang}/contact`} class="pilule pilule-contour">
          {t.secondaryButton}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sur téléphone, la carte prend toute la largeur de l'écran (les deux pilules doivent
     tenir côte à côte jusqu'à 360 px) ; la photo et le titre partagent la première ligne,
     le texte et les portes passent dessous sur toute la largeur. */
  .fin-carte {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem 1rem;
    margin-inline: -1rem;
    padding: 1.75rem 1rem;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 1px 0 rgb(15 23 42 / 0.04), 0 24px 48px -32px rgb(15 23 42 / 0.25);
  }
  .fin-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }
  .fin-texte {
    display: contents;
  }
  .fin-titre {
    margin: 0;
  }
  .fin-chapo {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #4B5B6B;
    max-width: 52ch;
  }
  .fin-portes {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .fin-carte {
      margin-inline: 0;
      padding: 2.25rem;
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .fin-carte {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
      gap: 2.5rem;
      padding: 2.75rem 3rem;
    }
    .fin-texte {
      display: grid;
      gap: 0.75rem;
      min-width: 0;
    }
    .fin-chapo {
      grid-column: auto;
    }
    .fin-portes {
      grid-column: auto;
    }
  }
</style>
