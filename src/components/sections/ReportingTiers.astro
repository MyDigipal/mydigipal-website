---

<!-- Tracking, les solutions de reporting (direction Encre, 30/09/2026) : trois formules, la
     professionnelle en encre et plus large. Les prix sont ceux de l'offre. -->
<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <div class="formules">
      {t.tiers.map((x, i) => {
        const fonce = x.highlighted;
        return (
          <article class:list={['formule', fonce ? 'carte-encre formule-vedette' : 'carte']} data-reveal style={`--i:${i}`}>
            <div class="flex items-center gap-4">
              <span class="grid h-14 w-14 flex-none place-items-center rounded-2xl bg-white shadow-[inset_0_0_0_1px_var(--filet)]">
                {i === 0 ? <Marque nom="Looker" taille={28} /> : <Icon name={x.icon ?? 'bar-chart'} size={26} class="text-marque" />}
              </span>
              <div>
                <h3 class:list={['font-display text-2xl font-extrabold tracking-[-0.02em]', fonce ? 'text-white' : 'text-encre']}>{x.name}</h3>
                <p class={fonce ? 'text-sur-encre-2' : 'text-slate-500'}>{x.tool}</p>
              </div>
            </div>
            <p class:list={['font-display text-2xl font-extrabold', fonce ? 'text-white' : 'text-marque']}>{x.price}</p>
            <p class={fonce ? 'text-sur-encre-2' : 'text-slate-600'}>{x.description}</p>
            <ul class="grid gap-2">
              {x.features.map((f) => (
                <li class:list={['grid grid-cols-[18px_minmax(0,1fr)] gap-2', fonce ? 'text-sur-encre' : 'text-slate-700']}>
                  <Icon name="check" size={16} class={fonce ? 'mt-1 text-marque-clair' : 'mt-1 text-marque'} />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a href={`/${lang}/contact`} class:list={['pilule mt-auto self-start', fonce ? 'pilule-blanche' : 'pilule-contour']}>{t.cta}</a>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .formules {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .formule {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 24px;
  }
  @media (min-width: 1024px) {
    .formules {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 20px;
    }
    .formule {
      padding: 32px;
    }
    .formule-vedette {
      margin-block: -16px;
      padding: 44px 36px;
    }
  }
</style>
