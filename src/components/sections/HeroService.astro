---
import { type Language } from '@/i18n/config';
import { t } from '@/i18n/utils';
import Icon from '@/components/ui/Icon.astro';

interface Metric {
  value: string;
  label: string;
}

interface HeroTestimonial {
  quote: string;
  author: string;
  role?: string;
  company?: string;
}

interface Props {
  lang: Language;
  badge?: string;
  headline: string;
  subheadline?: string;
  description: string;
  color?: 'seo' | 'ads' | 'social' | 'abm' | 'training' | 'emailing' | 'ai' | 'tracking' | 'content' | 'primary' | 'automotive';
  /** 2-4 key result metrics surfaced above the fold (proof). */
  metrics?: Metric[];
  /** Scannable "what you get" bullets (typically service feature titles). */
  proofPoints?: string[];
  /** Optional one-line social proof shown in the proof panel footer. */
  testimonial?: HeroTestimonial;
  /** Optional per-page override of the "Trusted by" logo strip. */
  heroLogos?: { name: string; logo: string }[];
}

const {
  lang,
  badge,
  headline,
  subheadline,
  description,
  color = 'primary',
  metrics = [],
  proofPoints = [],
  testimonial,
  heroLogos: heroLogosProp,
} = Astro.props;

// `color` reste accepté pour ne pas toucher aux pages, mais toutes les pages
// services portent désormais le bleu du logo (Paul, 25/09/2026).
void color;

// Bande de logos clients sous les boutons, pour la crédibilité immédiate.
// Defaults to the acquisition clients; a page can override with its own set
// (e.g. AI Training passes its training clients).
const defaultHeroLogos = [
  { name: 'Genesys', logo: '/images/Client logo/genesys-vector-logo.png' },
  { name: 'Quantum Metrics', logo: '/images/Client logo/quantum.png' },
  { name: 'OpenText', logo: '/images/Client logo/opentext-logo.png' },
  { name: 'GWI', logo: '/images/Client logo/GWI.webp' },
  { name: 'BYmyCAR', logo: '/images/Client logo/BYmyCAR.png' },
];
const heroLogos = (heroLogosProp && heroLogosProp.length > 0) ? heroLogosProp : defaultHeroLogos;

const labels = {
  en: { trusted: 'Trusted by', results: 'Real results', whatYouGet: 'What you get', contact: 'Contact us' },
  fr: { trusted: 'Ils nous font confiance', results: 'Résultats concrets', whatYouGet: 'Ce que vous obtenez', contact: 'Nous contacter' },
};
const lbl = labels[lang] || labels.en;

const showPanel = metrics.length > 0 || proofPoints.length > 0;
---

<!-- Le hero des pages services, dans le style de l'accueil depuis le 25/09/2026 :
     fond blanc, titre serré en graisse 800, un seul bleu, et les deux mêmes portes
     que partout sur le site (« Calculer mon budget », « Nous contacter »). Aucune
     animation d'entrée : le titre et le paragraphe sont là dès le premier rendu. -->
<section class="hero-service relative bg-white border-b border-slate-100">
  <div class="container-custom pt-12 pb-16 sm:pt-16 lg:pt-20 lg:pb-24">
    <div class={`grid items-start gap-10 lg:gap-16 ${showPanel ? 'lg:grid-cols-[1.1fr_0.9fr]' : ''}`}>
      <div class={showPanel ? 'max-w-2xl' : 'max-w-3xl'}>
        {badge && (
          <p class="mb-5 text-sm font-semibold text-slate-500">{badge}</p>
        )}

        <h1 class="hero-service-titre font-display text-[2.375rem] sm:text-5xl lg:text-[3.75rem] font-extrabold text-encre mb-6 break-words hyphens-auto" lang={lang}>
          {headline}
        </h1>

        {subheadline && (
          <p class="text-lg sm:text-xl font-semibold text-marque mb-4 text-pretty">
            {subheadline}
          </p>
        )}

        <p class="text-base sm:text-lg text-slate-600 mb-9 max-w-[58ch] text-pretty">
          {description}
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href={`/${lang}/calculator`}
            class="group inline-flex items-center justify-center gap-2 h-13 px-6 rounded-full bg-marque text-white font-semibold hover:bg-marque-fonce active:scale-[0.98] transition-colors"
          >
            {t(lang, 'cta.calculateBudget')}
            <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
          </a>
          <a
            href={`/${lang}/contact`}
            class="inline-flex items-center justify-center h-13 px-6 rounded-full border border-slate-300 text-encre font-semibold hover:border-slate-400 hover:bg-slate-50 transition-colors"
          >
            {lbl.contact}
          </a>
        </div>

        <div class="mt-12">
          <p class="text-xs font-semibold text-slate-500 mb-4">{lbl.trusted}</p>
          <ul class="flex flex-wrap items-center gap-x-7 gap-y-4">
            {heroLogos.map((c) => (
              <li class="h-7 flex items-center">
                <img src={c.logo} alt={c.name} class="max-h-6 w-auto max-w-[108px] object-contain opacity-80" loading="eager" width="108" height="24" />
              </li>
            ))}
          </ul>
        </div>
      </div>

      {showPanel && (
        <div class="rounded-[20px] bg-[#f3f6f9] p-6 sm:p-8">
          {metrics.length > 0 && (
            <>
              <p class="text-xs font-semibold text-slate-500 mb-5">{lbl.results}</p>
              <dl class="grid grid-cols-2 gap-x-6 gap-y-6 mb-7">
                {metrics.slice(0, 4).map((m) => (
                  <div class="flex flex-col-reverse">
                    <dt class="text-sm text-slate-600 mt-1.5 leading-snug">{m.label}</dt>
                    <dd class="font-display font-extrabold text-[2.25rem] sm:text-[2.625rem] leading-none tracking-[-0.04em] text-encre">{m.value}</dd>
                  </div>
                ))}
              </dl>
            </>
          )}

          {proofPoints.length > 0 && (
            <div class={metrics.length > 0 ? 'pt-6 border-t border-slate-200' : ''}>
              <p class="text-xs font-semibold text-slate-500 mb-3">{lbl.whatYouGet}</p>
              <ul class="space-y-2.5">
                {proofPoints.slice(0, 4).map((p) => (
                  <li class="flex items-start gap-2.5 text-[15px] text-slate-700">
                    <svg class="mt-1 w-4 h-4 flex-shrink-0 text-marque" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {testimonial && (
            <figure class="mt-7 pt-6 border-t border-slate-200">
              <blockquote class="text-[15px] text-slate-700 leading-relaxed">{lang === 'fr' ? `«\u00a0${testimonial.quote}\u00a0»` : `“${testimonial.quote}”`}</blockquote>
              <figcaption class="mt-3 text-sm text-slate-500">
                <span class="text-encre font-semibold">{testimonial.author}</span>{testimonial.role ? `, ${testimonial.role}` : ''}{testimonial.company ? `, ${testimonial.company}` : ''}
              </figcaption>
            </figure>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-service-titre {
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
</style>
