---

<!-- Emailing, le service complet (direction Encre, 30/09/2026) : huit chantiers en cartes, le
     premier sur deux colonnes et en encre, trois rangs pleins. -->
<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <ul class="chantiers">
      {t.services.map((s, i) => {
        const fonce = i === 0;
        return (
          <li class:list={['chantier', fonce ? 'carte-encre chantier-large' : 'carte']} data-reveal style={`--i:${i % 3}`}>
            <span class:list={['tuile tuile-grande', { 'tuile-pleine': fonce }]}><Fragment set:html={icons[s.icon as keyof typeof icons]} /></span>
            <h3 class:list={['titre-carte', fonce ? 'text-white' : 'text-encre']}>{s.title}</h3>
            <p class={fonce ? 'text-sur-encre-2' : 'text-slate-600'}>{s.description}</p>
            <ul class="puces">{s.features.map((f) => <li>{f}</li>)}</ul>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .chantiers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .chantier {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 24px;
  }
  .chantier :global(svg) {
    width: 32px;
    height: 32px;
  }
  @media (min-width: 768px) {
    .chantiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .chantiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .chantier {
      padding: 32px;
    }
    .chantier-large {
      grid-column: span 2;
    }
  }
</style>
