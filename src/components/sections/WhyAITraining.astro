---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Why AI Training?",
    headline: "AI isn't coming. It's already here.",
    description: "Companies that embrace AI gain a critical edge. They save time, reduce errors, move faster, and free their teams to focus on what really matters: creativity, strategy, and decision-making.",
    features: [
      {
        icon: "zap",
        title: "Time back on routine work",
        description: "Teams using AI report dramatic productivity gains on routine tasks like content creation, data analysis, and reporting."
      },
      {
        icon: "shield",
        title: "Proper usage & compliance",
        description: "Training prevents misuse and ensures your team uses AI tools safely, respecting data privacy and company guidelines."
      },
      {
        icon: "trending-up",
        title: "Competitive advantage",
        description: "Companies embracing AI move faster and innovate more. Don't let your competitors get ahead while you wait."
      },
      {
        icon: "users",
        title: "Employee empowerment",
        description: "Give your team the skills they need for the future. Confident employees become AI champions in your organization."
      }
    ],
  },
  fr: {
    badge: "Pourquoi une formation IA ?",
    headline: "L'IA n'arrive pas. Elle est déjà là.",
    description: "Les entreprises qui adoptent l'IA gagnent un avantage crucial. Elles gagnent du temps, réduisent les erreurs, avancent plus vite, et libèrent leurs équipes pour se concentrer sur l'essentiel : créativité, stratégie et prise de décision.",
    features: [
      {
        icon: "zap",
        title: "Du temps rendu sur les tâches routinières",
        description: "Les équipes utilisant l'IA rapportent des gains de productivité significatifs sur les tâches routinières."
      },
      {
        icon: "shield",
        title: "Usage correct & conformité",
        description: "La formation prévient les mauvais usages et assure une utilisation sécurisée des outils IA."
      },
      {
        icon: "trending-up",
        title: "Avantage concurrentiel",
        description: "Les entreprises adoptant l'IA avancent plus vite et innovent davantage. Ne laissez pas vos concurrents prendre de l'avance."
      },
      {
        icon: "users",
        title: "Autonomisation des équipes",
        description: "Donnez à vos équipes les compétences pour l'avenir. Des employés confiants deviennent des champions de l'IA."
      }
    ],
  }
};

const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026), correction de cap : le propos, puis quatre cartes de
     verre de tailles différentes, chacune avec sa grande icône (la première sur toute la
     largeur, les trois autres dessous). Plus de « 40 %+ » : aucune source. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.description}</p>
    </header>
    <ul class="raisons">
      {t.features.map((feature, index) => (
        <li class:list={['raison', `raison-${index}`]} data-reveal style={`--i:${index}`}>
          <span class="raison-icone" aria-hidden="true"><Icon name={feature.icon} size={index === 0 ? 36 : 30} /></span>
          <h3 class="raison-titre">{feature.title}</h3>
          <p class="text-sur-encre-2">{feature.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .raisons {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .raison {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 24px;
    border-radius: var(--rayon-panneau);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), 0 30px 60px -36px rgb(2 9 16 / 0.9);
  }
  .raison-icone {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 6px;
    border-radius: 18px;
    background: var(--color-marque);
    color: #fff;
  }
  .raison-titre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  /* La première carte est la raison qui compte : plus grande, sur un verre bleuté. */
  .raison-0 {
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(29 113 184 / 0.45), transparent 65%),
      rgb(255 255 255 / 0.06);
  }
  .raison-0 .raison-icone {
    width: 80px;
    height: 80px;
    border-radius: 22px;
  }
  @media (min-width: 768px) {
    .raisons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .raison-0 {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .raisons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .raison {
      padding: 32px;
    }
    .raison-0 {
      grid-column: 1 / -1;
      grid-template-columns: 80px minmax(0, 1fr);
      column-gap: 28px;
      align-items: center;
      padding: 40px;
    }
    .raison-0 .raison-icone {
      grid-row: span 2;
      margin-bottom: 0;
    }
    .raison-0 .raison-titre {
      font-size: 2rem;
    }
  }
</style>
