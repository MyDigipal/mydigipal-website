    models: {
      title: "Technologies avec lesquelles nous travaillons",
      items: [
        { name: "OpenAI GPT-4", icon: "sparkles" },
        { name: "Anthropic Claude", icon: "message-circle" },
        { name: "Google Gemini", icon: "globe" },
        { name: "Mistral / Llama", icon: "box" },
