const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026) : une section d'encre. Les principes et les étapes en
     listes entre des filets, sans pastilles 01 à 05 ; les durées restent (ce sont les
     conditions du projet, pas des résultats). -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[900px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">
        {t.headline}
        <span class="block text-marque-clair">{t.subheadline}</span>
      </h2>
      <p class="chapo">{t.description}</p>
    </header>

    <ul class="grid gap-x-10 md:grid-cols-2 lg:grid-cols-4">
      {t.principles.map((principle, index) => (
        <li class="grid content-start gap-2 border-t border-white/10 py-7" data-reveal style={`--i:${index}`}>
          <Icon name={principle.icon} size={22} class="mb-1 text-marque-clair" />
          <h3 class="text-lg font-semibold text-white">{principle.title}</h3>
          <p class="text-sur-encre-2">{principle.description}</p>
        </li>
      ))}
    </ul>

    <h3 class="mb-8 mt-16 font-display text-2xl font-extrabold tracking-[-0.02em] text-white lg:mt-24 lg:text-3xl">{t.process.title}</h3>
    <ol class="grid gap-x-8 md:grid-cols-2 lg:grid-cols-5">
      {t.process.steps.map((step, index) => (
        <li class="grid content-start gap-2 border-t border-white/10 py-7" data-reveal style={`--i:${index}`}>
          <h4 class="font-display text-lg font-extrabold tracking-[-0.01em] text-white">{step.title}</h4>
          <p class="text-sur-encre-2">{step.description}</p>
          <p class="text-sm font-semibold text-marque-clair">{step.duration}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 border-t border-white/10 pt-8 lg:mt-20">
      <h3 class="mb-5 text-lg font-semibold text-white">{t.models.title}</h3>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {t.models.items.map((model) => (
          <li class="flex items-center gap-2.5 text-sur-encre">
            <Icon name={model.icon} size={18} class="text-marque-clair" />
            <span>{model.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
