  ambassador: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
  advanced: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
};

---

<!-- Direction Encre (30/09/2026), correction de cap : les cinq acquis en escalier, sur
     l'encre. Chaque marche monte d'un cran, de la peur de l'IA aux cas d'usage avancés :
     la progression se voit avant de se lire. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.intro}</p>
    </header>
    <ol class="marches">
      {t.benefits.map((b, index) => (
        <li class="marche" data-reveal style={`--i:${index};--m:${index}`}>
          <span class="marche-icone" aria-hidden="true"><Fragment set:html={icons[b.icon]} /></span>
          <h3 class="marche-titre">{b.title}</h3>
          <p class="text-sur-encre-2">{b.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .marches {
    display: grid;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marche {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 24px;
    border-radius: var(--rayon-panneau);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  /* La dernière marche est la plus haute : un verre bleuté. */
  .marche:last-child {
    background:
      linear-gradient(180deg, rgb(29 113 184 / 0.55), rgb(29 113 184 / 0.18) 70%),
      rgb(255 255 255 / 0.06);
  }
  .marche-icone {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--color-marque);
    color: #fff;
  }
  .marche-icone :global(svg) {
    width: 28px;
    height: 28px;
  }
  .marche-titre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    /* Sur tablette, l'escalier descend : chaque marche décale d'un cran. */
    .marche {
      margin-left: calc(var(--m) * 28px);
    }
  }
  @media (min-width: 1024px) {
    .marches {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: end;
      gap: 12px;
    }
    .marche {
      min-height: calc(400px + var(--m) * 64px);
      padding: 24px 20px;
    }
  }
</style>
