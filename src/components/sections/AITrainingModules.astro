---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Formats & pricing",
    headline: "Three formats. You set the intensity.",
    subtitle: "The price is per session and doesn't depend on how many people attend. The longer the session, the more your teams get hands-on with their own files.",
    priceLabelRemote: "Remote",
    priceLabelOnsite: "On-site",
    recommended: "Recommended",
    formats: [
      {
        name: "Discovery",
        duration: "1h",
        description: "A high-level panorama: what AI really changes at work, what it doesn't, where the tools stand. We present and answer questions. No exercises.",
        remote: "€700",
        onsite: "€950",
        highlighted: false
      },
      {
        name: "Awareness",
        duration: "2h",
        description: "The panorama plus the foundations: data security and the CRAFT prompting method, with a first hands-on exercise so everyone has touched it.",
        remote: "€1,200",
        onsite: "€1,500",
        highlighted: false
      },
      {
        name: "Hands-on workshop",
        duration: "3h30",
        description: "One topic in depth, lots of exercises: everyone works on their own files. The only format people leave actually knowing how to do it.",
        remote: "€1,700",
        onsite: "€2,100",
        highlighted: true
      }
    ],
    priceNote: "Excl. VAT, per session, regardless of headcount. A surcharge applies beyond 20 people in a plenary session (see below). On-site adds a travel & accommodation flat fee per day, mutualized if several sessions run the same day.",
    includedTitle: "What's included",
    included: [
      "Scoping calls with your teams",
      "A 100% custom program, built on your real cases",
      "Delivery by a hands-on practitioner, not a theorist",
      "Interactive training material handed to every participant",
      "Video recording and written transcript of the session",
      "Tool and best-practice recommendations for your context",
      "Per-session pricing, headcount-independent (except the plenary surcharge)",
      "The volume discount, from the second session"
    ],
    excludedTitle: "Not included",
    excluded: [
      "The on-site surcharge and the travel & accommodation flat fee (neither applies to remote formats)",
      "AI tool subscriptions (Claude Pro, ChatGPT Plus): we advise on the best picks",
      "Room rental if your premises aren't suitable",
      "Development of agents or automations on your infrastructure (separate project, quoted separately)",
      "Operational management of your ad campaigns (separate offer)"
    ],
    scaleTitle: "The more sessions, the less each one costs",
    scaleSubtitle: "A large part of our work (understanding your organization, designing the program, preparing demos on your files) is done once and benefits every session that follows. We pass it back to you.",
    scale: [
      { count: "2 sessions", discount: "-5%" },
      { count: "3-4 sessions", discount: "-10%" },
      { count: "5-7 sessions", discount: "-15%" },
      { count: "8 sessions +", discount: "-20%" }
    ],
    scaleNote: "Applied across all sessions in the program, formats mixed. Sessions don't have to run in the same month: a program can spread over the semester.",
    groupTitle: "How many people per session?",
    groupSubtitle: "The price doesn't depend on headcount, so you can gather widely. But let's be transparent about one thing few providers will tell you: group size changes what we can do for you. Not a matter of price, a matter of available attention.",
    groups: [
      { size: "Up to 12", label: "Maximum personalization", text: "The ideal format, and the cap we set for the hands-on workshop. We work on each person's files, every question gets answered, and we adapt the pace live." },
      { size: "13-20", label: "Good compromise", text: "Still very effective for discovery and awareness: small enough for questions to flow. Individual cases are followed less closely." },
      { size: "20+", label: "Plenary +15%", text: "We teach, demo and answer the group's questions, but we no longer coach anyone individually. A surcharge of +15% beyond 20, +30% beyond 50." }
    ],
    positioningTitle: "A complete training, at a fair price",
    positioningText: "Our hands-on workshop at €1,700 for twelve works out to €142 per head, with custom scoping, interactive material and the replay included.",
    positioningStat: "€142",
    positioningStatLabel: "per head for a hands-on workshop of 12, scoping and replay included",
    cta: "Get your custom quote"
  },
  fr: {
    badge: "Formats & tarifs",
    headline: "Trois formats. Vous réglez l'intensité.",
    subtitle: "Le tarif est par session et ne dépend pas du nombre de participants. Plus la session est longue, plus vos équipes manipulent leurs propres fichiers.",
    priceLabelRemote: "À distance",
    priceLabelOnsite: "Sur site",
    recommended: "Recommandé",
    formats: [
      {
        name: "Découverte",
        duration: "1h",
        description: "Un panorama à haut niveau : ce que l'IA change concrètement au travail, ce qu'elle ne fait pas, où en sont les outils. Nous présentons et répondons aux questions. Pas d'exercice.",
        remote: "700 €",
        onsite: "950 €",
        highlighted: false
      },
      {
        name: "Sensibilisation",
        duration: "2h",
        description: "Le panorama, plus les fondations : sécurité des données et méthode de prompting CRAFT, avec un premier exercice pour que chacun ait touché du doigt.",
        remote: "1 200 €",
        onsite: "1 500 €",
        highlighted: false
      },
      {
        name: "Atelier pratique",
        duration: "3h30",
        description: "Un axe métier en profondeur, beaucoup d'exercices : chacun manipule ses propres fichiers. Le seul format dont les participants ressortent en sachant faire.",
        remote: "1 700 €",
        onsite: "2 100 €",
        highlighted: true
      }
    ],
    priceNote: "Hors TVA, par session, quel que soit le nombre de participants. Une majoration s'applique au-delà de 20 personnes en session plénière (voir plus bas). En présentiel s'ajoute un forfait transport et hébergement par journée, mutualisé si plusieurs sessions se tiennent le même jour.",
    includedTitle: "Ce qui est compris",
    included: [
      "Cadrage et échanges préalables avec vos équipes",
      "Un programme 100 % sur mesure, bâti sur vos cas réels",
      "Une animation par un praticien, pas par un théoricien",
      "Un support de formation interactif remis à chaque participant",
      "Enregistrement vidéo et transcription écrite de la session",
      "Recommandations d'outils et de bonnes pratiques adaptées à votre contexte",
      "Un tarif par session qui ne dépend pas de l'effectif (hors majoration plénière)",
      "La remise volume, dès la deuxième session"
    ],
    excludedTitle: "Non compris",
    excluded: [
      "Le supplément présentiel et le forfait transport et hébergement (aucun des deux sur les formats à distance)",
      "Les abonnements aux outils IA (Claude Pro, ChatGPT Plus) : nous vous conseillons sur les choix",
      "La location d'une salle si vos locaux ne conviennent pas",
      "Le développement d'agents ou d'automatisations sur votre infrastructure (projet distinct, chiffré séparément)",
      "La gestion opérationnelle de vos campagnes publicitaires (offre distincte)"
    ],
    scaleTitle: "Plus vous prenez de sessions, moins chacune coûte",
    scaleSubtitle: "Une part importante de notre travail (comprendre votre organisation, concevoir le programme, préparer les démonstrations sur vos fichiers) se fait une seule fois et bénéficie à toutes les sessions suivantes. Nous vous la répercutons.",
    scale: [
      { count: "2 sessions", discount: "-5 %" },
      { count: "3-4 sessions", discount: "-10 %" },
      { count: "5-7 sessions", discount: "-15 %" },
      { count: "8 sessions +", discount: "-20 %" }
    ],
    scaleNote: "Remise appliquée sur l'ensemble des sessions du parcours, formats mélangés. Les sessions n'ont pas besoin de se tenir dans le même mois : un parcours peut s'étaler sur le semestre.",
    groupTitle: "Combien de personnes par session ?",
    groupSubtitle: "Le tarif ne dépend pas de l'effectif, vous pouvez donc réunir large. Mais soyons transparents sur un point que peu d'organismes disent : la taille du groupe change ce que nous sommes capables de faire. Pas une question de prix, une question d'attention disponible.",
    groups: [
      { size: "Jusqu'à 12", label: "Personnalisation maximale", text: "Le format idéal, et la limite que nous fixons pour l'atelier pratique. Nous travaillons sur les fichiers de chacun, chaque question trouve sa réponse, et nous adaptons le rythme en direct." },
      { size: "13-20", label: "Bon compromis", text: "Toujours très efficace en découverte et sensibilisation : assez petit pour que les questions circulent. Les cas individuels sont suivis moins finement." },
      { size: "20+", label: "Plénière +15 %", text: "Nous transmettons, démontrons et répondons aux questions du groupe, mais nous n'accompagnons plus personne individuellement. Majoration de +15 % au-delà de 20, +30 % au-delà de 50." }
    ],
    positioningTitle: "Une formation complète, à un tarif juste",
    positioningText: "Notre atelier pratique à 1 700 € pour douze revient à 142 € par tête, avec le cadrage sur mesure, le support interactif et le replay compris.",
    positioningStat: "142 €",
    positioningStatLabel: "par tête pour un atelier pratique de 12, cadrage et replay compris",
    cta: "Obtenir un devis sur mesure"
  }
};

const t = translations[lang] || translations.en;

// Correction de cap (30/09/2026) : des tuiles d'icône à la place des coches.
const iconesFormats = ['compass', 'shield', 'pen-tool'];
const iconesCompris = ['compass', 'sliders', 'user', 'file-text', 'play', 'star', 'users', 'trending-down'];
// Les remises en barres : la hauteur suit le pourcentage.
const remiseMax = Math.max(...t.scale.map((sc) => Math.abs(parseFloat(sc.discount.replace(/[^\d.,-]/g, '').replace(',', '.')))));
const hauteurRemise = (d: string) => Math.abs(parseFloat(d.replace(/[^\d.,-]/g, '').replace(',', '.'))) / remiseMax;
// La taille des groupes en points : douze, vingt, puis trente dont les derniers pâlissent.
const pointsGroupe = [12, 20, 30];
---

<!-- Direction Encre (30/09/2026), correction de cap : l'offre sur l'encre, en objets. Les
     trois formats en cartes (l'atelier pratique, recommandé, en blanc et plus large), ce
     qui est compris en tuiles d'icône, les remises en barres, la taille des groupes en
     points. Les prix sont ceux de l'offre. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <div class="formats">
      {t.formats.map((f, i) => (
        <article class:list={['format', { 'format-vedette': f.highlighted }]} data-reveal style={`--i:${i}`}>
          <div class="flex items-start justify-between gap-4">
            <span class="format-icone" aria-hidden="true"><Icon name={iconesFormats[i] ?? 'check'} size={28} /></span>
            {f.highlighted && <span class="format-badge">{t.recommended}</span>}
          </div>
          <p class="format-duree">{f.duration}</p>
          <h3 class="format-nom">{f.name}</h3>
          <p class="format-texte">{f.description}</p>
          <dl class="format-prix">
            <div>
              <dt>{t.priceLabelRemote}</dt>
              <dd>{f.remote}</dd>
            </div>
            <div>
              <dt>{t.priceLabelOnsite}</dt>
              <dd>{f.onsite}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
    <p class="mt-5 max-w-4xl text-sm leading-relaxed text-sur-encre-2">{t.priceNote}</p>

    <div class="mt-16 grid grid-cols-1 gap-10 lg:mt-24 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] lg:gap-12">
      <div>
        <h3 class="mb-6 font-display text-2xl font-extrabold tracking-[-0.02em] text-white">{t.includedTitle}</h3>
        <ul class="compris">
          {t.included.map((item, i) => (
            <li class="compris-tuile">
              <span class="compris-icone" aria-hidden="true"><Icon name={iconesCompris[i] ?? 'check'} size={22} /></span>
              <span class="text-sur-encre">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="exclus">
        <h3 class="mb-5 text-lg font-semibold text-white">{t.excludedTitle}</h3>
        <ul class="grid gap-3">
          {t.excluded.map((item) => (
            <li class="flex items-start gap-3 text-sur-encre-2">
              <svg class="mt-1 h-4 w-4 flex-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-10 border-t border-white/10 pt-12 lg:mt-24 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div class="grid content-start gap-3">
        <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{t.scaleTitle}</h3>
        <p class="text-sur-encre-2">{t.scaleSubtitle}</p>
        <p class="text-sm leading-relaxed text-sur-encre-2">{t.scaleNote}</p>
      </div>
      <ul class="remises">
        {t.scale.map((sc) => (
          <li class="remise" style={`--h:${hauteurRemise(sc.discount).toFixed(3)}`}>
            <span class="remise-valeur">{sc.discount}</span>
            <span class="remise-barre" aria-hidden="true"></span>
            <span class="remise-nombre">{sc.count}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-16 border-t border-white/10 pt-12 lg:mt-20">
      <div class="mb-8 grid max-w-3xl gap-3">
        <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{t.groupTitle}</h3>
        <p class="text-sur-encre-2">{t.groupSubtitle}</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {t.groups.map((g, i) => (
          <div class="groupe">
            <span class="groupe-points" aria-hidden="true">
              {Array.from({ length: pointsGroupe[i] ?? 12 }, (_, k) => (
                <i class:list={{ 'groupe-point-pale': i === 2 && k >= 20 }}></i>
              ))}
            </span>
            <p class="font-display text-2xl font-extrabold text-white">{g.size}</p>
            <p class="font-semibold text-marque-clair">{g.label}</p>
            <p class="text-sur-encre-2">{g.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 grid items-center gap-8 rounded-[20px] bg-white/[0.06] p-8 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)] lg:grid-cols-[1.4fr_1fr] lg:p-12">
      <div>
        <h3 class="mb-4 font-display text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{t.positioningTitle}</h3>
        <p class="text-sur-encre">{t.positioningText}</p>
      </div>
      <div class="lg:border-l lg:border-white/10 lg:pl-8">
        <p class="font-display text-5xl font-extrabold tracking-[-0.04em] text-white md:text-6xl">{t.positioningStat}</p>
        <p class="mt-3 text-sur-encre-2">{t.positioningStatLabel}</p>
      </div>
    </div>

    <div class="mt-12">
      <a href={`/${lang}/contact`} class="pilule pilule-blanche">
        {t.cta}
        <svg class="pilule-fleche h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .formats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .format {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
    border-radius: var(--rayon-panneau);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .format-icone {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.1);
    color: var(--marque-clair);
  }
  .format-badge {
    border-radius: 999px;
    padding: 4px 12px;
    background: var(--color-marque);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .format-duree {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 2rem + 2.4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .format-nom {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .format-texte {
    flex: 1;
    color: var(--texte-sombre-2);
  }
  .format-prix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--filet-sombre);
  }
  .format-prix dt {
    font-size: 0.875rem;
    color: var(--texte-sombre-2);
  }
  .format-prix dd {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: #fff;
  }
  /* Le format recommandé ressort : une carte blanche, plus large, qui déborde. */
  .format-vedette {
    background: #fff;
    box-shadow: 0 40px 80px -30px rgb(2 9 16 / 0.9);
  }
  .format-vedette .format-icone {
    background: var(--color-marque);
    color: #fff;
  }
  .format-vedette .format-duree,
  .format-vedette .format-nom,
  .format-vedette .format-prix dd {
    color: var(--encre);
  }
  .format-vedette .format-texte,
  .format-vedette .format-prix dt {
    color: #4b5b6b;
  }
  .format-vedette .format-prix {
    border-top-color: var(--filet);
  }

  .compris {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .compris-tuile {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .compris-icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--color-marque);
    color: #fff;
  }
  .exclus {
    align-self: start;
    padding: 24px;
    border-radius: var(--rayon-panneau);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  /* Les remises : une barre par palier, la hauteur suit le pourcentage. */
  .remises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
    gap: 10px;
    min-height: 260px;
  }
  .remise {
    display: grid;
    justify-items: start;
    align-content: end;
    gap: 10px;
    height: 100%;
  }
  .remise-valeur {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    line-height: 1;
    color: #fff;
  }
  .remise-barre {
    width: 100%;
    height: calc(40px + var(--h) * 150px);
    border-radius: 10px 10px 4px 4px;
    background: linear-gradient(180deg, var(--marque-clair), var(--color-marque));
  }
  .remise-nombre {
    font-size: 0.9375rem;
    color: var(--texte-sombre-2);
  }

  .groupe {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 24px;
    border-radius: var(--rayon-panneau);
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .groupe-points {
    display: grid;
    grid-template-columns: repeat(10, 14px);
    gap: 6px;
    margin-bottom: 10px;
  }
  .groupe-points i {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--marque-clair);
  }
  .groupe-points .groupe-point-pale {
    opacity: 0.3;
  }

  @media (min-width: 640px) {
    .compris {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .formats {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.3fr);
      gap: 20px;
    }
    .format {
      padding: 32px 28px;
    }
    .format-vedette {
      margin-block: -16px;
      padding: 44px 36px;
    }
  }
</style>
