    ],
    positioningTitle: "Une formation complète, à un tarif juste",
    positioningText: "Notre atelier pratique à 1 700 € pour douze revient à 142 € par tête, avec le cadrage sur mesure, le support interactif et le replay compris.",
    positioningStat: "142 €",
    positioningStatLabel: "par tête pour un atelier pratique de 12, cadrage et replay compris",
    cta: "Obtenir un devis sur mesure"
  }
};

const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026) : l'offre sur une section d'encre. Les trois formats
     côte à côte entre des filets (le recommandé sur un panneau de verre), ce qui est
     compris ou non, les remises, les tailles de groupe. Les prix sont ceux de l'offre ;
     la comparaison avec « le marché », sans source, est retirée. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <div class="grid gap-4 md:grid-cols-3 md:gap-0">
      {t.formats.map((f) => (
        <div class:list={['relative flex flex-col gap-4 rounded-[20px] p-7 md:px-8', f.highlighted ? 'bg-white/[0.07] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.16)]' : 'border-t border-white/10 md:rounded-none md:border-t-0 md:[&:not(:first-child)]:border-l']}>
          {f.highlighted && <span class="self-start rounded-full bg-sur-encre px-3 py-1 text-sm font-semibold text-marque-fonce">{t.recommended}</span>}
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white">{f.name}</h3>
            <span class="text-sm font-semibold text-marque-clair">{f.duration}</span>
          </div>
          <p class="flex-1 text-sur-encre-2">{f.description}</p>
          <dl class="grid grid-cols-2 gap-3 border-t border-white/10 pt-5">
            <div>
              <dt class="text-sm text-sur-encre-2">{t.priceLabelRemote}</dt>
              <dd class="font-display text-2xl font-extrabold text-white">{f.remote}</dd>
            </div>
            <div>
              <dt class="text-sm text-sur-encre-2">{t.priceLabelOnsite}</dt>
              <dd class="font-display text-2xl font-extrabold text-white">{f.onsite}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
    <p class="mt-5 max-w-4xl text-sm leading-relaxed text-sur-encre-2">{t.priceNote}</p>

    <div class="mt-16 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="mb-5 text-lg font-semibold text-white">{t.includedTitle}</h3>
        <ul class="grid gap-3">
          {t.included.map((item) => (
            <li class="flex items-start gap-3 text-sur-encre">
              <svg class="mt-1 h-4 w-4 flex-none text-marque-clair" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="mb-5 text-lg font-semibold text-white">{t.excludedTitle}</h3>
        <ul class="grid gap-3">
          {t.excluded.map((item) => (
            <li class="flex items-start gap-3 text-sur-encre-2">
              <svg class="mt-1 h-4 w-4 flex-none text-sur-encre-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-12">
      <div class="mb-8 grid max-w-3xl gap-3">
        <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{t.scaleTitle}</h3>
        <p class="text-sur-encre-2">{t.scaleSubtitle}</p>
      </div>
      <dl class="grid grid-cols-2 gap-y-6 md:grid-cols-4">
        {t.scale.map((sc) => (
          <div class="flex flex-col-reverse gap-1 border-l border-white/10 pl-5">
            <dt class="text-sur-encre-2">{sc.count}</dt>
            <dd class="font-display text-3xl font-extrabold text-white md:text-4xl">{sc.discount}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 max-w-4xl text-sm leading-relaxed text-sur-encre-2">{t.scaleNote}</p>
    </div>

    <div class="mt-16 border-t border-white/10 pt-12">
      <div class="mb-8 grid max-w-3xl gap-3">
        <h3 class="font-display text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{t.groupTitle}</h3>
        <p class="text-sur-encre-2">{t.groupSubtitle}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {t.groups.map((g) => (
          <div class="grid content-start gap-2">
            <p class="font-display text-2xl font-extrabold text-white">{g.size}</p>
            <p class="font-semibold text-marque-clair">{g.label}</p>
            <p class="text-sur-encre-2">{g.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 grid items-center gap-8 rounded-[20px] bg-white/[0.06] p-8 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)] lg:grid-cols-[1.4fr_1fr] lg:p-12">
      <div>
        <h3 class="mb-4 font-display text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{t.positioningTitle}</h3>
        <p class="text-sur-encre">{t.positioningText}</p>
      </div>
      <div class="lg:border-l lg:border-white/10 lg:pl-8">
        <p class="font-display text-5xl font-extrabold tracking-[-0.04em] text-white md:text-6xl">{t.positioningStat}</p>
        <p class="mt-3 text-sur-encre-2">{t.positioningStatLabel}</p>
      </div>
    </div>

    <div class="mt-12">
      <a href={`/${lang}/contact`} class="pilule pilule-blanche">
        {t.cta}
        <svg class="pilule-fleche h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </div>
</section>
