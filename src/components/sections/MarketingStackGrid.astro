---
/**
 * Les outils de la passerelle MCP (direction Encre, 30/09/2026), sur AI Training et AI
 * Solutions. Deux choses : les trois chiffres de la passerelle en production, puis le mur
 * des outils rangés par famille, chacun avec sa vraie marque EN COULEUR
 * (`logos-outils.ts`, généré par `scripts/logos-outils-mcp.py` depuis simple-icons, CC0).
 * Quatre outils n'ont pas de marque libre (LinkedIn, Ahrefs, Lemlist, Airscale) : leur
 * nom seul, jamais une fausse marque.
 *
 * ⚠️ 244 outils, 21 plateformes, 18+ clients : les chiffres de l'agence, remis à la
 * demande de Paul le 30/09/2026. À tenir à jour ici, dans `MCPBuildSection` et dans
 * `MCPCustomBuildSection`.
 */
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import { LOGOS_OUTILS } from './logos-outils';

interface Props {
  lang: Language;
  variant?: 'training' | 'solutions';
}

const { lang, variant = 'training' } = Astro.props;

const translations = {
  en: {
    training: {
      badge: "Connected stack",
      headline: "Your whole stack. One interface.",
      subtitle:
        "From Google Ads to Lemlist through BigQuery, we connect everything your team already uses. Here's what we orchestrate in production for our clients.",
    },
    solutions: {
      badge: "What we connect",
      headline: "Your stack, orchestrated.",
      subtitle:
        "From Google Ads to Lemlist through BigQuery, we build MCPs and automations on top of the tools you already rely on. Here's what we operate in production today.",
    },
  },
  fr: {
    training: {
      badge: "Stack connectée",
      headline: "Toute votre stack. Une seule interface.",
      subtitle:
        "De Google Ads à Lemlist en passant par BigQuery : on connecte tout ce que votre équipe utilise déjà. Voici ce qu'on orchestre en production pour nos clients.",
    },
    solutions: {
      badge: "Ce qu'on connecte",
      headline: "Votre stack, orchestrée.",
      subtitle:
        "De Google Ads à Lemlist en passant par BigQuery : on construit des MCPs et des automatisations par-dessus les outils que vous utilisez déjà. Voici ce qu'on opère en production aujourd'hui.",
    },
  },
};

const tBlock = translations[lang] || translations.en;
const tVariant = tBlock[variant] || tBlock.training;
const t = tVariant;

type Category = "ppc" | "data" | "seo" | "sales" | "content" | "ops";

interface Platform {
  name: string;
  initials: string;
  color: string;
  category: Category;
  useCase: { en: string; fr: string };
}

const platforms: Platform[] = [
  { name: "Google Ads", initials: "GA", color: "#fbbc05", category: "ppc",
    useCase: { en: "Adjust budgets, create ad groups, export search terms", fr: "Ajuster budgets, créer ad groups, exporter search terms" } },
  { name: "Meta Ads", initials: "MA", color: "#0866ff", category: "ppc",
    useCase: { en: "Audiences, creatives, conversions, budget pacing", fr: "Audiences, créatifs, conversions, pacing de budget" } },
  { name: "LinkedIn Ads", initials: "Li", color: "#0a66c2", category: "ppc",
    useCase: { en: "B2B campaigns, sponsorships, performance metrics", fr: "Campagnes B2B, sponsorisés, métriques de performance" } },
  { name: "Google Analytics 4", initials: "G4", color: "#f9ab00", category: "data",
    useCase: { en: "Traffic, events and conversions by source", fr: "Trafic, événements et conversions par source" } },
  { name: "Search Console", initials: "SC", color: "#458cf5", category: "seo",
    useCase: { en: "Clicks, impressions, CTR by country and device", fr: "Clics, impressions, CTR par pays et device" } },
  { name: "BigQuery", initials: "BQ", color: "#669df6", category: "data",
    useCase: { en: "Query multi-account, detect anomalies, automate reports", fr: "Requêter multi-compte, détecter anomalies, automatiser rapports" } },
  { name: "Tag Manager", initials: "GT", color: "#246fdb", category: "data",
    useCase: { en: "Create tags, triggers, variables across accounts", fr: "Créer tags, déclencheurs, variables multi-comptes" } },
  { name: "Ahrefs", initials: "Ah", color: "#ff6a00", category: "seo",
    useCase: { en: "Backlinks, domain rating, keyword explorer, audit", fr: "Backlinks, domain rating, keyword explorer, audit" } },
  { name: "Lemlist", initials: "Le", color: "#8067e3", category: "sales",
    useCase: { en: "Launch campaigns, enrich leads, CRM webhooks", fr: "Lancer campagnes, enrichir leads, webhooks CRM" } },
  { name: "Airscale", initials: "As", color: "#10b981", category: "sales",
    useCase: { en: "Find emails, phones, LinkedIn profiles at scale", fr: "Trouver emails, téléphones, profils LinkedIn à grande échelle" } },
  { name: "ClickUp", initials: "Cu", color: "#7b68ee", category: "ops",
    useCase: { en: "Tasks, time tracking, docs, sprints, custom fields", fr: "Tâches, time tracking, docs, sprints, champs custom" } },
  { name: "Notion", initials: "No", color: "#0f0f0f", category: "content",
    useCase: { en: "Databases, relations, wikis, client knowledge bases", fr: "Bases de données, relations, wikis, bases de connaissances" } },
  { name: "Gmail", initials: "Gm", color: "#ea4335", category: "content",
    useCase: { en: "Search, drafts, reply with thread context", fr: "Recherche, brouillons, réponses en contexte de thread" } },
  { name: "Google Drive", initials: "Dr", color: "#1fa463", category: "content",
    useCase: { en: "Files, folders, sharing, uploads, shared drives", fr: "Fichiers, dossiers, partage, uploads, drives partagés" } },
  { name: "Sheets", initials: "Sh", color: "#0f9d58", category: "content",
    useCase: { en: "Read and write configs, briefs and reporting dashboards", fr: "Lire/écrire configs, briefs et dashboards de reporting" } },
  { name: "Docs", initials: "Do", color: "#4285f4", category: "content",
    useCase: { en: "Generate reports, update content, template exports", fr: "Générer rapports, mettre à jour contenu, exports templates" } },
  { name: "Slides", initials: "Sl", color: "#f4b400", category: "content",
    useCase: { en: "Replace text, export slide decks from data", fr: "Remplacer textes, exporter decks à partir de données" } },
  { name: "Calendar", initials: "Ca", color: "#4285f4", category: "ops",
    useCase: { en: "Create events, freebusy, multi-calendar scheduling", fr: "Créer événements, freebusy, planification multi-calendrier" } },
  { name: "n8n", initials: "n8", color: "#ea4b71", category: "ops",
    useCase: { en: "Build, version and run workflows from Claude", fr: "Construire, versionner et exécuter des workflows depuis Claude" } },
  { name: "Render", initials: "Re", color: "#46e3b7", category: "ops",
    useCase: { en: "Deploy services, env vars, logs, suspend & resume", fr: "Déployer services, env vars, logs, suspendre & reprendre" } },
];

const categoryLabels: Record<Category, { en: string; fr: string }> = {
  ppc: { en: "Paid Media", fr: "Paid Media" },
  data: { en: "Data", fr: "Data" },
  seo: { en: "SEO", fr: "SEO" },
  sales: { en: "Sales", fr: "Sales" },
  content: { en: "Content", fr: "Contenu" },
  ops: { en: "Ops", fr: "Ops" },
};
// Les outils rangés par famille, dans l'ordre où on les présente.
const familles = (['ppc', 'data', 'seo', 'sales', 'content', 'ops'] as Category[]).map((c) => ({
  nom: categoryLabels[c][lang] || categoryLabels[c].en,
  outils: platforms.filter((p) => p.category === c),
}));

const passerelle = {
  en: {
    titre: "Our MCP gateway, in production",
    chiffres: [
      { cible: 244, suffixe: "", label: "tools exposed" },
      { cible: 21, suffixe: "", label: "platforms connected" },
      { cible: 18, suffixe: "+", label: "active clients" },
    ],
  },
  fr: {
    titre: "Notre passerelle MCP, en production",
    chiffres: [
      { cible: 244, suffixe: "", label: "outils exposés" },
      { cible: 21, suffixe: "", label: "plateformes connectées" },
      { cible: 18, suffixe: "+", label: "clients actifs" },
    ],
  },
}[lang];
---

<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <div class="passerelle" data-counter-section="zero" data-reveal>
      <p class="font-semibold text-sur-encre">{passerelle.titre}</p>
      <dl class="grid grid-cols-3 gap-4 sm:gap-8">
        {passerelle.chiffres.map((c) => (
          <div class="flex flex-col-reverse gap-1">
            <dt class="text-sm leading-snug text-sur-encre-2 sm:text-base">{c.label}</dt>
            <dd class="passerelle-chiffre">
              <span data-target={c.cible} data-suffix={c.suffixe}>{c.cible}{c.suffixe}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="familles mt-14 lg:mt-20">
      {familles.map((f, index) => (
        <div class="famille" data-reveal style={`--i:${index % 3}`}>
          <h3 class="mb-4 font-display text-xl font-extrabold tracking-[-0.02em] text-encre">{f.nom}</h3>
          <ul class="grid gap-3">
            {f.outils.map((o) => {
              const logo = LOGOS_OUTILS[o.name];
              return (
                <li class="outil">
                  <span class="outil-marque" aria-hidden="true">
                    {logo ? (
                      <svg viewBox={logo.viewBox} width="26" height="26" fill={logo.couleur}><path d={logo.trace} /></svg>
                    ) : (
                      <Icon name="box" size={20} class="text-slate-400" />
                    )}
                  </span>
                  <span class="grid gap-0.5">
                    <span class="font-semibold text-encre">{o.name}</span>
                    <span class="text-[0.9375rem] leading-snug text-slate-600">{o.useCase[lang] || o.useCase.en}</span>
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Les trois chiffres sur un panneau d'encre, comme les résultats du hero. */
  .passerelle {
    display: grid;
    gap: 22px;
    padding: 28px 24px;
    border-radius: var(--rayon-panneau);
    background:
      radial-gradient(110% 90% at 100% 0%, rgb(29 113 184 / 0.5) 0%, rgb(29 113 184 / 0.12) 45%, transparent 70%),
      var(--encre);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1), var(--ombre-forte);
  }
  .passerelle-chiffre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.2rem + 5vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: #fff;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Le mur des outils : des colonnes de hauteurs inégales, sans trou. */
  .familles {
    columns: 1;
    column-gap: 40px;
  }
  .famille {
    break-inside: avoid;
    padding-bottom: 36px;
  }
  .outil {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 16px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--filet), 0 1px 2px rgb(11 27 43 / 0.04);
  }
  .outil-marque {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--brume);
  }
  @media (min-width: 640px) {
    .familles {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .passerelle {
      grid-template-columns: 220px minmax(0, 1fr);
      align-items: center;
      gap: 40px;
      padding: 40px 44px;
    }
    .familles {
      columns: 3;
    }
  }
</style>
