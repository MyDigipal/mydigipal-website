---
import { type Language } from '@/i18n/config';
import GrilleMots from '@/components/motion/GrilleMots.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "The foundations",
    headline: "The CRAFT method",
    subtitle: "Most people think \"AI doesn't work\": they just don't know how to ask. CRAFT is the prompt structure that turns a correct answer into a usable one. It's part of the foundations every participant leaves with, alongside the non-negotiable data-security module.",
    craft: [
      { letter: "C", word: "Context", description: "What's the situation or background?", exemple: "I'm preparing Monday's sales meeting with the team." },
      { letter: "R", word: "Role", description: "Who is the AI supposed to act as?", exemple: "You are an experienced sales director." },
      { letter: "A", word: "Action", description: "What do you want it to do?", exemple: "Summarise the quarter's sales and suggest three priorities." },
      { letter: "F", word: "Format", description: "What should the output look like?", exemple: "A table, then a short conclusion." },
      { letter: "T", word: "Tone", description: "How should it sound?", exemple: "Direct, no jargon." }
    ],
    exempleTitre: "The prompt, field by field",
    conclusion: "Each field is one thing the AI no longer has to guess.",
    securityTitle: "Data security, the non-negotiable module",
    securityText: "A client file, a sales sheet or a contract doesn't get pasted just anywhere. We cover which data never to send, which settings to switch on, and which European options exist. We consider this module mandatory in every sector."
  },
  fr: {
    badge: "Les fondations",
    headline: "La méthode CRAFT",
    subtitle: "La plupart des gens pensent que \"l'IA ne fonctionne pas\" : ils ne savent simplement pas la solliciter. CRAFT est la structure de prompt qui transforme un résultat correct en résultat exploitable. Elle fait partie des fondations que chaque participant emporte, avec le module non négociable de sécurité des données.",
    craft: [
      { letter: "C", word: "Contexte", description: "Quelle est la situation ou le contexte ?", exemple: "Je prépare la réunion commerciale de lundi avec l'équipe." },
      { letter: "R", word: "Rôle", description: "Quel rôle doit jouer l'IA ?", exemple: "Tu es un directeur commercial expérimenté." },
      { letter: "A", word: "Action", description: "Que voulez-vous qu'elle fasse ?", exemple: "Résume les ventes du trimestre et propose trois priorités." },
      { letter: "F", word: "Format", description: "À quoi doit ressembler le résultat ?", exemple: "Un tableau, puis une conclusion courte." },
      { letter: "T", word: "Ton", description: "Comment doit-elle s'exprimer ?", exemple: "Direct, sans jargon." }
    ],
    exempleTitre: "Le prompt, champ par champ",
    conclusion: "Chaque champ, c'est une chose que l'IA n'a plus à deviner.",
    securityTitle: "La sécurité des données, le module non négociable",
    securityText: "Un fichier client, un tableau de vente ou un contrat ne se colle pas n'importe où. Nous couvrons quelles données ne jamais envoyer, quels réglages activer et quelles options européennes existent. Nous considérons ce module indispensable, quel que soit le secteur."
  }
};

const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026) : la méthode CRAFT sur une section d'encre, expliquée
     par la grille de mots (chaque lettre est un champ du prompt, sa ligne s'écrit à
     côté). L'ancienne animation laissait les lettres invisibles sans script. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-10 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <GrilleMots
      lang={lang}
      mots={t.craft.map((c) => ({ lettre: c.letter, mot: c.word, description: c.description, exemple: c.exemple }))}
      titreExemple={t.exempleTitre}
      conclusion={t.conclusion}
    />

    <div class="mt-14 grid max-w-[880px] grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 border-t border-white/10 pt-8 lg:mt-20">
      <svg class="row-span-2 mt-1 h-6 w-6 text-marque-clair" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
      <h3 class="text-lg font-semibold text-white">{t.securityTitle}</h3>
      <p class="text-sur-encre-2">{t.securityText}</p>
    </div>
  </div>
</section>
