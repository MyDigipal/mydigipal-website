const t = content[lang];
---

<!-- SEO : l'agence traditionnelle et nous (direction Encre, 30/09/2026). Sur l'encre, le
     tableau se lit en deux colonnes : la façon habituelle en retrait, la nôtre sur une
     bande claire. Puis quatre engagements en cartes de verre. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <div class="comparatif" data-reveal>
      <div class="comparatif-tete" aria-hidden="true">
        <span></span>
        <span class="text-sur-encre-2">{t.traditionalLabel}</span>
        <span class="comparatif-nous">{t.mydigipalLabel}</span>
      </div>
      <ul>
        {t.rows.map((row) => (
          <li class="comparatif-ligne">
            <p class="comparatif-critere"><span class="tuile h-10 w-10 rounded-xl bg-white/10 text-marque-clair"><Icon name={row.iconName} size={20} /></span>{row.category}</p>
            <p class="comparatif-eux"><span class="comparatif-etiquette">{t.traditionalLabel}</span>{row.traditional}</p>
            <p class="comparatif-nous-texte"><span class="comparatif-etiquette">{t.mydigipalLabel}</span>{row.mydigipal}</p>
          </li>
        ))}
      </ul>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-5">
      {t.aspects.map((a, i) => (
        <li class="carte-verre grid content-start gap-3 p-6" data-reveal style={`--i:${i}`}>
          <span class="tuile tuile-pleine"><Icon name={a.icon} size={26} /></span>
          <h3 class="titre-carte text-white">{a.title}</h3>
          <p class="text-sur-encre-2">{a.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12">
      <a href={t.ctaHref} class="pilule pilule-blanche">
        {t.cta}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
    </div>
  </div>
</section>

<style>
  .comparatif {
    border-radius: var(--rayon-panneau);
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    overflow: hidden;
  }
  .comparatif-tete {
    display: none;
  }
  .comparatif-ligne {
    display: grid;
    gap: 10px;
    padding: 20px;
    border-top: 1px solid var(--filet-sombre);
  }
  .comparatif-ligne:first-child {
    border-top: 0;
  }
  .comparatif-critere {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    color: #fff;
  }
  .comparatif-eux {
    color: var(--texte-sombre-2);
  }
  .comparatif-nous-texte {
    padding: 12px 14px;
    border-radius: 12px;
    background: #fff;
    color: var(--encre);
    font-weight: 600;
  }
  .comparatif-etiquette {
    display: block;
    margin-bottom: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0.7;
  }
  @media (min-width: 1024px) {
    .comparatif-tete,
    .comparatif-ligne {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 24px;
      padding: 18px 28px;
    }
    .comparatif-tete {
      font-weight: 600;
      font-size: 0.9375rem;
    }
    .comparatif-nous {
      color: var(--marque-clair);
    }
    .comparatif-etiquette {
      display: none;
    }
    .comparatif-nous-texte {
      margin-block: -6px;
    }
  }
</style>
