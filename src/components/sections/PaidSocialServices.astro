---

<!-- Paid Social, le service complet (direction Encre, 30/09/2026) : six chantiers en cartes de
     verre sur l'encre, le premier sur deux colonnes, le dernier sur toute la largeur. L'appel au calculateur est passé dans
     le ruban de la page (service déjà coché). Les quatre vignettes « Nos créations »
     étaient des aplats sans image : retirées, à remettre avec de vraies créations. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <ul class="chantiers">
      {t.services.map((s, i) => (
        <li class:list={['chantier carte-verre', { 'chantier-large': i === 0, 'chantier-pleine': i === t.services.length - 1 && t.services.length === 6 }]} data-reveal style={`--i:${i % 3}`}>
          <span class="tuile tuile-pleine tuile-grande"><Fragment set:html={icons[s.icon as keyof typeof icons]} /></span>
          <h3 class="titre-carte text-white">{s.title}</h3>
          <p class="text-sur-encre-2">{s.description}</p>
          <ul class="puces">{s.features.map((f) => <li>{f}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .chantiers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .chantier {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 24px;
  }
  .chantier :global(svg) {
    width: 32px;
    height: 32px;
  }
  @media (min-width: 768px) {
    .chantiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .chantiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .chantier {
      padding: 32px;
    }
    /* Six cartes sur trois colonnes : la première sur deux, la dernière sur toute la
       largeur, trois rangs pleins. */
    .chantier-pleine {
      grid-column: 1 / -1;
    }
    .chantier-large {
      grid-column: span 2;
      background:
        radial-gradient(90% 120% at 100% 0%, rgb(29 113 184 / 0.45), transparent 65%),
        rgb(255 255 255 / 0.06);
    }
  }
</style>
