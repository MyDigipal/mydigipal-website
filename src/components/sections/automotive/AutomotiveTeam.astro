---
/**
 * L'équipe, pages automobile (direction Encre, 30/09/2026) : les portraits en couleur et en
 * grand, puis ce dont chacun s'occupe, par rubrique. Plus de voile sombre sur les photos.
 */
import type { Language } from '@/i18n/config';

interface TeamMember {
  name: string;
  role: string;
  image: string;
  responsibilities: Array<{
    category: string;
    items: string[];
  }>;
}

interface Props {
  lang: Language;
  team: TeamMember[];
  fond?: 'blanc' | 'brume';
}

const { lang, team, fond = 'blanc' } = Astro.props;

const t = {
  en: { titre: 'The people who run your campaigns', chapo: 'A small automotive team: the same people from the audit to the monthly review.' },
  fr: { titre: 'Les personnes qui pilotent vos campagnes', chapo: 'Une équipe automobile resserrée : les mêmes personnes de l’audit au point mensuel.' },
}[lang];
---

<section class:list={['py-20 lg:py-32', fond === 'brume' ? 'section-brume' : 'section-blanc']}>
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.titre}</h2>
      <p class="chapo">{t.chapo}</p>
    </header>

    <ul class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-6 lg:gap-8">
      {team.map((m, i) => (
        <li class="grid content-start gap-5" data-reveal style={`--i:${i}`}>
          <img
            src={m.image}
            alt={m.name}
            class="aspect-[4/3] w-full rounded-[var(--rayon-panneau)] object-cover object-[50%_20%] md:aspect-[4/5] md:object-top"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 class="titre-carte text-encre">{m.name}</h3>
            <p class="mt-1 font-medium text-marque">{m.role}</p>
          </div>
          <dl class="grid gap-3 border-t border-slate-200 pt-4">
            {m.responsibilities.map((r) => (
              <div>
                <dt class="text-sm font-semibold text-encre">{r.category}</dt>
                {r.items.map((item) => <dd class="mt-0.5 text-[0.9375rem] leading-snug text-slate-600">{item}</dd>)}
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  </div>
</section>
