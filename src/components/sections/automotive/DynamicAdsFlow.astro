---
/**
 * Dynamic Ads, la notion de la page : le stock qui devient l'annonce. Depuis le 01/10/2026,
 * c'est la chaîne en isométrie (`motion/ChaineStock.astro`) qui l'explique : les voitures
 * deviennent un flux, Merchant Center en fait des annonces, un acheteur en choisit une.
 * Ses cinq étapes s'allument à côté de la scène ; elles remplacent la carte de verre et les
 * quatre cartes numérotées d'avant.
 */
import type { Language } from '@/i18n/config';
import ChaineStock from '@/components/motion/ChaineStock.astro';

interface Props {
  lang: Language;
  /** Accepté pour ne pas toucher aux pages. */
  color?: string;
}

const { lang, color } = Astro.props;
void color;

const translations = {
  en: {
    title: 'Your stock becomes the ad',
    subtitle: 'Dynamic Ads in one picture: every vehicle in stock becomes an ad, shown to the buyer it interests, on Google, Facebook and Instagram.',
  },
  fr: {
    title: 'Votre stock devient l’annonce',
    subtitle: 'Les Dynamic Ads, en une image : chaque véhicule du stock devient une annonce, montrée à l’acheteur qu’elle intéresse, sur Google, Facebook et Instagram.',
  },
};

const t = translations[lang] || translations.en;
---

<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 id="flux-titre" class="titre-moyen">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <ChaineStock lang={lang} fond="encre" />
  </div>
</section>
