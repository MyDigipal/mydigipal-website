---
/**
 * Dynamic Ads, un catalogue et trois plateformes (direction Encre, 30/09/2026) : sur la
 * brume, une carte blanche par plateforme avec sa marque EN COULEUR, ses formats et son
 * audience. Les audiences (2,9 Mrd, 2 Mrd, 90 %) sont des chiffres de marché sans source
 * affichée, gardés en attendant la décision de Paul.
 */
import type { Language } from '@/i18n/config';
import Marque from '@/components/ui/Marque.astro';

interface Props {
  lang: Language;
  /** Accepté pour ne pas toucher aux pages. */
  color?: string;
}

const { lang, color } = Astro.props;
void color;

const translations = {
  en: {
    title: 'One Catalog, All Platforms',
    subtitle: 'Your vehicle inventory automatically displays across the most powerful advertising networks',
    channels: [
      {
        name: 'Facebook',
        icon: 'facebook',
        color: 'from-blue-600 to-blue-700',
        shadow: 'shadow-blue-500/30',
        description: 'Reach billions of users with personalized vehicle ads in their news feed and marketplace',
        features: ['News Feed Ads', 'Marketplace Integration', 'Carousel Formats', 'Lead Generation Forms'],
        reach: '2.9B',
        reachLabel: 'Monthly Users'
      },
      {
        name: 'Instagram',
        icon: 'instagram',
        color: 'from-pink-500 via-purple-500 to-orange-400',
        shadow: 'shadow-pink-500/30',
        description: 'Showcase your vehicles with stunning visuals to an engaged, younger audience',
        features: ['Stories & Reels', 'Feed Posts', 'Shop Integration', 'Visual Discovery'],
        reach: '2B',
        reachLabel: 'Monthly Users'
      },
      {
        name: 'Google Display',
        icon: 'globe',
        color: 'from-emerald-500 to-teal-600',
        shadow: 'shadow-emerald-500/30',
        description: 'Appear across millions of websites and apps when users research vehicles',
        features: ['Display Network', 'Discovery Ads', 'YouTube Placements', 'Gmail Ads'],
        reach: '90%',
        reachLabel: 'Internet Reach'
      }
    ],
    learnMore: 'Learn More'
  },
  fr: {
    title: 'Un catalogue, toutes les plateformes',
    subtitle: 'Un seul catalogue, une seule configuration : vos véhicules s\'affichent sur les trois grands réseaux publicitaires, qui travaillent ensemble.',
    channels: [
      {
        name: 'Facebook',
        icon: 'facebook',
        color: 'from-blue-600 to-blue-700',
        shadow: 'shadow-blue-500/30',
        description: 'Touchez des milliards d\'utilisateurs avec des annonces personnalisées dans leur fil d\'actualité et sur Marketplace.',
        features: ['Publicités dans le fil d\'actualité', 'Intégration Marketplace', 'Formats carrousel', 'Formulaires de leads'],
        reach: '2,9 Mrd',
        reachLabel: 'utilisateurs par mois'
      },
      {
        name: 'Instagram',
        icon: 'instagram',
        color: 'from-pink-500 via-purple-500 to-orange-400',
        shadow: 'shadow-pink-500/30',
        description: 'Présentez vos véhicules en images, à une audience plus jeune et très engagée.',
        features: ['Stories et Reels', 'Publications dans le fil', 'Intégration Shop', 'Découverte visuelle'],
        reach: '2 Mrd',
        reachLabel: 'utilisateurs par mois'
      },
      {
        name: 'Google Display',
        icon: 'globe',
        color: 'from-emerald-500 to-teal-600',
        shadow: 'shadow-emerald-500/30',
        description: 'Apparaissez sur des millions de sites et d\'applications quand les utilisateurs cherchent un véhicule.',
        features: ['Réseau Display', 'Discovery Ads', 'Placements YouTube', 'Annonces Gmail'],
        reach: '90 %',
        reachLabel: 'des internautes touchés'
      }
    ],
    learnMore: 'En savoir plus'
  }
};

const t = translations[lang] || translations.en;
const marque: Record<string, string> = { Facebook: 'Facebook', Instagram: 'Instagram', 'Google Display': 'Google Ads' };
---

<section class="section-brume py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <ul class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-5">
      {t.channels.map((c, i) => (
        <li class="carte flex flex-col gap-5 p-6 lg:p-8" data-reveal style={`--i:${i}`}>
          <span class="grid h-16 w-16 flex-none place-items-center rounded-[18px] bg-brume-clair"><Marque nom={marque[c.name] ?? c.name} taille={34} /></span>
          <div class="grid gap-2">
            <h3 class="titre-carte text-encre">{c.name}</h3>
            <p class="text-slate-600 text-pretty">{c.description}</p>
          </div>
          <ul class="puces">{c.features.map((f) => <li>{f}</li>)}</ul>
          <p class="mt-auto flex items-baseline gap-2 border-t border-slate-200 pt-5">
            <span class="font-display text-4xl font-extrabold tracking-[-0.04em] text-encre">{c.reach}</span>
            <span class="text-slate-600">{c.reachLabel}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
