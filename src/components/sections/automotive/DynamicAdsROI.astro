---
/**
 * Dynamic Ads, avant et après (direction Encre, 30/09/2026) : sur le blanc, quatre chiffres
 * en grand, puis la publicité classique sur une carte grise et les Dynamic Ads sur une carte
 * d'encre. Chiffres de l'agence sans source affichée, gardés en attendant la décision de Paul.
 */
import type { Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
  /** Accepté pour ne pas toucher aux pages. */
  color?: string;
}

const { lang, color } = Astro.props;
void color;

const translations = {
  en: {
    title: 'The ROI of Dynamic Ads',
    subtitle: 'Why leading dealerships are switching to automated inventory advertising',
    comparison: {
      title: 'Traditional ads vs Dynamic Ads',
      traditional: {
        label: 'Traditional advertising',
        items: [
          { label: 'Cost per lead', value: '€25-80', negative: true },
          { label: 'Setup Time', value: '10+ hours/week', negative: true },
          { label: 'Personalization', value: 'Manual', negative: true },
          { label: 'Inventory updates', value: 'Manual', negative: true },
          { label: 'Multi-platform', value: 'Separate campaigns', negative: true }
        ]
      },
      dynamic: {
        label: 'Dynamic Ads',
        items: [
          { label: 'Cost per lead', value: '€3-10', positive: true },
          { label: 'Setup Time', value: '< 1 hour/week', positive: true },
          { label: 'Personalization', value: 'Automatic', positive: true },
          { label: 'Inventory updates', value: 'Real-time', positive: true },
          { label: 'Multi-platform', value: 'One catalog', positive: true }
        ]
      }
    },
    stats: [
      { value: '85%', label: 'Lower cost per lead', icon: 'trending-down' },
      { value: '7x', label: 'More leads generated', icon: 'users' },
      { value: '10h', label: 'Saved weekly', icon: 'clock' },
      { value: '3x', label: 'Higher conversion rate', icon: 'target' }
    ],
    cta: 'Calculate Your ROI'
  },
  fr: {
    title: 'Le ROI des Dynamic Ads',
    subtitle: 'Pourquoi les concessions passent à une publicité qui suit leur stock toute seule.',
    comparison: {
      title: 'Publicité traditionnelle vs Dynamic Ads',
      traditional: {
        label: 'Publicité traditionnelle',
        items: [
          { label: 'Coût par lead', value: '25 à 80 €', negative: true },
          { label: 'Temps passé', value: '10 h et plus par semaine', negative: true },
          { label: 'Personnalisation', value: 'Manuelle', negative: true },
          { label: 'Mises à jour du stock', value: 'Manuelles', negative: true },
          { label: 'Plateformes', value: 'Campagnes séparées', negative: true }
        ]
      },
      dynamic: {
        label: 'Dynamic Ads',
        items: [
          { label: 'Coût par lead', value: '3 à 10 €', positive: true },
          { label: 'Temps passé', value: 'moins d\'1 h par semaine', positive: true },
          { label: 'Personnalisation', value: 'Automatique', positive: true },
          { label: 'Mises à jour du stock', value: 'En temps réel', positive: true },
          { label: 'Plateformes', value: 'Un seul catalogue', positive: true }
        ]
      }
    },
    stats: [
      { value: '85 %', label: 'de coût par lead en moins', icon: 'trending-down' },
      { value: '7x', label: 'plus de leads générés', icon: 'users' },
      { value: '10 h', label: 'économisées par semaine', icon: 'clock' },
      { value: '3x', label: 'de taux de conversion', icon: 'target' }
    ],
    cta: 'Calculer votre ROI'
  }
};

const t = translations[lang] || translations.en;
---

<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <dl class="grid grid-cols-2 gap-x-6 gap-y-8 border-y border-slate-200 py-10 lg:grid-cols-4 lg:py-12">
      {t.stats.map((s, i) => (
        <div class="flex flex-col-reverse gap-2" data-reveal style={`--i:${i}`}>
          <dt class="text-slate-600">{s.label}</dt>
          <dd class="font-display text-5xl font-extrabold leading-none tracking-[-0.045em] text-encre lg:text-6xl">{s.value}</dd>
        </div>
      ))}
    </dl>

    <h3 class="titre-carte mt-16 mb-6 text-encre lg:mt-24">{t.comparison.title}</h3>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5">
      <div class="rounded-[var(--rayon-panneau)] bg-brume-clair p-6 lg:p-8" data-reveal>
        <p class="mb-5 font-semibold text-slate-600">{t.comparison.traditional.label}</p>
        <ul class="grid gap-0">
          {t.comparison.traditional.items.map((item) => (
            <li class="flex items-center justify-between gap-4 border-b border-slate-200 py-3.5 last:border-0">
              <span class="text-slate-600">{item.label}</span>
              <span class="flex items-center gap-1.5 text-right font-semibold text-slate-800">
                <Icon name="x" size={16} class="flex-none text-red-500" />
                {item.value}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="carte-encre p-6 lg:p-8" data-reveal style="--i:1">
        <p class="mb-5 font-semibold text-white">{t.comparison.dynamic.label}</p>
        <ul class="grid gap-0">
          {t.comparison.dynamic.items.map((item) => (
            <li class="flex items-center justify-between gap-4 border-b border-white/10 py-3.5 last:border-0">
              <span class="text-sur-encre-2">{item.label}</span>
              <span class="flex items-center gap-1.5 text-right font-semibold text-white">
                <Icon name="check" size={16} class="flex-none text-marque-clair" />
                {item.value}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
