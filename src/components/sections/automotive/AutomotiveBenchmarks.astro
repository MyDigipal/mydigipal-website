---
/**
 * Les résultats de trois concessions, pages automobile (direction Encre, 30/09/2026) : sur
 * l'encre, le chiffre en très grand, le logo du client EN COULEUR sur sa plaque blanche
 * (Paul, 30/09/2026 : plus de gris), la comparaison dessous. La première carte est la plus
 * large. Les chiffres sont ceux de la fiche MDX (chiffres de l'agence, gardés, à sourcer).
 */
import type { Language } from '@/i18n/config';

interface Benchmark {
  logo: string;
  logoAlt: string;
  value: string;
  label: string;
  comparison?: string;
}

interface Props {
  lang: Language;
  benchmarks: Benchmark[];
  /** Accepté pour ne pas toucher aux pages. */
  color?: string;
}

const { lang, benchmarks, color } = Astro.props;
void color;

const t = {
  en: { titre: 'Outperforming the competition', chapo: 'Results from our automotive clients, set against the averages of the sector.' },
  fr: { titre: 'Mieux que la moyenne du secteur', chapo: 'Les résultats de nos clients automobiles, comparés aux moyennes du secteur.' },
}[lang];

// « 0.2€ » s'écrit « 0,2 € » en français.
const valeur = (v: string) => (lang === 'fr' ? v.replace(/(\d)\.(\d)/g, '$1,$2').replace(/(\d)\s?(%|€)/g, '$1\u00a0$2') : v);
---

<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.titre}</h2>
      <p class="chapo">{t.chapo}</p>
    </header>

    <ul class="auto-bench">
      {benchmarks.map((b, i) => (
        <li class:list={['auto-bench-carte carte-verre', { 'auto-bench-tete': i === 0 }]} data-reveal style={`--i:${i}`}>
          <span class="auto-bench-logo">
            <img src={b.logo} alt={b.logoAlt} loading="lazy" decoding="async" />
          </span>
          <p class="auto-bench-chiffre">{valeur(b.value)}</p>
          <div class="grid gap-1.5">
            <h3 class="text-lg font-semibold text-white">{b.label}</h3>
            {b.comparison && <p class="text-sur-encre-2">{valeur(b.comparison)}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .auto-bench {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .auto-bench-carte {
    display: grid;
    align-content: start;
    gap: 20px;
    padding: 28px 24px;
  }
  .auto-bench-tete {
    background:
      radial-gradient(110% 90% at 0% 0%, rgb(29 113 184 / 0.55), transparent 62%),
      rgb(255 255 255 / 0.06);
  }
  .auto-bench-logo {
    display: grid;
    place-items: center;
    justify-self: start;
    height: 56px;
    padding: 8px 16px;
    border-radius: 14px;
    background: #fff;
  }
  .auto-bench-logo img {
    max-height: 40px;
    max-width: 140px;
    width: auto;
    object-fit: contain;
  }
  .auto-bench-chiffre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 1.6rem + 3vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: #fff;
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .auto-bench {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: 20px;
    }
    .auto-bench-carte {
      padding: 36px 32px;
    }
    .auto-bench-tete .auto-bench-chiffre {
      font-size: clamp(4rem, 1.6rem + 4.5vw, 6.5rem);
    }
  }
</style>
