---
/**
 * Les questions, pages automobile : la présentation de `ServiceFAQ` (direction Encre,
 * 30/09/2026) avec les questions de la fiche MDX. Le titre à gauche, collé en haut de
 * l'écran sur ordinateur, les questions à droite entre des filets, en `<details>` : les
 * réponses sont dans le HTML servi, elles s'ouvrent sans script. Placées AVANT l'appel
 * final, avec leurs données structurées.
 */
import type { Language } from '@/i18n/config';
import FAQSchema from '@/components/seo/FAQSchema.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  lang: Language;
  faq: FAQItem[];
  /** Accepté pour ne pas toucher aux pages. */
  color?: string;
}

const { lang, faq, color } = Astro.props;
void color;

const t = {
  en: { titre: 'Frequently asked questions', chapo: 'What dealerships ask us before they start.' },
  fr: { titre: 'Questions fréquentes', chapo: 'Ce que les concessions nous demandent avant de commencer.' },
}[lang];
---

<FAQSchema faqs={faq} />

<section class="auto-faq section-blanc py-20 lg:py-32">
  <div class="container-custom grid items-start gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-18">
    <header class="grid gap-5 lg:sticky lg:top-28 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.titre}</h2>
      <p class="chapo">{t.chapo}</p>
    </header>

    <div>
      {faq.map((item) => (
        <details class="auto-faq-question border-b border-slate-200 first:border-t">
          <summary class="flex cursor-pointer items-start justify-between gap-5 py-[22px] lg:py-[26px]">
            <span class="font-display text-lg font-bold leading-snug tracking-[-0.01em] text-encre lg:text-xl">{item.question}</span>
            <svg class="auto-faq-plus mt-0.5 h-6 w-6 flex-none text-marque" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <p class="max-w-[66ch] pb-[26px] pr-11 text-base leading-relaxed text-slate-600 text-pretty lg:text-[1.0625rem]">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .auto-faq-question summary {
    list-style: none;
  }
  .auto-faq-question summary::-webkit-details-marker {
    display: none;
  }
  .auto-faq-question summary:hover span {
    color: var(--color-marque);
  }
  .auto-faq-plus {
    transition: transform 400ms var(--mdp-entree);
  }
  .auto-faq-question[open] .auto-faq-plus {
    transform: rotate(45deg);
  }
</style>
