---
/**
 * Les cas d'usage, pages automobile (direction Encre, 30/09/2026) : une ligne par cas,
 * l'image de la fiche en grand dans son cadre gris clair, alternée à gauche et à droite,
 * le texte de l'autre côté, ce qui est compris en puces. Sur le blanc.
 */
import type { Language } from '@/i18n/config';

interface UseCase {
  id: string;
  title: string;
  description: string;
  image?: string;
  features?: string[];
}

interface Props {
  lang: Language;
  useCases: UseCase[];
  /** Le titre et le chapeau propres à la page ; à défaut, un titre commun. */
  titre?: string;
  chapo?: string;
  /** Accepté pour ne pas toucher aux pages. */
  color?: string;
}

const { lang, useCases, titre, chapo, color } = Astro.props;
void color;

const t = {
  titre: titre ?? (lang === 'fr' ? 'Ce qu’on met en place' : 'What we put in place'),
  chapo,
};
---

<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-20 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.titre}</h2>
      {t.chapo && <p class="chapo">{t.chapo}</p>}
    </header>

    <div class="grid gap-16 lg:gap-24">
      {useCases.map((u, i) => (
        <article class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-16" data-reveal>
          {u.image && (
            <figure class:list={['auto-cas-visuel', { 'lg:order-last': i % 2 === 1 }]}>
              <img src={u.image} alt="" loading="lazy" decoding="async" />
            </figure>
          )}
          <div class="grid content-start gap-4">
            <p class="text-sm font-semibold text-slate-500">{u.id}</p>
            <h3 class="titre-carte text-encre lg:text-[2rem]">{u.title}</h3>
            <p class="text-lg leading-relaxed text-slate-600 text-pretty">{u.description}</p>
            {u.features && u.features.length > 0 && (
              <ul class="puces mt-2">
                {u.features.map((f) => <li>{f}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .auto-cas-visuel {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin: 0;
    padding: 28px;
    border-radius: var(--rayon-scene);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--filet), 0 24px 50px -36px rgb(11 27 43 / 0.35);
  }
  .auto-cas-visuel img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
