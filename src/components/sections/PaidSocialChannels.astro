// La marque de chaque plateforme (simple-icons ; LinkedIn par son glyphe).
const marques: Record<string, string> = { linkedin: 'LinkedIn', facebook: 'Meta Ads', youtube: 'YouTube', twitter: 'X' };

---

<!-- Paid Social, les plateformes (direction Encre, 30/09/2026) : quatre cartes avec la vraie
     marque de chaque plateforme, en couleur. LinkedIn, la plateforme du B2B, en encre et
     sur deux colonnes. -->
<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <ul class="plateformes">
      {t.channels.map((c, i) => {
        const fonce = i === 0;
        return (
          <li class:list={['plateforme', fonce ? 'carte-encre plateforme-large' : 'carte', { 'plateforme-large': i === 3 }]} data-reveal style={`--i:${i % 3}`}>
            <div class="flex items-start justify-between gap-4">
              <span class="grid h-16 w-16 flex-none place-items-center rounded-2xl bg-white shadow-[inset_0_0_0_1px_var(--filet)]"><Marque nom={marques[c.icon] ?? c.name} taille={32} /></span>
              <p class="text-right">
                <span class:list={['block font-display text-3xl font-extrabold tracking-[-0.03em]', fonce ? 'text-white' : 'text-encre']}>{c.stat}</span>
                <span class={fonce ? 'text-sur-encre-2' : 'text-slate-500'}>{c.statLabel}</span>
              </p>
            </div>
            <h3 class:list={['titre-carte text-2xl', fonce ? 'text-white' : 'text-encre']}>{c.name}</h3>
            <p class={fonce ? 'text-sur-encre-2' : 'text-slate-600'}>{c.description}</p>
            <ul class="puces">{c.features.map((f) => <li>{f}</li>)}</ul>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .plateformes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .plateforme {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 28px 24px;
  }
  @media (min-width: 768px) {
    .plateformes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .plateformes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .plateforme {
      padding: 32px;
    }
    .plateforme-large {
      grid-column: span 2;
    }
  }
</style>
