---

<!-- SEO, phase 2 : le SEO technique (direction Encre, 30/09/2026). Les cartes qui se
     retournent sont gardées : le recto dit le chantier, le verso son détail. Tailles
     variées (la première et la dernière sur deux colonnes). Au clavier et au doigt, le
     bouton de la carte la retourne. -->
<section id="technical-seo" class="section-brume py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <ul class="retournes">
      {t.items.map((item, i) => (
        <li class:list={['retourne', { 'retourne-large': i === 0 || i === 3 }]} data-retourne data-reveal style={`--i:${i % 3}`}>
          <div class="retourne-int">
            <div class="retourne-face retourne-recto carte">
              <span class="tuile tuile-grande"><Icon name={item.icon} size={32} /></span>
              <h3 class="titre-carte text-encre">{item.title}</h3>
              <p class="text-slate-600">{item.frontText}</p>
              <button type="button" class="retourne-bouton" data-retourner aria-expanded="false">
                {lang === 'fr' ? 'Voir le détail' : 'See the detail'}<Icon name="refresh-cw" size={16} />
              </button>
            </div>
            <div class="retourne-face retourne-verso carte-encre">
              <p class="titre-carte text-white" aria-hidden="true">{item.title}</p>
              <ul class="retourne-liste">
                {item.backDetails.map((d) => <li>{d}</li>)}
              </ul>
              <button type="button" class="retourne-bouton retourne-bouton-clair" data-retourner aria-expanded="true">
                {lang === 'fr' ? 'Retour' : 'Back'}<Icon name="refresh-cw" size={16} />
              </button>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href={`/${lang}/contact`} class="pilule pilule-pleine">
        {t.cta.text}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
      <p class="text-slate-500">{t.cta.subtext}</p>
    </div>
  </div>
</section>

<style>
  .retournes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .retourne {
    perspective: 1400px;
    min-height: 340px;
  }
  .retourne-int {
    position: relative;
    height: 100%;
    min-height: inherit;
    transition: transform 0.7s cubic-bezier(0.15, 1, 0.32, 1);
    transform-style: preserve-3d;
  }
  .retourne-face {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 24px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .retourne-verso {
    transform: rotateY(180deg);
  }
  .retourne.est-retournee .retourne-int {
    transform: rotateY(180deg);
  }
  @media (hover: hover) {
    .retourne:not(.est-manuel):hover .retourne-int {
      transform: rotateY(180deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .retourne-int {
      transition: none;
    }
  }
  .retourne-bouton {
    align-self: end;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: auto;
    font-weight: 600;
    color: var(--color-marque);
  }
  .retourne-bouton-clair {
    color: var(--marque-clair);
  }
  .retourne-recto {
    grid-template-rows: auto auto auto 1fr;
  }
  .retourne-verso {
    grid-template-rows: auto 1fr auto;
  }
  .retourne-liste {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .retourne-liste li {
    position: relative;
    padding-left: 18px;
    color: var(--texte-sombre);
  }
  .retourne-liste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 2px;
    border-radius: 2px;
    background: var(--marque-clair);
  }
  @media (min-width: 768px) {
    .retournes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .retournes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .retourne-large {
      grid-column: span 2;
    }
    .retourne-face {
      padding: 32px;
    }
    .retourne-large .retourne-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }
</style>

<script>
  function monterRetournes() {
    document.querySelectorAll<HTMLElement>('[data-retourne]').forEach((carte) => {
      if (carte.dataset.monte) return;
      carte.dataset.monte = '1';
      carte.querySelectorAll<HTMLButtonElement>('[data-retourner]').forEach((b) => {
        b.addEventListener('click', () => {
          // Après un clic, le survol ne retourne plus la carte : c'est le bouton qui décide.
          carte.classList.add('est-manuel');
          const oui = carte.classList.toggle('est-retournee');
          // Le focus suit la face visible.
          const cible = carte.querySelector<HTMLButtonElement>(oui ? '.retourne-verso [data-retourner]' : '.retourne-recto [data-retourner]');
          window.setTimeout(() => cible?.focus({ preventScroll: true }), 60);
        });
      });
    });
  }
  monterRetournes();
  document.addEventListener('astro:page-load', monterRetournes);
</script>
