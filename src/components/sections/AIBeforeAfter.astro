---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Before / after",
    headline: "What this looks like in your business",
    subheadline: "Four tasks your team still does by hand today, and what is left of them once a system takes over.",
    beforeLabel: "Today, by hand",
    afterLabel: "Once automated",
    humanLabel: "Still done by a human",
    footnote: "Every setup starts by looking at how you actually work, with your volume and your tools.",
    tasks: [
      {
        icon: "mail",
        title: "Sorting and qualifying inbound requests",
        time: "roughly 3 to 5 hours a week",
        before: "Someone opens every message, works out whether it is a prospect, a client or cold outreach, then forwards it to the right person. Anything landing on Friday evening waits until Monday.",
        after: "Every request is read, summarised, sorted by type and by urgency, then pushed into the CRM and flagged to the right person within minutes.",
        human: "Deciding what to answer once a request is qualified, and settling the edge cases the system flags.",
      },
      {
        icon: "mic",
        title: "Meeting notes and follow-ups",
        time: "roughly 2 to 4 hours a week",
        before: "Notes are written up after the fact, the summary is drafted by hand, then the actions are copied into the project tool. Usually the next day, once the details have already blurred.",
        after: "The summary is drafted from the recording, decisions and actions are extracted with an owner and a due date, and the tasks are created in the tool the team already uses.",
        human: "Reading the summary before it goes out, and correcting whatever was misheard.",
      },
      {
        icon: "file-text",
        title: "Chasing quotes with no reply",
        time: "roughly 1 to 2 hours a week, when it happens at all",
        before: "You have to remember who never came back, reopen the quote, dig through the thread for context, then write something that does not read like a template. Chasing always comes last.",
        after: "Quotes with no reply surface on their own at the right moment, with a follow-up already drafted from the context of the deal, ready to send or to edit.",
        human: "Reading the draft, tailoring it to the client, and deciding when to stop chasing.",
      },
      {
        icon: "bar-chart-2",
        title: "Putting the monthly report together",
        time: "roughly 2 hours a week, bunched at month end",
        before: "Export each platform, paste the tables together, format the whole thing, rewrite the same commentary. The file is ready a week after the month has closed.",
        after: "The data is pulled together on its own, notable swings are picked out, and the report arrives pre-filled with a first draft of the commentary on what moved.",
        human: "Explaining why it moved, deciding what changes next month, and telling the client.",
      },
    ],
  },
  fr: {
    badge: "Avant / après",
    headline: "À quoi ça ressemble chez vous",
    subheadline: "Quatre tâches que vos équipes font encore à la main aujourd'hui, et ce qu'il en reste une fois qu'un système s'en occupe.",
    beforeLabel: "Aujourd'hui, à la main",
    afterLabel: "Une fois automatisé",
    humanLabel: "Ce qui reste à un humain",
    footnote: "Chaque mise en place commence par regarder comment vous travaillez vraiment, avec votre volume et vos outils.",
    tasks: [
      {
        icon: "mail",
        title: "Le tri et la qualification des demandes entrantes",
        time: "environ 3 à 5 heures par semaine",
        before: "Quelqu'un ouvre chaque message, devine s'il s'agit d'un prospect, d'un client ou d'un démarchage, puis le transfère à la bonne personne. Ce qui arrive le vendredi soir attend le lundi.",
        after: "Chaque demande est lue, résumée, classée par type et par urgence, puis déposée dans le CRM et signalée à la bonne personne en quelques minutes.",
        human: "Décider quoi répondre une fois la demande qualifiée, et arbitrer les cas ambigus que le système signale.",
      },
      {
        icon: "mic",
        title: "Les comptes rendus de réunion et leur suivi",
        time: "environ 2 à 4 heures par semaine",
        before: "On reprend ses notes après coup, on rédige le compte rendu à la main, puis on recopie les actions dans l'outil de gestion. Souvent le lendemain, quand les détails ont déjà bougé.",
        after: "Le compte rendu est rédigé à partir de l'enregistrement, les décisions et les actions en sont extraites avec un responsable et une échéance, et les tâches sont créées dans l'outil que l'équipe utilise déjà.",
        human: "Relire le compte rendu avant l'envoi, et corriger ce qui a été mal compris.",
      },
      {
        icon: "file-text",
        title: "La relance des devis en attente",
        time: "environ 1 à 2 heures par semaine, quand elles sont faites",
        before: "Il faut se souvenir de qui n'a pas répondu, rouvrir le devis, retrouver le contexte de l'échange, puis écrire un message qui ne sente pas le copier-coller. La relance passe toujours après le reste.",
        after: "Les devis sans réponse remontent d'eux-mêmes au bon moment, avec une relance déjà écrite à partir du contexte du dossier, prête à envoyer ou à retoucher.",
        human: "Lire le brouillon, l'ajuster au client, et décider quand on arrête de relancer.",
      },
      {
        icon: "bar-chart-2",
        title: "La préparation du reporting mensuel",
        time: "environ 2 heures par semaine, concentrées en fin de mois",
        before: "On exporte chaque plateforme, on recolle les tableaux, on remet en forme, on réécrit les mêmes commentaires. Le fichier est prêt une semaine après la fin du mois.",
        after: "Les données sont rassemblées toutes seules, les écarts notables sont repérés, et le rapport arrive pré-rempli avec un premier jet de commentaire sur ce qui a bougé.",
        human: "Expliquer pourquoi ça a bougé, trancher ce qu'on change le mois suivant, et le dire au client.",
      },
    ],
  }
};

const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026) : fond blanc, une ligne par tâche entre des filets :
     aujourd'hui à la main, une fois automatisé, ce qui reste à un humain. Plus de cartes
     ni de durées affichées (des ordres de grandeur sans source ; le champ `time` reste
     dans les données). -->
<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subheadline}</p>
    </header>
    <div class="grid">
      {t.tasks.map((task, index) => (
        <article class="grid gap-6 border-t border-slate-200 py-9 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-10" data-reveal style={`--i:${index % 2}`}>
          <h3 class="flex items-start gap-3 font-display text-xl font-extrabold tracking-[-0.02em] text-encre">
            <Icon name={task.icon} size={22} class="mt-0.5 flex-none text-marque" />
            <span>{task.title}</span>
          </h3>
          <div class="grid content-start gap-2">
            <p class="text-sm font-semibold text-slate-500">{t.beforeLabel}</p>
            <p class="text-slate-600">{task.before}</p>
          </div>
          <div class="grid content-start gap-2">
            <p class="text-sm font-semibold text-marque">{t.afterLabel}</p>
            <p class="text-encre">{task.after}</p>
          </div>
          <div class="grid content-start gap-2">
            <p class="text-sm font-semibold text-slate-500">{t.humanLabel}</p>
            <p class="text-slate-600">{task.human}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-8 max-w-2xl text-slate-500">{t.footnote}</p>
  </div>
</section>
