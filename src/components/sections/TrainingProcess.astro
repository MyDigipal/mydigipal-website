---
import { type Language } from '@/i18n/config';
import RailMorphing from '@/components/motion/RailMorphing.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Our Approach",
    headline: "How We Create Your Training",
    subtitle: "A collaborative process designed to maximize impact",
    steps: [
      {
        number: "01",
        title: "Discovery",
        description: "We learn about your team's needs through two discovery meetings to understand your context, challenges, and objectives.",
        icon: "🔍"
      },
      {
        number: "02",
        title: "Use Case Definition",
        description: "We define specific use cases tailored to your audience: real scenarios from their daily work that AI can improve.",
        icon: "🎯"
      },
      {
        number: "03",
        title: "Content Creation",
        description: "We create custom training materials with your branding. You review and can request modifications before delivery.",
        icon: "📝"
      },
      {
        number: "04",
        title: "Training Delivery",
        description: "We deliver the training either in-person at your offices or remotely via Zoom or Teams, whatever works best for your team.",
        icon: "🎓"
      },
      {
        number: "05",
        title: "Recording & Transcripts",
        description: "All sessions are recorded with generated transcripts, so participants can revisit the content anytime.",
        icon: "🎥"
      },
      {
        number: "06",
        title: "Feedback & Follow-up",
        description: "We collect post-training feedback to measure satisfaction and identify areas for continuous improvement.",
        icon: "📊"
      }
    ]
  },
  fr: {
    badge: "Notre approche",
    headline: "Comment nous créons votre formation",
    subtitle: "Un processus collaboratif conçu pour maximiser l'impact",
    steps: [
      {
        number: "01",
        title: "Découverte",
        description: "Nous découvrons les besoins de votre équipe à travers deux réunions pour comprendre votre contexte, défis et objectifs.",
        icon: "🔍"
      },
      {
        number: "02",
        title: "Définition des use cases",
        description: "Nous définissons des cas d'usage spécifiques adaptés à votre audience : des scénarios réels de leur quotidien que l'IA peut améliorer.",
        icon: "🎯"
      },
      {
        number: "03",
        title: "Création du contenu",
        description: "Nous créons des supports de formation personnalisés à votre image. Vous validez et pouvez demander des modifications.",
        icon: "📝"
      },
      {
        number: "04",
        title: "Réalisation du training",
        description: "Nous dispensons la formation en présentiel dans vos locaux ou à distance via Zoom ou Teams, selon vos préférences.",
        icon: "🎓"
      },
      {
        number: "05",
        title: "Enregistrement & transcripts",
        description: "Toutes les sessions sont enregistrées avec génération de transcripts, pour que les participants puissent revoir le contenu.",
        icon: "🎥"
      },
      {
        number: "06",
        title: "Feedback & suivi",
        description: "Nous collectons les retours post-formation pour mesurer la satisfaction et identifier les axes d'amélioration.",
        icon: "📊"
      }
    ]
  }
};

const t = translations[lang] || translations.en;

// Le rail : cinq stations. La réalisation et son enregistrement sont un même moment,
// leurs deux textes sont réunis sur la même station.
const e = t.steps;
const stations = [
  { titre: e[0].title, texte: e[0].description, forme: 'loupe' as const },
  { titre: e[1].title, texte: e[1].description, forme: 'cible' as const },
  { titre: e[2].title, texte: e[2].description, forme: 'structure' as const },
  { titre: e[3].title, texte: `${e[3].description} ${e[4].description}`, forme: 'bulle' as const },
  { titre: e[5].title, texte: e[5].description, forme: 'courbe' as const },
];
---

<!-- Direction Encre (30/09/2026), correction de cap : la fabrication de la formation sur
     le rail. Un seul objet voyage de la découverte au suivi et change de forme à chaque
     étape (loupe, cible, structure, bulle, courbe). -->
<section class="section-blanc py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-10 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <RailMorphing lang={lang} stations={stations} />
  </div>
</section>
