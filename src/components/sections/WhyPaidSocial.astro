---
/**
 * WhyPaidSocial - Educational section about Paid Social value
 * Shows key benefits with animated counters and visual blocks
 */
import type { Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import Marque from '@/components/ui/Marque.astro';

interface Props {
  lang: Language;
  color?: string;
}

const { lang, color = 'social' } = Astro.props;

const content = {
  en: {
    badge: 'Why Paid Social?',
    title: 'Target your ideal prospect',
    subtitle: 'Reach your audience when they show interest, and build awareness with the people you have chosen.',
    stat: '4.9B',
    statLabel: 'social media users worldwide',
    blocks: [
      {
        icon: 'target',
        title: 'Precision targeting',
        description: 'Reach decision-makers by job title, company size, industry, and interests with laser-focused accuracy.',
      },
      {
        icon: 'clock',
        title: 'Right time, right place',
        description: 'Be there when your prospects are actively engaged and showing purchase intent signals.',
      },
      {
        icon: 'trending-up',
        title: 'Measurable ROI',
        description: 'Track every click, conversion, and dollar spent with transparent, real-time reporting.',
      },
      {
        icon: 'users',
        title: 'ABM ready',
        description: 'Align with Account-Based Marketing strategies to target high-value accounts directly.',
      },
    ],
  },
  fr: {
    badge: 'Pourquoi le paid social ?',
    title: 'Ciblez votre prospect idéal',
    subtitle: 'Détectez votre audience cible quand elle montre de l\'intérêt, et améliorez votre notoriété auprès d\'une audience sélectionnée.',
    stat: '4,9 Mrd',
    statLabel: 'utilisateurs de réseaux sociaux dans le monde',
    blocks: [
      {
        icon: 'target',
        title: 'Ciblage de précision',
        description: 'Atteignez les décideurs par titre de poste, taille d\'entreprise, secteur et intérêts avec une précision chirurgicale.',
      },
      {
        icon: 'clock',
        title: 'Bon moment, bon endroit',
        description: 'Soyez présent quand vos prospects sont activement engagés et montrent des signaux d\'intention d\'achat.',
      },
      {
        icon: 'trending-up',
        title: 'ROI mesurable',
        description: 'Suivez chaque clic, conversion et euro dépensé avec un reporting transparent en temps réel.',
      },
      {
        icon: 'users',
        title: 'Prêt pour l\'ABM',
        description: 'Alignez-vous avec les stratégies Account-Based Marketing pour cibler directement les comptes à haute valeur.',
      },
    ],
  },
};

const t = content[lang] || content.en;

const colorClasses = {
  social: {
    badge: 'bg-violet-100 text-violet-700',
    stat: 'text-violet-500',
    icon: 'bg-violet-100 text-violet-600',
    border: 'border-violet-200 hover:border-violet-400',
    glow: 'violet',
  },
};

const colors = colorClasses[color as keyof typeof colorClasses] || colorClasses.social;
---

<!-- Paid Social, pourquoi (direction Encre, modèle AI Training, 30/09/2026) : sur l'encre,
     le chiffre de l'audience en très grand, puis quatre raisons en cartes de verre. -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-5">
      <div class="audience carte-verre" data-reveal>
        <p class="audience-chiffre">{t.stat}</p>
        <p class="text-lg text-sur-encre">{t.statLabel}</p>
        <ul class="mt-6 flex flex-wrap gap-3" aria-label={lang === 'fr' ? 'Plateformes' : 'Platforms'}>
          {['LinkedIn', 'Meta Ads', 'YouTube', 'X'].map((m) => (
            <li class="grid h-12 w-12 place-items-center rounded-2xl bg-white"><Marque nom={m} taille={24} /></li>
          ))}
        </ul>
      </div>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {t.blocks.map((b, i) => (
          <li class="carte-verre grid content-start gap-3 p-6" data-reveal style={`--i:${i}`}>
            <span class="tuile tuile-pleine"><Icon name={b.icon} size={26} /></span>
            <h3 class="titre-carte text-white">{b.title}</h3>
            <p class="text-sur-encre-2">{b.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .audience {
    display: grid;
    align-content: end;
    gap: 8px;
    min-height: 320px;
    padding: 32px 28px;
    background:
      radial-gradient(110% 90% at 0% 0%, rgb(29 113 184 / 0.55), transparent 62%),
      rgb(255 255 255 / 0.06);
  }
  .audience-chiffre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 2.4rem + 7vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: #fff;
    white-space: nowrap;
  }
</style>
