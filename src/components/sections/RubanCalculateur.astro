---
/**
 * Le ruban vers le calculateur (direction Encre, 30/09/2026, demande de Paul) : une
 * invitation à chiffrer le service de la page, qui ouvre le calculateur avec ce service
 * déjà coché (`/calculator?service=<id>`, lu par `CalculatorV6`). Un panneau bleu très
 * pâle dans une bande blanche : il ne se confond ni avec l'appel final (bleu plein), ni
 * avec une section d'encre.
 *
 * Le nom du service est celui du calculateur (`domainName`), pour que le visiteur retrouve
 * le même mot coché de l'autre côté. Un identifiant que le calculateur ne connaît pas
 * (`b2b-abm`) ne rend rien : le calculateur l'ignorerait et le ruban mentirait.
 */
import type { Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import { DOMAIN_ORDER, domainName } from '@/components/calculator-v6/engine';
import type { ServiceDomain } from '@/components/calculator/types';

interface Props {
  lang: Language;
  /** L'identifiant du calculateur (`calculatorServiceId` de la fiche). */
  service?: string;
}

const { lang, service } = Astro.props;
const fr = lang === 'fr';
const connu = !!service && (DOMAIN_ORDER as string[]).includes(service);
const nom = connu ? domainName(service as ServiceDomain, lang) : '';
const lien = `/${lang}/calculator?service=${service}`;
---

{connu && (
  <section class="section-blanc py-10 lg:py-14">
    <div class="container-custom">
      <div class="ruban" data-reveal>
        <span class="ruban-icone" aria-hidden="true"><Icon name="calculator" size={26} /></span>
        <div class="grid gap-1">
          <p class="font-display text-xl font-extrabold tracking-[-0.02em] text-encre lg:text-2xl">
            {fr ? `Chiffrer ${nom} pour votre cas` : `Price ${nom} for your case`}
          </p>
          <p class="text-slate-600">
            {fr
              ? `Le calculateur s’ouvre avec ${nom} déjà coché : votre budget, le niveau d’accompagnement, un prix.`
              : `The calculator opens with ${nom} already selected: your budget, the level of support, a price.`}
          </p>
        </div>
        <a href={lien} class="pilule pilule-pleine">
          {fr ? 'Calculer mon budget' : 'Calculate my budget'}
          <Icon name="arrow-right" size={18} class="pilule-fleche" />
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .ruban {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding: 24px;
    border-radius: var(--rayon-panneau);
    background: var(--color-marque-doux);
    box-shadow: inset 0 0 0 1px rgb(29 113 184 / 0.12);
  }
  .ruban-icone {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: #fff;
    color: var(--color-marque);
    box-shadow: 0 8px 20px -10px rgb(21 90 147 / 0.45);
  }
  @media (min-width: 768px) {
    .ruban {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 24px;
      padding: 28px 32px;
    }
  }
</style>
