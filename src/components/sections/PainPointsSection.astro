---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import VideoEmbed from '@/components/ui/VideoEmbed.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  en: {
    badge: 'The Problem',
    title: 'Is Your Content Actually Visible?',
    subtitle: 'Most businesses invest in SEO — but still miss 40% of search traffic shifting to AI platforms.',
    painPoints: [
      {
        iconName: 'search',
        iconGradient: 'from-red-500 to-rose-600',
        color: 'red',
        title: 'Invisible on AI Search',
        description: 'ChatGPT, Perplexity and Gemini recommend your competitors — not you. Your content exists, but AI assistants can\'t cite it.',
        stat: '0%',
        statLabel: 'of businesses optimize for AI search',
      },
      {
        iconName: 'trending-down',
        iconGradient: 'from-amber-500 to-orange-600',
        color: 'amber',
        title: 'Traditional SEO Isn\'t Enough',
        description: 'Ranking #1 on Google is great — but when 40% of users ask ChatGPT instead, your rankings miss a growing audience.',
        stat: '40%',
        statLabel: 'of searches involve AI by 2026',
      },
      {
        iconName: 'zap',
        iconGradient: 'from-orange-500 to-red-600',
        color: 'orange',
        title: 'Competitors Are Moving Fast',
        description: 'While you focus on keywords and backlinks, early adopters are already optimizing for AI citations and structured data.',
        stat: '3x',
        statLabel: 'faster content velocity needed',
      },
      {
        iconName: 'database',
        iconGradient: 'from-slate-500 to-slate-700',
        color: 'slate',
        title: 'Content That Can\'t Be Extracted',
        description: 'Your website lacks structured data, clear definitions, and citable formats. AI models skip content they can\'t parse.',
        stat: '73%',
        statLabel: 'of websites lack proper Schema markup',
      },
    ],
    cta: 'There\'s a better way →',
  },
  fr: {
    badge: 'Le problème',
    title: 'Votre contenu est-il vraiment visible ?',
    subtitle: 'La plupart des entreprises investissent en SEO, mais passent à côté de 40% du trafic qui migre vers les plateformes IA.',
    painPoints: [
      {
        iconName: 'search',
        iconGradient: 'from-red-500 to-rose-600',
        color: 'red',
        title: 'Invisible sur la recherche IA',
        description: 'ChatGPT, Perplexity et Gemini recommandent vos concurrents, pas vous. Votre contenu existe, mais les assistants IA ne le citent pas.',
        stat: '0%',
        statLabel: 'des entreprises optimisent pour la recherche IA',
      },
      {
        iconName: 'trending-down',
        iconGradient: 'from-amber-500 to-orange-600',
        color: 'amber',
        title: 'Le SEO traditionnel ne suffit plus',
        description: 'Être #1 sur Google, c\'est bien, mais quand 40% des utilisateurs demandent à ChatGPT, vos classements ratent une audience croissante.',
        stat: '40%',
        statLabel: 'des recherches impliqueront l\'IA d\'ici 2026',
      },
      {
        iconName: 'zap',
        iconGradient: 'from-orange-500 to-red-600',
        color: 'orange',
        title: 'Vos concurrents avancent vite',
        description: 'Pendant que vous misez sur les mots-clés et les backlinks, les précurseurs optimisent déjà pour les citations IA et les données structurées.',
        stat: '3x',
        statLabel: 'de vélocité de contenu nécessaire',
      },
      {
        iconName: 'database',
        iconGradient: 'from-slate-500 to-slate-700',
        color: 'slate',
        title: 'Un contenu non extractible',
        description: 'Votre site manque de données structurées, de définitions claires et de formats citables. Les modèles IA ignorent le contenu qu\'ils ne peuvent pas analyser.',
        stat: '73%',
        statLabel: 'des sites manquent de balisage Schema',
      },
    ],
    cta: 'Il y a une meilleure approche →',
  },
};

const t = content[lang];

const colorMap: Record<string, { bg: string; border: string; text: string; glow: string }> = {
  red: { bg: 'bg-red-500/10', border: 'border-red-500/20', text: 'text-red-400', glow: 'shadow-red-500/5' },
  amber: { bg: 'bg-amber-500/10', border: 'border-amber-500/20', text: 'text-amber-400', glow: 'shadow-amber-500/5' },
  orange: { bg: 'bg-orange-500/10', border: 'border-orange-500/20', text: 'text-orange-400', glow: 'shadow-orange-500/5' },
  slate: { bg: 'bg-slate-500/10', border: 'border-slate-500/20', text: 'text-slate-400', glow: 'shadow-slate-500/5' },
};
---

<!-- SEO, le problème (direction Encre, modèle AI Training, 30/09/2026) : sur l'encre, la
     vidéo SEO contre LLMO en visuel dominant, les quatre constats en cartes de verre à
     côté. Les chiffres des constats sont gardés tels quels (à sourcer, voir le pilotage). -->
<section class="section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">{t.title}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-10">
      <div class="lg:sticky lg:top-28" data-reveal>
        <div class="overflow-hidden rounded-[20px] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12),var(--ombre-forte)]">
          <VideoEmbed
            src="/videos/seo/SEOvsLLMO.mp4"
            poster="/videos/seo/SEOvsLLMO.jpg"
            title={lang === 'fr' ? 'SEO vs LLMO : deux moteurs, une stratégie' : 'SEO vs LLMO — Two engines, one strategy'}
            description={lang === 'fr' ? 'Voir la comparaison SEO vs LLMO' : 'See SEO vs LLMO comparison'}
            schemaName="SEO vs LLMO Comparison by MyDigipal"
            schemaDescription="Understanding the difference between traditional SEO and Large Language Model Optimization"
            schemaUploadDate="2026-02-10"
          />
        </div>
      </div>
      <ul class="grid gap-3">
        {t.painPoints.map((point, index) => (
          <li class="carte-verre grid grid-cols-[56px_minmax(0,1fr)] gap-x-4 gap-y-2 p-5 lg:p-6" data-reveal style={`--i:${index}`}>
            <span class="tuile tuile-pleine row-span-3"><Icon name={point.iconName} size={26} /></span>
            <h3 class="titre-carte text-white">{point.title}</h3>
            <p class="text-sur-encre-2">{point.description}</p>
            <p class="text-sm text-sur-encre-2"><b class="mr-1.5 font-display text-lg font-extrabold text-white">{point.stat}</b>{point.statLabel}</p>
          </li>
        ))}
      </ul>
    </div>
    <a href="#llmo" class="pilule pilule-claire mt-12">
      {t.cta.replace(/\s*→\s*$/, '')}
      <Icon name="arrow-down" size={18} class="pilule-fleche" />
    </a>
  </div>
</section>
