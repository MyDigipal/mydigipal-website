---
/**
 * AI Solutions : le serveur MCP construit sur mesure (direction Encre, 30/09/2026).
 * Le terminal factice (ROAS, CPA, comptes et campagnes inventés) est remplacé par la
 * carte de verre, la même explication que sur AI Training (`donnees-mcp.ts`). Plus de
 * « 244 outils, 21 plateformes, 18+ clients » : aucune source affichée. Le lien de
 * contact garde son `?topic=mcp-build`.
 */
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';
import CarteVerre from '@/components/motion/CarteVerre.astro';
import { carteMcp } from '@/components/motion/donnees-mcp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    headline: "Your MCP, built to order.",
    headlineAccent: "We design. We deploy. We operate.",
    subtitle:
      "We run our own MCP gateway in production. We build yours the same way: with your data, your rules, your stack.",
    bullets: [
      {
        icon: "cpu",
        title: "Battle-tested in production",
        text: "Our own MCP runs on Google Cloud Run and is queried by our clients every day. We know what breaks, what scales, and what's worth building versus what isn't.",
      },
      {
        icon: "zap",
        title: "Plugged into your real stack",
        text: "Ahrefs, GA4, Meta Ads, BigQuery, HubSpot, Notion, Lemlist, your internal APIs. We build the connectors you actually need, not a generic vendor demo.",
      },
      {
        icon: "sparkles",
        title: "Claude Desktop, Claude Code or your own agent",
        text: "Your MCP works with Anthropic's clients out of the box, and with any custom agent you decide to build on top. No lock-in.",
      },
    ],
    carteTitre: "What your MCP server will do",
    cta: "Scope your MCP with us",
    ctaHref: "/en/contact?topic=mcp-build",
  },
  fr: {
    headline: "Votre MCP, conçu pour vous.",
    headlineAccent: "On le construit. On le déploie. On l'opère.",
    subtitle:
      "On opère notre propre passerelle MCP en production. On construit la vôtre de la même façon : avec vos données, vos règles, votre stack.",
    bullets: [
      {
        icon: "cpu",
        title: "Éprouvé en production",
        text: "Notre MCP tourne sur Google Cloud Run et nos clients l'interrogent chaque jour. On sait ce qui casse, ce qui tient à l'échelle, et ce qui vaut le coup d'être construit ou non.",
      },
      {
        icon: "zap",
        title: "Connecté à votre vraie stack",
        text: "Ahrefs, GA4, Meta Ads, BigQuery, HubSpot, Notion, Lemlist, vos API internes. On construit les connecteurs dont vous avez vraiment besoin, pas une démo générique.",
      },
      {
        icon: "sparkles",
        title: "Claude Desktop, Claude Code ou votre propre agent",
        text: "Votre MCP fonctionne d'emblée avec les applications d'Anthropic, et avec n'importe quel agent que vous déciderez de construire dessus. Aucune dépendance.",
      },
    ],
    carteTitre: "Ce que fera votre serveur MCP",
    cta: "Cadrer votre MCP avec nous",
    ctaHref: "/fr/contact?topic=mcp-build",
  },
};

const t = translations[lang] || translations.en;
const carte = carteMcp(lang);
---

<section class="mcp-custom section-encre section-monte py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen">
        {t.headline}
        <span class="block text-marque-clair">{t.headlineAccent}</span>
      </h2>
      <p class="chapo">{t.subtitle}</p>
    </header>

    <ul class="grid gap-x-10 md:grid-cols-3">
      {t.bullets.map((b, index) => (
        <li class="grid content-start gap-2 border-t border-white/10 py-6" data-reveal style={`--i:${index}`}>
          <Icon name={b.icon} size={22} class="mb-1 text-marque-clair" />
          <h3 class="text-lg font-semibold text-white">{b.title}</h3>
          <p class="text-sur-encre-2">{b.text}</p>
        </li>
      ))}
    </ul>

    <h3 id="mcp-sur-mesure-carte" class="mb-8 mt-16 font-display text-2xl font-extrabold tracking-[-0.02em] text-white lg:mt-24 lg:text-3xl">{t.carteTitre}</h3>
    <CarteVerre lang={lang} titreId="mcp-sur-mesure-carte" {...carte} />

    <div class="mt-14 lg:mt-20">
      <a href={t.ctaHref} class="pilule pilule-blanche">
        {t.cta}
        <Icon name="arrow-right" size={18} class="pilule-fleche" />
      </a>
    </div>
  </div>
</section>
