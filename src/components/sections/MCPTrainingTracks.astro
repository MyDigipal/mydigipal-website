---
import { type Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const translations = {
  en: {
    badge: "Technical tracks",
    headline: "Three tracks. One outcome: autonomy.",
    subtitle:
      "Hands-on programs for growth operators and technical marketers who want to own their stack, not just use it.",
    tracks: [
      {
        icon: "zap",
        name: "Growth automation",
        duration: "1 day",
        audience: "Growth managers, marketing ops",
        description:
          "Build workflows that enrich leads, sync campaigns to your BI, and run every morning without you.",
        outcomes: [
          "Launch an n8n workflow: Lemlist, Airscale, ClickUp",
          "Export campaign performance to Sheets on a schedule",
          "Set up daily jobs with error alerts on Gmail",
        ],
        price: "From €1,500",
        highlighted: false,
      },
      {
        icon: "cpu",
        name: "Build your MCP",
        duration: "2 days",
        audience: "Technical CMOs, founders, consultants",
        description:
          "Design, build and deploy your own Model Context Protocol. Claude Desktop or Claude Code, connected to your real marketing stack.",
        outcomes: [
          "Define the tools your MCP needs",
          "Deploy a custom MCP to your infra (Cloud Run, Render or local)",
          "Query your marketing stack in natural language",
          "Evolve your agents over time: we transfer the method",
        ],
        bonus: "Delivered: a custom MCP live on your infra, full documentation, 1 month of support",
        price: "From €3,500",
        highlighted: true,
      },
      {
        icon: "database",
        name: "Data & reporting (BI)",
        duration: "1.5 days",
        audience: "Analysts, performance managers",
        description:
          "Consolidate multi-channel data in BigQuery, write cross-platform SQL, and generate beautiful reports automatically.",
        outcomes: [
          "Consolidate Meta, Google Ads and GA4 into one BigQuery layer",
          "Write SQL to compare channels, flag anomalies, compute ROI",
          "Auto-generate HTML, Slides and Docs reports",
        ],
        price: "From €2,200",
        highlighted: false,
      },
    ],
    cta: "Discuss this track",
    ctaHref: "/en/contact?topic=technical-track",
  },
  fr: {
    badge: "Parcours techniques",
    headline: "Trois parcours. Une promesse : l'autonomie.",
    subtitle:
      "Des programmes pratiques pour les growth operators et marketeurs techniques qui veulent maîtriser leur stack, pas seulement l'utiliser.",
    tracks: [
      {
        icon: "zap",
        name: "Growth Automation",
        duration: "1 jour",
        audience: "Growth managers, marketing ops",
        description:
          "Construisez des workflows qui enrichissent vos leads, synchronisent vos campagnes avec votre BI et tournent tous les matins sans vous.",
        outcomes: [
          "Lancer un workflow n8n : Lemlist - Airscale - ClickUp",
          "Exporter les performances campaigns vers Sheets en automatique",
          "Planifier des jobs quotidiens avec alertes d'erreur sur Gmail",
        ],
        price: "À partir de 1 500€",
        highlighted: false,
      },
      {
        icon: "cpu",
        name: "Build Your MCP",
        duration: "2 jours",
        audience: "CMOs techniques, fondateurs, consultants",
        description:
          "Concevez, construisez et déployez votre propre Model Context Protocol. Claude Desktop ou Claude Code, connecté à votre vraie stack marketing.",
        outcomes: [
          "Définir les tools dont votre MCP a besoin",
          "Déployer un MCP custom sur votre infra (Cloud Run, Render ou local)",
          "Interroger votre stack marketing en langage naturel",
          "Faire évoluer vos agents - on vous transmet la méthode",
        ],
        bonus: "Livrables : un MCP custom déployé sur votre infra, la documentation complète, 1 mois de support",
        price: "À partir de 3 500€",
        highlighted: true,
      },
      {
        icon: "database",
        name: "Data & Reporting BI",
        duration: "1,5 jour",
        audience: "Analystes, performance managers",
        description:
          "Consolidez vos données multi-canal dans BigQuery, écrivez du SQL cross-plateforme, et générez des rapports propres en automatique.",
        outcomes: [
          "Consolider Meta, Google Ads et GA4 dans une couche BigQuery unique",
          "Écrire du SQL pour comparer canaux, détecter anomalies, calculer le ROI",
          "Générer automatiquement rapports HTML, Slides et Docs",
        ],
        price: "À partir de 2 200€",
        highlighted: false,
      },
    ],
    cta: "Discuter ce parcours",
    ctaHref: "/fr/contact?topic=parcours-technique",
  },
};

const t = translations[lang] || translations.en;
---

<!-- Direction Encre (30/09/2026), correction de cap : les trois parcours en cartes, le
     plus demandé en encre et plus large, qui dépasse des deux autres. Grande tuile d'icône
     par parcours. Les prix sont ceux de l'offre. Le lien de contact garde son
     `?topic=parcours-technique`. -->
<section class="section-brume py-20 lg:py-32">
  <div class="container-custom">
    <header class="mb-12 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.headline}</h2>
      <p class="chapo">{t.subtitle}</p>
    </header>
    <div class="parcours">
      {t.tracks.map((track, i) => (
        <article class:list={['parcours-carte', { 'parcours-vedette': track.highlighted }]} data-reveal style={`--i:${i}`}>
          <div class="flex items-start justify-between gap-4">
            <span class="parcours-icone" aria-hidden="true"><Icon name={track.icon} size={28} /></span>
            {track.highlighted && <span class="parcours-badge">{lang === 'fr' ? 'Le plus demandé' : 'Most asked for'}</span>}
          </div>
          <p class="parcours-public">{track.duration}, {track.audience}</p>
          <h3 class="parcours-nom">{track.name}</h3>
          <p class="parcours-texte">{track.description}</p>
          <ul class="grid flex-grow content-start gap-3">
            {track.outcomes.map((outcome) => (
              <li class="parcours-acquis">
                <Icon name="arrow-right" size={16} class="mt-1 flex-none" />
                <span>{outcome}</span>
              </li>
            ))}
          </ul>
          {track.bonus && <p class="parcours-bonus">{track.bonus}</p>}
          <p class="parcours-prix">{track.price}</p>
          <a href={t.ctaHref} class:list={['pilule self-start', track.highlighted ? 'pilule-blanche' : 'pilule-contour']}>{t.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .parcours {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .parcours-carte {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 24px;
    border-radius: var(--rayon-panneau);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--filet), 0 18px 40px -28px rgb(11 27 43 / 0.35);
  }
  .parcours-icone {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: var(--color-marque-doux);
    color: var(--color-marque);
  }
  .parcours-badge {
    border-radius: 999px;
    padding: 4px 12px;
    background: var(--color-marque);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .parcours-public {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #5b6b7b;
  }
  .parcours-nom {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.625rem;
    letter-spacing: -0.02em;
    color: var(--encre);
  }
  .parcours-texte {
    color: #4b5b6b;
  }
  .parcours-acquis {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #334155;
  }
  .parcours-acquis :global(svg) {
    color: var(--color-marque);
  }
  .parcours-bonus {
    padding-top: 16px;
    border-top: 1px solid var(--filet);
    color: #4b5b6b;
  }
  .parcours-prix {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.625rem;
    color: var(--encre);
  }
  /* Le parcours le plus demandé : une carte d'encre qui dépasse des deux autres. */
  .parcours-vedette {
    background:
      radial-gradient(110% 70% at 100% 0%, rgb(29 113 184 / 0.5), transparent 65%),
      var(--encre);
    box-shadow: var(--ombre-forte);
  }
  .parcours-vedette .parcours-icone {
    background: var(--color-marque);
    color: #fff;
  }
  .parcours-vedette .parcours-nom,
  .parcours-vedette .parcours-prix {
    color: #fff;
  }
  .parcours-vedette .parcours-public,
  .parcours-vedette .parcours-texte,
  .parcours-vedette .parcours-bonus {
    color: var(--texte-sombre-2);
  }
  .parcours-vedette .parcours-acquis {
    color: var(--texte-sombre);
  }
  .parcours-vedette .parcours-acquis :global(svg) {
    color: var(--marque-clair);
  }
  .parcours-vedette .parcours-bonus {
    border-top-color: var(--filet-sombre);
  }
  @media (min-width: 1024px) {
    .parcours {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 20px;
    }
    .parcours-carte {
      padding: 32px 28px;
    }
    .parcours-vedette {
      margin-block: -20px;
      padding: 44px 36px;
    }
  }
</style>
