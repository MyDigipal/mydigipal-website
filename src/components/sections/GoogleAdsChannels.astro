---
/**
 * Google Ads : les formats que nous gérons (direction Encre, 30/09/2026), repris de la
 * maquette. Deux formats qui pèsent (Performance Max en panneau d'encre sur ordinateur,
 * Search), deux qui accompagnent (Shopping, Display et vidéo). Plus de cartes égales,
 * plus de pourcentages de performance sans source.
 */
import type { Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Language;
  color?: string;
}

const { lang } = Astro.props;
const fr = lang === 'fr';

const t = {
  titre: fr ? 'Les formats que nous gérons' : 'The formats we run',
  chapo: fr
    ? 'Le bon format dépend de ce que cherche votre client, pas de ce que la plateforme pousse.'
    : 'The right format depends on what your customer is looking for, not on what the platform pushes.',
  pmax: {
    nom: 'Performance Max',
    texte: fr
      ? 'Une seule campagne pour les six réseaux de Google, pilotée par les signaux et les conversions qu’on lui donne.'
      : 'One campaign across Google’s six networks, steered by the signals and conversions we give it.',
    etiquettes: fr
      ? ['Groupes d’éléments', 'Signaux d’audience', 'Conversions importées', 'Exclusions']
      : ['Asset groups', 'Audience signals', 'Imported conversions', 'Exclusions'],
  },
  search: {
    nom: 'Search',
    texte: fr
      ? 'Touchez les personnes qui cherchent déjà ce que vous vendez. Votre annonce apparaît en tête de Google au moment où la question est posée.'
      : 'Reach people who are already searching for what you sell. Your ad appears at the top of Google at the moment the question is asked.',
    etiquettes: fr
      ? ['Ciblage par mots-clés', 'Extensions d’annonce', 'Enchères intelligentes', 'Annonces responsives']
      : ['Keyword targeting', 'Ad extensions', 'Smart bidding', 'Responsive ads'],
  },
  seconds: [
    {
      nom: 'Shopping',
      texte: fr
        ? 'Vos produits avec leur image et leur prix, directement dans les résultats. Le flux fait la moitié du travail, nous le tenons propre.'
        : 'Your products with their image and price, right in the results. The feed does half the work, and we keep it clean.',
      etiquettes: fr ? ['Flux produits', 'Merchant Center', 'Inventaire local'] : ['Product feeds', 'Merchant Center', 'Local inventory'],
    },
    {
      nom: fr ? 'Display et vidéo' : 'Display and video',
      texte: fr
        ? 'Faire connaître la marque et retrouver les visiteurs qui n’ont pas converti, sur les sites partenaires et sur YouTube.'
        : 'Build awareness and bring back visitors who did not convert, across partner sites and YouTube.',
      etiquettes: fr
        ? ['Remarketing', 'YouTube', 'Display responsive', 'Audiences personnalisées']
        : ['Remarketing', 'YouTube', 'Responsive display', 'Custom audiences'],
    },
  ],
};
const reseaux = ['search', 'play', 'image', 'compass', 'mail', 'map-pin'];
---

<section class="section-brume py-20 lg:py-32" id="formats">
  <div class="container-custom">
    <header class="mb-10 grid max-w-[880px] gap-5 lg:mb-16 lg:gap-6">
      <h2 class="titre-moyen text-encre">{t.titre}</h2>
      <p class="chapo">{t.chapo}</p>
    </header>

    <div class="formats-grille">
      <article class="format format-pmax" data-reveal style="--i:0">
        <h3 class="format-nom">{t.pmax.nom}</h3>
        <p class="format-texte">{t.pmax.texte}</p>
        <ul class="etiquettes">{t.pmax.etiquettes.map((e) => <li>{e}</li>)}</ul>
        <ul class="format-reseaux" aria-hidden="true">
          {reseaux.map((r) => <li><Icon name={r} size={18} /></li>)}
        </ul>
      </article>
      <article class="format format-search" data-reveal style="--i:1">
        <h3 class="format-nom">{t.search.nom}</h3>
        <p class="format-texte">{t.search.texte}</p>
        <ul class="etiquettes">{t.search.etiquettes.map((e) => <li>{e}</li>)}</ul>
      </article>
      {t.seconds.map((f, i) => (
        <article class="format format-second" data-reveal style={`--i:${i + 2}`}>
          <h3 class="format-nom">{f.nom}</h3>
          <p class="format-texte">{f.texte}</p>
          <ul class="etiquettes">{f.etiquettes.map((e) => <li>{e}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .formats-grille {
    display: grid;
    gap: 16px;
  }
  .format {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 28px 24px;
    border-radius: var(--rayon-panneau);
    background: #fff;
    box-shadow: 0 1px 2px rgb(11 27 43 / 0.05), 0 16px 40px -16px rgb(11 27 43 / 0.2);
  }
  .format-nom {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.875rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--encre);
  }
  .format-texte {
    color: #4b5b6b;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .etiquettes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .etiquettes li {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--brume);
    color: #4b5b6b;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }
  /* Performance Max est un panneau d'encre sur ordinateur ; sur téléphone il reste
     clair, la scène qui précède est déjà une longue page d'encre. */
  .format-reseaux {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    padding-top: 24px;
    color: var(--color-marque);
  }
  .format-reseaux::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--filet);
  }
  .format-reseaux li {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-marque-doux);
  }
  .format-second {
    background: rgb(255 255 255 / 0.62);
    box-shadow: inset 0 0 0 1px rgb(11 27 43 / 0.06);
  }
  .format-second .format-nom {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .format-second .etiquettes li {
    background: rgb(11 27 43 / 0.05);
  }
  @media (min-width: 1024px) {
    .formats-grille {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 20px;
    }
    .format {
      padding: 44px;
      gap: 18px;
    }
    .format-nom {
      font-size: 2.5rem;
    }
    .format-texte {
      font-size: 1.0625rem;
    }
    .etiquettes li {
      font-size: 0.9375rem;
    }
    .format-pmax {
      grid-column: span 7;
      background:
        radial-gradient(90% 70% at 100% 0%, rgb(29 113 184 / 0.5), rgb(29 113 184 / 0.12) 48%, transparent 72%),
        var(--encre);
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1), var(--ombre-forte);
    }
    .format-pmax .format-nom {
      color: #fff;
    }
    .format-pmax .format-texte {
      color: var(--texte-sombre-2);
    }
    .format-pmax .etiquettes li {
      background: rgb(255 255 255 / 0.09);
      color: var(--texte-sombre);
    }
    .format-pmax .format-reseaux {
      color: var(--marque-clair);
    }
    .format-pmax .format-reseaux::before {
      background: var(--filet-sombre);
    }
    .format-pmax .format-reseaux li {
      background: var(--verre);
      box-shadow: inset 0 0 0 1px var(--verre-bord);
    }
    /* Search est moins haut que son voisin : ses étiquettes se posent en bas du panneau. */
    .format-search {
      grid-column: span 5;
      grid-template-rows: auto auto 1fr;
      align-content: stretch;
    }
    .format-search .etiquettes {
      align-self: end;
    }
    .format-second {
      grid-column: span 6;
      padding: 32px 44px;
      gap: 12px;
    }
    .format-second .format-nom {
      font-size: 1.5rem;
    }
    .format-second .format-texte {
      font-size: 1rem;
    }
  }
</style>
