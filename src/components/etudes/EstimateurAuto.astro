  .sombre .est-choix input:focus-visible + span { outline-color: #fff; }

  /* Les curseurs : la piste se remplit jusqu'à la valeur. */
  input[type='range'] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 32px; background: transparent; cursor: pointer; margin: 0;
    --plein: var(--color-marque); --vide: #D5DEE8;
