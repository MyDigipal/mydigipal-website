  .sombre .est-ville input[type='text'] { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.24); color: #fff; }
  .sombre .est-ville input[type='text']::placeholder { color: #94A6B8; }
  .sombre .est-ville input[type='text']:focus { outline-color: #fff; border-color: #fff; }
  .est-liste {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 6px);
    margin: 0; padding: 6px; list-style: none; border-radius: 14px; background: #fff;
    box-shadow: inset 0 0 0 1px var(--filet), 0 24px 48px -20px rgb(11 27 43 / 0.45);
  }
  .est-liste[hidden] { display: none; }
  .est-liste :global(li) {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 10px 12px; border-radius: 10px; cursor: pointer; color: var(--encre);
  }
  .est-liste :global(li b) { font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
  .est-liste :global(li span) { font-size: 0.85rem; color: #5B6B7B; white-space: nowrap; }
  .est-liste :global(li[aria-selected='true']), .est-liste :global(li[role='option']:hover) { background: var(--color-marque-doux); }
  .est-liste :global(li.est-aucune) { cursor: default; color: #5B6B7B; }

  /* Le résultat : une carte d'encre sur fond clair, blanche sur l'encre. */
  .est-resultat {
    display: grid; align-content: start; gap: 20px; padding: 24px; min-height: 280px;
    border-radius: var(--rayon-panneau); color: var(--texte-sombre);
    background: radial-gradient(110% 80% at 100% 0%, rgb(29 113 184 / 0.5), transparent 65%), var(--encre);
    box-shadow: var(--ombre-forte);
  }
  .sombre .est-resultat { background: #fff; color: var(--encre); box-shadow: 0 30px 60px -36px rgb(2 9 16 / 0.9); }
  @media (min-width: 640px) { .est-resultat { padding: 32px; } }
  .est-vide, .est-erreur { display: flex; gap: 12px; align-items: flex-start; align-self: center; font-size: 1.05rem; line-height: 1.5; color: var(--texte-sombre-2); max-width: 36ch; }
  .sombre .est-vide, .sombre .est-erreur { color: #4B5B6B; }
  .est-vide[hidden], .est-erreur[hidden], .est-alerte[hidden] { display: none; }
  .est-vide :global(svg), .est-erreur :global(svg) { flex: none; margin-top: 2px; color: var(--marque-clair); }
  .sombre .est-vide :global(svg), .sombre .est-erreur :global(svg) { color: var(--color-marque); }
  .est-plein { display: grid; gap: 20px; }
  .est-zone { font-size: 1rem; line-height: 1.55; color: var(--texte-sombre-2); }
  .est-zone :global(b) { color: #fff; font-weight: 600; }
  .sombre .est-zone { color: #4B5B6B; }
  .sombre .est-zone :global(b) { color: var(--encre); }

  .est-ventes { display: grid; gap: 4px; }
  .est-ventes b {
    font-family: var(--font-display); font-weight: 800; letter-spacing: -0.035em; line-height: 1;
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4.25rem); color: #e8bd62; font-variant-numeric: tabular-nums;
  }
  .sombre .est-ventes b { color: #9A6B12; }
  .est-ventes span { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; color: #fff; }
