    background: #fff; border: 2px solid var(--plein); box-shadow: 0 2px 8px rgb(11 27 43 / 0.25);
  }
  input[type='range']::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: #fff; border: 2px solid var(--plein); box-shadow: 0 2px 8px rgb(11 27 43 / 0.25); }
