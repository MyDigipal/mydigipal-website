  .est-label { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; color: var(--encre); padding: 0; }
  .sombre .est-label { color: #fff; }
  .est-ligne { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
  .est-valeur { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; color: var(--color-marque); font-variant-numeric: tabular-nums; }
  .sombre .est-valeur { color: var(--marque-clair); }
  .est-aide, .est-bornes { font-size: 0.875rem; color: #5B6B7B; }
