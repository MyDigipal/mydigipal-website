---
/**
 * Page AI Content (04/11/2026) : la publication et le suivi, qui ferme la boucle du mois.
 * Une ligne de quatre arrêts, puis la flèche de retour vers les sujets du mois suivant : c'est
 * elle qui porte le sens (le suivi choisit les prochains sujets). Sous 768 px, la ligne devient
 * verticale et la flèche remonte sur le côté.
 */
import type { Language } from '@/i18n/config';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const T = {
  fr: {
    titre: 'Nous publions, puis nous suivons chaque article',
    chapo: 'Une fois l’article validé, il part en ligne. Puis nous regardons ce qu’il rapporte, et c’est ce suivi qui oriente le mois d’après.',
    arrets: [
      ['Sur votre site', 'Avec un accès à votre site, nous publions nous-mêmes : mise en page, vidéo, vignette, liens et données structurées. Rien à copier, rien à coller.'],
      ['Un article par semaine', 'Un rythme régulier montre à Google un site qui vit.'],
      ['Positions et clics suivis', 'Dans Ahrefs et la Search Console, article par article.'],
      ['Le mois suivant en tient compte', 'Ce qui monte nous dit quoi creuser, ce qui stagne nous dit quoi compléter.'],
    ],
    retour: 'Retour aux sujets du mois suivant',
  },
  en: {
    titre: 'We publish, then we track every article',
    chapo: 'Once the article is approved, it goes live. Then we watch what it brings in, and that tracking shapes the month after.',
    arrets: [
      ['On your site', 'With access to your site, we publish ourselves: layout, video, thumbnail, links and structured data. Nothing to copy and paste.'],
      ['One article a week', 'A steady pace shows Google a site that is alive.'],
      ['Rankings and clicks tracked', 'In Ahrefs and Search Console, article by article.'],
      ['Next month takes it in', 'What climbs tells us what to dig into, what stalls tells us what to complete.'],
    ],
    retour: 'Back to next month’s topics',
  },
}[lang];
---

<section class="section-encre section-monte ps">
  <div class="container-custom">
    <header class="ps-tete">
      <h2 class="titre-moyen">{T.titre}</h2>
      <p class="chapo">{T.chapo}</p>
    </header>
    <div class="ps-boucle">
      <ol class="ps-ligne">
        {T.arrets.map(([titre, texte], i) => (
          <li data-reveal style={`--i:${i}`} class:list={{ 'ps-dernier': i === T.arrets.length - 1 }}>
            <i aria-hidden="true"></i>
            <strong>{titre}</strong>
            <span>{texte}</span>
          </li>
        ))}
      </ol>
      <div class="ps-retour" aria-hidden="true">
        <svg viewBox="0 0 1000 60" preserveAspectRatio="none"><path d="M 778 2 L 778 38 Q 778 54 762 54 L 24 54 Q 8 54 8 38 L 8 2" fill="none" stroke="#e8bd62" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke" stroke-dasharray="6 7" /></svg>
      </div>
      <p class="ps-retour-texte">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 3v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {T.retour}
      </p>
    </div>
  </div>
</section>

<style>
  .ps { padding: 88px 0 96px; }
  @media (min-width: 1024px) { .ps { padding: 128px 0 136px; } }
  .ps-tete { display: grid; gap: 18px; max-width: 820px; margin-bottom: 52px; }
  .ps-ligne { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; position: relative; }
  .ps-ligne li { position: relative; display: grid; gap: 6px; padding: 0 0 30px 34px; }
  .ps-ligne li i { position: absolute; left: 0; top: 4px; width: 16px; height: 16px; border-radius: 99px; background: var(--color-marque); box-shadow: 0 0 0 5px rgb(29 113 184 / 0.25); }
  .ps-ligne li:after { content: ''; position: absolute; left: 7px; top: 26px; bottom: 0; width: 2px; background: var(--filet-sombre); }
  .ps-ligne li.ps-dernier:after { display: none; }
  .ps-ligne li.ps-dernier i { background: #e8bd62; box-shadow: 0 0 0 5px rgb(232 189 98 / 0.22); }
  .ps-ligne strong { color: #fff; font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; font-size: 20px; }
  .ps-ligne span { color: var(--texte-sombre-2); font-size: 15.5px; line-height: 1.5; max-width: 40ch; }
  .ps-retour { display: none; }
  .ps-retour-texte { display: flex; align-items: center; gap: 10px; margin: 6px 0 0 34px; color: #e8bd62; font-weight: 600; font-size: 15px; }
  .ps-retour-texte svg { width: 20px; height: 20px; flex: none; }
  @media (min-width: 768px) {
    .ps-ligne { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
    .ps-ligne li { padding: 34px 0 0; }
    .ps-ligne li i { top: 0; }
    .ps-ligne li:after { left: 26px; right: -28px; top: 7px; bottom: auto; width: auto; height: 2px; }
    .ps-retour { display: block; position: relative; height: 60px; margin: 18px 0 0; }
    .ps-retour svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .ps-retour-texte { justify-content: center; margin: 10px 0 0; }
  }
</style>
