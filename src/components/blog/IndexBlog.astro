---
/**
 * L'index du blog, partagé par `/{lang}/blog` (page 1) et `/{lang}/blog/page/[page]`
 * (30/09/2026). Douze articles par page en pages statiques ; l'article à la une ne vit que sur
 * la première. La recherche et les deux filtres gardent leurs identifiants, et portent sur TOUS
 * les articles de la langue : au premier usage, le script lit `/{lang}/blog/articles.json`.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { type Language } from '@/i18n/config';
import { ARTICLES_PAR_PAGE, articlesPublies, adressePage } from '@/lib/blog-pages';
import Icon from '@/components/ui/Icon.astro';
import VignetteBlog from '@/components/ui/VignetteBlog.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';

interface Props {
  lang: Language;
  /** La page de l'index, à partir de 1. */
  page: number;
}

const { lang, page } = Astro.props;

// Tous les articles publiés de la langue ; la page n'en affiche que douze, mais la recherche
// et les filtres portent sur tous (index `/{lang}/blog/articles.json`, lu à la demande).
const posts = await articlesPublies(lang);
const nbPages = Math.max(1, Math.ceil(posts.length / ARTICLES_PAR_PAGE));
const pagePosts = posts.slice((page - 1) * ARTICLES_PAR_PAGE, page * ARTICLES_PAR_PAGE);

// Helper to get the blog URL for current language
const getBlogUrl = (post: typeof posts[0]) => {
  const slug = post.id.replace(/^(en|fr)\//, '');
  return `/${lang}/blog/${slug}`;
};

// Categories and industries for filters
const categories = [
  { id: 'all', label: lang === 'fr' ? 'Tous' : 'All' },
  { id: 'abm', label: 'ABM' },
  { id: 'ai', label: lang === 'fr' ? 'IA' : 'AI' },
  { id: 'paid-ads', label: lang === 'fr' ? 'Publicité' : 'Paid Ads' },
  { id: 'seo', label: 'SEO' },
  { id: 'marketing-ops', label: 'Marketing Ops' },
  { id: 'strategy', label: lang === 'fr' ? 'Stratégie' : 'Strategy' },
  { id: 'company-news', label: lang === 'fr' ? 'Actualités' : 'News' },
];

const industries = [
  { id: 'all', label: lang === 'fr' ? 'Toutes' : 'All' },
  { id: 'automotive', label: lang === 'fr' ? 'Automobile' : 'Automotive' },
  { id: 'b2b-tech', label: 'B2B Tech' },
  { id: 'general', label: lang === 'fr' ? 'Général' : 'General' },
];

const translations = {
  en: {
    title: 'Blog - Digital Marketing, AI and B2B Growth',
    description: 'Expert insights on digital marketing, AI automation and B2B growth strategies. Actionable advice from the MyDigipal team, published every single week.',
    hero: {
      badge: 'Insights & resources',
      headline: 'Our blog',
      subheadline: 'Expert insights on digital marketing, AI, and B2B growth strategies',
    },
    search: 'Search articles...',
    filterCategory: 'Filter by topic',
    filterIndustry: 'Filter by industry',
    readMore: 'Read more',
    noResults: 'No articles found matching your criteria.',
    featured: 'Featured',
    minRead: 'min read',
  },
  fr: {
    title: 'Blog - Marketing digital, IA et croissance B2B',
    description: 'Analyses sur le marketing digital, l\'automatisation IA et les stratégies de croissance B2B. Des conseils actionnables, publiés par l\'équipe MyDigipal.',
    hero: {
      badge: 'Blog',
      headline: 'Notre blog',
      subheadline: 'Expertise en marketing digital, IA et stratégies de croissance B2B',
    },
    search: 'Rechercher des articles...',
    filterCategory: 'Filtrer par sujet',
    filterIndustry: 'Filtrer par industrie',
    readMore: 'Lire la suite',
    noResults: 'Aucun article trouvé correspondant à vos critères.',
    featured: 'À la une',
    minRead: 'min de lecture',
  },
};

const t = translations[lang] || translations.en;
const fr = lang === 'fr';
const libelleCategorie = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const dateCourte = (d: Date) => d.toLocaleDateString(fr ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const avecImage = (p: typeof posts[0]) => !!p.data.image && !p.data.image.includes('/images/blog/');
// À la une : le dernier article publié, puis les trois suivants en liste.
const [une, ...suivants] = posts;
const ensuite = suivants.slice(0, 3);

// Un titre et une description uniques par page (check-seo refuse les doublons) : la page 1
// garde ceux d'avant.
const seoPage = page === 1
  ? { title: t.title, description: t.description }
  : fr
    ? {
        title: `Blog marketing digital, IA et B2B, page ${page}`,
        description: `Page ${page} sur ${nbPages} du blog MyDigipal : nos analyses sur le marketing digital, l'automatisation IA et la croissance B2B, avec des conseils concrets chaque semaine.`,
      }
    : {
        title: `Digital Marketing, AI and B2B Blog, Page ${page}`,
        description: `Page ${page} of ${nbPages} of the MyDigipal blog: our insights on digital marketing, AI automation and B2B growth, with practical advice from the team every single week.`,
      };
const site = 'https://mydigipal.com';
const precedente = page > 1 ? adressePage(lang, page - 1) : null;
const suivante = page < nbPages ? adressePage(lang, page + 1) : null;
const lx = fr
  ? { pagination: 'Pages du blog', precedente: 'Précédente', suivante: 'Suivante', page: 'Page', sur: 'sur', }
  : { pagination: 'Blog pages', precedente: 'Previous', suivante: 'Next', page: 'Page', sur: 'of', };
---

<PageLayout
  lang={lang}
  title={seoPage.title}
  description={seoPage.description}
>
  <Fragment slot="head">
    {precedente && <link rel="prev" href={`${site}${precedente}`} />}
    {suivante && <link rel="next" href={`${site}${suivante}`} />}
  </Fragment>

  <PageHero
    eyebrow={t.hero.badge}
    title={t.hero.headline}
    description={page === 1 ? t.hero.subheadline : `${lx.page} ${page} ${lx.sur} ${nbPages}. ${t.hero.subheadline}.`}
  />

  <!-- À la une (encre) : le dernier article en grand, les trois suivants en liste. Direction
       Encre, groupe 4 (30/09/2026). Le texte des articles n'est pas touché. -->
  {page === 1 && une && (
    <section class="section-encre section-monte py-20 lg:py-28">
      <div class="container-custom grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] lg:gap-8">
        <a href={getBlogUrl(une)} class="carte-verre group grid overflow-hidden" data-reveal>
          {avecImage(une) && (
            <span class="block aspect-[1200/630] overflow-hidden">
              <VignetteBlog image={une.data.image!} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" fetchpriority="high" sizes="(min-width: 1024px) 60vw, calc(100vw - 32px)" />
            </span>
          )}
          <span class="grid gap-3 p-6 lg:p-8">
            <span class="text-sm font-semibold text-sur-encre-2">{t.featured} · {libelleCategorie[une.data.category] ?? une.data.category} · <time datetime={une.data.date.toISOString()}>{dateCourte(une.data.date)}</time></span>
            <span class="titre-carte text-white lg:text-[2rem]">{une.data.title}</span>
            <span class="text-sur-encre-2 text-pretty">{une.data.description}</span>
            <span class="mt-2 inline-flex items-center gap-2 font-semibold text-marque-clair transition-all group-hover:gap-3">{t.readMore}<Icon name="arrow-right" size={16} /></span>
          </span>
        </a>
        <ul class="grid content-start gap-4">
          {ensuite.map((p, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <a href={getBlogUrl(p)} class="carte-verre group grid gap-2 p-5 lg:p-6">
                <span class="text-sm font-semibold text-sur-encre-2">{libelleCategorie[p.data.category] ?? p.data.category} · <time datetime={p.data.date.toISOString()}>{dateCourte(p.data.date)}</time></span>
                <span class="font-display text-lg font-bold leading-snug text-white transition-colors group-hover:text-marque-clair">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- La recherche et les filtres, puis tous les articles (blanc). Les identifiants et les
       attributs lus par le script du bas de page sont ceux d'avant. -->
  <section class="section-blanc py-20 lg:py-28">
    <div class="container-custom">
      <div class="mb-10 flex flex-col gap-4 lg:mb-14 lg:flex-row lg:items-center lg:justify-between">
        <div class="relative w-full lg:w-96">
          <Icon name="search" size={20} class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            id="blog-search"
            placeholder={t.search}
            aria-label={t.search}
            class="champ-blog w-full pl-13 pr-5"
          />
        </div>
        <div class="flex flex-wrap gap-3">
          <label class="relative">
            <span class="sr-only">{t.filterCategory}</span>
            <select id="category-filter" class="champ-blog cursor-pointer appearance-none pl-5 pr-11">
              {categories.map((cat) => (
                <option value={cat.id}>{cat.label}</option>
              ))}
            </select>
            <Icon name="chevron-down" size={16} class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" />
          </label>
          <label class="relative">
            <span class="sr-only">{t.filterIndustry}</span>
            <select id="industry-filter" class="champ-blog cursor-pointer appearance-none pl-5 pr-11">
              {industries.map((ind) => (
                <option value={ind.id}>{ind.label}</option>
              ))}
            </select>
            <Icon name="chevron-down" size={16} class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" />
          </label>
        </div>
      </div>

      <div id="no-results" class="hidden py-16 text-center">
        <p class="text-xl text-slate-500">{t.noResults}</p>
      </div>

      <p id="blog-trouves" class="mb-6 hidden font-semibold text-slate-500" aria-live="polite"></p>

      <div id="blog-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" data-lang={lang} data-libelle-lire={t.readMore} data-trouves-singulier={fr ? '{} article trouvé' : '{} article found'} data-trouves-pluriel={fr ? '{} articles trouvés' : '{} articles found'}>
        {pagePosts.map((post) => (
          <article
            class="blog-card carte group overflow-hidden"
            data-title={post.data.title.toLowerCase()}
            data-description={post.data.description.toLowerCase()}
            data-category={post.data.category}
            data-industry={post.data.industry}
          >
            <a href={getBlogUrl(post)} class="relative block aspect-[16/10] overflow-hidden" tabindex="-1" aria-hidden="true">
              {avecImage(post) ? (
                <VignetteBlog
                  image={post.data.image!}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                />
              ) : (
                <span class="absolute inset-0 bg-marque-doux"></span>
              )}
            </a>
            <div class="grid gap-3 p-6">
              <p class="text-sm font-semibold text-slate-500">
                {libelleCategorie[post.data.category] ?? post.data.category} · <time datetime={post.data.date.toISOString()}>{dateCourte(post.data.date)}</time>
              </p>
              <h2 class="font-display text-xl font-bold leading-snug text-encre line-clamp-3 transition-colors group-hover:text-marque">
                <a href={getBlogUrl(post)}>{post.data.title}</a>
              </h2>
              <p class="text-slate-600 line-clamp-3">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>

      {nbPages > 1 && (
        <nav id="blog-pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2 lg:mt-16" aria-label={lx.pagination}>
          {precedente ? (
            <a href={precedente} rel="prev" class="page-lien page-fleche"><Icon name="arrow-left" size={16} />{lx.precedente}</a>
          ) : (
            <span class="page-lien page-fleche opacity-40" aria-hidden="true"><Icon name="arrow-left" size={16} />{lx.precedente}</span>
          )}
          {Array.from({ length: nbPages }, (_, i) => i + 1).map((n) =>
            n === page ? (
              <span class="page-lien page-active" aria-current="page">{n}</span>
            ) : (
              <a href={adressePage(lang, n)} class="page-lien" aria-label={`${lx.page} ${n}`}>{n}</a>
            )
          )}
          {suivante ? (
            <a href={suivante} rel="next" class="page-lien page-fleche">{lx.suivante}<Icon name="arrow-right" size={16} /></a>
          ) : (
            <span class="page-lien page-fleche opacity-40" aria-hidden="true">{lx.suivante}<Icon name="arrow-right" size={16} /></span>
          )}
        </nav>
      )}
    </div>
  </section>

  <FinalCTA lang={lang} />
</PageLayout>

<script>
  // La recherche et les filtres portent sur TOUS les articles de la langue, pas seulement sur
  // les douze de la page : au premier usage, on lit l'index `/{lang}/blog/articles.json`, et
  // les cartes trouvées remplacent la grille (la pagination se cache). Sans filtre ni
  // recherche, la grille de la page revient telle quelle. Si l'index ne se lit pas, on filtre
  // les cartes de la page, comme avant.
  interface Article { t: string; d: string; c: string; i: string; u: string; img: string; cat: string; date: string; iso: string }

  const echapper = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  function brancher() {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
    const industryFilter = document.getElementById('industry-filter') as HTMLSelectElement | null;
    const blogGrid = document.getElementById('blog-grid');
    const noResults = document.getElementById('no-results');
    const pagination = document.getElementById('blog-pagination');
    const trouves = document.getElementById('blog-trouves');
    if (!blogGrid || blogGrid.dataset.branche) return;
    blogGrid.dataset.branche = '1';
    const lang = blogGrid.dataset.lang || 'en';
    const lire = blogGrid.dataset.libelleLire || 'Read more';
    const grilleDeLaPage = blogGrid.innerHTML;
    let index: Article[] | null = null;
    let chargement: Promise<Article[] | null> | null = null;

    const charger = () => {
      if (!chargement) {
        chargement = fetch(`/${lang}/blog/articles.json`)
          .then((r) => (r.ok ? r.json() : null))
          .then((a) => (index = a))
          .catch(() => null);
      }
      return chargement;
    };

    const carte = (a: Article) => `
      <article class="blog-card carte group overflow-hidden" data-title="${echapper(a.t.toLowerCase())}" data-description="${echapper(a.d.toLowerCase())}" data-category="${echapper(a.c)}" data-industry="${echapper(a.i)}">
        <a href="${echapper(a.u)}" class="relative block aspect-[16/10] overflow-hidden" tabindex="-1" aria-hidden="true">
          ${a.img ? `<img src="${echapper(a.img)}" alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />` : '<span class="absolute inset-0 bg-marque-doux"></span>'}
        </a>
        <div class="grid gap-3 p-6">
          <p class="text-sm font-semibold text-slate-500">${echapper(a.cat)} · <time datetime="${echapper(a.iso)}">${echapper(a.date)}</time></p>
          <h2 class="font-display text-xl font-bold leading-snug text-encre line-clamp-3 transition-colors group-hover:text-marque"><a href="${echapper(a.u)}">${echapper(a.t)}</a></h2>
          <p class="text-slate-600 line-clamp-3">${echapper(a.d)}</p>
        </div>
      </article>`;

    const afficherVide = (vide: boolean) => {
      noResults?.classList.toggle('hidden', !vide);
      blogGrid.classList.toggle('hidden', vide);
    };

    async function filtrer() {
      const terme = searchInput?.value.trim().toLowerCase() || '';
      const cat = categoryFilter?.value || 'all';
      const ind = industryFilter?.value || 'all';
      const actif = terme !== '' || cat !== 'all' || ind !== 'all';
      if (!actif) {
        blogGrid.innerHTML = grilleDeLaPage;
        pagination?.classList.remove('hidden');
        trouves?.classList.add('hidden');
        afficherVide(false);
        return;
      }
      const tous = index ?? (await charger());
      const garde = (titre: string, desc: string, c: string, i: string) =>
        (titre.includes(terme) || desc.includes(terme)) && (cat === 'all' || c === cat) && (ind === 'all' || i === ind);
      if (tous) {
        const choisis = tous.filter((a) => garde(a.t.toLowerCase(), a.d.toLowerCase(), a.c, a.i));
        blogGrid.innerHTML = choisis.map(carte).join('');
        pagination?.classList.add('hidden');
        if (trouves) {
          trouves.textContent = blogGrid.dataset[choisis.length > 1 ? 'trouvesPluriel' : 'trouvesSingulier']?.replace('{}', String(choisis.length)) || String(choisis.length);
          trouves.classList.toggle('hidden', choisis.length === 0);
        }
        afficherVide(choisis.length === 0);
        return;
      }
      // L'index ne s'est pas lu : on filtre les cartes de la page, comme avant.
      blogGrid.innerHTML = grilleDeLaPage;
      let n = 0;
      blogGrid.querySelectorAll<HTMLElement>('.blog-card').forEach((c) => {
        const ok = garde(c.dataset.title || '', c.dataset.description || '', c.dataset.category || '', c.dataset.industry || '');
        c.style.display = ok ? 'block' : 'none';
        if (ok) n++;
      });
      afficherVide(n === 0);
    }

    void lire;
    searchInput?.addEventListener('input', filtrer);
    categoryFilter?.addEventListener('change', filtrer);
    industryFilter?.addEventListener('change', filtrer);
    // Précharger l'index dès que la personne s'approche de la recherche.
    searchInput?.addEventListener('focus', charger, { once: true });
  }
  brancher();
  document.addEventListener('astro:page-load', brancher);
</script>

<style>
  .page-lien {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-weight: 600;
    color: #334155;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--filet);
    transition: color 200ms, background-color 200ms;
  }
  a.page-lien:hover {
    color: var(--color-marque);
  }
  .page-active {
    color: #fff;
    background: var(--color-marque);
    box-shadow: none;
  }

  .champ-blog {
    height: 52px;
    border-radius: 999px;
    background: #fff;
    color: var(--encre);
    box-shadow: inset 0 0 0 1px var(--filet);
    outline: none;
    transition: box-shadow 200ms;
  }
  .champ-blog:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-marque);
  }
  .pl-13 {
    padding-left: 3.25rem;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
