---
/**
 * Aller plus loin : les trois parcours techniques (14/10/2026). Leur contenu vient de
 * `MCPTrainingTracks` ; leur prix, de la grille (le double de l'ancienne, décision de Paul :
 * ils demandent beaucoup de personnalisation et de compréhension du projet). Le nom, la
 * durée, le public et le prix se lisent sans rien ouvrir ; le détail se déplie.
 */
import type { Language } from '@/i18n/config';
import { GRILLE, type Devise } from '@/lib/formation/grille';
import { montant } from '@/lib/formation/moteur';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const devise: Devise = lang === 'fr' ? 'EUR' : 'USD';
const des = (cle: keyof typeof GRILLE.parcours) => montant(GRILLE.parcours[cle][devise], lang, devise);

const T = {
  fr: {
    titre: 'Pour ceux qui veulent construire',
    chapo: 'Des parcours techniques pour les profils qui veulent maîtriser leur stack, pas seulement l’utiliser. Chacun se bâtit sur votre projet : nous prenons le temps de le comprendre avant d’écrire une ligne.',
    a: 'À partir de',
    detail: 'Ce que vous saurez faire',
    contact: 'Parler de votre projet',
    parcours: [
      {
        cle: 'automatisations' as const, nom: 'Automatisations marketing', duree: '1 jour', public: 'Growth managers, marketing ops',
        texte: 'Construisez des workflows qui enrichissent vos leads, synchronisent vos campagnes avec votre BI et tournent tous les matins sans vous.',
        acquis: ['Lancer un workflow n8n : Lemlist, Airscale, ClickUp', 'Exporter les performances des campagnes vers Sheets en automatique', 'Planifier des tâches quotidiennes avec des alertes d’erreur sur Gmail'],
      },
      {
        cle: 'mcp' as const, nom: 'Construire votre serveur MCP', duree: '2 jours', public: 'CMO techniques, fondateurs, consultants',
        texte: 'Concevez, construisez et déployez votre propre serveur MCP : Claude Desktop ou Claude Code, branché sur votre vraie stack marketing.',
        acquis: ['Définir les outils dont votre serveur a besoin', 'Le déployer sur votre infrastructure (Cloud Run, Render ou en local)', 'Interroger votre stack marketing en langage naturel', 'Faire évoluer vos agents : nous vous transmettons la méthode'],
        bonus: 'Livrés : un serveur MCP sur mesure sur votre infrastructure, la documentation complète, un mois de support.',
      },
      {
        cle: 'data' as const, nom: 'Data et reporting (BI)', duree: '1,5 jour', public: 'Analystes, responsables de la performance',
        texte: 'Consolidez vos données multicanal dans BigQuery, écrivez du SQL qui croise les plateformes et générez des rapports propres en automatique.',
        acquis: ['Réunir Meta, Google Ads et GA4 dans une seule couche BigQuery', 'Écrire le SQL qui compare les canaux, repère les anomalies et calcule le retour', 'Générer automatiquement des rapports HTML, Slides et Docs'],
      },
    ],
  },
  en: {
    titre: 'For those who want to build',
    chapo: 'Technical tracks for people who want to own their stack, not just use it. Each one is built on your project: we take the time to understand it before writing a line.',
    a: 'From',
    detail: 'What you will be able to do',
    contact: 'Talk about your project',
    parcours: [
      {
        cle: 'automatisations' as const, nom: 'Marketing automation', duree: '1 day', public: 'Growth managers, marketing ops',
        texte: 'Build workflows that enrich leads, sync your campaigns to your BI and run every morning without you.',
        acquis: ['Launch an n8n workflow: Lemlist, Airscale, ClickUp', 'Export campaign performance to Sheets on a schedule', 'Set up daily jobs with error alerts on Gmail'],
      },
      {
        cle: 'mcp' as const, nom: 'Build your MCP server', duree: '2 days', public: 'Technical CMOs, founders, consultants',
        texte: 'Design, build and deploy your own MCP server: Claude Desktop or Claude Code, connected to your real marketing stack.',
        acquis: ['Define the tools your server needs', 'Deploy it on your infrastructure (Cloud Run, Render or local)', 'Query your marketing stack in natural language', 'Evolve your agents over time: we hand over the method'],
        bonus: 'Delivered: a custom MCP server on your infrastructure, full documentation, one month of support.',
      },
      {
        cle: 'data' as const, nom: 'Data and reporting (BI)', duree: '1.5 days', public: 'Analysts, performance managers',
        texte: 'Consolidate multi-channel data in BigQuery, write cross-platform SQL, and generate clean reports automatically.',
        acquis: ['Bring Meta, Google Ads and GA4 into one BigQuery layer', 'Write the SQL that compares channels, flags anomalies and computes return', 'Auto-generate HTML, Slides and Docs reports'],
      },
    ],
  },
}[lang];
---

<section class="section-brume apl" id="parcours-techniques">
  <div class="container-custom">
    <header class="apl-tete">
      <h2 class="titre-moyen text-encre">{T.titre}</h2>
      <p class="chapo">{T.chapo}</p>
    </header>
    <div class="apl-liste">
      {T.parcours.map((p) => (
        <details class="apl-parcours">
          <summary>
            <span class="apl-nom">{p.nom}</span>
            <span class="apl-meta">{p.duree} · {p.public}</span>
            <span class="apl-prix"><small>{T.a}</small> {des(p.cle)}</span>
            <svg class="apl-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="apl-corps">
            <p>{p.texte}</p>
            <p class="apl-sous">{T.detail}</p>
            <ul>{p.acquis.map((a) => <li>{a}</li>)}</ul>
            {'bonus' in p && p.bonus && <p class="apl-bonus">{p.bonus}</p>}
          </div>
        </details>
      ))}
    </div>
    <div class="pilules apl-cta"><a class="pilule pilule-pleine" href={`/${lang}/contact?topic=parcours-technique`}>{T.contact}</a></div>
  </div>
</section>

<style>
  .apl { padding: 88px 0 72px; }
  @media (min-width: 1024px) { .apl { padding: 128px 0 104px; } }
  .apl-tete { display: grid; gap: 18px; max-width: 820px; margin-bottom: 36px; }
  .apl-liste { display: grid; gap: 12px; }
  .apl-parcours { background: #fff; border-radius: 22px; box-shadow: inset 0 0 0 1px var(--filet); }
  .apl-parcours summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'nom prix' 'meta chevron'; gap: 4px 16px; align-items: center; padding: 20px 22px; }
  .apl-parcours summary::-webkit-details-marker { display: none; }
  @media (min-width: 900px) {
    .apl-parcours summary { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr) auto auto; grid-template-areas: 'nom meta prix chevron'; padding: 24px 28px; }
  }
  .apl-nom { grid-area: nom; font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; font-size: 20px; color: var(--encre); }
  .apl-meta { grid-area: meta; font-size: 14px; color: #4B5B6B; }
  .apl-prix { grid-area: prix; font-family: var(--font-display); font-weight: 800; font-size: 20px; color: var(--encre); white-space: nowrap; text-align: right; }
  .apl-prix small { font-family: var(--font-sans); font-weight: 500; font-size: 13px; color: #4B5B6B; }
  .apl-chevron { grid-area: chevron; width: 22px; height: 22px; color: var(--color-marque); justify-self: end; transition: transform .3s cubic-bezier(0.15, 1, 0.32, 1); }
  .apl-parcours[open] .apl-chevron { transform: rotate(180deg); }
  .apl-parcours summary:focus-visible { outline: 2px solid var(--color-marque); outline-offset: 2px; border-radius: 22px; }
  .apl-corps { padding: 0 22px 22px; display: grid; gap: 10px; max-width: 820px; }
  @media (min-width: 900px) { .apl-corps { padding: 0 28px 26px; } }
  .apl-corps p { margin: 0; color: #4B5B6B; }
  .apl-sous { font-weight: 600; color: var(--encre) !important; margin-top: 6px !important; }
  .apl-corps ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; color: var(--encre); }
  .apl-bonus { font-size: 14px; background: var(--color-marque-doux); border-radius: 12px; padding: 10px 14px; color: var(--encre) !important; }
  .apl-cta { margin-top: 28px; }
</style>
