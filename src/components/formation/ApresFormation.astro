---
/**
 * Ce que les équipes savent faire après la formation (14/10/2026). Fusion de trois sections
 * de l'ancienne page : « Pourquoi une formation IA », les bénéfices pour les managers et
 * l'escalier des acquis. Le visuel dominant est fait des tâches que les participants ont
 * citées dans leurs retours (`data/formation/avis.ts`, colonne « compétences activables au
 * quotidien ») : ce sont leurs mots, pas les nôtres.
 */
import type { Language } from '@/i18n/config';
import { TACHES } from '@/data/formation/avis';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const T = {
  fr: {
    titre: 'Ce qu’ils savent faire en sortant',
    chapo: 'Pas une culture générale de l’IA : des gestes précis, sur leurs propres fichiers, qu’ils refont le lendemain.',
    acquis: [
      ['Ne plus avoir peur de l’IA', 'On la rend concrète, pas à pas, sur les cas de leur métier.'],
      ['Savoir la solliciter', 'La méthode CRAFT : des demandes précises, des réponses exploitables.'],
      ['Savoir ce qu’elle fait vraiment', 'Synthèses, analyses de données, rédaction, présentations, automatisations.'],
      ['Diffuser autour de soi', 'Les participants deviennent les relais de leur équipe.'],
      ['Repérer les cas avancés', 'Les processus où l’IA fera gagner le plus de temps.'],
    ],
    tachesTitre: 'Ce que les participants disent qu’ils feront dès le lendemain',
    tachesNote: 'Extraits de leurs retours écrits.',
    managerTitre: 'Et pour vous, qui pilotez l’équipe',
    manager: [
      'Une adoption réelle, même dans les équipes peu techniques',
      'Des relais internes qui proposent des améliorations',
      'Du temps rendu sur les tâches répétitives, et qui se mesure',
      'Un usage sécurisé, dans des outils approuvés',
    ],
  },
  en: {
    titre: 'What they can do when they walk out',
    chapo: 'Not general AI culture: precise moves, on their own files, that they repeat the next day.',
    acquis: [
      ['No longer afraid of AI', 'We make it concrete, step by step, on the cases of their job.'],
      ['Knowing how to ask', 'The CRAFT method: precise requests, usable answers.'],
      ['Knowing what it really does', 'Summaries, data analysis, writing, presentations, automations.'],
      ['Spreading it around them', 'Participants become the go-to people in their team.'],
      ['Spotting the advanced cases', 'The processes where AI will save the most time.'],
    ],
    tachesTitre: 'What participants say they will do the very next day',
    tachesNote: 'Taken from their written feedback.',
    managerTitre: 'And for you, leading the team',
    manager: [
      'Real adoption, even in non-technical teams',
      'Internal champions who suggest improvements',
      'Time given back on repetitive tasks, and measurable',
      'Safe use, in approved tools',
    ],
  },
}[lang];
---

<section class="section-encre section-monte af">
  <div class="container-custom">
    <header class="af-tete">
      <h2 class="titre-moyen">{T.titre}</h2>
      <p class="chapo">{T.chapo}</p>
    </header>

    <div class="af-grille">
      <ol class="af-acquis">
        {T.acquis.map(([titre, texte]) => (
          <li><strong>{titre}</strong><span>{texte}</span></li>
        ))}
      </ol>

      <figure class="af-taches" data-taches>
        <figcaption><span>{T.tachesTitre}</span><small>{T.tachesNote}</small></figcaption>
        <ul>
          {TACHES.map((x, i) => (
            <li style={`--i:${i}`}><q>{x.texte[lang]}</q><span>{x.ou}</span></li>
          ))}
        </ul>
      </figure>
    </div>

    <div class="af-manager">
      <p>{T.managerTitre}</p>
      <ul>
        {T.manager.map((m) => (
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>{m}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .af { padding: 88px 0 96px; }
  @media (min-width: 1024px) { .af { padding: 128px 0 136px; } }
  .af-tete { display: grid; gap: 18px; max-width: 820px; margin-bottom: 48px; }
  .af-grille { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; }
  @media (min-width: 1024px) { .af-grille { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr); gap: 56px; align-items: start; } }
  .af-acquis { list-style: none; counter-reset: acquis; margin: 0; padding: 0; display: grid; gap: 0; }
  .af-acquis li { display: grid; gap: 4px; padding: 18px 0; border-top: 1px solid var(--filet-sombre); }
  .af-acquis li:last-child { border-bottom: 1px solid var(--filet-sombre); }
  .af-acquis strong { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: #fff; }
  .af-acquis span { color: var(--texte-sombre-2); font-size: 15px; }

  .af-taches { margin: 0; border-radius: 28px; padding: 24px; background: rgb(255 255 255 / 0.05); border: 1px solid var(--filet-sombre); }
  @media (min-width: 768px) { .af-taches { padding: 30px; } }
  .af-taches figcaption { display: grid; gap: 4px; margin-bottom: 18px; }
  .af-taches figcaption span { font-weight: 600; color: #fff; }
  .af-taches figcaption small { font-size: 13px; color: var(--texte-sombre-2); }
  .af-taches ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  @media (min-width: 640px) { .af-taches ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .af-taches li { background: #fff; color: var(--encre); border-radius: 16px; padding: 14px 16px; display: grid; gap: 8px; align-content: space-between; box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.5); }
  .af-taches q { quotes: '«\202f' '\202f»'; font-weight: 600; font-size: 15px; line-height: 1.4; }
  :lang(en) .af-taches q { quotes: '“' '”'; }
  .af-taches li span { font-size: 12px; color: #4B5B6B; }

  .af-manager { margin-top: 44px; display: grid; gap: 14px; }
  .af-manager p { margin: 0; font-weight: 600; color: #fff; }
  .af-manager ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px 28px; }
  @media (min-width: 768px) { .af-manager ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .af-manager ul { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .af-manager li { display: flex; gap: 10px; align-items: flex-start; color: var(--texte-sombre); font-size: 15px; }
  .af-manager svg { width: 18px; height: 18px; color: var(--marque-clair); flex: none; margin-top: 2px; }

  /* Les tâches arrivent une à une : l'état de départ n'existe que sous html.mv. */
  :global(html.mv) [data-taches]:not(.af-jouee) li { opacity: 0; transform: translateY(14px) scale(.98); }
  .af-jouee li { transition: opacity .55s cubic-bezier(0.15, 1, 0.32, 1), transform .55s cubic-bezier(0.15, 1, 0.32, 1); transition-delay: calc(var(--i) * 0.12s); }
</style>

<script>
  function initTaches() {
    document.querySelectorAll<HTMLElement>('[data-taches]').forEach((f) => {
      if (f.dataset.pret) return;
      f.dataset.pret = '1';
      if (!document.documentElement.classList.contains('mv')) { f.classList.add('af-jouee'); return; }
      new IntersectionObserver(([e], o) => { if (e.isIntersecting) { f.classList.add('af-jouee'); o.disconnect(); } }, { threshold: 0.25 }).observe(f);
    });
  }
  initTaches();
  document.addEventListener('astro:page-load', initTaches);
</script>
