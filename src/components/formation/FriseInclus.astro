---
/**
 * Ce qui est compris dans chaque séance (14/10/2026, deuxième version). Paul a trouvé la liste
 * à puces « chiante » et préférait l'ancienne section animée : on reprend donc le rail de
 * « Comment nous créons votre formation » (`RailMorphing`, une forme qui voyage de station en
 * station et change de forme), avec SA liste : diagnostic, formulaire aux participants, calls
 * de brief et briefs écrits, programme sur le métier et contenu en avance, la séance,
 * l'enregistrement et les recommandations. Rien d'autre n'est promis.
 */
import type { Language } from '@/i18n/config';
import RailMorphing from '@/components/motion/RailMorphing.astro';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const T = {
  fr: {
    titre: 'Ce qui est compris, avant, pendant et après la séance',
    chapo: 'À distance comme en présentiel, en 3 heures comme à la journée. C’est ce travail autour de la séance qui la rend utile dès le lendemain.',
    stations: [
      { titre: 'Le diagnostic', texte: 'Un call pour savoir où en est l’équipe avec l’IA, ses outils, ses usages. Puis un formulaire à chaque participant, pour connaître chacun.', forme: 'loupe' },
      { titre: 'Les briefs', texte: 'Plusieurs calls de brief et des briefs écrits : nous calons le programme avec vous, cas par cas.', forme: 'bulle' },
      { titre: 'Votre programme', texte: 'Bâti sur les cas de votre métier, dans vos outils. Le contenu est accessible avant la séance.', forme: 'structure' },
      { titre: 'La séance', texte: 'Animée par un praticien : chacun travaille sur ses propres fichiers, avec un support interactif remis à tous.', forme: 'curseur' },
      { titre: 'Et après', texte: 'L’enregistrement des séquences, la transcription écrite, et des recommandations d’outils pour votre contexte.', forme: 'courbe' },
    ],
  },
  en: {
    titre: 'What is included, before, during and after the session',
    chapo: 'Remote or on-site, three hours or a full day. The work around the session is what makes it useful the very next day.',
    stations: [
      { titre: 'The diagnostic', texte: 'A call to see where the team stands with AI, its tools, its uses. Then a questionnaire for every participant, to get to know each person.', forme: 'loupe' },
      { titre: 'The briefs', texte: 'Several briefing calls and written briefs: we shape the programme with you, case by case.', forme: 'bulle' },
      { titre: 'Your programme', texte: 'Built on the cases of your trade, in your tools. The content is available before the session.', forme: 'structure' },
      { titre: 'The session', texte: 'Led by a practitioner: everyone works on their own files, with interactive material for all.', forme: 'curseur' },
      { titre: 'And after', texte: 'The recording of the sequences, the written transcript, and tool recommendations for your context.', forme: 'courbe' },
    ],
  },
}[lang];
---

<section class="section-blanc fi" id="compris">
  <div class="container-custom">
    <header class="fi-tete">
      <h2 class="titre-moyen text-encre">{T.titre}</h2>
      <p class="chapo">{T.chapo}</p>
    </header>
    <RailMorphing lang={lang} stations={T.stations as { titre: string; texte: string; forme: 'loupe' | 'bulle' | 'structure' | 'curseur' | 'courbe' }[]} />
  </div>
</section>

<style>
  .fi { padding: 80px 0; }
  @media (min-width: 1024px) { .fi { padding: 120px 0; } }
  .fi-tete { display: grid; gap: 18px; max-width: 820px; margin-bottom: 40px; }
</style>
