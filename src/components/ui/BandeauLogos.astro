---
/**
 * La bande de logos de la direction Encre (30/09/2026) : un libellé à gauche, les
 * logos en grille immobile à droite, EN COULEUR (Paul, 30/09/2026 : plus de noir et blanc
 * ni de gris sur tout le site), sur fond clair. Aucun défilé, aucun
 * compteur de clients. Sert au bas du hero des pages services (`HeroService`) et
 * à `TrustedBy`.
 *
 * Deux façons de donner les logos :
 * - `slugs` : les logos détourés de `src/data/accueil/logos.json`, affichés à
 *   SURFACE égale (`hauteurLogo`), comme sur l'accueil ;
 * - `logos` : des fichiers quelconques `{ name, logo }`, tenus dans une boîte de
 *   28 px de haut (la page AI Training passe ainsi ses clients de formation).
 */
import { LOGOS, hauteurLogo } from '@/components/accueil/donnees';

interface LogoLibre {
  name: string;
  logo: string;
}

interface Props {
  titre: string;
  slugs?: string[];
  logos?: LogoLibre[];
}

/** Les clients de l'agence, ceux de la maquette : automobile puis B2B. */
const LOGOS_AGENCE = [
  'theobald', 'vulcain', 'dmd', 'bymycar', 'ford', 'motork',
  'genesys', 'opentext', 'edenred', 'gwi', 'symbl', 'quantum',
];

const { titre, slugs = LOGOS_AGENCE, logos } = Astro.props;

const liste =
  logos && logos.length > 0
    ? logos.map((l) => ({ nom: l.name, src: l.logo, largeur: 120, hauteur: 28, h: undefined as number | undefined }))
    : slugs
        .filter((s) => LOGOS[s])
        .map((s) => ({ nom: LOGOS[s].nom, src: LOGOS[s].src, largeur: LOGOS[s].largeur, hauteur: LOGOS[s].hauteur, h: hauteurLogo(s, 2400, 20, 40) }));
---

<div class="container-custom bandeau-logos grid items-center gap-7 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-12">
  <p class="text-base font-medium leading-snug text-slate-600">{titre}</p>
  <ul class="grid grid-cols-3 items-center justify-items-center gap-x-4 gap-y-7 sm:grid-cols-4 lg:grid-cols-6 lg:gap-x-7 lg:gap-y-9">
    {liste.map((l) => (
      <li class="flex h-10 items-center">
        <img
          src={l.src}
          alt={l.nom}
          width={l.largeur}
          height={l.hauteur}
          style={l.h ? `height:${l.h}px` : undefined}
          class:list={['w-auto max-w-full object-contain', { 'max-h-7': !l.h }]}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
</div>

