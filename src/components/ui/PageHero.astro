---
/**
 * Le haut des pages d'index (services, IA, automobile, études de cas, blog,
 * recrutement) : fond blanc, rubrique en bleu du logo, titre serré en graisse 800
 * aligné à gauche, et au plus les deux portes du site, en pilules côte à côte
 * (direction Encre, 30/09/2026). Il remplace six bandeaux sombres en
 * dégradé, chacun avec ses halos. Aucune animation d'entrée : le titre est là dès
 * le premier rendu.
 *
 * Le créneau `apres` pose un bloc pleine largeur sous le texte (l'aiguillage de `/ai`).
 */
import Icon from '@/components/ui/Icon.astro';

interface Action {
  href: string;
  label: string;
  /** « plein » : la pilule bleue ; « contour » : la pilule blanche bordée. */
  style?: 'plein' | 'contour';
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  description?: string;
  actions?: Action[];
}

const { eyebrow, title, subtitle, description, actions = [] } = Astro.props;
---

<!-- Direction Encre (30/09/2026) : la rubrique en bleu du logo (la seule de la page),
     le titre aux mesures communes (`titre-grand`), les boutons en pilules côte à côte. -->
<section class="page-hero section-blanc border-b border-slate-200">
  <div class="container-custom pt-10 pb-14 sm:pt-14 lg:pt-18 lg:pb-20">
    <div class="grid max-w-4xl justify-items-start gap-5 lg:gap-6">
      {eyebrow && <p class="rubrique">{eyebrow}</p>}
      <h1 class="titre-grand text-encre break-words">
        {title}
      </h1>
      {subtitle && <p class="text-lg sm:text-xl font-semibold text-encre text-pretty">{subtitle}</p>}
      {description && <p class="chapo">{description}</p>}
      {actions.length > 0 && (
        <div class="pilules mt-3">
          {actions.map((a) =>
            a.style === 'contour' ? (
              <a href={a.href} class="pilule pilule-contour">
                {a.label}
              </a>
            ) : (
              <a href={a.href} class="pilule pilule-pleine">
                {a.label}
                <Icon name="arrow-right" size={18} class="pilule-fleche" />
              </a>
            ),
          )}
        </div>
      )}
      <slot />
    </div>
    <slot name="apres" />
  </div>
</section>
