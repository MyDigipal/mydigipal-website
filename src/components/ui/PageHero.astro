---
/**
 * Le haut des pages d'index (services, IA, automobile, études de cas, blog,
 * recrutement), dans le style de l'accueil depuis le 25/09/2026 : fond blanc,
 * sur-titre gris, titre serré en graisse 800 aligné à gauche, une ligne en bleu du
 * logo, et au plus les deux portes du site. Il remplace six bandeaux sombres en
 * dégradé, chacun avec ses halos. Aucune animation d'entrée : le titre est là dès
 * le premier rendu.
 */
import Icon from '@/components/ui/Icon.astro';

interface Action {
  href: string;
  label: string;
  /** « plein » : la pilule bleue ; « contour » : la pilule blanche bordée. */
  style?: 'plein' | 'contour';
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  description?: string;
  actions?: Action[];
}

const { eyebrow, title, subtitle, description, actions = [] } = Astro.props;
---

<section class="page-hero bg-white border-b border-slate-100">
  <div class="container-custom pt-12 pb-14 sm:pt-16 lg:pt-20 lg:pb-20">
    <div class="max-w-4xl">
      {eyebrow && <p class="mb-5 text-sm font-semibold text-slate-500">{eyebrow}</p>}
      <h1 class="page-hero-titre font-display text-[2.375rem] sm:text-5xl lg:text-[4rem] font-extrabold text-encre break-words hyphens-auto">
        {title}
      </h1>
      {subtitle && <p class="mt-5 text-lg sm:text-xl font-semibold text-marque text-pretty">{subtitle}</p>}
      {description && <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-[60ch] text-pretty">{description}</p>}
      {actions.length > 0 && (
        <div class="mt-9 flex flex-wrap gap-3">
          {actions.map((a) =>
            a.style === 'contour' ? (
              <a href={a.href} class="inline-flex items-center justify-center h-13 px-6 rounded-full border border-slate-300 text-encre font-semibold hover:border-slate-400 hover:bg-slate-50 transition-colors">
                {a.label}
              </a>
            ) : (
              <a href={a.href} class="group inline-flex items-center justify-center gap-2 h-13 px-6 rounded-full bg-marque text-white font-semibold hover:bg-marque-fonce active:scale-[0.98] transition-colors">
                {a.label}
                <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
              </a>
            ),
          )}
        </div>
      )}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero-titre {
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
</style>
