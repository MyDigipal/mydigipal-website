---
// L'image d'un article, servie à la taille de son cadre (voir `lib/vignettes-blog.ts`).
import { vignette } from '../../lib/vignettes-blog';

interface Props {
  image: string;
  alt?: string;
  sizes: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
}

const { image, alt = '', sizes, class: classe, loading = 'lazy', fetchpriority } = Astro.props;
const v = vignette(image);
---

<picture>
  {v.avif && <source type="image/avif" srcset={v.avif} sizes={sizes} />}
  {v.webp && <source type="image/webp" srcset={v.webp} sizes={sizes} />}
  <img
    src={v.src}
    alt={alt}
    class={classe}
    width={v.largeur}
    height={v.hauteur}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
