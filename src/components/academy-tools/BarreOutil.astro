---
import Drapeau from './Drapeau.astro';

/**
 * La barre des pages outils.
 *
 * Elle reprend trait pour trait celle de la page de vente (`academy/Barre.tsx`) :
 * même logo, mêmes pilules, même sélecteur de devise, même sélecteur de langue,
 * même bouton (demande de Paul du 13/09/2026 : « t'as pas pris le même menu que
 * l'autre page, peut-être qu'on s'aligne entre les deux »).
 *
 * ⚠️ Elle n'est PAS le composant React de la page de vente, et c'est voulu.
 * Celui-là porte la progression du récit, le compteur « Jour n / 30 » et un
 * observateur de sections qui n'ont aucun sens ici, et il impose React au
 * chargement. Cette page charge React seulement quand la console arrive à
 * l'écran ; une barre en îlot `client:load` annulerait ce gain. Tout ce qui
 * bouge ici tient dans le script du bas de page : le menu, et la devise.
 *
 * Les trois prix sont posés dans `data-prix` au build : le sélecteur de devise
 * fonctionne donc même si l'application ne répond pas, alors qu'un sélecteur
 * qui attend une requête reste muet quelques secondes après l'affichage.
 */
interface Props {
  locale: 'fr' | 'en';
  /** Le chemin de la même page dans l'autre langue. */
  lienAutreLangue: string;
  reperes: Array<{ id: string; libelle: string }>;
  cta: string;
  lienApp: string;
  lienVente: string;
  /** Les montants du programme, dans les trois devises, en centimes. */
  prix: Partial<Record<'EUR' | 'GBP' | 'USD', number>>;
  copy: {
    marque: string;
    aria: string;
    langue: string;
    langueAria: string;
    menuOuvrir: string;
    menuSections: string;
    menuLangue: string;
    menuDevise: string;
  };
}

const { locale, lienAutreLangue, reperes, cta, lienApp, lienVente, prix, copy } = Astro.props;
const autre = locale === 'fr' ? 'en' : 'fr';
const DEVISES = [
  { code: 'EUR', symbole: '€' },
  { code: 'GBP', symbole: '£' },
  { code: 'USD', symbole: '$' },
] as const;
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-filet-nuit bg-salle/92 backdrop-blur"
  data-theme="nuit"
  data-barre-outil
  data-prix={JSON.stringify(prix)}
>
  <div class="mx-auto flex h-16 max-w-[1280px] items-center gap-4 px-4 sm:px-6">
    <a href={lienVente} class="flex flex-none items-center gap-2.5" aria-label="MyDigipal">
      <img
        src="/images/Logos/03_Full white.png"
        alt=""
        width={140}
        height={40}
        class="h-7 w-auto"
        loading="eager"
      />
      <span
        class="hidden font-ac-mono text-[10.5px] font-bold uppercase tracking-[0.18em] text-brume-nuit sm:inline"
        >{copy.marque}</span
      >
    </a>

    <nav class="-mx-1 hidden min-w-0 flex-1 items-center gap-1 px-1 lg:flex" aria-label={copy.aria}>
      {
        reperes.map((r) => (
          <a
            href={`#${r.id}`}
            class="whitespace-nowrap rounded-full border border-filet-nuit px-3 py-1.5 font-ac-mono text-[11px] font-bold uppercase tracking-[0.12em] text-corps-nuit transition duration-150 hover:border-brume-nuit hover:text-ivoire"
          >
            {r.libelle}
          </a>
        ))
      }
    </nav>

    <div
      class="ml-auto hidden flex-none items-center overflow-hidden rounded-bouton border border-filet-nuit lg:flex"
    >
      {
        DEVISES.map((d) => (
          <button
            type="button"
            data-devise={d.code}
            aria-pressed={d.code === 'EUR'}
            aria-label={d.code}
            class="min-h-10 cursor-pointer border-0 bg-transparent px-2.5 font-ac-mono text-[12px] font-bold text-corps-nuit transition duration-150 hover:text-ivoire aria-pressed:bg-or aria-pressed:text-salle"
          >
            {d.symbole}
          </button>
        ))
      }
    </div>

    <a
      href={lienAutreLangue}
      hreflang={autre}
      aria-label={copy.langueAria}
      title={copy.langueAria}
      class="hidden min-h-10 flex-none items-center gap-2 rounded-bouton border border-filet-nuit px-2.5 font-ac-mono text-[11px] font-bold uppercase tracking-[0.1em] text-corps-nuit transition duration-150 hover:border-brume-nuit hover:text-ivoire lg:flex"
    >
      <Drapeau locale={autre} />
      <span>{copy.langue}</span>
    </a>

    <!-- Sous lg, tout ce qui précède rentre dans le panneau. -->
    <button
      type="button"
      data-menu-bouton
      aria-expanded="false"
      aria-controls="barre-menu"
      aria-label={copy.menuOuvrir}
      class="ml-auto grid h-11 w-11 flex-none cursor-pointer place-items-center rounded-bouton border border-filet-nuit bg-transparent text-corps-nuit transition hover:border-brume-nuit hover:text-ivoire lg:hidden"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
    </button>

    <a
      href={lienApp}
      data-app-link
      class="hidden min-h-10 flex-none items-center whitespace-nowrap rounded-bouton bg-or px-4 py-2 text-[14px] font-semibold text-salle transition duration-150 hover:bg-or-vif lg:inline-flex"
    >
      {cta}
    </a>
  </div>

  <div
    id="barre-menu"
    hidden
    class="absolute inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-filet-nuit bg-salle px-4 pb-5 pt-4 shadow-[0_18px_40px_-18px_rgba(0,0,0,.8)] sm:px-6 lg:hidden"
  >
    <p class="m-0 mb-2.5 font-ac-mono text-[10.5px] font-bold uppercase tracking-[.16em] text-brume-nuit">
      {copy.menuSections}
    </p>
    <nav class="flex flex-col gap-1.5" aria-label={copy.aria}>
      {
        reperes.map((r) => (
          <a
            href={`#${r.id}`}
            data-menu-lien
            class="flex min-h-11 items-center rounded-[10px] border border-filet-nuit px-3.5 font-ac-mono text-[12px] font-bold uppercase tracking-[.12em] text-corps-nuit transition hover:border-brume-nuit hover:text-ivoire"
          >
            {r.libelle}
          </a>
        ))
      }
    </nav>

    <a
      href={lienApp}
      data-app-link
      data-menu-lien
      class="mt-3.5 flex min-h-12 items-center justify-center rounded-bouton bg-or px-4 text-[15px] font-semibold text-salle transition hover:bg-or-vif"
    >
      {cta}
    </a>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-4 border-t border-filet-nuit pt-4">
      <div>
        <p class="m-0 mb-2 font-ac-mono text-[10.5px] font-bold uppercase tracking-[.16em] text-brume-nuit">
          {copy.menuLangue}
        </p>
        <a
          href={lienAutreLangue}
          hreflang={autre}
          class="flex min-h-11 items-center gap-2 rounded-bouton border border-filet-nuit px-3 font-ac-mono text-[12px] font-bold uppercase tracking-[.1em] text-corps-nuit transition hover:border-brume-nuit hover:text-ivoire"
        >
          <Drapeau locale={autre} />
          <span>{copy.langue}</span>
        </a>
      </div>
      <div>
        <p class="m-0 mb-2 font-ac-mono text-[10.5px] font-bold uppercase tracking-[.16em] text-brume-nuit">
          {copy.menuDevise}
        </p>
        <div class="flex items-center overflow-hidden rounded-bouton border border-filet-nuit">
          {
            DEVISES.map((d) => (
              <button
                type="button"
                data-devise={d.code}
                aria-pressed={d.code === 'EUR'}
                aria-label={d.code}
                class="min-h-11 cursor-pointer border-0 bg-transparent px-3.5 font-ac-mono text-[12px] font-bold text-corps-nuit transition hover:text-ivoire aria-pressed:bg-or aria-pressed:text-salle"
              >
                {d.symbole}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</header>
