---
/**
 * La grille de mots (direction Encre, 30/09/2026) : une méthode nommée en quatre à six
 * mots, CRAFT par exemple. Ce qu'elle explique : chaque lettre est un CHAMP du prompt.
 * Les lettres s'allument l'une après l'autre, et à chaque lettre sa ligne s'écrit dans
 * un prompt d'exemple, étiquetée par la lettre. Un libellé naît à côté de ce qu'il
 * nomme, au moment où ça se passe (règle de Paul, lot 3 des essais).
 *
 * Contrat du socle : l'état final est celui de la feuille de style, le même sans
 * script ; chaque lettre est un bouton qui rejoue le passage jusqu'à elle.
 * À poser dans une `.section-encre`.
 */
import type { Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Mot {
  lettre: string;
  mot: string;
  description: string;
  /** La ligne du prompt d'exemple qui remplit ce champ. */
  exemple: string;
}

interface Props {
  lang: Language;
  mots: Mot[];
  /** Le titre du prompt d'exemple. */
  titreExemple: string;
  /** La phrase qui conclut, sous le prompt. */
  conclusion?: string;
}

const { lang, mots, titreExemple, conclusion } = Astro.props;
if (mots.length < 3 || mots.length > 6) throw new Error(`GrilleMots : de trois à six mots, pas ${mots.length}.`);
const rejouer = lang === 'fr' ? 'Rejouer' : 'Replay';

// La partition : une lettre toutes les 1,3 s, puis la conclusion.
const PAS = 1.3;
const DEBUT = 0.4;
const TENUE = +(DEBUT + PAS * mots.length + 0.8).toFixed(2);
const reperes = mots.map((_, i) => ({
  aller: i === 0 ? 0 : +(DEBUT + PAS * i - 0.2).toFixed(2),
  tenir: i === mots.length - 1 ? TENUE : +(DEBUT + PAS * i + 1.1).toFixed(2),
  jusqua: i === mots.length - 1 ? TENUE : +(DEBUT + PAS * (i + 1) - 0.2).toFixed(2),
}));
---

<div class="gm" data-grille-mots data-n={mots.length} data-tenue={TENUE}>
  <div class="gm-plateau">
    <ol class="gm-mots">
      {mots.map((m, i) => (
        <li class="gm-rang">
          <button
            type="button"
            class="gm-bouton"
            data-aller={reperes[i].aller}
            data-tenir={reperes[i].tenir}
            data-jusqua={reperes[i].jusqua}
            data-dernier={i === mots.length - 1 ? '' : undefined}
            aria-pressed={i === mots.length - 1 ? 'true' : 'false'}
          >
            <span class="gm-lettre" aria-hidden="true">{m.lettre}</span>
            <span class="gm-texte">
              <span class="gm-mot">{m.mot}</span>
              <span class="gm-description">{m.description}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <figure class="gm-prompt">
      <figcaption class="gm-prompt-titre">{titreExemple}</figcaption>
      <ul class="gm-lignes">
        {mots.map((m) => (
          <li class="gm-ligne">
            <span class="gm-etiquette" aria-hidden="true">{m.lettre}</span>
            <span class="gm-exemple"><span class="sr-only">{m.mot} : </span>{m.exemple}</span>
          </li>
        ))}
      </ul>
      {conclusion && <p class="gm-conclusion">{conclusion}</p>}
    </figure>
  </div>

  <button type="button" class="gm-rejouer" data-rejouer>
    <Icon name="refresh-cw" size={18} />
    {rejouer}
  </button>
</div>

<style>
  .gm :focus-visible {
    outline-color: #fff;
  }
  .gm-plateau {
    display: grid;
    gap: 32px;
  }
  .gm-mots {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gm-bouton {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 64px;
    padding: 4px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .gm-lettre {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--color-marque);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }
  .gm-bouton:hover .gm-mot {
    color: var(--marque-clair);
  }
  .gm-texte {
    display: grid;
    gap: 2px;
  }
  .gm-mot {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    transition: color 200ms ease;
  }
  .gm-description {
    color: var(--texte-sombre-2);
  }

  /* Le prompt d'exemple : un panneau de verre, une ligne par champ. */
  .gm-prompt {
    margin: 0;
    padding: 24px 20px;
    border-radius: var(--rayon-panneau);
    background:
      radial-gradient(120% 70% at 0% 0%, rgb(255 255 255 / 0.10), transparent 58%),
      #0f2740;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14), 0 32px 64px -28px rgb(2 9 16 / 0.8);
  }
  .gm-prompt-titre {
    margin-bottom: 18px;
    font-weight: 600;
    color: var(--texte-sombre-2);
  }
  .gm-lignes {
    display: grid;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gm-ligne {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
  }
  .gm-etiquette {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--texte-sombre);
    color: var(--color-marque-fonce);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1;
  }
  .gm-exemple {
    padding-top: 4px;
    color: var(--texte-sombre);
    text-wrap: pretty;
  }
  .gm-conclusion {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--filet-sombre);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.35;
    color: #fff;
  }

  .gm-rejouer {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    margin-top: 28px;
    margin-left: -12px;
    padding: 0 14px 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    color: var(--texte-sombre-2);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .gm-rejouer:hover {
    color: #fff;
    background: var(--verre);
  }

  @media (min-width: 1024px) {
    .gm-plateau {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 64px;
    }
    .gm-bouton {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 20px;
      min-height: 80px;
    }
    .gm-lettre {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      font-size: 2.25rem;
    }
    .gm-mot {
      font-size: 1.5rem;
    }
    .gm-prompt {
      padding: 36px 32px;
    }
    .gm-exemple {
      font-size: 1.0625rem;
    }
    .gm-conclusion {
      font-size: 1.375rem;
    }
  }
</style>

<script>
  import { scene, courbes as C, seg, mix, depasse, clamp } from '@/lib/motion';

  const PAS = 1.3;
  const DEBUT = 0.4;

  function monter(el: HTMLElement) {
    if (el.dataset.monte) return;
    el.dataset.monte = '1';
    const n = Number(el.dataset.n);
    const TENUE = Number(el.dataset.tenue);
    const lettres = Array.from(el.querySelectorAll<HTMLElement>('.gm-lettre'));
    const textes = Array.from(el.querySelectorAll<HTMLElement>('.gm-texte'));
    const etiquettes = Array.from(el.querySelectorAll<HTMLElement>('.gm-etiquette'));
    const exemples = Array.from(el.querySelectorAll<HTMLElement>('.gm-exemple'));
    const conclusion = el.querySelector<HTMLElement>('.gm-conclusion');
    const touches = [...lettres, ...textes, ...etiquettes, ...exemples, conclusion].filter(Boolean) as HTMLElement[];

    function rendu(t: number) {
      if (t >= TENUE - 0.001) {
        for (const nd of touches) {
          nd.style.transform = '';
          nd.style.opacity = '';
        }
        return;
      }
      for (let i = 0; i < n; i++) {
        const a = DEBUT + PAS * i;
        // La lettre est un objet : elle peut dépasser un peu en se posant. Avant son
        // tour, elle attend en filigrane, pour que la grille se lise dès le départ.
        const q = Math.max(0, depasse(1.4)(seg(t, a, a + 0.55)));
        lettres[i].style.transform = `scale(${mix(0.72, 1, q).toFixed(4)})`;
        lettres[i].style.opacity = mix(0.22, 1, seg(t, a, a + 0.18)).toFixed(3);
        // Le mot et sa description : le déplacement fait le geste, l'opacité est courte.
        const e = C.entree(seg(t, a + 0.12, a + 0.67));
        textes[i].style.transform = `translate3d(${((1 - e) * 14).toFixed(2)}px,0,0)`;
        textes[i].style.opacity = mix(0.22, 1, seg(t, a + 0.12, a + 0.3)).toFixed(3);
        // Puis sa ligne s'écrit dans le prompt, étiquetée par la lettre.
        const p = Math.max(0, depasse(1.6)(seg(t, a + 0.4, a + 0.8)));
        etiquettes[i].style.transform = `scale(${p.toFixed(4)})`;
        etiquettes[i].style.opacity = seg(t, a + 0.4, a + 0.5).toFixed(3);
        const f = C.entree(seg(t, a + 0.5, a + 1.05));
        exemples[i].style.transform = `translate3d(${((1 - f) * -16).toFixed(2)}px,0,0)`;
        exemples[i].style.opacity = seg(t, a + 0.5, a + 0.66).toFixed(3);
      }
      if (conclusion) {
        const a = DEBUT + PAS * n;
        const e = C.entree(seg(t, a, a + 0.55));
        conclusion.style.transform = `translate3d(0,${((1 - e) * 16).toFixed(2)}px,0)`;
        conclusion.style.opacity = seg(t, a, a + 0.14).toFixed(3);
      }
    }

    const h = el.getBoundingClientRect().height || 1;
    const seuil = clamp((window.innerHeight * 0.4) / h, 0.12, 0.6);
    scene(el, { tenue: TENUE, rendu, seuil });
  }

  function monterTout() {
    document.querySelectorAll<HTMLElement>('[data-grille-mots]').forEach(monter);
  }
  monterTout();
  document.addEventListener('astro:page-load', monterTout);
</script>
