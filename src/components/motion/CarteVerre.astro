---
/**
 * La carte de verre (direction Encre, 30/09/2026). Un objet, ce qui y entre et ce
 * qui en sort : une campagne Performance Max, un serveur MCP, un flux de stock.
 * Portée de la maquette `labo/refonte-site/direction-a.html` (#scene-pmax) et de
 * l'essai `carte-3d` ; Paul : « vraiment une super animation », avec une phrase à
 * gauche et une à droite pendant que la carte vit.
 *
 * Trois temps, une chose bouge à la fois :
 *   1. ce qu'on lui donne : les entrées arrivent de la gauche et se rangent ;
 *   2. ce qu'elle décide : la carte pivote, un trait par sortie se trace ;
 *   3. ce qu'on lui apprend : les retours reviennent, les garde-fous ferment un passage.
 * Puis la phrase de conclusion monte de son masque.
 *
 * Le contrat du socle (`src/lib/motion/scene.ts`) : l'état final est celui de la
 * feuille de style, le même sans script, sous mouvement réduit et avec `?fige=1` ;
 * la scène joue une fois à l'entrée dans l'écran, les repères rejouent chaque temps.
 * À l'instant de tenue elle retire tous ses styles en ligne.
 *
 * Sur téléphone (sous 1 024 px), la solution de la direction C : le dessin, réduit à
 * ses icônes, reste collé sous l'en-tête pendant qu'on lit les trois temps, et les
 * libellés sortent du dessin pour s'écrire en listes à 16 px sous chaque temps.
 *
 * À poser dans une `.section-encre`. Les icônes sont des noms de `ui/Icon.astro`.
 */
import type { Language } from '@/i18n/config';
import Icon from '@/components/ui/Icon.astro';

interface Element {
  libelle: string;
  icone: string;
}
interface Temps {
  titre: string;
  texte: string;
}

interface Props {
  lang: Language;
  /** Le nom écrit sur la carte. */
  nom: string;
  /** Temps 1 : ce qui entre dans la carte (six au plus). */
  entrees: Element[];
  /** Temps 2 : où elle se montre, un trait par sortie (six au plus). */
  sorties: Element[];
  /** Temps 3 : ce qui revient dans la carte (trois au plus). */
  retours: Element[];
  /** Temps 3 : les passages fermés (deux au plus). */
  gardes?: string[];
  /** Les trois phrases, dans l'ordre : à gauche, à droite, à gauche. */
  temps: [Temps, Temps, Temps];
  /** Deux lignes : la seconde est en blanc. */
  conclusion?: [string, string];
  /** L'identifiant du titre de la section, pour nommer le groupe de repères. */
  titreId?: string;
}

const { lang, nom, entrees, sorties, retours, gardes = [], temps, conclusion, titreId } = Astro.props;
const rejouer = lang === 'fr' ? 'Rejouer' : 'Replay';

// Le faisceau, dessiné au pixel : une sortie ou un garde-fou tous les 52 px (44 de haut,
// 8 d'écart), les garde-fous 24 px sous la dernière sortie. Le départ est au milieu.
const n = sorties.length;
const g = gardes.length;
const H = g > 0 ? 52 * (n + g) + 8 : 52 * n - 8;
const o = H / 2;
const traits = sorties.map((_, k) => `M0 ${o} C 84 ${o} 68 ${22 + 52 * k} 148 ${22 + 52 * k}`);
const impasses = gardes.map((_, j) => `M0 ${o} C 78 ${o} 58 ${52 * n + 38 + 52 * j} 134 ${52 * n + 38 + 52 * j}`);

// Les repères : chaque temps rejoue le passage qui y mène, puis s'y arrête.
const TENUE = 14;
const reperes = [
  { aller: 0, tenir: 4.6, jusqua: 5.1 },
  { aller: 5.1, tenir: 9.1, jusqua: 9.6 },
  { aller: 9.6, tenir: TENUE, jusqua: TENUE, dernier: true },
];
---

<div class="cv" data-carte-verre style={`--n:${n}`}>
  <div class="cv-reperes" role="group" aria-labelledby={titreId}>
    {temps.map((tp, i) => (
      <button
        type="button"
        class="cv-repere"
        data-aller={reperes[i].aller}
        data-tenir={reperes[i].tenir}
        data-jusqua={reperes[i].jusqua}
        data-dernier={reperes[i].dernier ? '' : undefined}
        aria-pressed={reperes[i].dernier ? 'true' : 'false'}
      >
        {tp.titre}
      </button>
    ))}
    <button type="button" class="cv-rejouer" data-rejouer>
      <Icon name="refresh-cw" size={18} />
      {rejouer}
    </button>
  </div>

  <div class="cv-plateau">
    <div class="cv-temps cv-temps-1">
      <h3 class="cv-temps-titre"><span class="ligne"><span>{temps[0].titre}</span></span></h3>
      <p class="cv-temps-texte">{temps[0].texte}</p>
      <ul class="cv-liste" aria-hidden="true">
        {entrees.map((e) => <li><Icon name={e.icone} size={18} />{e.libelle}</li>)}
      </ul>
    </div>

    <div class="cv-machine">
      <div class="cv-champ">
        <span class="cv-ombre" aria-hidden="true"></span>
        <div class="cv-pose">
          <div class="cv-carte">
            <span class="cv-dos" aria-hidden="true"></span>
            <span class="cv-face" aria-hidden="true"><span class="cv-reflet"></span></span>
            <div class="cv-contenu">
              <p class="cv-nom">{nom}</p>
              <ul class="cv-entrees">
                {entrees.map((e) => (
                  <li><span class="cv-puce"><Icon name={e.icone} size={16} /><span class="cv-libelle">{e.libelle}</span></span></li>
                ))}
              </ul>
              <ul class="cv-retours">
                {retours.map((r) => (
                  <li><span class="cv-puce"><Icon name={r.icone} size={16} /><span class="cv-libelle">{r.libelle}</span></span></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <svg class="cv-faisceau" viewBox={`0 0 148 ${H}`} width="148" height={H} aria-hidden="true" focusable="false">
        {traits.map((d) => <path class="cv-trait" pathLength="1" d={d} />)}
        {impasses.map((d) => <path class="cv-impasse" pathLength="1" d={d} />)}
      </svg>

      <div class="cv-tiges" aria-hidden="true">
        {sorties.map(() => <span class="cv-tige"></span>)}
      </div>

      <div class="cv-sorties">
        <ul class="cv-reseaux">
          {sorties.map((s) => (
            <li><Icon name={s.icone} size={16} /><span class="cv-libelle">{s.libelle}</span></li>
          ))}
        </ul>
        {g > 0 && (
          <ul class="cv-gardes">
            {gardes.map((nomGarde) => (
              <li>
                <span class="cv-garde-trait" aria-hidden="true"></span>
                <Icon name="ban" size={18} class="cv-garde-signe" />
                <span class="cv-garde-nom cv-libelle">{nomGarde}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="cv-temps cv-temps-2">
      <h3 class="cv-temps-titre"><span class="ligne"><span>{temps[1].titre}</span></span></h3>
      <p class="cv-temps-texte">{temps[1].texte}</p>
      <ul class="cv-liste" aria-hidden="true">
        {sorties.map((s) => <li><Icon name={s.icone} size={18} />{s.libelle}</li>)}
      </ul>
    </div>

    <div class="cv-temps cv-temps-3">
      <h3 class="cv-temps-titre"><span class="ligne"><span>{temps[2].titre}</span></span></h3>
      <p class="cv-temps-texte">{temps[2].texte}</p>
      <ul class="cv-liste" aria-hidden="true">
        {retours.map((r) => <li><Icon name={r.icone} size={18} />{r.libelle}</li>)}
        {gardes.map((nomGarde) => <li><Icon name="ban" size={18} />{nomGarde}</li>)}
      </ul>
    </div>
  </div>

  {conclusion && (
    <p class="cv-conclusion">
      <span class="ligne"><span class="cv-conclusion-1">{conclusion[0]}</span></span>
      <span class="ligne"><span class="cv-conclusion-2">{conclusion[1]}</span></span>
    </p>
  )}
</div>

<style>
  .cv {
    --entete: 73px;
    --gouttiere: 1rem;
  }
  @media (min-width: 640px) {
    .cv {
      --gouttiere: 1.5rem;
    }
  }
  .cv :focus-visible {
    outline-color: #fff;
  }
  .ligne {
    display: block;
    overflow: hidden;
    padding-block: 0.12em;
    margin-block: -0.12em;
  }
  .ligne > span {
    display: block;
  }

  /* ----- les repères ----- */
  .cv-reperes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-bottom: 32px;
  }
  .cv-repere:not(:nth-of-type(3)) {
    grid-column: 1 / -1;
  }
  .cv-repere,
  .cv-rejouer {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--texte-sombre-2);
    transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }
  .cv-repere {
    width: 100%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }
  .cv-repere:hover {
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
  }
  .cv-repere[aria-pressed='true'] {
    background: var(--texte-sombre);
    color: var(--encre);
    box-shadow: none;
  }
  .cv-rejouer {
    padding: 0 14px 0 12px;
  }
  .cv-rejouer:hover {
    color: #fff;
    background: var(--verre);
  }

  /* ----- le plateau : sur téléphone, le dessin d'abord, collé sous l'en-tête ----- */
  .cv-plateau {
    display: grid;
    gap: 28px;
  }
  .cv-machine {
    order: -1;
    position: sticky;
    top: var(--entete);
    z-index: 2;
    margin-inline: calc(var(--gouttiere) * -1);
    padding: 12px var(--gouttiere) 14px;
    background: var(--encre);
    border-bottom: 1px solid var(--filet-sombre);
  }
  .cv-temps {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .cv-temps-titre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.625rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .cv-temps-texte {
    color: var(--texte-sombre-2);
    text-wrap: pretty;
  }
  .cv-liste {
    display: grid;
    gap: 8px;
    margin-top: 4px;
  }
  .cv-liste li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--texte-sombre);
    font-weight: 500;
  }
  .cv-liste :global(svg) {
    flex: none;
    color: var(--marque-clair);
  }

  /* ----- la carte ----- */
  .cv-champ {
    position: relative;
    perspective: 1300px;
  }
  .cv-champ::before {
    content: '';
    position: absolute;
    inset: -22% -30%;
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(29 113 184 / 0.34), rgb(29 113 184 / 0.1) 55%, transparent);
  }
  .cv-ombre {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -20px;
    height: 36px;
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(2 9 16 / 0.85), rgb(2 9 16 / 0.35) 55%, transparent);
  }
  .cv-pose {
    position: relative;
    transform-style: preserve-3d;
  }
  .cv-carte {
    position: relative;
    border-radius: var(--rayon-panneau);
    transform-style: preserve-3d;
    transform: rotateX(2deg) rotateY(3deg);
  }
  .cv-dos {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #0a1c2e;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    transform: translateZ(-22px);
  }
  .cv-face {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    background:
      radial-gradient(120% 70% at 0% 0%, rgb(255 255 255 / 0.13), transparent 58%),
      linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02) 60%),
      #0f2740;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.17);
  }
  .cv-reflet {
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: 0;
    width: 52%;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.2) 42%, rgb(255 255 255 / 0.06) 62%, transparent);
    opacity: 0;
    transform: translate3d(-160%, 0, 0) skewX(-18deg);
  }
  .cv-contenu {
    position: relative;
    padding: 14px 16px;
    transform-style: preserve-3d;
  }
  .cv-nom {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 10px;
    transform: translateZ(14px);
  }
  .cv-entrees,
  .cv-retours {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    transform-style: preserve-3d;
  }
  .cv-retours {
    margin-top: 12px;
    padding-top: 12px;
  }
  .cv-retours::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--filet-sombre);
  }
  /* Chaque puce a sa place dans la carte : un contour en pointillés, visible tant que la
     puce n'est pas arrivée. Au repos il est éteint (--place vaut 0). */
  .cv-entrees li,
  .cv-retours li {
    position: relative;
    min-width: 0;
    transform-style: preserve-3d;
  }
  .cv-entrees li {
    border-radius: var(--rayon-interieur);
  }
  .cv-retours li {
    border-radius: 999px;
  }
  .cv-entrees li::before,
  .cv-retours li::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px dashed rgb(255 255 255 / 0.26);
    opacity: var(--place, 0);
  }
  .cv-puce {
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    line-height: 1.1;
    transform: translateZ(14px);
  }
  .cv-entrees .cv-puce {
    width: 40px;
    height: 40px;
    border-radius: var(--rayon-interieur);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.11);
    font-weight: 500;
    color: var(--texte-sombre);
  }
  .cv-entrees :global(svg) {
    flex: none;
    color: var(--marque-clair);
  }
  /* Sur l'encre, un résultat s'écrit en blanc. */
  .cv-retours .cv-puce {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--texte-sombre);
    color: var(--encre);
    font-weight: 600;
  }
  .cv-retours :global(svg) {
    flex: none;
    color: var(--color-marque);
  }
  /* Sur téléphone les libellés sont dans les listes sous chaque temps : dans le dessin,
     ils restent pour les lecteurs d'écran seulement. */
  .cv-libelle {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ----- les sorties ----- */
  .cv-faisceau {
    display: none;
  }
  .cv-tiges,
  .cv-reseaux {
    display: grid;
    grid-template-columns: repeat(var(--n), 40px);
    justify-content: center;
    gap: 8px;
  }
  .cv-tiges {
    height: 18px;
    margin-top: 6px;
  }
  .cv-tige {
    justify-self: center;
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: rgb(125 184 238 / 0.55);
    transform-origin: 50% 0;
  }
  .cv-reseaux li {
    display: grid;
    place-items: center;
    height: 40px;
    border-radius: 999px;
    background: var(--verre);
    box-shadow: inset 0 0 0 1px var(--verre-bord);
    font-weight: 600;
    line-height: 1;
    color: var(--texte-sombre);
    white-space: nowrap;
  }
  .cv-reseaux :global(svg) {
    color: var(--marque-clair);
  }
  .cv-gardes {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 10px;
  }
  .cv-gardes li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 24px;
    color: var(--texte-sombre-2);
    font-weight: 500;
    line-height: 1.2;
  }
  .cv-garde-trait {
    flex: none;
    width: 26px;
    height: 2px;
    border-radius: 1px;
    background: rgb(125 184 238 / 0.55);
    margin-right: -12px;
    transform-origin: 0 50%;
  }
  .cv :global(.cv-garde-signe) {
    color: var(--texte-sombre);
  }

  .cv-conclusion {
    margin-top: 48px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.625rem, 1.1rem + 2.3vw, 2.875rem);
    line-height: 1.14;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .cv-conclusion-1 {
    color: var(--texte-sombre-2);
  }
  .cv-conclusion-2 {
    color: #fff;
  }

  /* ----- sur ordinateur : phrase, machine, phrase ----- */
  @media (min-width: 1024px) {
    .cv-reperes {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 56px;
    }
    .cv-repere {
      width: auto;
    }
    .cv-rejouer {
      margin-left: auto;
    }
    .cv-liste {
      display: none;
    }
    .cv-libelle {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
    /* Trois colonnes. La machine garde sa largeur (son faisceau est dessiné au pixel),
       ce sont les deux colonnes de texte qui cèdent la place. */
    .cv-plateau {
      grid-template-columns: minmax(0, 270px) auto minmax(0, 250px);
      justify-content: space-between;
      grid-template-rows: auto auto;
      column-gap: 28px;
      row-gap: 40px;
      align-items: start;
    }
    .cv-temps-1 {
      grid-column: 1;
      grid-row: 1;
    }
    .cv-temps-3 {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
    }
    .cv-temps-2 {
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: center;
    }
    .cv-machine {
      order: 0;
      position: static;
      margin: 0;
      padding: 0;
      background: none;
      border: 0;
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      display: grid;
      grid-template-columns: 250px 120px 142px;
      align-items: center;
    }
    .cv-champ {
      z-index: 2;
    }
    .cv-ombre {
      bottom: -34px;
      height: 56px;
    }
    .cv-carte {
      transform: rotateX(2.5deg) rotateY(5deg);
    }
    .cv-contenu {
      padding: 22px;
    }
    .cv-nom {
      font-size: 1.25rem;
      margin-bottom: 16px;
    }
    .cv-entrees {
      display: grid;
      grid-template-columns: 1fr;
    }
    .cv-entrees .cv-puce {
      justify-content: flex-start;
      gap: 8px;
      width: auto;
      height: 40px;
      padding: 0 12px;
      font-size: 0.9375rem;
    }
    .cv-retours {
      gap: 8px;
      margin-top: 18px;
      padding-top: 18px;
    }
    .cv-retours .cv-puce {
      justify-content: flex-start;
      gap: 8px;
      width: auto;
      height: 36px;
      padding: 0 14px 0 12px;
      font-size: 0.9375rem;
    }
    .cv-tiges {
      display: none;
    }
    /* Le faisceau part de sous la carte : 28 px de recouvrement cachent le départ. */
    .cv-faisceau {
      display: block;
      position: relative;
      z-index: 1;
      margin-left: -28px;
      overflow: visible;
    }
    .cv-faisceau path {
      fill: none;
      stroke: rgb(125 184 238 / 0.6);
      stroke-width: 1.5;
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
    .cv-faisceau .cv-impasse {
      stroke: rgb(125 184 238 / 0.38);
    }
    .cv-sorties {
      position: relative;
      z-index: 1;
    }
    .cv-reseaux {
      grid-template-columns: 1fr;
    }
    .cv-reseaux li {
      display: flex;
      justify-content: flex-start;
      gap: 8px;
      height: 44px;
      padding: 0 16px 0 14px;
      font-size: 0.9375rem;
    }
    .cv-gardes {
      display: grid;
      justify-content: stretch;
      gap: 8px;
      margin-top: 24px;
    }
    .cv-gardes li {
      height: 44px;
      gap: 10px;
      font-size: 0.9375rem;
      white-space: nowrap;
    }
    .cv-garde-trait {
      display: none;
    }
    .cv :global(.cv-garde-signe) {
      margin-left: -14px;
    }
    .cv-conclusion {
      margin-top: 88px;
      text-align: center;
    }
  }
  @media (min-width: 1200px) {
    .cv-plateau {
      column-gap: 32px;
    }
    .cv-machine {
      grid-template-columns: 300px 120px 160px;
    }
  }
  @media (min-width: 1360px) {
    .cv-machine {
      grid-template-columns: 320px 120px 172px;
    }
  }

  /* Pendant la lecture seulement, les éléments animés ont leur calque. */
  [data-scene='lecture'] .cv-pose,
  [data-scene='lecture'] .cv-carte,
  [data-scene='lecture'] .cv-puce,
  [data-scene='lecture'] .cv-reseaux li {
    will-change: transform;
  }
</style>

<script>
  import { scene, courbes as C, seg, mix, clamp, ressort, depasse, type Scene } from '@/lib/motion';

  const TENUE = 14;
  const P = {
    entree: 0.1,
    t1: { titre: 1.1, texte: 1.4, elements: 1.8, pas: 0.24 },
    pivot1: [5.1, 5.9],
    t2: { titre: 5.7, texte: 6.0, traits: 6.4, pas: 0.2 },
    pivot2: [9.6, 10.4],
    t3: { titre: 10.0, texte: 10.3, retours: 10.6, pasR: 0.28, gardes: 11.8, pasG: 0.25 },
    fin: [12.95, 13.08],
    reflets: [
      [0.8, 2.0, 1],
      [5.2, 6.3, -1],
      [9.7, 10.8, 1],
    ],
  };
  const inOutSine = (p: number) => -(Math.cos(Math.PI * p) - 1) / 2;
  const px = (v: number) => v.toFixed(2) + 'px';

  type N = HTMLElement | SVGElement;

  function vider(noeuds: (N | null)[]) {
    for (const n of noeuds) {
      if (!n) continue;
      n.style.transform = '';
      n.style.opacity = '';
      n.style.strokeDashoffset = '';
      n.style.removeProperty('--place');
    }
  }
  function poserLigne(n: N | null, t: number, debut: number) {
    if (!n) return;
    const e = C.entree(seg(t, debut, debut + 0.9));
    n.style.transform = `translate3d(0,${((1 - e) * 125).toFixed(2)}%,0)`;
  }
  function poserBloc(n: N | null, t: number, debut: number) {
    if (!n) return;
    const e = C.entree(seg(t, debut, debut + 0.55));
    n.style.transform = `translate3d(0,${px((1 - e) * 22)},0)`;
    n.style.opacity = seg(t, debut, debut + 0.14).toFixed(3);
  }

  function monter(el: HTMLElement): Scene | undefined {
    if (el.dataset.monte) return;
    el.dataset.monte = '1';
    const large = window.matchMedia('(min-width: 1024px)');
    const un = <T extends Element = HTMLElement>(s: string) => el.querySelector<T & N>(s);
    const tous = <T extends Element = HTMLElement>(s: string) => Array.from(el.querySelectorAll<T & N>(s));

    const champ = un('.cv-champ');
    const pose = un('.cv-pose');
    const carte = un('.cv-carte');
    const ombre = un('.cv-ombre');
    const reflet = un('.cv-reflet');
    if (!champ || !pose || !carte || !ombre || !reflet) return;
    const elements = tous('.cv-entrees .cv-puce');
    const retours = tous('.cv-retours .cv-puce');
    const places = tous('.cv-entrees > li, .cv-retours > li');
    const traits = tous<SVGElement>('.cv-trait');
    const impasses = tous<SVGElement>('.cv-impasse');
    const tiges = tous('.cv-tige');
    const reseaux = tous('.cv-reseaux > li');
    const bouts = tous('.cv-garde-trait');
    const signes = tous<SVGElement>('.cv-garde-signe');
    const noms = tous('.cv-garde-nom');
    const titres = [1, 2, 3].map((k) => un(`.cv-temps-${k} .ligne > span`));
    const textes = [1, 2, 3].map((k) => tous(`.cv-temps-${k} .cv-temps-texte, .cv-temps-${k} .cv-liste`));
    const fin = [un('.cv-conclusion-1'), un('.cv-conclusion-2')];
    const touches: (N | null)[] = [champ, pose, carte, ombre, reflet, ...elements, ...retours, ...traits, ...impasses,
      ...tiges, ...reseaux, ...bouts, ...signes, ...noms, ...places, ...titres, ...textes.flat(), ...fin];

    function rendu(t: number) {
      // L'état final est celui de la feuille de style.
      if (t >= TENUE - 0.001) {
        vider(touches);
        return;
      }
      const L = large.matches;

      // La carte : deux ressorts, la position se pose, le pivot continue.
      const u = t - P.entree;
      const ep = ressort(u, 0.85, 3.8);
      const er = ressort(u, 0.6, 3.4);
      const p1 = C.inOutCubic(seg(t, P.pivot1[0], P.pivot1[1]));
      const p2 = C.inOutCubic(seg(t, P.pivot2[0], P.pivot2[1]));
      const D0 = L ? [150, 190] : [40, 90];
      const R0 = L ? [20, -54, 7] : [16, -40, 5];
      const RA = L ? [3, -9] : [2, -6]; // ouverte vers ce qui arrive, par la gauche
      const RB = L ? [2, 10] : [-5, 4]; // tournée vers les sorties : à droite, ou dessous sur téléphone
      const RC = L ? [2.5, 5] : [2, 3]; // le repos : les valeurs de la feuille de style
      let rx = mix(R0[0], RA[0], er);
      let ry = mix(R0[1], RA[1], er);
      const rz = mix(R0[2], 0, er);
      rx = mix(rx, RB[0], p1);
      ry = mix(ry, RB[1], p1);
      rx = mix(rx, RC[0], p2);
      ry = mix(ry, RC[1], p2);
      // Un pivot s'accompagne d'un léger recul : la carte ne tourne pas sur place.
      const recul = -40 * (C.bosse(p1) + C.bosse(p2));
      champ.style.opacity = seg(t, P.entree, P.entree + 0.22).toFixed(3);
      pose.style.transform = `translate3d(${px(D0[0] * (1 - ep))},${px(D0[1] * (1 - ep))},${px(recul)})`;
      carte.style.transform = `rotateX(${rx.toFixed(3)}deg) rotateY(${ry.toFixed(3)}deg) rotateZ(${rz.toFixed(3)}deg)`;
      const eo = clamp(ep, 0, 1);
      ombre.style.opacity = eo.toFixed(3);
      ombre.style.transform = `translate3d(${px(D0[0] * 0.5 * (1 - ep))},0,0) scale(${mix(0.62, 1, eo).toFixed(4)},1)`;

      // Le reflet traverse le verre, une fois par temps.
      let rf = 0;
      let rxp = -160;
      for (const r of P.reflets) {
        const s = seg(t, r[0], r[1]);
        if (s > 0 && s < 1) {
          rf = C.bosse(s);
          rxp = r[2] > 0 ? mix(-160, 230, inOutSine(s)) : mix(230, -160, inOutSine(s));
        }
      }
      reflet.style.opacity = rf.toFixed(3);
      reflet.style.transform = `translate3d(${rxp.toFixed(2)}%,0,0) skewX(-18deg)`;

      // Temps 1 : la phrase, puis les entrées se rangent dans la carte.
      poserLigne(titres[0], t, P.t1.titre);
      textes[0].forEach((n) => poserBloc(n, t, P.t1.texte));
      const course = L ? 300 : 140;
      elements.forEach((n, i) => {
        const a = P.t1.elements + P.t1.pas * i;
        const p = C.entree(seg(t, a, a + 0.55));
        n.style.transform = `translate3d(${px(-(1 - p) * course)},0,14px)`;
        n.style.opacity = seg(t, a, a + 0.1).toFixed(3);
        // Sa place l'attend dans la carte, et s'efface quand il s'y range.
        places[i]?.style.setProperty('--place', (1 - seg(t, a + 0.12, a + 0.4)).toFixed(3));
      });

      // Temps 2 : la phrase, le faisceau se trace, les sorties se posent.
      poserLigne(titres[1], t, P.t2.titre);
      textes[1].forEach((n) => poserBloc(n, t, P.t2.texte));
      reseaux.forEach((n, i) => {
        const a = P.t2.traits + P.t2.pas * i;
        const trace = C.inOutCubic(seg(t, a, a + 0.45));
        const trait = traits[i];
        if (trait) {
          trait.style.strokeDashoffset = (1 - trace).toFixed(4);
          trait.style.opacity = trace > 0 ? '1' : '0';
        }
        if (tiges[i]) tiges[i].style.transform = `scale(1,${trace.toFixed(4)})`;
        const q = depasse(1.4)(seg(t, a + 0.28, a + 0.68));
        n.style.transform = `scale(${mix(0.82, 1, q).toFixed(4)})`;
        n.style.opacity = seg(t, a + 0.28, a + 0.4).toFixed(3);
      });

      // Temps 3 : les retours reviennent, les garde-fous ferment un passage.
      poserLigne(titres[2], t, P.t3.titre);
      textes[2].forEach((n) => poserBloc(n, t, P.t3.texte));
      retours.forEach((n, j) => {
        const a = P.t3.retours + P.t3.pasR * j;
        const p = C.entree(seg(t, a, a + 0.55));
        // Ils reviennent d'où sont les sorties : de la droite sur ordinateur, du bas sur téléphone.
        n.style.transform = L ? `translate3d(${px((1 - p) * 380)},0,14px)` : `translate3d(0,${px((1 - p) * 120)},14px)`;
        n.style.opacity = seg(t, a, a + 0.1).toFixed(3);
        places[elements.length + j]?.style.setProperty('--place', (1 - seg(t, a + 0.12, a + 0.4)).toFixed(3));
      });
      signes.forEach((n, k) => {
        const a = P.t3.gardes + P.t3.pasG * k;
        const trace = C.inOutCubic(seg(t, a, a + 0.3));
        const impasse = impasses[k];
        if (impasse) {
          impasse.style.strokeDashoffset = (1 - trace).toFixed(4);
          impasse.style.opacity = trace > 0 ? '1' : '0';
        }
        if (bouts[k]) bouts[k].style.transform = `scale(${trace.toFixed(4)},1)`;
        const ferme = depasse(1.6)(seg(t, a + 0.2, a + 0.5));
        n.style.transform = `scale(${Math.max(0, ferme).toFixed(4)})`;
        n.style.opacity = seg(t, a + 0.2, a + 0.3).toFixed(3);
        const e = C.entree(seg(t, a + 0.3, a + 0.85));
        if (noms[k]) {
          noms[k].style.transform = `translate3d(${px(-(1 - e) * 12)},0,0)`;
          noms[k].style.opacity = seg(t, a + 0.3, a + 0.44).toFixed(3);
        }
      });

      // La pose finale : la phrase de conclusion.
      poserLigne(fin[0], t, P.fin[0]);
      poserLigne(fin[1], t, P.fin[1]);
    }

    // Le seuil se règle sur la hauteur du bloc : on demande une part d'écran, pas une
    // part de bloc (sur téléphone la scène fait plusieurs écrans).
    const h = el.getBoundingClientRect().height || 1;
    const seuil = clamp((window.innerHeight * (large.matches ? 0.45 : 0.3)) / h, 0.08, 0.6);
    const s = scene(el, { tenue: TENUE, rendu, seuil });
    // Au passage d'une mise en page à l'autre, la pose se recalcule.
    large.addEventListener('change', () => {
      if (!s.enLecture) s.reposer();
    });
    return s;
  }

  function monterTout() {
    document.querySelectorAll<HTMLElement>('[data-carte-verre]').forEach((el) => monter(el));
  }
  monterTout();
  document.addEventListener('astro:page-load', monterTout);
</script>
