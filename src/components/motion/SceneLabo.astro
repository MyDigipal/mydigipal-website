---
/**
 * Une scène du labo motion (`public/motion/<nom>.html`, contrat `render(t)` + `lecteur.js`),
 * dans un cadre qui garde ses proportions, à poser sur n'importe quelle page (13/10/2026).
 *
 * Chargée à l'approche, jouée en boucle tant qu'elle est à l'écran, posée sur son image de
 * repos sinon. La version anglaise est servie depuis `/motion/en/` sur les pages anglaises.
 * Scènes carrées tirées de l'audit Exaforce et adaptées à l'automobile :
 * `recherche-concession` (Google Ads) et `audience-meta` (Facebook et Instagram).
 */
import type { Language } from '@/i18n/config';

interface Props {
  lang: Language;
  /** Nom du fichier dans `public/motion/`, sans `.html`. */
  nom: string;
  /** Titre accessible du cadre. */
  titre: string;
  /** `carre` (1080 x 1080), `large` (16:9) ou `portrait` (1080 x 1350, scène lue avec `?p=1`). */
  format?: 'carre' | 'large' | 'portrait';
  /** Instant posé quand la scène n'est pas à l'écran (secondes). */
  repos?: number;
  /** Barre de progression, pause au clic, aller à un instant (règle de Paul du 13/10/2026). */
  controles?: boolean;
  /** Au téléphone, la version verticale de la même scène (`?p=1`, 1080 x 1350) : le carré y serait illisible. */
  portraitMobile?: boolean;
  class?: string;
}

const { lang, nom, titre, format = 'carre', repos = 13, controles = false, portraitMobile = false, class: classe = '' } = Astro.props;
const url = `/motion/${lang === 'fr' ? '' : 'en/'}${nom}.html`;
const variantes = portraitMobile
  ? [{ src: url, format, classeVariante: 'scene-labo-ordi' }, { src: `${url}?p=1`, format: 'portrait', classeVariante: 'scene-labo-tel' }]
  : [{ src: url, format, classeVariante: '' }];
---

{variantes.map((v) => (
<figure class:list={['scene-labo', `scene-labo-${v.format}`, v.classeVariante, classe, { 'scene-labo-controles': controles }]} data-scene-labo>
  <iframe src={v.src} title={titre} loading="lazy" data-repos={repos} tabindex="-1"></iframe>
  {controles && (
    <>
      <button type="button" class="sl-calque" data-sl-calque aria-label={lang === 'fr' ? 'Mettre en pause ou reprendre' : 'Pause or resume'}></button>
      <div class="sl-barre" data-sl-barre><input type="range" min="0" max="1000" value="0" aria-label={lang === 'fr' ? 'Aller à un instant' : 'Seek'} /></div>
    </>
  )}
</figure>
))}

<style>
  .scene-labo {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    border-radius: var(--rayon-scene, 24px);
    background: #08131f;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08), 0 40px 90px -40px rgb(11 27 43 / 0.55);
  }
  .scene-labo-carre { aspect-ratio: 1 / 1; }
  .scene-labo-large { aspect-ratio: 16 / 9; }
  .scene-labo-portrait { aspect-ratio: 1080 / 1350; }
  .scene-labo-tel { display: none; }
  @media (max-width: 767px) { .scene-labo-ordi { display: none; } .scene-labo-tel { display: block; } }
  .sl-calque { position: absolute; inset: 0; border: 0; background: transparent; cursor: pointer; z-index: 1; }
  .sl-barre { position: absolute; left: 16px; right: 16px; bottom: 12px; z-index: 2; opacity: 0; transition: opacity .25s; }
  .scene-labo-controles:hover .sl-barre, .scene-labo-controles[data-pause] .sl-barre, .sl-barre:focus-within { opacity: 1; }
  .sl-barre input { width: 100%; height: 18px; accent-color: #e8bd62; cursor: pointer; }
  .scene-labo iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  /* Même mécanique que les scènes des études de cas : jouer à l'écran, se poser sinon. */
  function envoyer(f: HTMLIFrameElement, m: object) { f.contentWindow?.postMessage(m, '*'); }
  function brancherScenes() {
    const cadres = Array.from(document.querySelectorAll<HTMLIFrameElement>('[data-scene-labo] iframe'));
    const repos = (f: HTMLIFrameElement) => { envoyer(f, { cmd: 'pause' }); envoyer(f, { cmd: 'seek', t: Number(f.dataset.repos || 0) }); };
    if (!('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => {
        const f = e.target as HTMLIFrameElement;
        f.dataset.visible = e.isIntersecting ? '1' : '';
        if (e.isIntersecting) { envoyer(f, { cmd: 'seek', t: 0 }); envoyer(f, { cmd: 'play' }); } else repos(f);
      }),
      { threshold: 0.35 },
    );
    cadres.forEach((f) => {
      if (f.dataset.branche) return;
      f.dataset.branche = '1';
      f.addEventListener('load', () => { if (!f.dataset.visible) repos(f); });
      io.observe(f);
    });
  }
  /* Les contrôles : la scène dit où elle en est ({ essai, t, duree, joue }), la barre suit. */
  function brancherControles() {
    document.querySelectorAll<HTMLElement>('.scene-labo-controles').forEach((fig) => {
      if (fig.dataset.controles) return;
      fig.dataset.controles = '1';
      const f = fig.querySelector('iframe')!;
      const curseur = fig.querySelector<HTMLInputElement>('[data-sl-barre] input')!;
      let duree = 1;
      let pause = false;
      window.addEventListener('message', (e) => {
        if (e.source !== f.contentWindow || !e.data?.essai) return;
        duree = e.data.duree || 1;
        if (document.activeElement !== curseur) curseur.value = String(Math.round((e.data.t / duree) * 1000));
      });
      fig.querySelector('[data-sl-calque]')!.addEventListener('click', () => {
        pause = !pause;
        if (pause) { fig.dataset.pause = '1'; envoyer(f, { cmd: 'pause' }); } else { delete fig.dataset.pause; envoyer(f, { cmd: 'play' }); }
      });
      curseur.addEventListener('input', () => { pause = true; fig.dataset.pause = '1'; envoyer(f, { cmd: 'pause' }); envoyer(f, { cmd: 'seek', t: (Number(curseur.value) / 1000) * duree }); });
    });
  }
  brancherScenes();
  brancherControles();
  document.addEventListener('astro:page-load', () => { brancherScenes(); brancherControles(); });
</script>
