---
/**
 * La formation sur mesure, en trois temps (demande de Paul du 14/10/2026, hero de la page
 * AI Training) : on écoute l'équipe (ses outils, son métier, sa priorité), on construit son
 * programme et le logo de sa marque s'y pose, puis la formation se donne en salle, à
 * distance ou en ligne avec l'Academy.
 *
 * Règles du mouvement : l'état par défaut du HTML est l'image finale (sans script, sous
 * mouvement réduit ou `?fige=1`, on la voit posée) ; la scène est une fonction du temps,
 * `rendu(t)`, jouée une fois puis tenue ; courbe A ; chaque texte reste au moins 2,5 s ;
 * les éléments d'un temps DEVIENNENT ceux du suivant (les demandes deviennent les lignes du
 * programme), rien ne s'efface sur place ; barre de progression, pause au clic, rejouer.
 * Les tailles sont en `cqw` : la scène garde ses proportions à toutes les largeurs.
 */
import type { Language } from '@/i18n/config';

interface Props {
  lang: Language;
  /** Le logo qui se pose sur le programme : un vrai client de formation. */
  logo: { src: string; nom: string };
}
const { lang, logo } = Astro.props;

const T = {
  fr: {
    etapes: ['On vous écoute', 'On construit', 'On forme'],
    equipe: 'Votre équipe',
    visio: 'call de diagnostic',
    demandes: ['Nos outils : Copilot, Excel et Teams', 'Notre équipe : la finance', 'Notre priorité : le reporting du mois'],
    programme: 'Programme IA',
    pour: 'Équipe finance',
    lignes: ['Copilot, Excel et Teams, sur vos fichiers', 'Les cas de la finance', 'Le reporting du mois, pas à pas', 'CRAFT et la sécurité des données'],
    modes: ['En salle', 'À distance', 'En ligne'],
    academy: 'Academy',
    pause: 'Mettre en pause ou reprendre',
    rejouer: 'Rejouer',
    titre: 'Comment nous construisons votre formation',
  },
  en: {
    etapes: ['We listen', 'We build', 'We train'],
    equipe: 'Your team',
    visio: 'diagnostic call',
    demandes: ['Our tools: Copilot, Excel and Teams', 'Our team: finance', 'Our priority: month-end reporting'],
    programme: 'AI programme',
    pour: 'Finance team',
    lignes: ['Copilot, Excel and Teams, on your files', 'Finance use cases', 'Month-end reporting, step by step', 'CRAFT and data security'],
    modes: ['On-site', 'Remote', 'Online'],
    academy: 'Academy',
    pause: 'Pause or resume',
    rejouer: 'Replay',
    titre: 'How we build your training',
  },
}[lang];
---

<figure class="sfm" data-scene-formation aria-label={T.titre}>
  <div class="sfm-boite">
    <ol class="sfm-etapes">
      {T.etapes.map((e, i) => <li data-etape={i}><span>{i + 1}</span>{e}</li>)}
    </ol>

    <!-- Temps 1 : l'appel et les demandes de l'équipe. -->
    <div class="sfm-appel" data-el="appel">
      <div class="sfm-visage" aria-hidden="true"><i></i><i></i><i></i></div>
      <strong>{T.equipe}</strong>
      <span>{T.visio}</span>
    </div>
    <div class="sfm-bulles">
      {T.demandes.map((d, i) => <p class="sfm-bulle" data-el={`bulle${i}`}>{d}</p>)}
    </div>

    <!-- Temps 2 : le programme, à la marque du client. -->
    <div class="sfm-programme" data-el="programme">
      <div class="sfm-prog-tete">
        <span class="sfm-logo" data-el="logo"><img src={logo.src} alt={logo.nom} /></span>
        <span class="sfm-prog-titre"><strong>{T.programme}</strong><small>{T.pour}</small></span>
      </div>
      <ul>
        {T.lignes.map((l, i) => (
          <li data-el={`ligne${i}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            {l}
          </li>
        ))}
      </ul>
    </div>

    <!-- Temps 3 : trois façons de la suivre. -->
    <svg class="sfm-fils" data-el="fils" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M50 0 V40 M50 40 H17 V100 M50 40 V100 M50 40 H83 V100" pathLength="1" />
    </svg>
    <div class="sfm-mode sfm-salle" data-el="mode0">
      <div class="sfm-mode-vue" aria-hidden="true">
        <span class="sfm-table"></span>
        {Array.from({ length: 8 }, (_, k) => <i data-el={`chaise${k}`} style={`--a:${k * 45}deg`}></i>)}
      </div>
      <span class="sfm-mode-nom">{T.modes[0]}</span>
    </div>
    <div class="sfm-mode sfm-distance" data-el="mode1">
      <div class="sfm-mode-vue" aria-hidden="true">
        {Array.from({ length: 6 }, (_, k) => <i data-el={`tuile${k}`}><b></b></i>)}
      </div>
      <span class="sfm-mode-nom">{T.modes[1]}</span>
    </div>
    <div class="sfm-mode sfm-ligne" data-el="mode2">
      <div class="sfm-mode-vue" aria-hidden="true">
        <span class="sfm-ecran"><em>{T.academy}</em><span class="sfm-barre"><span data-el="progres"></span></span></span>
        <span class="sfm-pied"></span>
      </div>
      <span class="sfm-mode-nom">{T.modes[2]}</span>
    </div>
  </div>

  <div class="sfm-lecteur" data-lecteur hidden>
    <button type="button" class="sfm-rejouer" data-rejouer>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4.5h4.5" /></svg>
      {T.rejouer}
    </button>
    <input type="range" min="0" max="1000" value="1000" data-curseur aria-label={T.pause} />
  </div>
</figure>

<style>
  .sfm { margin: 0; display: grid; gap: 10px; }
  .sfm-boite { position: relative; container-type: inline-size; aspect-ratio: 100 / 94; border-radius: 28px; overflow: hidden; cursor: pointer;
    background: radial-gradient(120% 80% at 100% 0%, rgb(29 113 184 / 0.35), transparent 60%), var(--encre); box-shadow: var(--ombre-forte); }
  .sfm-boite * { box-sizing: border-box; }

  .sfm-etapes { position: absolute; left: 5cqw; right: 5cqw; top: 5cqw; margin: 0; padding: 0; list-style: none; display: flex; gap: 1.6cqw; }
  .sfm-etapes li { flex: 1; display: flex; align-items: center; gap: 1.4cqw; padding: 1.6cqw 2cqw; border-radius: 999px; font-size: 2.9cqw; font-weight: 600; color: var(--texte-sombre-2); background: rgb(255 255 255 / 0.06); white-space: nowrap; transition: background-color .4s, color .4s; }
  .sfm-etapes span { display: grid; place-items: center; width: 4.4cqw; height: 4.4cqw; border-radius: 999px; background: rgb(255 255 255 / 0.12); font-size: 2.6cqw; flex: none; }
  .sfm-etapes li.actif { background: #fff; color: var(--encre); }
  .sfm-etapes li.actif span { background: var(--color-marque); color: #fff; }

  /* Temps 1. */
  .sfm-appel { position: absolute; left: 5cqw; top: 30cqw; width: 33cqw; height: 34cqw; border-radius: 4cqw; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.12); display: grid; justify-items: center; align-content: center; gap: 1.2cqw; color: #fff; text-align: center; }
  .sfm-visage { display: flex; }
  .sfm-visage i { width: 7cqw; height: 7cqw; border-radius: 999px; background: var(--marque-clair); border: 0.6cqw solid var(--encre); margin-left: -1.6cqw; }
  .sfm-visage i:nth-child(2) { background: #3B8FD9; }
  .sfm-visage i:nth-child(3) { background: #E9C46A; }
  .sfm-appel strong { font-size: 3.4cqw; }
  .sfm-appel span { font-size: 2.7cqw; color: var(--texte-sombre-2); }
  .sfm-bulles { position: absolute; z-index: 2; left: 42cqw; width: 53cqw; top: 30cqw; display: grid; gap: 2.4cqw; }
  .sfm-bulle { margin: 0; padding: 2.2cqw 2.8cqw; border-radius: 3cqw 3cqw 3cqw 0.8cqw; background: #fff; color: var(--encre); font-size: 3.1cqw; font-weight: 600; line-height: 1.25; box-shadow: 0 1.6cqw 3cqw -1.4cqw rgb(0 0 0 / 0.5); }

  /* Temps 2. */
  .sfm-programme { position: absolute; left: 17cqw; top: 19cqw; width: 66cqw; border-radius: 4cqw; background: #fff; color: var(--encre); padding: 3.6cqw; transform-origin: 50% 0; box-shadow: 0 2cqw 5cqw -2cqw rgb(0 0 0 / 0.6); }
  .sfm-prog-tete { display: flex; align-items: center; gap: 3cqw; padding-bottom: 2.6cqw; margin-bottom: 2cqw; border-bottom: 1px solid var(--filet); }
  .sfm-logo { flex: none; width: 17cqw; height: 9cqw; border-radius: 2cqw; display: grid; place-items: center; background: var(--brume); padding: 1.4cqw; }
  .sfm-logo img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
  .sfm-prog-titre { display: grid; }
  .sfm-prog-titre strong { font-family: var(--font-display); font-weight: 800; font-size: 4.2cqw; letter-spacing: -0.02em; }
  .sfm-prog-titre small { font-size: 2.8cqw; color: #4B5B6B; }
  .sfm-programme ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4cqw; }
  .sfm-programme li { display: flex; align-items: center; gap: 1.8cqw; font-size: 3cqw; font-weight: 600; padding: 1.5cqw 2cqw; border-radius: 2cqw; background: var(--brume); }
  .sfm-programme li svg { width: 3.4cqw; height: 3.4cqw; color: var(--color-marque); flex: none; }

  /* Temps 3 (et image finale). */
  .sfm-fils { position: absolute; left: 0; width: 100cqw; top: 55.5cqw; height: 10.5cqw; overflow: visible; }
  .sfm-fils path { fill: none; stroke: rgb(125 184 238 / 0.55); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .sfm-mode { position: absolute; top: 66cqw; width: 28cqw; display: grid; justify-items: center; gap: 1.6cqw; }
  .sfm-salle { left: 3cqw; } .sfm-distance { left: 36cqw; } .sfm-ligne { left: 69cqw; }
  .sfm-mode-vue { position: relative; width: 26cqw; height: 18cqw; border-radius: 3cqw; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.14); }
  .sfm-mode-nom { font-size: 3.1cqw; font-weight: 600; color: #fff; }
  .sfm-table { position: absolute; left: 50%; top: 50%; width: 8cqw; height: 8cqw; margin: -4cqw 0 0 -4cqw; border-radius: 999px; background: rgb(125 184 238 / 0.18); border: 1px solid rgb(125 184 238 / 0.5); }
  .sfm-salle i { position: absolute; left: 50%; top: 50%; width: 2.6cqw; height: 2.6cqw; margin: -1.3cqw 0 0 -1.3cqw; border-radius: 999px; background: var(--marque-clair); transform: rotate(var(--a)) translateY(-6.4cqw); }
  .sfm-distance .sfm-mode-vue { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1cqw; padding: 1.6cqw; }
  .sfm-distance i { border-radius: 1.2cqw; background: rgb(255 255 255 / 0.1); display: grid; place-items: center; }
  .sfm-distance b { width: 2.6cqw; height: 2.6cqw; border-radius: 999px; background: var(--marque-clair); }
  .sfm-ecran { position: absolute; left: 3cqw; right: 3cqw; top: 2.4cqw; bottom: 4.4cqw; border-radius: 1.4cqw; background: #0d1424; border: 1px solid rgb(233 196 106 / 0.45); display: grid; align-content: center; justify-items: center; gap: 1.4cqw; }
  .sfm-ecran em { font-style: normal; font-size: 2.6cqw; font-weight: 600; color: #E9C46A; }
  .sfm-barre { width: 70%; height: 1.4cqw; border-radius: 999px; background: rgb(255 255 255 / 0.12); overflow: hidden; }
  .sfm-barre span { display: block; height: 100%; width: 72%; background: #E9C46A; border-radius: inherit; transform-origin: left center; }
  .sfm-pied { position: absolute; left: 1.4cqw; right: 1.4cqw; bottom: 1.6cqw; height: 1.4cqw; border-radius: 0 0 1.4cqw 1.4cqw; background: rgb(255 255 255 / 0.25); }

  /* L'image finale, sans script : le programme réduit en haut, les trois modes dessous. */
  [data-el='appel'], .sfm-bulle { opacity: 0; }
  .sfm-programme { transform: scale(0.64); }
  .sfm-etapes li:last-child { background: #fff; color: var(--encre); }
  .sfm-etapes li:last-child span { background: var(--color-marque); color: #fff; }
  .sfm-boite.anime .sfm-etapes li:last-child:not(.actif) { background: rgb(255 255 255 / 0.06); color: var(--texte-sombre-2); }
  .sfm-boite.anime .sfm-etapes li:last-child:not(.actif) span { background: rgb(255 255 255 / 0.12); color: inherit; }

  .sfm-lecteur { display: flex; align-items: center; gap: 12px; }
  .sfm-lecteur[hidden] { display: none; }
  .sfm-lecteur input { flex: 1; accent-color: var(--color-marque); height: 18px; }
  .sfm-rejouer { display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: var(--color-marque); font-weight: 600; font-size: 14px; cursor: pointer; padding: 4px 0; }
  .sfm-rejouer svg { width: 16px; height: 16px; }
</style>

<script>
  // Courbe A (signature MyDigipal) : entrée cubic-bezier(0.15, 1, 0.32, 1).
  function bezier(x1: number, y1: number, x2: number, y2: number) {
    const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
    const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
    const sx = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sy = (t: number) => ((ay * t + by) * t + cy) * t;
    return (x: number) => {
      let t = x;
      for (let i = 0; i < 8; i++) { const d = (3 * ax * t + 2 * bx) * t + cx; const e = sx(t) - x; if (Math.abs(e) < 1e-5 || !d) break; t -= e / d; }
      return sy(Math.min(1, Math.max(0, t)));
    };
  }
  const A = bezier(0.15, 1, 0.32, 1);
  const seg = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  const DUREE = 17.5;

  function initScenes() {
    document.querySelectorAll<HTMLElement>('[data-scene-formation]').forEach((fig) => {
      if (fig.dataset.pret) return;
      fig.dataset.pret = '1';
      const boite = fig.querySelector<HTMLElement>('.sfm-boite')!;
      const el = (n: string) => fig.querySelector<HTMLElement>(`[data-el="${n}"]`)!;
      const etapes = [...fig.querySelectorAll<HTMLElement>('[data-etape]')];
      const fige = window.matchMedia('(prefers-reduced-motion: reduce)').matches || /[?&]fige=1/.test(location.search);
      if (fige) return; // l'image finale du HTML suffit

      let t = 0;
      const style = (n: string, o: number, tr = '') => { const e = el(n); e.style.opacity = String(o); e.style.transform = tr; };
      const fils = el('fils').querySelector('path')!;

      // Le trajet de chaque demande vers sa ligne du programme, mesuré (programme à l'échelle 1).
      let trajets: { dx: number; dy: number }[] = [];
      const mesurer = () => {
        const prog = el('programme');
        const avant = prog.style.transform;
        prog.style.transform = 'none';
        trajets = [0, 1, 2].map((i) => {
          const b = el(`bulle${i}`), l = el(`ligne${i}`);
          const tb = b.style.transform; b.style.transform = 'none';
          const rb = b.getBoundingClientRect(), rl = l.getBoundingClientRect();
          b.style.transform = tb;
          return { dx: rl.left - rb.left, dy: rl.top - rb.top };
        });
        prog.style.transform = avant;
      };
      mesurer();
      new ResizeObserver(() => { mesurer(); rendu(t); }).observe(boite);

      /** L'état de la scène à l'instant t (secondes). Fonction du temps seul. */
      function rendu(t: number) {
        const etape = t < 6 ? 0 : t < 12 ? 1 : 2;
        etapes.forEach((li, i) => li.classList.toggle('actif', i === etape));

        // Temps 1 : l'appel entre, les trois demandes arrivent, tenues jusqu'à 6 s.
        const sortie = A(seg(t, 6, 6.8));
        style('appel', A(seg(t, 0.3, 0.9)) * (1 - sortie), `translateX(${mix(-6, 0, A(seg(t, 0.3, 0.9))) - sortie * 10}cqw)`);

        // Temps 2 : le programme entre ; chaque demande glisse vers sa ligne et la devient.
        const entree = A(seg(t, 6, 6.9));
        const reduit = A(seg(t, 12, 12.9));
        el('programme').style.opacity = String(entree);
        el('programme').style.transform = `translateY(${(1 - entree) * 6}cqw) scale(${mix(1, 0.64, reduit)})`;
        for (let i = 0; i < 3; i++) {
          const arrive = A(seg(t, 1 + i * 1.2, 1.6 + i * 1.2));
          const vers = A(seg(t, 6.6 + i * 0.45, 7.5 + i * 0.45));
          const dx = (trajets[i]?.dx ?? 0) * vers, dy = (trajets[i]?.dy ?? 0) * vers;
          style(`bulle${i}`, arrive * (1 - seg(t, 7.4 + i * 0.45, 7.5 + i * 0.45)), `translate(calc(${dx}px + ${(1 - arrive) * 4}cqw), ${dy}px) scale(${mix(1, 0.86, vers)})`);
          style(`ligne${i}`, A(seg(t, 7.45 + i * 0.45, 7.75 + i * 0.45)));
        }
        style('ligne3', A(seg(t, 8.6, 9.2)), `translateY(${(1 - A(seg(t, 8.6, 9.2))) * 2}cqw)`);
        // Le logo de la marque se pose sur le programme (un objet : il peut dépasser).
        const l = seg(t, 9.6, 10.4);
        const rebond = l < 1 ? 1 - Math.pow(1 - l, 3) * Math.cos(l * Math.PI * 1.6) : 1;
        style('logo', Math.min(1, l * 2.5), `translateY(${(1 - rebond) * -5}cqw) scale(${0.7 + 0.3 * rebond})`);

        // Temps 3 : les fils partent du programme, les trois modes se posent et vivent.
        fils.style.strokeDashoffset = String(1 - A(seg(t, 12.6, 13.6)));
        for (let i = 0; i < 3; i++) {
          const k = A(seg(t, 13.2 + i * 0.4, 13.9 + i * 0.4));
          style(`mode${i}`, k, `translateY(${(1 - k) * 4}cqw)`);
        }
        for (let k = 0; k < 8; k++) { const p = A(seg(t, 14.4 + k * 0.12, 14.8 + k * 0.12)); const c = el(`chaise${k}`); c.style.opacity = String(p); }
        for (let k = 0; k < 6; k++) { const p = A(seg(t, 14.6 + k * 0.15, 15 + k * 0.15)); el(`tuile${k}`).style.opacity = String(0.25 + 0.75 * p); }
        el('progres').style.transform = `scaleX(${A(seg(t, 14.8, 16.6))})`;
      }

      // Le lecteur : joue une fois, tient l'image finale ; clic = pause ; curseur = aller à.
      const lecteur = fig.querySelector<HTMLElement>('[data-lecteur]')!;
      const curseur = fig.querySelector<HTMLInputElement>('[data-curseur]')!;
      lecteur.hidden = false;
      boite.classList.add('anime');
      let joue = false, dernier = 0, raf = 0;
      const poser = (v: number) => { t = Math.min(DUREE, Math.max(0, v)); rendu(t); curseur.value = String(Math.round((t / DUREE) * 1000)); };
      const boucle = (now: number) => {
        if (!joue) return;
        t += Math.min(0.05, (now - dernier) / 1000); dernier = now;
        poser(t);
        if (t >= DUREE) { joue = false; return; }
        raf = requestAnimationFrame(boucle);
      };
      const lancer = () => { if (t >= DUREE) t = 0; joue = true; dernier = performance.now(); cancelAnimationFrame(raf); raf = requestAnimationFrame(boucle); };
      boite.addEventListener('click', () => { if (joue) joue = false; else lancer(); });
      fig.querySelector('[data-rejouer]')!.addEventListener('click', () => { t = 0; lancer(); });
      curseur.addEventListener('input', () => { joue = false; poser((Number(curseur.value) / 1000) * DUREE); });
      poser(0);
      (fig as unknown as { __scene: { aller: (v: number) => void } }).__scene = { aller: (v: number) => { joue = false; poser(v); } };
      // Elle joue à l'arrivée à l'écran, une fois.
      new IntersectionObserver(([e], o) => { if (e.isIntersecting) { lancer(); o.disconnect(); } }, { threshold: 0.4 }).observe(boite);
    });
  }
  initScenes();
  document.addEventListener('astro:page-load', initScenes);
</script>
