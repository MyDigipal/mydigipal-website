    line-height: 1.1;
    letter-spacing: -0.03em;
    word-spacing: 0.06em;
  }
  .fiche-texte {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--texte);
  }
  .fiche-compris-titre {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gris);
  }
  .fiche-compris {
    list-style: none;
    margin: -0.35rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
