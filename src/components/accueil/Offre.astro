  @media (prefers-reduced-motion: reduce) {
    .offre-marqueur,
    .fiche.est-active {
      transition: none;
    }
    .fiche {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Le repère qui glisse et la fiche qui suit : la ligne survolée à la
   * souris, ou atteinte au clavier, devient la ligne active. On garde la
   * dernière quand le pointeur quitte la liste (la fiche ne se vide jamais).
   * Au doigt, rien ne change : la ligne mène directement à sa page.
   */
  document.querySelectorAll<HTMLElement>('[data-offre]').forEach((section) => {
    const zone = section.querySelector<HTMLElement>('[data-listes]');
    const marqueur = section.querySelector<HTMLElement>('[data-marqueur]');
    const lignes = Array.from(section.querySelectorAll<HTMLElement>('[data-service]'));
    const fiches = Array.from(section.querySelectorAll<HTMLElement>('[data-fiche]'));
    if (!zone || !marqueur || !lignes.length) return;

    let active = lignes.find((l) => l.classList.contains('est-active')) ?? lignes[0];

    const placer = () => {
      const z = zone.getBoundingClientRect();
      const r = active.getBoundingClientRect();
      if (!r.height) return;
      marqueur.style.transform = `translateY(${r.top - z.top}px)`;
      marqueur.style.height = `${r.height}px`;
      marqueur.classList.add('est-pret');
    };

    const activer = (ligne: HTMLElement) => {
      if (ligne === active) return;
      active.classList.remove('est-active');
      active = ligne;
      ligne.classList.add('est-active');
      fiches.forEach((f) => f.classList.toggle('est-active', f.dataset.fiche === ligne.dataset.service));
      placer();
    };

    lignes.forEach((l) => {
      l.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') activer(l);
      });
      l.addEventListener('focus', () => activer(l));
    });

    // Le premier placement sans glissade, puis à chaque changement de taille
    // (polices chargées, fenêtre redimensionnée).
    marqueur.style.transition = 'none';
    placer();
    requestAnimationFrame(() => (marqueur.style.transition = ''));
    new ResizeObserver(placer).observe(zone);
  });
</script>
