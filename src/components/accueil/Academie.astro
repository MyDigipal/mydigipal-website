---
/**
 * L'AI Academy, mise en avant : ce qu'elle est, et l'application qui tourne.
 *
 * Demande de Paul du 24/09/2026 : « une petite section sur l'Académie […] avec
 * une belle photo et une vidéo […] quelque chose qui fasse la promotion de la
 * MyDigipal AI Academy. C'est un des trucs qu'on veut mettre en avant le plus. »
 *
 * La « vidéo », ce sont les boucles filmées de l'application
 * (`public/academy/demos/`, en français quand elles existent : `baseDemo()`),
 * les mêmes que sur la page de vente, en onglets : une boucle par écran, le
 * tour avance seul d'un écran à l'autre tant qu'on ne touche à rien, et
 * s'arrête au premier geste. Le bouton pause est toujours là (une vidéo qui
 * bouge plus de cinq secondes doit pouvoir s'arrêter), et sous
 * prefers-reduced-motion rien ne démarre seul : l'affiche, et le bouton.
 *
 * ⚠️ Pas les visuels de `public/academy/visuels/` : ce sont des images
 * composées (une apprenante, des cartes flottantes) qui portent des chiffres
 * inventés (35 %, 2 650 points, « 7 day streak »). La règle de la page est
 * « contenu réel, aucun chiffre inventé ». La photo réelle d'une formation est
 * dans la section suivante (La Poste).
 *
 * Textes : le titre et les fiches des écrans sont ceux de la page de vente
 * (`academy/copy.ts`, `hero.titre` et `visite.spots`), chiffres compris, lus
 * dans l'API de l'Academy (instantané en secours, relus dans le navigateur par
 * `data-fait`).
 *
 * Performance : aucune vidéo avant que la section approche de l'écran ;
 * une seule balise `<video>` dont on change la source, pas six.
 *
 * Les films PARLANTS (25/09/2026, demande de Paul : « il y a des vidéos que
 * tu peux reprendre de la page de vente ») viennent ensuite, dans le miroir
 * des boucles : titre et liste à gauche, écran à droite. Ce sont ceux de la
 * page de vente (`academy-v2/copy-v2.ts`, `films`), titres et légendes
 * compris. Un film ne part qu'au clic, avec le son ; il fait taire la boucle
 * muette, et la boucle relancée le fait taire.
 *
 * Sur l'accueil (groupe 5 de la refonte, 30/09/2026, demande de Paul), les
 * écrans et les films sont REPLIÉS (`replie`) : sans clic, on passe de la
 * vidéo de présentation aux avis puis aux services. Deux `<details>` natifs,
 * leur texte est dans le HTML servi, ils s'ouvrent vers le bas sous leur
 * titre, qui ne bouge pas. Rien ne se charge ni ne joue tant qu'un pli est
 * fermé ; le refermer arrête sa vidéo. `/ai` les montre ouverts, sans pli.
 */
import Icon from '@/components/ui/Icon.astro';
import type { Jour30Data } from '@/components/academy/data';
import { jour30Copy } from '@/components/academy/copy';
import { baseDemo } from '@/components/academy/demos-fr';
import { MARQUES } from '@/components/academy-tools/logos';
import { OUTILS_PUBLIES, lienOutil } from '@/components/academy-tools';
import { copyV2 } from '@/components/academy-v2/copy-v2';
import { faitsAcademy, serrer, type Lang } from './donnees';

interface Props {
  lang: Lang;
  academy: Jour30Data;
  /** La vidéo de présentation. `/ai` la montre déjà dans sa carte de l'Academy. */
  presentation?: boolean;
  /** Les écrans et les films repliés sous deux titres (l'accueil). */
  replie?: boolean;
  /** Ajoutée à la section (l'accueil y met `section-monte`). */
  class?: string;
}
const { lang, academy, presentation = true, replie = false, class: classe } = Astro.props;
const fr = lang === 'fr';
const f = faitsAcademy(academy, lang);
const c = jour30Copy(lang);
const spots = c.visite.spots(academy.faits);

// L'écran filmé, et la fiche de la page de vente qui le décrit.
const ECRANS = [
  { demo: 'atelier', spot: spots.atelier },
  { demo: 'prompts', spot: spots.prompts },
  { demo: 'cas', spot: spots.cas },
  { demo: 'quiz', spot: spots.exercices },
  { demo: 'assistant', spot: spots.assistant },
  { demo: 'avance', spot: spots.parcours2 },
].map((e) => ({ ...e, base: baseDemo(e.demo, lang) }));

const outils = OUTILS_PUBLIES.filter((o) => MARQUES[o.id]);

// Les films PARLANTS de la page de vente (`academy-v2/copy-v2.ts`, 25/09/2026),
// repris tels quels, titres et légendes compris : en anglais, Paul qui fait
// visiter l'espace, ouvre une leçon et montre les automatisations ; en
// français, les deux extraits de la conférence donnée pour SeLoger.
const cf = copyV2(lang).films;
const FILMS = [cf.tour, cf.produit, cf.mcp, ...(cf.salle?.films ?? [])].filter(
  (x): x is NonNullable<typeof x> => !!x,
);

const t = fr
  ? {
      logo: 'MyDigipal AI Academy',
      chapeau: `${f.lecons} leçons à votre rythme : la méthode de prompting, le parcours de votre outil, des exercices sur vos propres cas, jusqu’aux agents et aux serveurs MCP.`,
      chapeauGabarit: '{} leçons à votre rythme : la méthode de prompting, le parcours de votre outil, des exercices sur vos propres cas, jusqu’aux agents et aux serveurs MCP.',
      faits: {
        lecons: 'leçons',
        modules: 'modules',
        prompts: 'prompts prêts à copier',
        heures: 'de lecture et d’exercices',
      },
      voir: 'Voir l’Academy',
      outils: 'Un parcours pour votre outil',
      ecrans: 'Les écrans de l’Academy',
      pause: 'Mettre la vidéo en pause',
      lire: 'Lire la vidéo',
      presentation: 'L’AI Academy en 30 secondes',
      filmsTitre: 'La méthode, devant une vraie salle.',
      filmsChapeau: 'Des extraits d’une conférence donnée pour les équipes de SeLoger, avec le son. Les données sont fictives, les réflexes sont ceux de la formation.',
      filmsChoix: 'Choisir un film',
      filmsVoir: 'Voir',
      pliEcrans: 'L’application, écran par écran',
      pliEcransCompte: (n: number) => `${n} écrans filmés`,
      pliFilmsCompte: (n: number) => (n > 1 ? `${n} films, avec le son` : 'Un film, avec le son'),
    }
  : {
      logo: 'MyDigipal AI Academy',
      chapeau: `${f.lecons} lessons at your own pace: the prompting method, the path for your own tool, exercises on your own cases, all the way to agents and MCP servers.`,
      chapeauGabarit: '{} lessons at your own pace: the prompting method, the path for your own tool, exercises on your own cases, all the way to agents and MCP servers.',
      faits: {
        lecons: 'lessons',
        modules: 'modules',
        prompts: 'prompts ready to copy',
        heures: 'of reading and exercises',
      },
      voir: 'See the Academy',
      outils: 'A path for your tool',
      ecrans: 'Academy screens',
      pause: 'Pause the video',
      lire: 'Play the video',
      presentation: 'The AI Academy in 30 seconds',
      filmsTitre: 'Paul shows you around.',
      filmsChapeau: 'Films with sound: the learner space, a lesson from the inside, and the automations running on a real setup.',
      filmsChoix: 'Pick a film',
      filmsVoir: 'Watch',
      pliEcrans: 'The app, screen by screen',
      pliEcransCompte: (n: number) => `${n} screens on film`,
      pliFilmsCompte: (n: number) => (n > 1 ? `${n} films with sound` : 'One film with sound'),
    };

// Le résumé du pli des écrans : leurs noms, à la suite (« L’atelier CRAFT, la
// bibliothèque, les cas d’usage… »), lus dans les fiches de la page de vente.
const minuscule = (s: string) => (/^[A-Z]{2}/.test(s) ? s : s.charAt(0).toLowerCase() + s.slice(1));
const resumeEcrans = (() => {
  const noms = ECRANS.map((e) => minuscule(e.spot.kicker)).join(', ');
  return `${noms.charAt(0).toUpperCase()}${noms.slice(1)}.`;
})();

// Sur l'accueil, chaque pli est un `<details>` et les deux vont ensemble dans
// `.academie-plis` ; ailleurs (`/ai`), rien autour : le DOM ne change pas.
const Pli = replie ? 'details' : Fragment;
const pli = (id: string) => (replie ? { class: 'academie-pli', 'data-pli': id } : {});
const Plis = replie ? 'div' : Fragment;
const plis = replie ? { class: 'academie-plis', 'data-reveal': '', style: '--i:2' } : {};

const faits = [
  { cle: 'lecons', valeur: String(f.lecons), libelle: t.faits.lecons },
  { cle: 'modules', valeur: String(f.modules), libelle: t.faits.modules },
  { cle: 'prompts', valeur: String(f.prompts), libelle: t.faits.prompts },
  { cle: 'heures', valeur: f.heures, libelle: t.faits.heures },
];
---

<section class:list={['academie', classe, { 'est-replie': replie }]} aria-labelledby="academie-titre" data-academie>
  <div class="container-custom">
    <div class="academie-tete">
      <div class="academie-intro" data-reveal>
        <img
          class="academie-logo"
          src="/images/accueil/academy-logo-nuit.webp"
          alt={t.logo}
          width="214"
          height="88"
          loading="lazy"
          decoding="async"
        />
        <h2 id="academie-titre" class="titre-section academie-titre" set:html={serrer(c.hero.titre)} />
        <p class="chapeau academie-chapeau" data-fait="lecons" data-gabarit={t.chapeauGabarit}>{t.chapeau}</p>
      </div>

      <div class="academie-cote" data-reveal style="--i:1">
        <dl class="academie-faits">
          {faits.map((x) => (
            <div>
              <dt data-fait={x.cle}>{x.valeur}</dt>
              <dd>{x.libelle}</dd>
            </div>
          ))}
        </dl>
        <div class="academie-actions">
          <a href={`/${lang}/academy`} class="bouton-plein bouton-clair">
            <span>{t.voir}</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={f.lienGratuit} class="lien-fleche academie-gratuit">
            <span data-fait="gratuites" data-gabarit={c.hero.cta2(0).replace('0', '{}')}>{c.hero.cta2(f.gratuites)}</span>
            <Icon name="arrow-up-right" size={17} />
          </a>
        </div>
      </div>
    </div>

    {/* La vidéo de présentation (27/09/2026), la même que dans le hero de la
        page de vente : muette, elle part seule quand elle entre à l'écran,
        s'arrête quand elle en sort, et jamais seule sous
        prefers-reduced-motion. */}
    {presentation && (
    <figure class="academie-presentation" data-presentation data-reveal style="--i:2">
      <div class="presentation-ecran">
        <video
          class="presentation-video"
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          poster={`/academy/videos/presentation-v4-${lang}.webp`}
          aria-label={t.presentation}
          data-pres-video
        >
          <source src={`/academy/videos/presentation-v4-${lang}.mp4`} type="video/mp4" />
        </video>
        <button type="button" class="academie-lecture est-arretee" aria-label={t.lire} data-pres-bouton data-pause={t.pause} data-lire={t.lire}>
          <Icon name="pause" size={16} class="icone-pause" />
          <Icon name="play" size={16} class="icone-lire" />
        </button>
      </div>
    </figure>
    )}

    <Plis {...plis}>
    <Pli {...pli('ecrans')}>
    {replie && (
      <summary class="pli-tete">
        <span class="pli-texte">
          <span class="pli-titre" set:html={serrer(t.pliEcrans)} />
          <span class="pli-resume">{resumeEcrans}</span>
        </span>
        <span class="pli-compte">{t.pliEcransCompte(ECRANS.length)}</span>
        <span class="pli-signe" aria-hidden="true"></span>
      </summary>
    )}
    <div class="academie-demo" data-demo data-reveal={replie ? undefined : ''} style="--i:2">
      <div class="academie-onglets" role="tablist" aria-label={t.ecrans}>
        {ECRANS.map((e, i) => (
          <button
            type="button"
            role="tab"
            id={`aca-onglet-${i}`}
            aria-controls="aca-panneau"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="academie-onglet"
            data-base={e.base}
          >
            <span class="onglet-kicker">{e.spot.kicker}</span>
            <span class="onglet-titre" set:html={serrer(e.spot.titre)} />
            <span class="onglet-barre" aria-hidden="true"><span data-barre></span></span>
          </button>
        ))}
      </div>

      <figure class="academie-panneau" id="aca-panneau" role="tabpanel" aria-labelledby="aca-onglet-0">
        <div class="academie-ecran">
          <img
            class="academie-affiche"
            src={`${ECRANS[0].base}.jpg`}
            alt=""
            width="940"
            height="734"
            loading="lazy"
            decoding="async"
            data-affiche
          />
          <video class="academie-video" muted playsinline preload="none" disablepictureinpicture aria-hidden="true" data-video></video>
          <button type="button" class="academie-lecture" aria-label={t.pause} data-lecture data-pause={t.pause} data-lire={t.lire}>
            <Icon name="pause" size={16} class="icone-pause" />
            <Icon name="play" size={16} class="icone-lire" />
          </button>
        </div>
        <figcaption class="academie-legende">
          {ECRANS.map((e, i) => (
            <p data-aca-legende={i} hidden={i !== 0}>
              <b set:html={serrer(e.spot.titre)} />
              <span>{e.spot.texte}</span>
            </p>
          ))}
        </figcaption>
      </figure>
    </div>
    </Pli>

    {FILMS.length > 0 && (
      <Pli {...pli('films')}>
      {replie && (
        <summary class="pli-tete">
          <span class="pli-texte">
            <span class="pli-titre" set:html={serrer(t.filmsTitre)} />
            <span class="pli-resume">{t.filmsChapeau}</span>
          </span>
          <span class="pli-compte">{t.pliFilmsCompte(FILMS.length)}</span>
          <span class="pli-signe" aria-hidden="true"></span>
        </summary>
      )}
      <div class="academie-films" data-films data-lire={t.lire}>
        {!replie && (
          <div class="films-tete" data-reveal>
            <h3 class="films-titre" set:html={serrer(t.filmsTitre)} />
            <p class="films-chapeau">{t.filmsChapeau}</p>
          </div>
        )}

        <figure class="films-bloc" data-reveal={replie ? undefined : ''} style="--i:1">
          <div class="films-ecran">
            <img
              class="films-affiche"
              src={`/academy/videos/${FILMS[0].id}.webp`}
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
              data-films-affiche
            />
            <video class="films-video" preload="none" playsinline data-films-video></video>
            <button type="button" class="films-lire" aria-label={`${t.lire} : ${FILMS[0].titre}`} data-films-lire>
              <span class="films-rond">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <polygon points="5 3 19 12 5 21 5 3" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="films-libelle">{t.filmsVoir}<span class="films-duree" data-films-duree></span></span>
            </button>
          </div>
          <figcaption class="films-legende">
            <b data-films-titre>{FILMS[0].titre}</b>
            <span data-films-texte>{FILMS[0].legende}</span>
          </figcaption>
        </figure>

        {FILMS.length > 1 && (
          <ul class="films-liste" aria-label={t.filmsChoix} data-reveal={replie ? undefined : ''} style="--i:2">
            {FILMS.map((film, i) => (
              <li>
                <button
                  type="button"
                  class="films-choix"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-film={film.id}
                  data-titre={film.titre}
                  data-legende={film.legende}
                >
                  <img src={`/academy/videos/${film.id}.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                  <span class="films-choix-texte">
                    <span class="films-choix-titre">{film.titre}</span>
                    <span class="films-choix-duree" data-duree-de={film.id}></span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>
      </Pli>
    )}
    </Plis>

    {outils.length > 0 && (
      <div class="academie-outils" data-reveal style="--i:3">
        <p>{t.outils}</p>
        <ul>
          {outils.map((o) => (
            <li>
              <a href={lienOutil(o, lang)}>
                <svg viewBox={MARQUES[o.id].viewBox} aria-hidden="true" focusable="false">
                  <path d={MARQUES[o.id].trace} fill="currentColor" />
                </svg>
                <span>{o.nom}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  /* La salle de nuit de l'Academy : sa couleur à elle, la seule grande
     surface sombre de la page. L'or reste dans son logo ; les actions gardent
     le blanc et le bleu du site. */
  .academie {
    position: relative;
    overflow: hidden;
    background: var(--nuit);
    color: #eef2f6;
    padding: 5rem 0;
  }
  @media (min-width: 1024px) {
    .academie {
      padding: 7.5rem 0 8rem;
    }
  }
  .academie :is(a, button):focus-visible {
    outline-color: #fff;
  }

  .academie-tete {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .academie-tete {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }
    .academie-intro {
      grid-column: 1 / span 7;
    }
    .academie-cote {
      grid-column: 9 / span 4;
    }
  }
  .academie-logo {
    display: block;
    height: 44px;
    width: auto;
    margin-bottom: 2rem;
  }
  /* `.academie` devant : le style commun (`.accueil .titre-section`,
     `.accueil .chapeau`) a la même spécificité et passe après. */
  .academie .academie-titre {
    color: #fff;
  }
  .academie .academie-chapeau {
    color: #a9b6c4;
    max-width: 52ch;
  }

  .academie-faits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 1.25rem;
    margin: 0;
  }
  .academie-faits div {
    border-top: 1px solid rgb(255 255 255 / 0.14);
    padding-top: 0.85rem;
  }
  .academie-faits dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: #fff;
    white-space: nowrap;
  }
  .academie-faits dd {
    margin: 0.4rem 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: #a9b6c4;
  }
  .academie-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .academie .lien-fleche {
    color: #fff;
  }
  .academie .lien-fleche:hover {
    color: #fff;
    text-decoration-color: currentColor;
  }

  /* ------------------------------------------------------ l'application */
  .academie-demo {
    display: grid;
    gap: 1.25rem;
    margin-top: 3.5rem;
  }
  @media (min-width: 1024px) {
    .academie-demo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: start;
      margin-top: 5rem;
    }
    .academie-panneau {
      grid-column: 1 / span 8;
      grid-row: 1;
    }
    .academie-onglets {
      grid-column: 9 / span 4;
      grid-row: 1;
    }
  }

  .academie-panneau {
    position: relative;
    margin: 0;
  }

  /* La vidéo de présentation : pleine largeur, entre le titre et les écrans. */
  .academie-presentation {
    position: relative;
    margin: 3rem 0 0;
  }
  @media (min-width: 1024px) {
    .academie-presentation {
      margin-top: 4.5rem;
    }
  }
  .academie-presentation::before {
    content: '';
    position: absolute;
    inset: -8% -6% 6%;
    background: radial-gradient(closest-side, rgb(200 169 81 / 0.16), transparent);
    filter: blur(24px);
    pointer-events: none;
  }
  .presentation-ecran {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #0d1424;
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.85);
  }
  .presentation-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Une lueur du bleu du logo derrière l'écran, pas un dégradé de fond. */
  .academie-panneau::before {
    content: '';
    position: absolute;
    inset: -12% -8% 10%;
    background: radial-gradient(closest-side, rgb(29 113 184 / 0.28), transparent);
    filter: blur(20px);
    pointer-events: none;
  }
  .academie-ecran {
    position: relative;
    aspect-ratio: 940 / 734;
    border-radius: 14px;
    overflow: hidden;
    background: #f3f1ea;
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.85);
  }
  .academie-affiche,
  .academie-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .academie-video {
    opacity: 0;
    transition: opacity 0.35s var(--ease-sortie);
  }
  .academie-video.est-visible {
    opacity: 1;
  }
  .academie-lecture {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 0;
    background: rgb(10 18 29 / 0.78);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color 0.25s var(--ease-sortie);
  }
  .academie-lecture:hover {
