<script>
  /**
   * La vidéo de présentation : muette, elle démarre à l'entrée dans l'écran et
   * s'arrête à la sortie. Le bouton l'arrête pour de bon (le défilement ne la
   * relance plus), ou la relance. Un film parlant qui démarre la fait taire.
   */
  document.querySelectorAll<HTMLElement>('[data-presentation]').forEach((bloc) => {
    const v = bloc.querySelector<HTMLVideoElement>('[data-pres-video]');
    const b = bloc.querySelector<HTMLButtonElement>('[data-pres-bouton]');
    if (!v || !b) return;
    let arretee = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const etat = () => {
      b.classList.toggle('est-arretee', v.paused);
      b.setAttribute('aria-label', (v.paused ? b.dataset.lire : b.dataset.pause) ?? '');
    };
    v.addEventListener('play', etat);
    v.addEventListener('pause', etat);
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !arretee) v.play().catch(() => {});
        else if (!e.isIntersecting && !v.paused) v.pause();
      },
      { threshold: 0.35 },
    ).observe(v);
    b.addEventListener('click', () => {
      if (v.paused) {
        arretee = false;
        v.play().catch(() => {});
        (window as unknown as { dataLayer?: Record<string, unknown>[] }).dataLayer?.push({
          event: 'academy_video_play',
          video_id: 'presentation-accueil',
        });
      } else {
        arretee = true;
        v.pause();
      }
    });
    window.addEventListener('accueil-film-lecture', () => {
      arretee = true;
      v.pause();
    });
  });

  /**
   * Le lecteur des écrans de l'Academy.
   *
   * - Rien ne se charge avant que le lecteur approche de l'écran ; la vidéo
   *   se met en pause quand il en sort.
   * - Le tour : chaque boucle joue une fois, puis l'onglet suivant, tant
   *   qu'on n'a touché à rien. Un clic sur un onglet l'arrête et fait
   *   tourner en boucle l'écran choisi.
   * - Sous prefers-reduced-motion, rien ne démarre seul : l'affiche de
   *   l'écran, et le bouton lecture.
   * - Modèle ARIA des onglets : flèches, Début, Fin.
   */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  /** Un film parlant démarre ; la boucle muette repart. */
  const FILM = 'accueil-film-lecture';
  const BOUCLE = 'accueil-boucle-lecture';

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((demo) => {
    const bande = demo.querySelector<HTMLElement>('[role="tablist"]');
    const onglets = Array.from(demo.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const legendes = Array.from(demo.querySelectorAll<HTMLElement>('[data-aca-legende]'));
    const panneau = demo.querySelector<HTMLElement>('[role="tabpanel"]');
    const video = demo.querySelector<HTMLVideoElement>('[data-video]');
    const affiche = demo.querySelector<HTMLImageElement>('[data-affiche]');
    const bouton = demo.querySelector<HTMLButtonElement>('[data-lecture]');
    if (!bande || !onglets.length || !video || !affiche || !bouton || !panneau) return;

    let courant = 0;
    let tour = !reduit;
    let arretee = reduit;
    let visible = false;
    let chargee = -1;
    // Sur l'accueil, le lecteur est dans un pli : fermé, il ne charge ni ne joue rien.
    const pli = demo.closest('details');
    const ouvert = () => !pli || pli.open;

    const barre = (i: number) => onglets[i].querySelector<HTMLElement>('[data-barre]');

    const majBouton = () => {
      bouton.classList.toggle('est-arretee', arretee);
      bouton.setAttribute('aria-label', (arretee ? bouton.dataset.lire : bouton.dataset.pause) || '');
    };
    majBouton();

    const charger = (i: number) => {
      if (chargee === i) return;
      chargee = i;
      const base = onglets[i].dataset.base;
      video.classList.remove('est-visible');
      video.replaceChildren(
        Object.assign(document.createElement('source'), { src: `${base}.webm`, type: 'video/webm' }),
        Object.assign(document.createElement('source'), { src: `${base}.mp4`, type: 'video/mp4' }),
      );
      video.load();
    };

    const lire = () => {
      if (arretee || !visible) return;
      charger(courant);
      video.loop = !tour;
      video.play().catch(() => {
        /* lecture refusée : l'affiche reste */
      });
    };

    const choisir = (n: number, focus = false) => {
      courant = (n + onglets.length) % onglets.length;
      onglets.forEach((o, i) => {
        const oui = i === courant;
        o.setAttribute('aria-selected', String(oui));
        o.tabIndex = oui ? 0 : -1;
        const b = barre(i);
        if (b) b.style.transform = 'scaleX(0)';
      });
      legendes.forEach((l, i) => (l.hidden = i !== courant));
      panneau.setAttribute('aria-labelledby', onglets[courant].id);
      affiche.src = `${onglets[courant].dataset.base}.jpg`;
      if (focus) onglets[courant].focus({ preventScroll: true });
      // Au téléphone, l'onglet choisi reste visible dans la bande qu'on fait
      // glisser. Jamais `scrollIntoView` : pendant le tour, il ferait défiler
      // la PAGE vers un onglet sorti de l'écran.
      if (bande.scrollWidth > bande.clientWidth) {
        bande.scrollTo({ left: onglets[courant].offsetLeft - 16, behavior: reduit ? 'instant' : 'smooth' });
      }
      if (visible && !arretee) lire();
      else {
        chargee = -1;
        video.pause();
        video.classList.remove('est-visible');
      }
    };

    video.addEventListener('playing', () => video.classList.add('est-visible'));
    video.addEventListener('ended', () => {
      if (tour) choisir(courant + 1);
    });

    // La barre de l'onglet suit la lecture.
    let trame = 0;
    const suivre = () => {
      const b = barre(courant);
      if (b && video.duration) b.style.transform = `scaleX(${Math.min(1, video.currentTime / video.duration)})`;
      trame = video.paused ? 0 : requestAnimationFrame(suivre);
    };
    video.addEventListener('play', () => {
      if (!trame) trame = requestAnimationFrame(suivre);
    });

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting && ouvert();
        if (visible) lire();
        else video.pause();
      },
      { threshold: 0.3 },
    ).observe(demo);

    // Ouvert, il démarre s'il est à l'écran ; refermé, il s'arrête.
    pli?.addEventListener('toggle', () => {
      if (pli.open) {
        const r = demo.getBoundingClientRect();
        visible = r.top < innerHeight && r.bottom > 0;
        if (visible) lire();
      } else {
        visible = false;
        video.pause();
      }
    });

    bouton.addEventListener('click', () => {
      arretee = !arretee;
      tour = false;
      majBouton();
      if (arretee) video.pause();
      else {
        window.dispatchEvent(new CustomEvent(BOUCLE));
        lire();
      }
    });

    // Un film parlant démarre : la boucle muette s'arrête, pour qu'une seule
    // image bouge à l'écran.
    window.addEventListener(FILM, () => {
      arretee = true;
      tour = false;
      majBouton();
      video.pause();
    });

    onglets.forEach((o, i) => {
      o.addEventListener('click', () => {
        tour = false;
        choisir(i);
      });
      o.addEventListener('keydown', (e) => {
        const cible =
          e.key === 'ArrowRight' || e.key === 'ArrowDown' ? courant + 1
          : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? courant - 1
          : e.key === 'Home' ? 0
          : e.key === 'End' ? onglets.length - 1
          : null;
        if (cible === null) return;
        e.preventDefault();
        tour = false;
        choisir(cible, true);
      });
    });
  });

  /**
   * Les films parlants.
   *
   * - Rien ne se charge avant l'approche de la section ; alors seulement, les
   *   métadonnées de chaque film (quelques Ko, les fichiers sont en
   *   faststart) donnent la durée affichée, lue dans le fichier et jamais
   *   écrite dans le code.
   * - Un film ne part qu'au clic, avec le son et les contrôles du navigateur.
   *   Choisir un autre film dans la liste le lance aussitôt.
   * - Sorti de l'écran, il se met en pause.
   * - Même événement de mesure que la page de vente (`academy_video_play`).
   */
  const mn = (s: number) => `${Math.max(1, Math.round(s / 60))} min`;
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;

  /** L'ouverture d'un pli de l'accueil, mesurée une fois par visite et par pli. */
  document.querySelectorAll<HTMLDetailsElement>('details[data-pli]').forEach((pli) => {
    pli.addEventListener('toggle', () => {
      if (!pli.open || pli.dataset.mesure) return;
      pli.dataset.mesure = '1';
      const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
      w.dataLayer?.push({ event: 'accueil_pli_ouvert', pli: pli.dataset.pli });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-films]').forEach((bloc) => {
    const ecran = bloc.querySelector<HTMLElement>('.films-ecran');
    const video = bloc.querySelector<HTMLVideoElement>('[data-films-video]');
    const affiche = bloc.querySelector<HTMLImageElement>('[data-films-affiche]');
    const lire = bloc.querySelector<HTMLButtonElement>('[data-films-lire]');
    const duree = bloc.querySelector<HTMLElement>('[data-films-duree]');
    const titre = bloc.querySelector<HTMLElement>('[data-films-titre]');
    const texte = bloc.querySelector<HTMLElement>('[data-films-texte]');
    if (!ecran || !video || !affiche || !lire || !duree || !titre || !texte) return;
    const choix = Array.from(bloc.querySelectorAll<HTMLButtonElement>('[data-film]'));
    // Un seul film : pas de liste, son identifiant vient de l'affiche.
    const ids = choix.length ? choix.map((c) => c.dataset.film || '') : [affiche.src.split('/').pop()?.replace(/\.webp$/, '') || ''];
    const durees = new Map<string, number>();
    let courant = 0;

    const majTouche = () => {
      const d = durees.get(ids[courant]);
      duree.textContent = d ? mn(d) : '';
      lire.setAttribute('aria-label', `${bloc.dataset.lire || ''} : ${titre.textContent || ''}`);
    };

    const sonder = () => {
      ids.forEach((id) => {
        const v = document.createElement('video');
        v.preload = 'metadata';
        v.muted = true;
        v.addEventListener(
          'loadedmetadata',
          () => {
            if (Number.isFinite(v.duration) && v.duration > 0) {
              durees.set(id, v.duration);
              const cible = bloc.querySelector<HTMLElement>(`[data-duree-de="${id}"]`);
              if (cible) cible.textContent = mmss(v.duration);
              majTouche();
            }
            v.removeAttribute('src');
            v.load();
          },
          { once: true },
        );
        v.src = `/academy/videos/${id}.mp4`;
      });
    };
    // Sur l'accueil, les films sont dans un pli : rien n'est lu avant son ouverture.
    const pli = bloc.closest('details');
    let sonde = false;
    const sonderUneFois = () => {
      if (sonde) return;
      sonde = true;
      sonder();
    };
    const proche = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting || (pli && !pli.open)) return;
        proche.disconnect();
        sonderUneFois();
      },
      { rootMargin: '400px 0px' },
    );
    proche.observe(bloc);
    pli?.addEventListener('toggle', () => {
      if (pli.open) sonderUneFois();
      else video.pause();
    });

    const source = () => {
      video.replaceChildren(
        Object.assign(document.createElement('source'), { src: `/academy/videos/${ids[courant]}.mp4`, type: 'video/mp4' }),
      );
      video.load();
    };

    const jouer = () => {
      if (!video.querySelector('source')) source();
      ecran.classList.add('est-lance');
      video.controls = true;
      window.dispatchEvent(new CustomEvent(FILM));
      video.play().catch(() => {
        /* lecture refusée : les contrôles restent à disposition */
      });
      const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
      w.dataLayer?.push({ event: 'academy_video_play', video_id: ids[courant], emplacement: 'accueil' });
    };

    lire.addEventListener('click', jouer);

    choix.forEach((c, i) => {
      c.addEventListener('click', () => {
        if (i === courant && ecran.classList.contains('est-lance')) return;
        video.pause();
        courant = i;
        choix.forEach((x, j) => x.setAttribute('aria-pressed', String(j === i)));
        affiche.src = `/academy/videos/${ids[i]}.webp`;
        titre.textContent = c.dataset.titre || '';
        texte.textContent = c.dataset.legende || '';
        majTouche();
        source();
        jouer();
      });
    });

    // La boucle muette repart : le film se tait.
    window.addEventListener(BOUCLE, () => video.pause());

    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting && !video.paused) video.pause();
    }).observe(ecran);
  });
</script>
