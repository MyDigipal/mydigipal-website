---
/**
 * Le hero de la page d'accueil : des gens d'abord.
 *
 * Direction A du document de refonte (« Les visages »), poussée plus loin :
 * - le titre prend toute la largeur, et sa seconde ligne s'épaissit en
 *   entrant (axe de graisse de Plus Jakarta Sans, 300 à 800) : le seul
 *   mouvement du hero qui dit quelque chose, il dit la phrase. « Vos
 *   campagnes ont des visages » depuis le 25/09/2026 : Paul ne trouvait pas
 *   « Votre équipe marketing, en plus grand » assez fort, et le voulait plus
 *   grand ;
 * - les quatorze portraits, recadrés au même format par
 *   `scripts/visages-accueil.mjs`, EN COULEUR (Paul, 25/09/2026) ; c'est la
 *   personne qu'on survole, qu'on touche ou que la visite présente qui passe
 *   en noir et blanc, se soulève, et dont la légende dit le nom ;
 * - aucun « Réserver un appel » (Paul, 25/09/2026) : on commence par le
 *   calculateur, ou on nous écrit ;
 * - les portraits se chargent en différé (`loading="lazy"`) : à l'écran, le
 *   navigateur les demande juste après la mise en page, pendant leur entrée,
 *   au lieu de disputer la bande passante à la feuille de style avant le
 *   premier rendu (+250 ms mesurés sur téléphone en 4G lente) ;
 * - la légende sous la mosaïque dit qui c'est. Chaque visage est un bouton
 *   (souris, doigt ou clavier) dont le nom accessible est le texte alternatif
 *   de la photo ; la légende visible est donc masquée aux lecteurs d'écran
 *   (elle change toutes les 2,4 s pendant la visite).
 */
import Icon from '@/components/ui/Icon.astro';
import { EQUIPE, enLettres, portrait, serrer, type Lang } from './donnees';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';

const nombre = enLettres(EQUIPE.length, lang);
const t = fr
  ? {
      l1: 'Vos campagnes',
      l2: 'ont des visages.',
      sous: `${nombre} spécialistes du B2B et de l’automobile, à Paris et à Londres, qui travaillent dans vos comptes.`,
      budget: 'Calculer mon budget',
      contact: 'Nous contacter',
      survol: 'Survolez un visage pour savoir qui fait quoi.',
      toucher: 'Touchez un visage pour savoir qui fait quoi.',
    }
  : {
      l1: 'Your campaigns',
      l2: 'have faces.',
      sous: `${nombre} B2B and automotive specialists in London and Paris, working inside your accounts.`,
      budget: 'Calculate my budget',
      contact: 'Contact us',
      survol: 'Hover over a face to see who does what.',
      toucher: 'Tap a face to see who does what.',
    };

/**
 * La place de chaque visage, en demi-colonnes : un quinconce, chaque rangée
 * décalée d'un demi-visage sur la précédente.
 * - téléphone : 10 demi-colonnes, rangées de 5, 4 et 5 ;
 * - ordinateur : 15 demi-colonnes, deux rangées de 7.
 */
const RANGS_TEL = [5, 4, 5];
const place = (i: number) => {
  let r = 0;
  let reste = i;
  while (reste >= RANGS_TEL[r]) reste -= RANGS_TEL[r++];
  const colTel = RANGS_TEL[r] === 5 ? 1 + reste * 2 : 2 + reste * 2;
  const rangOrdi = i < 7 ? 0 : 1;
  const colOrdi = rangOrdi === 0 ? 1 + i * 2 : 2 + (i - 7) * 2;
  return `--ct:${colTel};--rt:${r + 1};--co:${colOrdi};--ro:${rangOrdi + 1};--i:${i}`;
};
---

<section class="visages" aria-labelledby="accueil-titre" data-visages>
  <div class="container-custom">
    <h1 id="accueil-titre" class="visages-titre" data-titre>
      <span class="ligne"><span style="--i:0" set:html={serrer(t.l1)} /></span>
      <span class="ligne"><span style="--i:1" class="ligne-poids" set:html={serrer(t.l2)} /></span>
    </h1>

    <div class="visages-corps">
      <div class="visages-texte">
        <p class="visages-sous">{t.sous}</p>
        <div class="visages-actions">
          <a href={`/${lang}/calculator`} class="bouton-plein">
            <span>{t.budget}</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={`/${lang}/contact`} class="lien-fleche">
            <span>{t.contact}</span>
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>

      <figure class="visages-mur">
        <ul class="mosaique" data-mosaique>
          {EQUIPE.map((p, i) => (
            <li class="visage" style={place(i)}>
              <button type="button" class="visage-bouton" data-nom={p.nom} data-role={p.role[lang]}>
                <img
                  src={portrait(p.slug)}
                  alt={`${p.nom}, ${p.role[lang]}`}
                  width="320"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
        <figcaption class="visages-legende" aria-hidden="true" data-legende>
          <span class="indice indice-survol">{t.survol}</span>
          <span class="indice indice-toucher">{t.toucher}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .visages {
    /* l'en-tête fixe a déjà sa cale de 72 px (Header.astro) */
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
    background: #fff;
  }
  @media (min-width: 1024px) {
    .visages {
      padding-top: 3.5rem;
      padding-bottom: 4.5rem;
    }
  }

  /* ---------------------------------------------------------------- le titre */
  .visages-titre {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-encre);
    /* Deux lignes courtes (« ont des visages. » fait ~7,2 em) : la taille suit
       la largeur de l'écran, 46 px sur un téléphone de 390 px, jusqu'à
       8,25 rem sur grand écran. */
    font-size: clamp(2.5rem, 11.8vw, 8.25rem);
    line-height: 0.95;
    letter-spacing: -0.042em;
    word-spacing: 0.08em;
    margin: 0;
  }
  .ligne-poids {
    white-space: nowrap;
  }
  /* La seconde ligne s'épaissit : elle entre fine (300) et finit comme la
     première (800). Seul le poids change, la ligne ne se replie pas
     (nowrap), donc rien ne bouge autour d'elle. */
  @media (prefers-reduced-motion: no-preference) {
    .visages-titre .ligne-poids {
      animation:
        ligne-monte 1s cubic-bezier(0.16, 1, 0.3, 1) both,
        prend-du-poids 1.3s cubic-bezier(0.65, 0, 0.35, 1) both;
      animation-delay: 200ms, 650ms;
    }
  }
  @keyframes prend-du-poids {
    from {
      font-weight: 300;
      letter-spacing: -0.02em;
    }
    to {
      font-weight: 800;
      letter-spacing: -0.042em;
    }
  }

  /* ---------------------------------------------------------------- le corps */
  .visages-corps {
    display: grid;
    gap: 2.25rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 1024px) {
    .visages-corps {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      margin-top: 2.75rem;
      align-items: start;
    }
    .visages-texte {
      grid-column: 1 / span 4;
      padding-top: 0.25rem;
    }
    .visages-mur {
      grid-column: 5 / span 8;
    }
  }
  .visages-sous {
    font-size: 1.125rem;
    line-height: 1.55;
    color: #3a4a5c;
    max-width: 34ch;
    text-wrap: pretty;
  }
  @media (min-width: 1024px) {
    .visages-sous {
      font-size: 1.25rem;
    }
  }
  .visages-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  /* Le texte du hero monte sans fondu : un élément qui démarre à opacité
     nulle n'est compté par le navigateur qu'une fois visible, et ce
     paragraphe est l'élément le plus grand (LCP) sur téléphone. */
  @media (prefers-reduced-motion: no-preference) {
    .visages-texte,
    .visages-legende {
      animation: hero-entre 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
    }
  }
  @keyframes hero-entre {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }

  /* --------------------------------------------------------------- la mosaïque */
  .visages-mur {
    margin: 0;
  }
  .mosaique {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 6px;
  }
  @media (min-width: 768px) {
    .mosaique {
      grid-template-columns: repeat(15, minmax(0, 1fr));
      gap: 8px;
    }
  }
  .visage {
    grid-column: var(--ct) / span 2;
    grid-row: var(--rt);
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #e9eef3;
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .visage {
      grid-column: var(--co) / span 2;
      grid-row: var(--ro);
      border-radius: 14px;
    }
  }
  .visage-bouton {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    touch-action: manipulation;
    border-radius: inherit;
  }
  .visage-bouton:focus-visible {
    outline: 2px solid var(--color-marque);
    outline-offset: 3px;
  }
  /* En couleur ; la personne présentée passe en noir et blanc, comme une
     photo qu'on sort de la série pour la regarder (Paul, 25/09/2026). */
  .visage img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: none;
    transition: filter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .visage.est-actif {
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 18px 34px -18px rgb(11 27 43 / 0.45);
    z-index: 1;
  }
  .visage.est-actif img {
    filter: grayscale(1) contrast(1.06) brightness(1.02);
  }
  @media (prefers-reduced-motion: no-preference) {
    .visage {
      animation: visage-pose 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 45ms + 250ms);
    }
  }
  @keyframes visage-pose {
    from {
      opacity: 0;
      transform: scale(0.86) translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .visages-legende {
    margin-top: 1rem;
    min-height: 1.5rem;
    font-size: 0.9375rem;
    color: #566779;
  }
  .visages-legende :global(b) {
    color: var(--color-encre);
    font-weight: 600;
  }
  .indice-toucher {
    display: none;
  }
  @media (hover: none) {
    .indice-survol {
      display: none;
    }
    .indice-toucher {
      display: inline;
    }
  }
  .visages-legende.a-nom .indice {
    display: none;
  }
</style>

<script>
  /**
   * La mosaïque : un visage survolé, touché, atteint au clavier ou présenté
   * par la visite passe en noir et blanc et la légende dit son nom. La visite fait
   * UN tour de l'équipe (2,4 s par personne), seulement quand la mosaïque est
   * à l'écran, s'arrête au premier geste du visiteur, et n'a jamais lieu s'il
   * a demandé moins d'animation à son système.
   */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-visages]').forEach((section) => {
    const mosaique = section.querySelector<HTMLElement>('[data-mosaique]');
    const legende = section.querySelector<HTMLElement>('[data-legende]');
    if (!mosaique || !legende) return;
    const visages = Array.from(mosaique.querySelectorAll<HTMLElement>('.visage-bouton'));
    const indices = legende.innerHTML;

    let actif: HTMLElement | null = null;
    const montrer = (v: HTMLElement | null) => {
      actif?.parentElement?.classList.remove('est-actif');
      actif = v;
      if (!v) {
        legende.classList.remove('a-nom');
        legende.innerHTML = indices;
        return;
      }
      v.parentElement?.classList.add('est-actif');
      legende.classList.add('a-nom');
      const b = document.createElement('b');
      b.textContent = v.dataset.nom || '';
      legende.replaceChildren(b, document.createTextNode(`, ${v.dataset.role || ''}`));
    };

    /* ------------------------------------------------ la visite automatique */
    let minuterie = 0;
    let rang = 0;
    let visible = false;
    let arretee = reduit;
    const suivant = () => {
      if (rang >= visages.length) {
        // Un tour complet : on rend la légende à son indice et on s'arrête.
        arreter();
        montrer(null);
        return;
      }
      montrer(visages[rang]);
      rang += 1;
    };
    // La première présentation attend que les visages soient posés (fin de
    // leur entrée, 1,8 s) ; ensuite, une personne toutes les 2,4 s.
    const lancer = () => {
      if (arretee || minuterie || !visible) return;
      minuterie = window.setTimeout(
        () => {
          suivant();
          if (!arretee) minuterie = window.setInterval(suivant, 2400);
        },
        rang === 0 ? 1800 : 2400,
      );
    };
    const suspendre = () => {
      window.clearTimeout(minuterie);
      window.clearInterval(minuterie);
      minuterie = 0;
    };
    const arreter = () => {
      arretee = true;
      suspendre();
    };
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) lancer();
        else suspendre();
      },
      { threshold: 0.3 },
    ).observe(mosaique);

    /* --------------------------------------------------- la main du visiteur */
    visages.forEach((v) => {
      v.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        arreter();
        montrer(v);
      });
      v.addEventListener('click', () => {
        arreter();
        montrer(actif === v ? null : v);
      });
      v.addEventListener('focus', () => {
        arreter();
        montrer(v);
      });
    });
    mosaique.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && arretee) montrer(null);
    });
  });
</script>
