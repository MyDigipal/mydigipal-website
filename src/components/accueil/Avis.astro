---
/**
 * Ce qu'en disent les personnes formées.
 *
 * La note et le nombre de retours viennent de l'Academy (`avis`), les
 * verbatims aussi (`temoignages`), mot pour mot, jamais réécrits, et filtrés
 * par `temoignagesPublics()` (ni Kering ni Chanel, décision de Paul du
 * 01/09/2026). Un verbatim par société, le plus court, et seulement s'il tient
 * en trois lignes : on ne coupe pas les mots d'un client pour les faire entrer.
 *
 * Les logos sont les onglets : on choisit une entreprise, on lit ce qu'une
 * personne de chez elle a écrit. Sans JavaScript, le premier verbatim reste
 * affiché. Le tour automatique s'arrête au premier geste.
 */
import type { Jour30Data } from '@/components/academy/data';
import { LOGOS, faitsAcademy, hauteurLogo, verbatims, type Lang } from './donnees';

interface Props {
  lang: Lang;
  academy: Jour30Data;
}
const { lang, academy } = Astro.props;
const fr = lang === 'fr';
const f = faitsAcademy(academy, lang);
const LONGUEUR_MAX = 120;
const citations = verbatims(academy).filter((v) => v.texte.length <= LONGUEUR_MAX);
const guillemets = (s: string) => (fr ? `«\u00a0${s}\u00a0»` : `“${s}”`);

const t = fr
  ? {
      titre: (n: number) => `La moyenne des ${n} retours de nos formations, en salle et à distance.`,
      gabarit: 'La moyenne des {} retours de nos formations, en salle et à distance.',
      onglets: 'Choisir une entreprise',
      photo: 'Formation IA chez E.Leclerc',
      legende: 'Une formation IA chez E.Leclerc.',
    }
  : {
      titre: (n: number) => `The average of ${n} reviews of our training sessions, in the room and remote.`,
      gabarit: 'The average of {} reviews of our training sessions, in the room and remote.',
      onglets: 'Pick a company',
      photo: 'AI training session at E.Leclerc',
      legende: 'An AI training session at E.Leclerc.',
    };
---

<section class="avis bloc" aria-labelledby="avis-titre" data-avis>
  <div class="container-custom avis-grille">
    <div class="avis-note" data-counter-section="zero" data-reveal>
      <p class="note" aria-hidden="true">
        <span
          data-target={f.noteValeur}
          data-decimals="1"
          data-locale={lang}
          data-fait="note">{f.note}</span><span class="sur">/10</span>
      </p>
      <h2 id="avis-titre" class="avis-titre">
        <span class="sr-only" data-fait="note" data-gabarit="{}/10. ">{f.note}/10. </span><span data-fait="retours" data-gabarit={t.gabarit}>{t.titre(f.retours)}</span>
      </h2>
    </div>

    <figure class="avis-photo" data-reveal style="--i:1">
      <img
        src="/academy/references/session-leclerc.jpg"
        alt={t.photo}
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
        data-pose
      />
      <figcaption>{t.legende}</figcaption>
    </figure>

    {citations.length > 0 && (
      <div class="avis-citations" data-reveal style="--i:2">
        {citations.map((c, i) => (
          <figure
            class="avis-panneau"
            id={`avis-panneau-${i}`}
            role="tabpanel"
            aria-labelledby={`avis-onglet-${i}`}
            hidden={i !== 0}
          >
            <blockquote class="avis-texte">{guillemets(c.texte)}</blockquote>
            <figcaption class="avis-auteur">
              <b>{c.auteur}</b>, {c.societe}
            </figcaption>
          </figure>
        ))}

        <div class="avis-onglets" role="tablist" aria-label={t.onglets}>
          {citations.map((c, i) => (
            <button
              type="button"
              role="tab"
              id={`avis-onglet-${i}`}
              aria-controls={`avis-panneau-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="avis-onglet"
            >
              <img
                src={LOGOS[c.logo].src}
                alt={c.societe}
                width={LOGOS[c.logo].largeur}
                height={LOGOS[c.logo].hauteur}
                style={`height:${hauteurLogo(c.logo, 1700, 16, 32)}px`}
                class:list={{ 'fond-blanc': LOGOS[c.logo].fondBlanc }}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .avis {
    background: #fff;
  }
  .avis-grille {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .avis-grille {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      row-gap: 3.5rem;
      align-items: start;
    }
    .avis-note {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .avis-citations {
      grid-column: 1 / span 7;
      grid-row: 2;
    }
    .avis-photo {
      grid-column: 9 / span 4;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }
  @media (max-width: 1023px) {
    .avis-photo {
      order: 3;
    }
  }

  .note {
    margin: 0 0 0.12em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 3rem + 11vw, 11.5rem);
    line-height: 0.82;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--color-encre);
  }
  .note .sur {
    font-size: 0.3em;
    letter-spacing: -0.02em;
    color: var(--gris);
    margin-left: 0.12em;
  }
  .avis-titre {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.625rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--texte);
    max-width: 30ch;
  }

  .avis-photo {
    margin: 0;
  }
  .avis-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 30% 50%;
    border-radius: 14px;
    background: var(--brume);
  }
  @media (min-width: 1024px) {
    .avis-photo img {
      aspect-ratio: 4 / 5;
    }
  }
  .avis-photo figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--gris);
  }

  .avis-citations {
    min-height: 15rem;
  }
  .avis-panneau {
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .avis-panneau:not([hidden]) {
      animation: citation-entre 0.7s var(--ease-sortie) both;
    }
  }
  @keyframes citation-entre {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .avis-texte {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 1rem + 1.7vw, 2.25rem);
    line-height: 1.24;
    letter-spacing: -0.02em;
    color: var(--color-encre);
    max-width: 30ch;
    text-wrap: pretty;
  }
  .avis-auteur {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--gris);
  }
  .avis-auteur b {
    color: var(--color-encre);
    font-weight: 600;
  }

  .avis-onglets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  /* Au téléphone, une bande qu'on fait glisser plutôt que trois rangées. */
  @media (max-width: 767px) {
    .avis-onglets {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      margin-inline: -1rem;
      padding: 2px 1rem;
    }
    .avis-onglet {
      flex: none;
      scroll-snap-align: start;
    }
  }
  .avis-onglet {
    touch-action: manipulation;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.25rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--trait);
    background: #fff;
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease-sortie),
      background-color 0.3s var(--ease-sortie);
  }
  .avis-onglet img {
    display: block;
    width: auto;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.6;
    transition:
      filter 0.3s var(--ease-sortie),
      opacity 0.3s var(--ease-sortie);
  }
  .avis-onglet img.fond-blanc {
    mix-blend-mode: multiply;
  }
  .avis-onglet:hover {
    border-color: #c5d0dc;
  }
  .avis-onglet:hover img {
    opacity: 0.9;
  }
  .avis-onglet[aria-selected='true'] {
    border-color: var(--color-encre);
  }
  .avis-onglet[aria-selected='true'] img {
    filter: none;
    opacity: 1;
  }
</style>

<script>
  /**
   * Les onglets des verbatims (modèle ARIA des onglets : flèches gauche et
   * droite, Début, Fin), et UN tour automatique, un verbatim toutes les 6 s,
   * seulement à l'écran, suspendu tant que le pointeur ou le focus est dans la
   * section, arrêté au premier geste, et jamais sous prefers-reduced-motion.
   */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-avis]').forEach((section) => {
    const onglets = Array.from(section.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panneaux = Array.from(section.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (onglets.length < 2) return;
    let courant = 0;

    const choisir = (n: number, focus = false) => {
      courant = (n + onglets.length) % onglets.length;
      onglets.forEach((o, i) => {
        const oui = i === courant;
        o.setAttribute('aria-selected', String(oui));
        o.tabIndex = oui ? 0 : -1;
      });
      panneaux.forEach((p, i) => (p.hidden = i !== courant));
      if (focus) onglets[courant].focus();
    };

    let minuterie = 0;
    let arrete = reduit;
    let visible = false;
    let survole = false;
    const lancer = () => {
      if (arrete || minuterie || !visible) return;
      minuterie = window.setInterval(() => {
        if (survole) return;
        if (courant + 1 >= onglets.length) {
          // Tour complet : on revient au premier et on s'arrête.
          arreter();
          choisir(0);
          return;
        }
        choisir(courant + 1);
      }, 6000);
    };
    const suspendre = () => {
      window.clearInterval(minuterie);
      minuterie = 0;
    };
    const arreter = () => {
      arrete = true;
      suspendre();
    };

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) lancer();
        else suspendre();
      },
      { threshold: 0.35 },
    ).observe(section);
    section.addEventListener('pointerenter', () => (survole = true));
    section.addEventListener('pointerleave', () => (survole = false));
    section.addEventListener('focusin', () => (survole = true));
    section.addEventListener('focusout', () => (survole = false));

    onglets.forEach((o, i) => {
      o.addEventListener('click', () => {
        arreter();
        choisir(i);
      });
      o.addEventListener('keydown', (e) => {
        const cible =
          e.key === 'ArrowRight' ? courant + 1
          : e.key === 'ArrowLeft' ? courant - 1
          : e.key === 'Home' ? 0
          : e.key === 'End' ? onglets.length - 1
          : null;
        if (cible === null) return;
        e.preventDefault();
        arreter();
        choisir(cible, true);
      });
    });
  });
</script>
